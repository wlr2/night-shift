		UiKit.label({ Text = ic[1], Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 48), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.white, TextSize = 13, ZIndex = 3, Parent = b })

					<Item class="ModuleScript" referent="254">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Turns the converted low-poly library (ReplicatedStorage.ArtData) into real
-- meshes on this client with EditableMesh / EditableImage.
--
-- Roblox clients may hold only a handful of EditableMeshes (8 in Studio
-- tests, 60k vertices / 20k triangles each), so every STATIC prop is baked
-- into a few merged world-space chunks that share one texture atlas. Only
-- moving props (the figure outside, crew silhouettes) get their own mesh.
--
-- The server places invisible parts tagged "ArtAnchor" with an ArtKey
-- attribute and flips workspace "MapReady" when the map is complete.
-- Visual only: collision always comes from server-side proxy parts.

local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Base64 = require(ReplicatedStorage.Shared.Util.Base64)

local ArtData = ReplicatedStorage:WaitForChild("ArtData")
local Index = require(ArtData:WaitForChild("Index")) :: any
local ModelsFolder = ArtData:WaitForChild("Models")
local TexturesFolder = ArtData:WaitForChild("Textures")

type PartData = {
	nv: number,
	nt: number,
	color: { number },
	center: { number },
	size: { number },
	v: string,
	n: string,
	uv: string,
	i: string,
}

type ModelData = { parts: { PartData }, min: { number }, max: { number } }

type Chunk = {
	em: EditableMesh,
	verts: number,
	tris: number,
	colors: { [string]: number },
}

local MAX_VERTS = 59000
local MAX_TRIS = 19900
local MAX_MESHES = 8

local ArtController = {}

local modelCache: { [string]: ModelData | false } = {}
local surfaceCache: { [string]: EditableImage | false } = {}
local atlas: EditableImage? = nil
local meshesUsed = 0
local baked = false
local dynamicBuilt: { [BasePart]: MeshPart } = {}

ArtController.stats = { chunks = 0, staticProps = 0, dynamicProps = 0, triangles = 0, skipped = 0 }

local function decode565(data: { w: number, h: number, data: string }, dest: buffer, destWidth: number, rowOffset: number)
	local raw = Base64.decode(data.data)
	for y = 0, data.h - 1 do
		for x = 0, data.w - 1 do
			local v = buffer.readu16(raw, (y * data.w + x) * 2)
			local o = ((y + rowOffset) * destWidth + x) * 4
			buffer.writeu8(dest, o, bit32.rshift(v, 11) * 255 // 31)
			buffer.writeu8(dest, o + 1, bit32.band(bit32.rshift(v, 5), 63) * 255 // 63)
			buffer.writeu8(dest, o + 2, bit32.band(v, 31) * 255 // 31)
			buffer.writeu8(dest, o + 3, 255)
		end
	end
end

local function loadAtlas(): EditableImage?
	if atlas then
		return atlas
	end
	local info = Index.atlas
	local px = buffer.create(info.w * info.h * 4)
	for i = 0, info.strips - 1 do
		local mod = TexturesFolder:FindFirstChild("Atlas_" .. i)
		if mod and mod:IsA("ModuleScript") then
			decode565((require :: any)(mod), px, info.w, i * info.strip)
		end
		if i % 2 == 1 then
			task.wait()
		end
	end
	local ok, img = pcall(function()
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(info.w, info.h) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(info.w, info.h), px)
		return image
	end)
	if ok then
		atlas = img
		return img
	end
	warn("[Art] atlas failed", img)
	return nil
end

-- Surface textures (walls, floors, paper) for server-built parts, applied
-- through Texture.ColorMapContent.
function ArtController.getSurface(name: string): EditableImage?
	local cached = surfaceCache[name]
	if cached == false then
		return nil
	elseif cached ~= nil then
		return cached :: EditableImage
	end
	local key = Index.surfaces[name]
	local mod = key and TexturesFolder:FindFirstChild(key)
	if not mod or not mod:IsA("ModuleScript") then
		surfaceCache[name] = false
		return nil
	end
	local data = (require :: any)(mod) :: { w: number, h: number, data: string }
	local px = buffer.create(data.w * data.h * 4)
	decode565(data, px, data.w, 0)
	local ok, img = pcall(function()
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(data.w, data.h) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(data.w, data.h), px)
		return image
	end)
	local result = if ok then img :: EditableImage else nil
	surfaceCache[name] = result or false
	return result
end

local function getModel(key: string): ModelData?
	local cached = modelCache[key]
	if cached == false then
		return nil
	elseif cached ~= nil then
		return cached :: ModelData
	end
	local mod = ModelsFolder:FindFirstChild(key)
	if not mod or not mod:IsA("ModuleScript") then
		modelCache[key] = false
		return nil
	end
	local ok, data = pcall(function()
		return (require :: any)(mod) :: ModelData
	end)
	local result = if ok then data :: ModelData else nil
	modelCache[key] = result or false
	return result
end

local function newChunk(): Chunk?
	if meshesUsed >= MAX_MESHES then
		return nil
	end
	local em = AssetService:CreateEditableMesh()
	if not em then
		return nil
	end
	meshesUsed += 1
	return { em = em, verts = 0, tris = 0, colors = {} }
end

local function finalizeChunk(chunk: Chunk, name: string, parent: Instance): MeshPart?
	if chunk.tris == 0 then
		return nil
	end
	local ok, mp = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromObject(chunk.em), {
			CollisionFidelity = Enum.CollisionFidelity.Box,
		})
	end)
	if not ok or not mp then
		warn("[Art] chunk failed", mp)
		return nil
	end
	mp.Name = name
	mp.Anchored = true
	mp.CanCollide = false
	mp.CanQuery = false
	mp.CanTouch = false
	mp.Material = Enum.Material.SmoothPlastic
	mp.Color = Color3.new(1, 1, 1)
	local img = loadAtlas()
	if img then
		mp.TextureContent = Content.fromObject(img)
	end
	mp.CFrame = CFrame.identity
	mp.Parent = parent
	ArtController.stats.triangles += chunk.tris
	return mp
end

-- Appends one model instance (transformed by cf, uniform scale s) to chunk.
local function appendModel(chunk: Chunk, data: ModelData, cf: CFrame, s: number, tint: Color3?)
	local em = chunk.em
	for _, pd in data.parts do
		local vb = Base64.decode(pd.v)
		local nb = Base64.decode(pd.n)
		local ub = Base64.decode(pd.uv)
		local ib = Base64.decode(pd.i)
		local cx, cy, cz = pd.center[1], pd.center[2], pd.center[3]
		local hx, hy, hz = pd.size[1] / 2, pd.size[2] / 2, pd.size[3] / 2
		local r, g, b = pd.color[1], pd.color[2], pd.color[3]
		if tint then
			r, g, b = r * tint.R, g * tint.G, b * tint.B
		end
		local ckey = string.format("%.3f,%.3f,%.3f", r, g, b)
		local colorId = chunk.colors[ckey]
		if not colorId then
			colorId = em:AddColor(Color3.new(r, g, b), 1)
			chunk.colors[ckey] = colorId
		end
		local vids = table.create(pd.nv)
		local nids = table.create(pd.nv)
		local uids = table.create(pd.nv)
		for k = 0, pd.nv - 1 do
			local lx = (cx + buffer.readi16(vb, k * 6) / 32767 * hx) * s
			local ly = (cy + buffer.readi16(vb, k * 6 + 2) / 32767 * hy) * s
			local lz = (cz + buffer.readi16(vb, k * 6 + 4) / 32767 * hz) * s
			vids[k + 1] = em:AddVertex(cf:PointToWorldSpace(Vector3.new(lx, ly, lz)))
			local n = Vector3.new(buffer.readi8(nb, k * 3), buffer.readi8(nb, k * 3 + 1), buffer.readi8(nb, k * 3 + 2)) / 127
			nids[k + 1] = em:AddNormal(cf:VectorToWorldSpace(n))
			uids[k + 1] = em:AddUV(Vector2.new(buffer.readu16(ub, k * 4) / 65535, buffer.readu16(ub, k * 4 + 2) / 65535))
		end
		local colors = { colorId, colorId, colorId }
		for t = 0, pd.nt - 1 do
			local a = buffer.readu16(ib, t * 6) + 1
			local bb = buffer.readu16(ib, t * 6 + 2) + 1
			local c = buffer.readu16(ib, t * 6 + 4) + 1
			local ok, fid = pcall(em.AddTriangle, em, vids[a], vids[bb], vids[c])
			if ok then
				em:SetFaceNormals(fid, { nids[a], nids[bb], nids[c] })
				em:SetFaceUVs(fid, { uids[a], uids[bb], uids[c] })
				em:SetFaceColors(fid, colors)
				chunk.tris += 1
			end
		end
		chunk.verts += pd.nv
	end
end

local function modelCounts(data: ModelData): (number, number)
	local v, t = 0, 0
	for _, pd in data.parts do
		v += pd.nv
		t += pd.nt
	end
	return v, t
end

local function anchorParams(anchor: BasePart): (string?, number, Color3?)
	local key = anchor:GetAttribute("ArtKey")
	local scale = anchor:GetAttribute("ArtScale")
	local tint = anchor:GetAttribute("ArtTint")
	return (if typeof(key) == "string" then key else nil),
		(if typeof(scale) == "number" then scale else 1),
		(if typeof(tint) == "Color3" then tint else nil)
end

-- Bakes every static anchor into merged chunks. Reserves room for dynamic props.
local function bakeStatic()
	if baked then
		return
	end
	baked = true
	local folder = Instance.new("Folder")
	folder.Name = "BakedArt"
	folder.Parent = workspace
	loadAtlas()

	local anchors: { BasePart } = {}
	for _, inst in CollectionService:GetTagged("ArtAnchor") do
		if inst:IsA("BasePart") and inst:GetAttribute("ArtDynamic") ~= true then
			table.insert(anchors, inst)
		end
	end
	-- spatial ordering keeps chunks compact (better culling)
	table.sort(anchors, function(a, b)
		return a.Position.X < b.Position.X
	end)

	local reserveForDynamic = 3
	local chunk = newChunk()
	local chunkIndex = 1
	local workDone = 0
	for _, anchor in anchors do
		local key, s, tint = anchorParams(anchor)
		local data = key and getModel(key)
		if data and chunk then
			local nv, nt = modelCounts(data)
			if chunk.verts + nv > MAX_VERTS or chunk.tris + nt > MAX_TRIS then
				finalizeChunk(chunk, "Chunk" .. chunkIndex, folder)
				chunkIndex += 1
				chunk = if meshesUsed < MAX_MESHES - reserveForDynamic then newChunk() else nil
			end
			if chunk then
				appendModel(chunk, data, anchor.CFrame, s, tint)
				ArtController.stats.staticProps += 1
				workDone += nv
				if workDone > 2500 then
					workDone = 0
					task.wait()
				end
			else
				ArtController.stats.skipped += 1
			end
		elseif data then
			ArtController.stats.skipped += 1
		end
	end
	if chunk then
		finalizeChunk(chunk, "Chunk" .. chunkIndex, folder)
	end
	ArtController.stats.chunks = chunkIndex
end

local function buildDynamic(anchor: BasePart)
	if dynamicBuilt[anchor] or not anchor.Parent then
		return
	end
	local key, s, tint = anchorParams(anchor)
	local data = key and getModel(key)
	if not data then
		return
	end
	local chunk = newChunk()
	if not chunk then
		warn("[Art] no mesh budget left for", key)
		return
	end
	-- build in the anchor's local space, then weld to it
	appendModel(chunk, data, CFrame.identity, s, tint)
	local mp = finalizeChunk(chunk, key or "Dynamic", anchor)
	if not mp then
		return
	end
	mp.Anchored = false
	mp.Massless = true
	mp.CFrame = anchor.CFrame
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = mp
	weld.Parent = mp
	dynamicBuilt[anchor] = mp
	ArtController.stats.dynamicProps += 1
	local function syncHidden()
		mp.Transparency = if anchor:GetAttribute("ArtHidden") == true then 1 else 0
	end
	syncHidden()
	anchor:GetAttributeChangedSignal("ArtHidden"):Connect(syncHidden)
end

function ArtController.isReady(): boolean
	return baked
end

function ArtController.init()
	CollectionService:GetInstanceAddedSignal("ArtAnchor"):Connect(function(inst: Instance)
		if baked and inst:IsA("BasePart") and inst:GetAttribute("ArtDynamic") == true then
			task.spawn(buildDynamic, inst)
		end
	end)
end

function ArtController.start()
	while workspace:GetAttribute("MapReady") ~= true do
		task.wait(0.1)
	end
	local ok, err = pcall(bakeStatic :: any)
	if not ok then
		warn("[Art] bake failed", err)
	end
	for _, inst in CollectionService:GetTagged("ArtAnchor") do
		if inst:IsA("BasePart") and inst:GetAttribute("ArtDynamic") == true then
			task.spawn(buildDynamic, inst)
		end
	end
	workspace:SetAttribute("ClientArtReady", true)
end

return ArtController
]]></ProtectedString>
							<string name="ScriptGuid">{DCC4626C-D09F-419B-9AEF-78A38845A395}</string>
							<BinaryString name="AttributesSerialize">AQAAAAgAAABTeW5jSGFzaAIQAAAAZjMzY2YxNDI4ZDc5YTA2NA==</BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">ArtController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">30936996b29238eb0aeb0d51000004d8</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0C7D17CD463A413387833305C9CAD391">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Mood: muted colour grade, soft bloom, haze, rain outside and on the glass,
-- restrained film grain, ambient loops, a personal dim light for blackouts,
-- blinking door indicator, and gradual "dread" as more data is erased.
-- Everything here is cosmetic and client-local.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local AssetService = game:GetService("AssetService")

local Layout = require(ReplicatedStorage.Shared.Layout)
local ArtController = require(script.Parent.ArtController)
local State = require(script.Parent.State)
local Sfx = require(script.Parent.Parent.Ui.Sfx)

local player = Players.LocalPlayer

local Atmosphere = {}

local cc: ColorCorrectionEffect
local bloom: BloomEffect
local atmos: Atmosphere
local rainEmitters: { ParticleEmitter } = {}
local grain: ImageLabel? = nil
local grainImages: { EditableImage } = {}
local dread = 0
local flashOverride: number? = nil

Atmosphere.cc = function(): ColorCorrectionEffect
	return cc
end

local function applySurfaces()
	local tints: { [string]: Color3 } = {
		carpet = Color3.fromRGB(150, 156, 176),
		ceiling_tile = Color3.fromRGB(150, 146, 136),
		wall_office = Color3.fromRGB(232, 222, 200),
	}
	local function apply(t: Instance)
		if not t:IsA("Texture") then
			return
		end
		local name = t:GetAttribute("Surface")
		if typeof(name) ~= "string" then
			return
		end
		local img = ArtController.getSurface(name)
		if img then
			t.ColorMapContent = Content.fromObject(img)
			local tint = tints[name]
			if tint then
				t.Color3 = tint
			end
		end
	end
	for _, t in CollectionService:GetTagged("Surface") do
		apply(t)
	end
	CollectionService:GetInstanceAddedSignal("Surface"):Connect(apply)
end

local function makeRain(region: { minX: number, maxX: number, minZ: number, maxZ: number }, height: number): ParticleEmitter
	local p = Instance.new("Part")
	p.Name = "RainCloud"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(region.maxX - region.minX, 1, region.maxZ - region.minZ)
	p.Position = Vector3.new((region.minX + region.maxX) / 2, height, (region.minZ + region.maxZ) / 2)
	p.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Rate = 260
	e.Lifetime = NumberRange.new(0.9, 1.1)
	e.Speed = NumberRange.new(55, 65)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(4, 4)
	e.Size = NumberSequence.new(0.06)
	e.Squash = NumberSequence.new(-3.5)
	e.Transparency = NumberSequence.new(0.55)
	e.LightEmission = 0.15
	e.LightInfluence = 0.6
	e.Color = ColorSequence.new(Color3.fromRGB(170, 185, 200))
	e.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
	e.Parent = p
	table.insert(rainEmitters, e)
	return e
end

local function rainOnGlass()
	-- slow drips sliding down each window (client-only frames)
	local drips: { { f: Frame, speed: number } } = {}
	for _, part in workspace:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("RainGlass") == true then
			local sg = Instance.new("SurfaceGui")
			sg.Face = Enum.NormalId.Back
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 30
			sg.LightInfluence = 1
			sg.Parent = part
			for _ = 1, 14 do
				local f = Instance.new("Frame")
				f.BorderSizePixel = 0
				f.BackgroundColor3 = Color3.fromRGB(190, 205, 220)
				f.BackgroundTransparency = 0.6 + math.random() * 0.3
				f.Size = UDim2.fromOffset(2, math.random(6, 18))
				f.Position = UDim2.fromScale(math.random(), math.random())
				f.Parent = sg
				table.insert(drips, { f = f, speed = 0.03 + math.random() * 0.08 })
			end
		end
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		for _, d in drips do
			local p = d.f.Position
			local y = p.Y.Scale + d.speed * acc
			if y > 1.05 then
				y = -0.05
			end
			d.f.Position = UDim2.fromScale(p.X.Scale, y)
		end
		acc = 0
	end)
end

local function buildGrain()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Grain"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15
	gui.Parent = player:WaitForChild("PlayerGui")
	local ok = pcall(function()
		for _ = 1, 3 do
			local img = AssetService:CreateEditableImage({ Size = Vector2.new(96, 96) })
			local buf = buffer.create(96 * 96 * 4)
			for i = 0, 96 * 96 - 1 do
				local v = math.random(0, 255)
				buffer.writeu8(buf, i * 4, v)
				buffer.writeu8(buf, i * 4 + 1, v)
				buffer.writeu8(buf, i * 4 + 2, v)
				buffer.writeu8(buf, i * 4 + 3, 255)
			end
			img:WritePixelsBuffer(Vector2.zero, Vector2.new(96, 96), buf)
			table.insert(grainImages, img)
		end
	end)
	if not ok or #grainImages == 0 then
		return
	end
	local label = Instance.new("ImageLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.ImageContent = Content.fromObject(grainImages[1])
	label.ScaleType = Enum.ScaleType.Tile
	label.TileSize = UDim2.fromOffset(192, 192)
	label.ImageTransparency = 0.955
	label.Active = false
	label.Interactable = false
	label.Parent = gui
	grain = label
	local i = 1
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 0.06 then
			acc = 0
			i = i % #grainImages + 1
			label.ImageContent = Content.fromObject(grainImages[i])
			label.Position = UDim2.fromOffset(math.random(-40, 0), math.random(-40, 0))
			label.ImageTransparency = 0.955 - dread * 0.02
		end
	end)
end

local function setupLighting()
	cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "NightGrade"
	cc.Saturation = -0.28
	cc.Contrast = 0.12
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(255, 244, 228)
	cc.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Name = "SoftBloom"
	bloom.Intensity = 0.55
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	for _, e in Lighting:GetChildren() do
		if e:IsA("SunRaysEffect") or e:IsA("DepthOfFieldEffect") then
			e.Enabled = false
		end
	end
	local existing = Lighting:FindFirstChildOfClass("Atmosphere")
	atmos = existing or Instance.new("Atmosphere")
	atmos.Density = 0.36
	atmos.Offset = 0.1
	atmos.Color = Color3.fromRGB(60, 66, 80)
	atmos.Decay = Color3.fromRGB(30, 32, 40)
	atmos.Glare = 0
	atmos.Haze = 2.2
	atmos.Parent = Lighting
	Lighting.ClockTime = 1.5
	Lighting.Brightness = 0.2
	Lighting.Ambient = Color3.fromRGB(26, 26, 32)
	Lighting.OutdoorAmbient = Color3.fromRGB(22, 24, 30)
	Lighting.EnvironmentDiffuseScale = 0.15
	Lighting.EnvironmentSpecularScale = 0.15
end

local function updateDread()
	local v = workspace:GetAttribute("Dread")
	dread = if typeof(v) == "number" then v else 0
	-- colder and greyer as the purge nears; rain picks up
	cc.Saturation = -0.28 - dread * 0.22
	cc.TintColor = Color3.fromRGB(255, 244, 228):Lerp(Color3.fromRGB(210, 225, 255), dread)
	atmos.Density = 0.36 + dread * 0.12
	for _, e in rainEmitters do
		e.Rate = 220 + dread * 260
	end
end

-- brief brightness dips used by power warnings and flickers (never touches
-- server-owned light state, so nothing can get stuck)
function Atmosphere.flicker(seconds: number, strength: number?)
	local s = strength or 0.35
	local token = os.clock()
	flashOverride = token
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < seconds and flashOverride == token do
			cc.Brightness = if math.random() < 0.5 then -s else 0.02
			task.wait(0.04 + math.random() * 0.12)
		end
		if flashOverride == token then
			cc.Brightness = 0.02
			flashOverride = nil
		end
	end)
end

local function ambience()
	Sfx.play("ambientRoom", { looped = true, volume = 0.3 })
	Sfx.play("rain", { looped = true, volume = 0.22 })
	Sfx.play("fanHum", { looped = true, volume = 0.12 })
	local tense = Sfx.play("ambientTense", { looped = true, volume = 0 })
	local finale = Sfx.play("ambientFinale", { looped = true, volume = 0 })
	if finale then
		State.Changed:Connect(function(snap)
			local on = snap.phase == "FinalPurge" or snap.phase == "SignOff" or snap.phase == "ClockOut"
			finale.Volume = if on then 0.45 else 0
		end)
	end
	if tense then
		workspace:GetAttributeChangedSignal("Dread"):Connect(function()
			tense.Volume = 0.05 + dread * 0.3
		end)
	end
end

local function personalLight(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and root:IsA("BasePart") then
		local l = Instance.new("PointLight")
		l.Name = "PhoneGlow"
		l.Range = 9
		l.Brightness = 0.22
		l.Color = Color3.fromRGB(200, 210, 255)
		l.Shadows = false
		l.Parent = root
	end
end

local function doorBlink()
	local acc = 0
	local on = true
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.4 then
			return
		end
		acc = 0
		local map = workspace:FindFirstChild("Map")
		local inter = map and map:FindFirstChild("Interactive")
		local light = inter and inter:FindFirstChild("DoorStatusLight")
		if light and light:IsA("BasePart") then
			on = not on
			light.Transparency = if light:GetAttribute("Alert") == true and not on then 0.8 else 0
		end
	end)
end

local function screenTexts()
	-- source monitor messages set by the story (server attribute "Text")
	local map = workspace:WaitForChild("Map", 20)
	local inter = map and map:WaitForChild("Interactive", 10)
	if not inter then
		return
	end
	for i = 1, 6 do
		local screen = inter:FindFirstChild("SourceScreen_" .. i)
		if screen and screen:IsA("BasePart") then
			local sg = Instance.new("SurfaceGui")
			sg.Name = "StoryText"
			sg.Face = Enum.NormalId.Back
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 80
			sg.LightInfluence = 0
			sg.Parent = screen
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.TextColor3 = Color3.fromRGB(120, 255, 140)
			t.Font = Enum.Font.Arcade
			t.TextScaled = true
			t.Text = ""
			t.Parent = sg
			local function sync()
				local v = screen:GetAttribute("Text")
				t.Text = if typeof(v) == "string" then v else ""
				screen.Material = if t.Text ~= "" then Enum.Material.Neon else Enum.Material.SmoothPlastic
				screen.Color = if t.Text ~= "" then Color3.fromRGB(10, 30, 14) else Color3.fromRGB(10, 14, 12)
			end
			screen:GetAttributeChangedSignal("Text"):Connect(sync)
			sync()
		end
	end
end

function Atmosphere.init()
	setupLighting()
end

function Atmosphere.start()
	while workspace:GetAttribute("MapReady") ~= true do
		task.wait(0.1)
	end
	applySurfaces()
	makeRain(Layout.ALLEY, 40)
	makeRain({ minX = -34, maxX = 36, minZ = -29, maxZ = -15 }, 40)
	makeRain(Layout.STREET, 40)
	rainOnGlass()
	buildGrain()
	doorBlink()
	ambience()
	task.spawn(screenTexts)
	workspace:GetAttributeChangedSignal("Dread"):Connect(updateDread)
	updateDread()
	player.CharacterAdded:Connect(personalLight)
	if player.Character then
		personalLight(player.Character)
	end
	local _ = grain
end

return Atmosphere
]]></ProtectedString>
							<string name="ScriptGuid">{FA9DDC9C-3BBF-4D4D-A149-63097AC1B2CB}</string>
							<BinaryString name="AttributesSerialize">AQAAAAgAAABTeW5jSGFzaAIQAAAAZTEyNzQ0ODlkYzNjOWIyZA==</BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Atmosphere</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">30936996b29238eb0aeb0d5100001bc1</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXB8F4AC34E36A4EEEA0D501B41D017ABE">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- The workstation desktop: a native-GUI, early-2000s style OS shell that
-- hosts every SecureErase utility. Opens when the server starts a session
-- for this player and closes the moment the session ends. Everything here is
-- presentation: actions are sent to the server as semantic commands tagged
-- with the session id, and the server answers with the authoritative state.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local State = require(script.Parent.State)
local UiKit = require(script.Parent.Parent.Ui.UiKit)

local C = UiKit.C
local player = Players.LocalPlayer

local Views: { [string]: any } = {}
for _, m in script.Parent.Parent:WaitForChild("Views"):GetChildren() do
	if m:IsA("ModuleScript") then
		Views[m.Name] = (require :: any)(m)
	end
end

local Desktop = {}

local W, H = 960, 600

local gui: ScreenGui
local bezel: Frame
local canvas: Frame
local canvasScale: UIScale
local windowsLayer: Frame
local mainWin: UiKit.Window
local mainParts: {
	header: TextLabel,
	stage: TextLabel,
	progressFill: Frame,
	instructions: TextLabel,
	game: Frame,
	feedback: TextLabel,
	hint: TextLabel,
	overlay: Frame,
	overlayText: TextLabel,
}
local side: { [string]: UiKit.Window } = {}
local sideOpen: { [string]: boolean } = {}
local taskbarTray: { erased: TextLabel, door: TextLabel, power: TextLabel, clock: TextLabel }
local startMenu: Frame
local toast: Frame
local toastText: TextLabel
local phantomFrame: Frame?
local fragmentWin: UiKit.Window?
local leaveButton: TextButton

local isOpen = false
local session: Types.SessionPayload? = nil
local lastViewKey = ""
local zTop = 20
local filesSelection: number? = nil
local sideKeys: { [string]: string } = {}
local finaleKey = ""

-- cheap content signature per side app, so snapshots that change nothing
-- relevant do not rebuild the window (scroll position and focus survive)
local function sideKey(name: string, snap: Types.Snapshot): string
	if name == "Messenger" then
		local last = snap.boss[#snap.boss]
		local open = 0
		for _, m in snap.boss do
			if m.answered then
				open += 1
			end
		end
		return string.format("%d:%s:%d", #snap.boss, if last then tostring(last.id) else "-", open)
	elseif name == "DriveInfo" then
		local parts = {}
		for _, d in snap.drives do
			table.insert(parts, d.state .. math.floor(d.progress * 20) .. (d.carrier or ""))
		end
		return table.concat(parts, "|")
	end
	return "static"
end

local function finaleSignature(snap: Types.Snapshot): string
	local parts: { string } = { snap.phase :: string, tostring(snap.power.workstation) }
	if snap.purge then
		for _, e in snap.purge do
			table.insert(parts, e.name .. tostring(e.cancelled))
		end
		table.insert(parts, tostring(math.floor(snap.purgeDeadline or 0)))
	end
	if snap.signOff then
		table.insert(parts, tostring(math.floor(snap.signOff.progress * 100)) .. tostring(snap.signOff.awaiting))
	end
	return table.concat(parts, ";")
end

local function send(kind: string, a: any?, b: any?, c: any?)
	local s = session
	if not s then
		return
	end
	Net.remote("Desktop"):FireServer(s.sessionId, kind, a, b, c)
end

function Desktop.leave()
	Net.remote("Leave"):FireServer()
	local character = player.Character
	local h = character and character:FindFirstChildOfClass("Humanoid")
	if h then
		h.Sit = false
		h.Jump = true
	end
end

-- ZIndexBehavior is Sibling, so raising the window frame raises the window.
local function bringToFront(w: UiKit.Window)
	zTop += 1
	w.frame.ZIndex = zTop
	if phantomFrame then
		phantomFrame.ZIndex = zTop + 100
	end
end

-- Side applications ---------------------------------------------------------

local renderSide: (name: string) -> ()

local function openSide(name: string)
	local w = side[name]
	if not w then
		return
	end
	sideOpen[name] = true
	w.frame.Visible = true
	bringToFront(w)
	renderSide(name)
	startMenu.Visible = false
end

local function closeSide(name: string)
	sideOpen[name] = false
	local w = side[name]
	if w then
		w.frame.Visible = false
	end
end

local function listLabel(parent: Instance, text: string, y: number, h: number, z: number, opts: { [string]: any }?): TextLabel
	local p: { [string]: any } = {
		Text = text,
		Size = UDim2.new(1, -16, 0, h),
		Position = UDim2.fromOffset(8, y),
		TextSize = 15,
		ZIndex = z,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = parent,
	}
	local extra: { [string]: any } = opts or {}
	for k, v in extra do
		p[k] = v
	end
	return UiKit.label(p)
end

renderSide = function(name: string)
	local w = side[name]
	local snap = State.snapshot
	if not w or not sideOpen[name] or not snap then
		return
	end
	local body = w.body
	UiKit.clear(body)
	local z = w.frame.ZIndex + 2
	local paper = UiKit.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.field, ZIndex = z, Parent = body })
	UiKit.bevel(paper, true)
	local scroll = UiKit.new("ScrollingFrame", {
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.fromOffset(3, 3),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 10,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = z + 1,
		Parent = paper,
	}) :: ScrollingFrame
	local y = 6
	if name == "Messenger" then
		for _, m in snap.boss do
			local tint = if m.kind == "false" then Color3.fromRGB(140, 30, 30) elseif m.kind == "system" then Color3.fromRGB(20, 80, 30) else C.info
			listLabel(scroll, string.format("[%s] %s:", State.nightClock(m.t), m.from), y, 18, z + 2, { Font = UiKit.FONT_BOLD, TextColor3 = tint })
			y += 18
			local lbl = listLabel(scroll, m.text, y, 40, z + 2, { AutomaticSize = Enum.AutomaticSize.Y })
			y += math.max(40, lbl.TextBounds.Y + 6)
			if m.choices and not m.answered then
				for i, choice in m.choices do
					UiKit.button({
						text = choice,
						size = UDim2.fromOffset(180, 30),
						position = UDim2.fromOffset(8 + (i - 1) * 188, y),
						parent = scroll,
						color = if i == 1 then C.face else Color3.fromRGB(230, 220, 190),
						textSize = 14,
						zindex = z + 2,
						onClick = function()
							send("bossReply", m.id, i)
						end,
					})
				end
				y += 36
			elseif m.answered then
				listLabel(scroll, "> " .. m.answered, y, 18, z + 2, { TextColor3 = C.faceDark, TextSize = 13 })
				y += 20
			end
			y += 6
		end
		scroll.CanvasPosition = Vector2.new(0, 100000)
	elseif name == "Procedures" then
		listLabel(scroll, "PROCEDURES.TXT - Night Operations (rev. 2006)", y, 22, z + 2, { Font = UiKit.FONT_BOLD })
		y += 28
		for _, line in Dialogue.PROCEDURES do
			local l = listLabel(scroll, line, y, 40, z + 2, { Font = UiKit.FONT_MONO, TextSize = 15 })
			y += math.max(40, l.TextBounds.Y + 8)
		end
		listLabel(scroll, "If an instruction contradicts these procedures, reject it and cite the number.", y + 6, 40, z + 2, { TextColor3 = C.bad, TextSize = 14 })
	elseif name == "Files" then
		listLabel(scroll, "C:\\RECOVERED\\  (fragments saved before shredding)", y, 20, z + 2, { Font = UiKit.FONT_BOLD })
		y += 26
		if #snap.fragments == 0 then
			listLabel(scroll, "(empty)", y, 20, z + 2, { TextColor3 = C.faceDark })
		end
		for _, idx in snap.fragments do
			local f = Dialogue.FRAGMENTS[idx]
			if f then
				UiKit.button({
					text = string.format("%02d  %s   (%s)", idx, f.title, f.kind),
					size = UDim2.new(1, -24, 0, 28),
					position = UDim2.fromOffset(8, y),
					parent = scroll,
					color = if filesSelection == idx then Color3.fromRGB(200, 215, 240) else C.field,
					textSize = 14,
					font = UiKit.FONT,
					zindex = z + 2,
					bevel = false,
					onClick = function()
						filesSelection = idx
						renderSide("Files")
					end,
				}).TextXAlignment = Enum.TextXAlignment.Left
				y += 30
				if filesSelection == idx then
					local l = listLabel(scroll, f.body, y, 80, z + 2, { Font = UiKit.FONT_MONO, TextSize = 14, BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(250, 248, 236) })
					y += math.max(80, l.TextBounds.Y + 10)
				end
			end
		end
	elseif name == "DriveInfo" then
		listLabel(scroll, "DRIVE MANAGER - team job status", y, 20, z + 2, { Font = UiKit.FONT_BOLD })
		y += 26
		listLabel(scroll, string.format("Erased: %d of %d", snap.erased, snap.total), y, 20, z + 2)
		y += 24
		for _, d in snap.drives do
			local where = d.state
			if d.carrier then
				where = "Carried by " .. d.carrier
			end
			local pct = math.floor(d.progress * 100)
			listLabel(scroll, string.format("%s  %-15s  %-22s %3d%%", d.id, d.name, where, pct), y, 20, z + 2, {
				Font = UiKit.FONT_MONO,
				TextSize = 13,
				TextColor3 = if d.state == "Erased" then C.good else C.text,
			})
			y += 22
			if d.gameTitle then
				listLabel(scroll, "      utility: " .. d.gameTitle, y, 18, z + 2, { TextSize = 12, TextColor3 = C.faceDark })
				y += 20
			end
		end
	end
end

-- Main SecureErase window ----------------------------------------------------

local function setFeedback(text: string?, kind: string?)
	mainParts.feedback.Text = text or ""
	mainParts.feedback.TextColor3 = if kind == "bad" then C.bad elseif kind == "good" then C.good else C.info
end

local function renderFinale(snap: Types.Snapshot)
	local g = mainParts.game
	UiKit.clear(g)
	local z = g.ZIndex
	if snap.phase == "FinalPurge" and snap.purge then
		local left = math.floor(snap.purgeDeadline or 0)
		finaleKey = finaleSignature(snap)
		mainWin.title.Text = "SecureErase :: FINAL PURGE QUEUE"
		mainParts.header.Text = "AUTOMATIC FINAL PURGE: EMPLOYEE RECORDS"
		mainParts.stage.Text = string.format("Executes in %d:%02d", left // 60, left % 60)
		mainParts.instructions.Text = "The final purge includes YOUR employee records. Cancel every entry from tonight, then run EMERGENCY SIGN-OFF."
		local allDone = true
		for i, e in snap.purge do
			local row = UiKit.frame({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, (i - 1) * 28), BackgroundColor3 = if e.locked then Color3.fromRGB(200, 196, 190) else C.field, ZIndex = z, Parent = g })
			UiKit.label({ Text = e.name, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.fromOffset(8, 0), Font = UiKit.FONT_MONO, TextSize = 14, ZIndex = z + 1, Parent = row })
			if e.locked then
				UiKit.label({ Text = "PURGED 03-NOV-2003", Size = UDim2.new(0.38, 0, 1, 0), Position = UDim2.fromScale(0.6, 0), TextColor3 = C.bad, TextSize = 13, ZIndex = z + 1, Parent = row })
			elseif e.cancelled then
				UiKit.label({ Text = "REMOVED FROM QUEUE", Size = UDim2.new(0.38, 0, 1, 0), Position = UDim2.fromScale(0.6, 0), TextColor3 = C.good, Font = UiKit.FONT_BOLD, TextSize = 13, ZIndex = z + 1, Parent = row })
			else
				allDone = false
				UiKit.button({
					text = "CANCEL",
					size = UDim2.new(0.25, 0, 1, -2),
					position = UDim2.fromScale(0.72, 0),
					parent = row,
					color = C.bad,
					textColor = C.white,
					textSize = 14,
					zindex = z + 2,
					onClick = function()
						send("purgeCancel", i)
					end,
				})
			end
		end
		local run = UiKit.button({
			text = "RUN EMERGENCY SIGN-OFF",
			size = UDim2.fromOffset(300, 40),
			position = UDim2.new(0.5, -150, 1, -42),
			parent = g,
			color = if allDone then C.good else C.faceDark,
			textColor = C.white,
			zindex = z + 2,
			onClick = function()
				send("signOffStart")
			end,
		})
		UiKit.setEnabled(run, allDone)
		mainParts.progressFill.Size = UDim2.fromScale(1 - math.clamp(left / 150, 0, 1), 1)
		mainParts.progressFill.BackgroundColor3 = C.bad
	elseif snap.phase == "SignOff" and snap.signOff then
		local s = snap.signOff
		mainWin.title.Text = "SecureErase :: EMERGENCY SIGN-OFF"
		mainParts.header.Text = "Writing tonight's timesheets to the off-site backup"
		mainParts.stage.Text = string.format("%d%%", math.floor(s.progress * 100))
		mainParts.instructions.Text = "Keep the workstation powered. At each checkpoint the operator must CONFIRM. Power loss pauses the sign-off; it never resets."
		mainParts.progressFill.Size = UDim2.fromScale(s.progress, 1)
		mainParts.progressFill.BackgroundColor3 = C.good
		local status = if not snap.power.workstation then "PAUSED - no power" elseif s.awaiting then "PAUSED - confirmation required" else "Running..."
		UiKit.label({ Text = status, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 20), TextXAlignment = Enum.TextXAlignment.Center, Font = UiKit.FONT_BOLD, TextSize = 24, ZIndex = z, Parent = g })
		if s.awaiting then
			UiKit.button({
				text = "CONFIRM CHECKPOINT",
				size = UDim2.fromOffset(320, 70),
				position = UDim2.new(0.5, -160, 0, 90),
				parent = g,
				color = C.good,
				textColor = C.white,
				textSize = 22,
				zindex = z + 1,
				onClick = function()
					send("signOffConfirm")
				end,
			})
		end
	elseif snap.phase == "ClockOut" or snap.phase == "Ending" then
		mainWin.title.Text = "SecureErase"
		mainParts.header.Text = "SIGN-OFF COMPLETE"
		mainParts.stage.Text = ""
		mainParts.instructions.Text = "Your records are safe off-site. Leave the computer, clock out at the lobby time clock and get out."
		mainParts.progressFill.Size = UDim2.fromScale(1, 1)
	end
end

local function renderMain()
	local s = session
	local snap = State.snapshot
	if not s or not snap then
		return
	end
	mainParts.hint.Text = s.hint or ""
	setFeedback(s.feedback, s.feedbackKind)
	local noPower = s.reason == "power" or not snap.power.workstation
	mainParts.overlay.Visible = noPower
	if noPower then
		mainParts.overlayText.Text = "SecureErase - Device not ready\n\nThe workstation has lost power.\nReset the tripped breaker (MAIN / WORKSTATION) at the panel in the UTILITY HALL.\n\nYour progress is saved."
	end
	if snap.phase == "FinalPurge" or snap.phase == "SignOff" or snap.phase == "ClockOut" or snap.phase == "Ending" then
		lastViewKey = "finale"
		renderFinale(snap)
		return
	end
	mainWin.title.Text = s.title or "SecureErase 2.1"
	mainParts.progressFill.BackgroundColor3 = Color3.fromRGB(40, 170, 60)
	local g = mainParts.game
	if not s.driveId then
		lastViewKey = "nodrive"
		UiKit.clear(g)
		mainParts.header.Text = "No drive connected"
		mainParts.stage.Text = ""
		mainParts.instructions.Text = "Dock a hard drive at the DOCK on this desk (a teammate can bring one from the rack). Use the desktop apps meanwhile."
		mainParts.progressFill.Size = UDim2.fromScale(0, 1)
		UiKit.label({
			Text = string.format("Team progress: %d / %d drives erased", snap.erased, snap.total),
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.fromOffset(0, 80),
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = UiKit.FONT_BOLD,
			TextSize = 22,
			ZIndex = g.ZIndex,
			Parent = g,
		})
		return
	end
	mainParts.header.Text = string.format("Connected: %s  %s", s.driveId, s.driveName or "")
	if not s.view then
		lastViewKey = "start"
		UiKit.clear(g)
		mainParts.stage.Text = "Ready"
		mainParts.instructions.Text = s.instructions or ""
		mainParts.progressFill.Size = UDim2.fromScale(0, 1)
		UiKit.button({
			name = "StartErase",
			text = "START SECURE ERASE",
			size = UDim2.fromOffset(320, 80),
			position = UDim2.new(0.5, -160, 0, 70),
			parent = g,
			color = C.good,
			textColor = C.white,
			textSize = 24,
			zindex = g.ZIndex + 1,
			onClick = function()
				send("start")
			end,
		})
		return
	end
	mainParts.stage.Text = if s.transitioning then "Erasing sectors..." else string.format("Stage %d / %d", s.stage, s.stages)
	mainParts.instructions.Text = s.instructions or ""
	local progress = s.progress or 0
	TweenService:Create(mainParts.progressFill, UiKit.FAST, { Size = UDim2.fromScale(progress, 1) }):Play()
	local view = s.view :: { [string]: any }
	local mod = Views[view.kind]
	if s.transitioning then
		UiKit.clear(g)
		UiKit.label({ Text = "Verifying stage... erasing sectors...", Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 90), TextXAlignment = Enum.TextXAlignment.Center, Font = UiKit.FONT_BOLD, TextSize = 22, ZIndex = g.ZIndex, Parent = g })
		lastViewKey = "transition"
		return
	end
	if mod then
		lastViewKey = view.kind
		mod.render(g, view, {
			act = function(action: string, a: any, b: any)
				send("act", action, a, b)
			end,
		}, g.ZIndex + 1)
	end
end

local function renderPhantom()
	local s = session
	if phantomFrame then
		phantomFrame:Destroy()
		phantomFrame = nil
	end
	local p = s and s.phantom
	if not p or not isOpen then
		return
	end
	local z = 400
	local f = UiKit.frame({ Name = "Phantom", Size = UDim2.fromOffset(360, 200), Position = UDim2.fromOffset(math.floor(p.x * W), math.floor(p.y * H)), ZIndex = z, Parent = windowsLayer })
	UiKit.bevel(f)
	local bar = UiKit.frame({ Name = "Bar", Size = UDim2.new(1, -6, 0, 26), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.fromRGB(120, 30, 30), ZIndex = z + 1, Parent = f })
	UiKit.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(110, 24, 24), Color3.fromRGB(170, 90, 60)), Parent = bar })
	UiKit.button({
		name = "PhantomClose",
		text = "X",
		size = UDim2.fromOffset(24, 20),
		position = UDim2.fromOffset(3, 3),
		parent = bar,
		zindex = z + 3,
		textSize = 14,
		onClick = function()
			send("phantom", p.id, "close")
		end,
	})
	UiKit.label({ Text = "SecureErase.exe - [Not Responding]", Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(34, 0), TextColor3 = Color3.fromRGB(255, 220, 210), Font = UiKit.FONT_BOLD, TextSize = 15, ZIndex = z + 2, Parent = bar })
	UiKit.label({ Text = "THE QUEUE MUST BE FINISHED.\nDO NOT READ THE FILES.\nPress OK to continue.", Size = UDim2.new(1, -20, 0, 90), Position = UDim2.fromOffset(12, 40), TextSize = 16, Font = UiKit.FONT_MONO, ZIndex = z + 2, Parent = f })
	UiKit.button({
		text = "OK",
		size = UDim2.fromOffset(100, 34),
		position = UDim2.new(0.5, -50, 1, -44),
		parent = f,
		zindex = z + 2,
		onClick = function()
			send("phantom", p.id, "ok")
		end,
	})
	if p.first then
		UiKit.label({
			Text = "Not a real dialog: red title bar, X on the LEFT. Close it with that X.",
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.new(0, 0, 1, 4),
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(255, 255, 210),
			TextSize = 14,
			ZIndex = z + 2,
			Parent = f,
		})
	end
	phantomFrame = f
end

-- Snapshot-driven chrome -----------------------------------------------------

local function renderTray(snap: Types.Snapshot)
	taskbarTray.erased.Text = string.format("ERASED %d/%d", snap.erased, snap.total)
	taskbarTray.door.Text = if snap.door == "Latched" then "DOOR OK" else "DOOR OPEN!"
	taskbarTray.door.TextColor3 = if snap.door == "Latched" then Color3.fromRGB(180, 255, 180) else Color3.fromRGB(255, 120, 110)
	taskbarTray.power.Text = if snap.power.workstation and snap.power.lights then "PWR OK" else "PWR FAULT"
	taskbarTray.power.TextColor3 = if snap.power.workstation and snap.power.lights then Color3.fromRGB(180, 255, 180) else Color3.fromRGB(255, 120, 110)
	taskbarTray.clock.Text = State.nightClock(snap.nightMinutes)
end

local function showToast(from: string, text: string)
	toastText.Text = from .. ": " .. text
	toast.Visible = true
	toast.Position = UDim2.fromOffset(W - 330, H - 34)
	TweenService:Create(toast, UiKit.POP, { Position = UDim2.fromOffset(W - 330, H - 34 - 96) }):Play()
	local stamp = os.clock()
	toast:SetAttribute("Stamp", stamp)
	task.delay(7, function()
		if toast:GetAttribute("Stamp") == stamp then
			toast.Visible = false
		end
	end)
end

local function showFragment(index: number)
	local f = Dialogue.FRAGMENTS[index]
	if not f or not isOpen then
		return
	end
	if fragmentWin then
		fragmentWin.frame:Destroy()
	end
	local win = UiKit.window(windowsLayer, "Recovered before shredding - " .. f.title, UDim2.fromOffset(460, 250), UDim2.fromOffset(250, 150), 300, function()
		if fragmentWin then
			fragmentWin.frame:Destroy()
			fragmentWin = nil
		end
	end)
	fragmentWin = win
	local paper = UiKit.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(250, 248, 236), ZIndex = 303, Parent = win.body })
	UiKit.label({ Text = f.kind:upper(), Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 6), Font = UiKit.FONT_BOLD, TextColor3 = C.bad, ZIndex = 304, Parent = paper })
	UiKit.label({ Text = f.body, Size = UDim2.new(1, -16, 1, -40), Position = UDim2.fromOffset(8, 30), Font = UiKit.FONT_MONO, TextSize = 15, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 304, Parent = paper })
	bringToFront(win)
end

-- Construction ---------------------------------------------------------------

local function build()
	gui = UiKit.new("ScreenGui", {
		Name = "Desktop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	bezel = UiKit.frame({
		Name = "Bezel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.98, 0.98),
		BackgroundColor3 = Color3.fromRGB(196, 188, 166),
		Parent = gui,
	})

						<ProtectedString name="Source"><![CDATA[--!strict
-- The guaranteed climax and ending, triggered by job progress (6/6 erased):
--   FinalPurge  the queue lists the team's own records: cancel them in time
--   SignOff     finite emergency sign-off; pauses (never resets) without
--               power; operator confirms milestones (each is a checkpoint)
--   ClockOut    time clock unlocks; slow pursuit; team clocks out and leaves
--   Ending      ending screen, then a fresh round
-- The goal and completion conditions are fixed; interruptions come from the
-- event director, which caps them during the finale so it always finishes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)
local Power = require(script.Parent.Power)
local Doors = require(script.Parent.Doors)
local Drives = require(script.Parent.Drives)
local Workstation = require(script.Parent.Workstation)
local Threat = require(script.Parent.Threat)
local PlayerStatus = require(script.Parent.PlayerStatus)
local Checkpoints = require(script.Parent.Checkpoints)

local Finale = {}

local token = 0
local clockPrompt: ProximityPrompt
local firstClockOut: number? = nil
local shiftStartClock = os.clock()

local CREW = { "D. MERRIN (2003)", "A. OSEI (2003)", "P. LIND (2003)", "J. RUIZ (2003)" }

local function allCancelled(): boolean
	local list = GameState.data.purge
	if not list then
		return false
	end
	for _, e in list do
		if not e.locked and not e.cancelled then
			return false
		end
	end
	return true
end

local function buildPurgeList()
	local list = {}
	for _, name in CREW do
		table.insert(list, { name = name, cancelled = false, locked = true })
	end
	for _, p in Players:GetPlayers() do
		table.insert(list, { name = string.upper(p.DisplayName) .. " (tonight)", cancelled = false, locked = false, userId = p.UserId })
	end
	GameState.data.purge = list
end

local beginSignOff: (progress: number) -> ()
local beginClockOut: () -> ()

local function beginFinalPurge()
	token += 1
	local my = token
	GameState.setPhase("FinalPurge")
	buildPurgeList()
	local solo = GameState.isSolo()
	GameState.data.purgeDeadline = os.clock() + (if solo then Config.PHASE.finalPurgeCountdown.solo else Config.PHASE.finalPurgeCountdown.coop)
	GameState.bossMessage(Dialogue.FINAL_PURGE, "system", nil, "SecureErase")
	task.delay(3, function()
		if token == my then
			GameState.bossMessage(Dialogue.FINAL_PURGE_BOSS, "story")
		end
	end)
	GameState.fx("FinalPurge", nil)
	GameState.markDirty()
	Workstation.push()
	task.spawn(function()
		while token == my and GameState.phase == "FinalPurge" do
			task.wait(0.5)
			GameState.markDirty()
			-- the queue cannot be cancelled without power, so the countdown pauses too
			if not Power.workstationOn() and GameState.data.purgeDeadline then
				GameState.data.purgeDeadline += 0.5
			end
			local deadline = GameState.data.purgeDeadline
			if deadline and os.clock() > deadline and not allCancelled() then
				GameState.fx("PurgeExecuted", nil)
				GameState.notify(nil, "FINAL PURGE EXECUTED. Your records are gone...", "bad")
				task.wait(2)
				if token == my then
					Checkpoints.restore("final purge executed")
				end
				return
			end
		end
	end)
end

beginSignOff = function(progress: number)
	token += 1
	local my = token
	GameState.setPhase("SignOff")
	GameState.data.signOff = { progress = progress, awaiting = false, paused = false }
	GameState.data.purgeDeadline = nil
	GameState.bossMessage(Dialogue.SIGNOFF_START, "system", nil, "SecureErase")
	task.delay(4, function()
		if token == my then
			GameState.bossMessage(Dialogue.SIGNOFF_BOSS, "story")
		end
	end)
	GameState.fx("SignOffStart", nil)
	Workstation.push()
	local duration = if GameState.isSolo() then Config.PHASE.signOffSeconds.solo else Config.PHASE.signOffSeconds.coop
	task.spawn(function()
		local last = os.clock()
		local lastShown, lastPaused = -1, false
		while token == my and GameState.phase == "SignOff" do
			task.wait(0.2)
			local now = os.clock()
			local dt = now - last
			last = now
			local s = GameState.data.signOff
			if not s then
				return
			end
			s.paused = not Power.workstationOn() or s.awaiting
			if not s.paused then
				local before = s.progress
				s.progress = math.min(1, s.progress + dt / duration)
				for _, m in Config.PHASE.signOffConfirmAt do
					if before < m and s.progress >= m then
						s.progress = m
						s.awaiting = true
						GameState.fx("SignOffConfirm", { at = m })
						GameState.notify(nil, string.format("Sign-off paused at %d%%: the operator must CONFIRM at the workstation.", math.floor(m * 100)), "info")
						break
					end
				end
				if s.progress >= 1 then
					beginClockOut()
					return
				end
			end
			local shown = math.floor(s.progress * 100)
			if shown ~= lastShown or s.paused ~= lastPaused then
				lastShown = shown
				lastPaused = s.paused
				GameState.markDirty()
				Workstation.push()
			end
		end
	end)
end

beginClockOut = function()
	token += 1
	local my = token
	GameState.setPhase("ClockOut")
	GameState.data.signOff = { progress = 1, awaiting = false, paused = false }
	GameState.data.clockedOut = {}
	firstClockOut = nil
	for _, p in Players:GetPlayers() do
		p:SetAttribute("ClockedOut", false)
	end
	Checkpoints.save("sign-off complete", { clockOut = true })
	GameState.bossMessage(Dialogue.CLOCKOUT, "system", nil, "SecureErase")
	GameState.fx("ClockOutStart", nil)
	Workstation.push()
	clockPrompt.ActionText = "Clock out"
	task.delay(7, function()
		if token == my and GameState.phase == "ClockOut" then
			Threat.pursue()
		end
	end)
	-- escape detection + door timing
	task.spawn(function()
		local Z = Layout.ESCAPE_ZONE
		while token == my and GameState.phase == "ClockOut" do
			task.wait(0.25)
			if firstClockOut and not GameState.data.frontDoorOpen and os.clock() - firstClockOut > Config.PHASE.clockOutUnlockAfterFirst then
				Doors.openFront()
			end
			for _, p in Players:GetPlayers() do
				local r = Guard.rootOf(p)
				if r and p:GetAttribute("Escaped") ~= true and GameState.data.frontDoorOpen then
					local pos = r.Position
					if pos.X >= Z.minX and pos.X <= Z.maxX and pos.Z >= Z.minZ and pos.Z <= Z.maxZ then
						PlayerStatus.setEscaped(p, true)
						GameState.fx("Escaped", { name = p.DisplayName })
					end
				end
			end
			-- ending when nobody is left inside; downed stragglers are carried out
			local inside, standingInside = 0, 0
			for _, p in Players:GetPlayers() do
				if p:GetAttribute("Escaped") ~= true then
					inside += 1
					if not PlayerStatus.isDowned(p) then
						standingInside += 1
					end
				end
			end
			if #Players:GetPlayers() > 0 and (inside == 0 or (standingInside == 0 and inside < #Players:GetPlayers())) then
				for _, p in Players:GetPlayers() do
					if p:GetAttribute("Escaped") ~= true then
						PlayerStatus.revive(p, nil)
						PlayerStatus.setEscaped(p, true)
					end
				end
				Finale.ending()
				return
			end
		end
	end)
end

function Finale.ending()
	token += 1
	local my = token
	GameState.setPhase("Ending")
	Threat.despawn()
	GameState.clearThreats()
	local elapsed = os.clock() - shiftStartClock
	GameState.fx("Ending", {
		title = Dialogue.ENDING.title,
		lines = Dialogue.ENDING.lines,
		minutes = math.floor(elapsed / 60),
		seconds = math.floor(elapsed % 60),
	})
	task.delay(Config.PHASE.endingSeconds, function()
		if token == my then
			Finale.resetRound()
		end
	end)
end

function Finale.resetRound()
	token += 1
	local d = GameState.data
	d.erased = 0
	d.fragments = {}
	d.boss = {}
	d.purge = nil
	d.purgeDeadline = nil
	d.signOff = nil
	d.clockedOut = {}
	d.roundStart = os.clock()
	d.round += 1
	shiftStartClock = os.clock()
	clockPrompt.ActionText = "Clock out"
	GameState.clearThreats()
	GameState.RoundReset:Fire()
	PlayerStatus.respawnAll()
	GameState.markDirty()
end

local function onClockOut(player: Player)
	if GameState.phase ~= "ClockOut" then
		GameState.notify(player, "The time clock won't accept your card until the shift is signed off.", "info")
		return
	end
	if player:GetAttribute("ClockedOut") == true then
		return
	end
	player:SetAttribute("ClockedOut", true)
	table.insert(GameState.data.clockedOut, player.DisplayName)
	GameState.fx("ClockedOut", { name = player.DisplayName })
	firstClockOut = firstClockOut or os.clock()
	local all = true
	for _, p in PlayerStatus.standing() do
		if p:GetAttribute("ClockedOut") ~= true then
			all = false
		end
	end
	if all then
		Doors.openFront()
	end
	GameState.markDirty()
end

-- Desktop commands --------------------------------------------------------

local function cmdPurgeCancel(_player: Player, a: any, _b: any): (string?, string?)
	if GameState.phase ~= "FinalPurge" then
		return nil
	end
	local list = GameState.data.purge
	if not list or typeof(a) ~= "number" or a ~= math.floor(a) or a < 1 or a > #list then
		return nil
	end
	local e = list[a]
	if e.locked then
		return "Record already purged in 2003. Cannot cancel.", "bad"
	end
	if e.cancelled then
		return nil
	end
	e.cancelled = true
	GameState.markDirty()
	if allCancelled() then
		return "All of tonight's staff records removed from the queue. Run EMERGENCY SIGN-OFF.", "good"
	end
	return e.name .. " removed from the purge queue.", "good"
end

local function cmdSignOffStart(_player: Player, _a: any, _b: any): (string?, string?)
	if GameState.phase ~= "FinalPurge" or not allCancelled() then
		return "Cancel every record from tonight first.", "bad"
	end
	Checkpoints.save("emergency sign-off started", { signOff = 0 })
	beginSignOff(0)
	return "Emergency sign-off running.", "good"
end

local function cmdSignOffConfirm(_player: Player, _a: any, _b: any): (string?, string?)
	local s = GameState.data.signOff
	if GameState.phase ~= "SignOff" or not s or not s.awaiting then
		return nil
	end
	s.awaiting = false
	Checkpoints.save(string.format("sign-off %d%%", math.floor(s.progress * 100)), { signOff = s.progress })
	return "Checkpoint confirmed. Sign-off continuing.", "good"
end

function Finale.init()
	clockPrompt = Prompts.make(MapBuilder.refs.timeClock, { action = "Clock out", object = "Time clock", hold = 0.6, distance = 8 })
	clockPrompt.Triggered:Connect(function(player)
		if Prompts.valid(player, clockPrompt, "clock") then
			onClockOut(player)
		end
	end)
	Workstation.registerCommand("purgeCancel", cmdPurgeCancel)
	Workstation.registerCommand("signOffStart", cmdSignOffStart)
	Workstation.registerCommand("signOffConfirm", cmdSignOffConfirm)

	Drives.Erased:Connect(function(_d, count)
		if count >= Config.DRIVE_COUNT and GameState.phase == "Work" then
			task.delay(4, function()
				if GameState.phase == "Work" and Drives.erasedCount() >= Config.DRIVE_COUNT then
					GameState.bossMessage(Dialogue.BOSS_PROGRESS[6], "story")
					Checkpoints.save("before the finale", { finalPurge = true })
					-- checkpoint phase should be FinalPurge so a wipe returns here
					local cp = Checkpoints.latest()
					if cp then
						cp.phase = "FinalPurge"
					end
					beginFinalPurge()
				end
			end)
		end
	end)

	Checkpoints.Restoring:Connect(function()
		token += 1 -- stop finale loops; Restored decides what to resume
		Threat.despawn()
	end)
	Checkpoints.Restored:Connect(function(cp)
		if not cp then
			return
		end
		local signOff = cp.extra.signOff
		if cp.extra.clockOut then
			beginClockOut()
		elseif typeof(signOff) == "number" then
			beginSignOff(signOff)
		elseif cp.phase == "FinalPurge" then
			beginFinalPurge()
		end
	end)

	Players.PlayerAdded:Connect(function(p)
		if GameState.phase == "FinalPurge" and GameState.data.purge then
			table.insert(GameState.data.purge, { name = string.upper(p.DisplayName) .. " (tonight)", cancelled = false, locked = false, userId = p.UserId })
			GameState.markDirty()
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		local list = GameState.data.purge
		if list then
			for i, e in list do
				if (e :: any).userId == p.UserId then
					table.remove(list, i)
					break
				end
			end
			GameState.markDirty()
		end
	end)
end

-- QA hooks (used only by the gated Cheats system)
Finale.debugBeginFinalPurge = beginFinalPurge
Finale.debugBeginSignOff = function(p: number)
	beginSignOff(p)
end
Finale.debugBeginClockOut = function()
	beginClockOut()
end

return Finale
]]></ProtectedString>
						<string name="ScriptGuid">{52602D0B-21AC-4DD7-B380-468A1ACBDE32}</string>
						<BinaryString name="AttributesSerialize">AQAAAAgAAABTeW5jSGFzaAIQAAAAYzdkYmMwZmYwMWIzZTBhYg==</BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Finale</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">30936996b29238eb0aeb0d510000150d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8837AD58F28F486DBFC221DBFF71047B">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Authoritative team/round state and its replication. Other systems mutate
-- their own state, then call GameState.markDirty(); a throttled loop sends a
-- full snapshot (cheap: the game state is small) so late joiners and every
-- client always render the same truth.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

type Phase = Types.Phase

local GameState = {}

GameState.phase = "Briefing" :: Phase
GameState.data = {
	erased = 0,
	fragments = {} :: { number },
	boss = {} :: { Types.BossMessage },
	purge = nil :: { { name: string, cancelled: boolean, locked: boolean, userId: number? } }?,
	purgeDeadline = nil :: number?,
	signOff = nil :: { progress: number, awaiting: boolean, paused: boolean }?,
	clockedOut = {} :: { string },
	frontDoorOpen = false,
	checkpoints = 0,
	threats = {} :: { Types.ThreatInfo },
	roundStart = os.clock(),
	round = 1,
	serverClockOffset = 0,
}

GameState.PhaseChanged = Signal.new() :: Signal.Signal<Phase, Phase>
GameState.RoundReset = Signal.new() :: Signal.Signal<>
GameState.PlayerCountChanged = Signal.new() :: Signal.Signal<number>
GameState.BossAnswered = Signal.new() :: Signal.Signal<number, string, Player>

-- providers: other systems plug their slice of the snapshot in
type Providers = {
	drives: (() -> { Types.DriveSnapshot })?,
	power: (() -> { main: boolean, lights: boolean, workstation: boolean, warning: boolean })?,
	door: (() -> Types.DoorState)?,
	dock: (() -> string?)?,
	operator: (() -> string?)?,
	objective: (() -> string)?,
}
GameState.providers = {} :: Providers

local dirty = true
local nextBossId = 1

function GameState.markDirty()
	dirty = true
end

function GameState.setPhase(p: Phase)
	local old: Phase = GameState.phase :: Phase
	if old == p then
		return
	end
	GameState.phase = p
	dirty = true
	GameState.PhaseChanged:Fire(p, old)
end

function GameState.nightMinutes(): number
	local elapsed = os.clock() - GameState.data.roundStart
	return (Config.NIGHT_START_MINUTES + elapsed * Config.GAME_MINUTES_PER_SECOND) % (24 * 60)
end

-- Players who count for difficulty and team wipes: connected, spawned, still inside.
function GameState.activePlayers(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character and p:GetAttribute("Escaped") ~= true then
			table.insert(list, p)
		end
	end
	return list
end

function GameState.playerCount(): number
	return math.max(1, #Players:GetPlayers())
end

function GameState.isSolo(): boolean
	return #Players:GetPlayers() <= 1
end

function GameState.notify(target: Player?, text: string, kind: string?)
	local r = Net.remote("Notify")
	if target then
		r:FireClient(target, text, kind or "info")
	else
		r:FireAllClients(text, kind or "info")
	end
end

function GameState.fx(name: string, data: any?, target: Player?)
	local r = Net.remote("Fx")
	if target then
		r:FireClient(target, name, data)
	else
		r:FireAllClients(name, data)
	end
end

-- Boss/system messages shown in the desktop messenger and as HUD pager toasts.
function GameState.bossMessage(text: string, kind: string?, choices: { string }?, from: string?): number
	local id = nextBossId
	nextBossId += 1
	local msg: Types.BossMessage = {
		id = id,
		from = from or "R. Kessler",
		text = text,
		kind = kind or "info",
		choices = choices,
		answered = nil,
		t = GameState.nightMinutes(),
	}
	table.insert(GameState.data.boss, msg)
	while #GameState.data.boss > 14 do
		table.remove(GameState.data.boss, 1)
	end
	dirty = true
	GameState.fx("BossMessage", { id = id, from = msg.from, text = text, kind = msg.kind })
	return id
end

function GameState.findBoss(id: number): Types.BossMessage?
	for _, m in GameState.data.boss do
		if m.id == id then
			return m
		end
	end
	return nil
end

function GameState.answerBoss(id: number, choice: string, by: Player): boolean
	local m = GameState.findBoss(id)
	if not m or m.answered or not m.choices or not table.find(m.choices, choice) then
		return false
	end
	m.answered = choice
	dirty = true
	GameState.BossAnswered:Fire(id, choice, by)
	return true
end

function GameState.setThreat(id: string, label: string?, urgent: boolean?, where: string?)
	local threats = GameState.data.threats
	for i, t in threats do
		if t.id == id then
			if label then
				t.label = label
				t.urgent = urgent == true
				t.where = where
			else
				table.remove(threats, i)
			end
			dirty = true
			return
		end
	end
	if label then
		table.insert(threats, { id = id, label = label, urgent = urgent == true, where = where })
		dirty = true
	end
end

function GameState.clearThreats()
	table.clear(GameState.data.threats)
	dirty = true
end

function GameState.snapshot(): Types.Snapshot
	local d = GameState.data
	local P = GameState.providers
	local power = if P.power then P.power() else { main = true, lights = true, workstation = true, warning = false }
	return {
		phase = GameState.phase :: Phase,
		erased = d.erased,
		total = Config.DRIVE_COUNT,
		nightMinutes = GameState.nightMinutes(),
		power = power,
		door = if P.door then P.door() else "Latched",
		threats = d.threats,
		drives = if P.drives then P.drives() else {},
		dock = if P.dock then P.dock() else nil,
		operator = if P.operator then P.operator() else nil,
		boss = d.boss,
		fragments = d.fragments,
		purge = d.purge,
		-- sent as seconds remaining (server clocks are not comparable on clients)
		purgeDeadline = if d.purgeDeadline then math.max(0, d.purgeDeadline - os.clock()) else nil,
		signOff = d.signOff,
		clockedOut = d.clockedOut,
		frontDoorOpen = d.frontDoorOpen,
		objective = if P.objective then P.objective() else "",
		checkpoints = d.checkpoints,
		serverTime = workspace:GetServerTimeNow(),
		soloMode = GameState.isSolo(),
	}
end

function GameState.init()
	Players.PlayerAdded:Connect(function(player)
		dirty = true
		GameState.PlayerCountChanged:Fire(#Players:GetPlayers())
		task.defer(function()
			Net.remote("State"):FireClient(player, GameState.snapshot())
		end)
	end)
	Players.PlayerRemoving:Connect(function()
		dirty = true
		task.defer(function()
			GameState.PlayerCountChanged:Fire(#Players:GetPlayers())
		end)
	end)
end

function GameState.start()
	local stateRemote = Net.remote("State")
	local lastSent = 0
	while true do
		task.wait(0.2)
		local now = os.clock()
		if dirty or now - lastSent > 2 then
			dirty = false
			lastSent = now
			stateRemote:FireAllClients(GameState.snapshot())
		end
	end
end

return GameState
]]></ProtectedString>
						<string name="ScriptGuid">{2CEB37AF-5EB1-4E15-8462-4588D3AC55EE}</string>
						<BinaryString name="AttributesSerialize">AQAAAAgAAABTeW5jSGFzaAIQAAAANzVhYjNjYjg4YWFjNGM4Mg==</BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">GameState</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">30936996b29238eb0aeb0d510000150f</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF4B8E5F1EADA434E9B74F410B5FD0CA6">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Simple team pings so voice chat is never required. Validated and
-- rate-limited; the server rebroadcasts to everyone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Net = require(ReplicatedStorage.Shared.Net)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)

local Pings = {}

function Pings.init()
	local remote = Net.remote("Ping")
	remote.OnServerEvent:Connect(function(player, pos: unknown)
		local rate = Config.RATE.ping
		if not Guard.allow(player, "ping", rate[1], rate[2]) then
			return
		end
		if typeof(pos) ~= "Vector3" then
			return
		end
		local v = pos :: Vector3
		if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
			return
		end
		if not Guard.near(player, v, Config.PING.maxDistance) or not Layout.inMap(v) then
			return
		end
		if player:GetAttribute("Escaped") == true then
			return
		end
		remote:FireAllClients(v, player.DisplayName, Layout.regionOf(v))
	end)
end

return Pings
]]></ProtectedString>
						<string name="ScriptGuid">{C697D978-C9A3-4F5E-86DC-458756145143}</string>
						<BinaryString name="AttributesSerialize">AQAAAAgAAABTeW5jSGFzaAIQAAAANDQ4Y2JjODMxNWRhZWEwMw==</BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Pings</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">30936996b29238eb0aeb0d5100001511</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX2B1B33C87FC64DE6B9B5393932D800CD">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Caught/downed state, teammate rescue, escape, and team-wipe detection.
-- Non-graphic: a caught player slumps in place and needs a teammate's hand.
-- Solo players and full-team wipes go straight to the checkpoint system
-- (via the TeamWiped signal, so this module never requires Checkpoints).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local Workstation = require(script.Parent.Workstation)
local Drives = require(script.Parent.Drives)

local PlayerStatus = {}

PlayerStatus.TeamWiped = Signal.new() :: Signal.Signal<string>
PlayerStatus.Downed = Signal.new() :: Signal.Signal<Player>
PlayerStatus.Revived = Signal.new() :: Signal.Signal<Player>

local revivePrompts: { [Player]: ProximityPrompt } = {}
local wipePending = false

function PlayerStatus.isDowned(p: Player): boolean
	return p:GetAttribute("Downed") == true
end

-- players inside the building who can still act
function PlayerStatus.standing(): { Player }
	local out = {}
	for _, p in GameState.activePlayers() do
		if not PlayerStatus.isDowned(p) and Guard.alive(p) then
			table.insert(out, p)
		end
	end
	return out
end

local function setMobility(p: Player, enabled: boolean)
	local h = Guard.humanoidOf(p)
	if h then
		h.WalkSpeed = if enabled then 16 else 0
		h.JumpHeight = if enabled then 7.2 else 0
		h.UseJumpPower = false
	end
end

local function checkWipe()
	if wipePending then
		return
	end
	local active = GameState.activePlayers()
	if #active == 0 then
		return
	end
	local anyStanding = #PlayerStatus.standing() > 0
	local anyDowned = false
	for _, p in active do
		if PlayerStatus.isDowned(p) then
			anyDowned = true
		end
	end
	local solo = #Players:GetPlayers() <= 1
	-- a wipe needs someone caught: a teammate leaving never rolls the team back
	if anyDowned and (solo or not anyStanding) then
		wipePending = true
		local delaySec = if solo then Config.DOWNED.soloRestoreDelay else Config.DOWNED.wipeRestoreDelay
		GameState.fx("TeamCaught", { solo = solo, delay = delaySec })
		task.delay(delaySec, function()
			wipePending = false
			-- re-check: someone may have joined or been revived meanwhile
			local downedNow = false
			for _, p in GameState.activePlayers() do
				if PlayerStatus.isDowned(p) then
					downedNow = true
				end
			end
			local still = downedNow and (#PlayerStatus.standing() == 0 or #Players:GetPlayers() <= 1)
			if still then
				PlayerStatus.TeamWiped:Fire(if solo then "caught" else "everyone caught")
			end
		end)
	end
end

function PlayerStatus.revive(p: Player, by: Player?)
	if not PlayerStatus.isDowned(p) then
		return
	end
	p:SetAttribute("Downed", false)
	p:SetAttribute("Grace", os.clock() + 3)
	setMobility(p, true)
	local prompt = revivePrompts[p]
	if prompt then
		prompt:Destroy()
		revivePrompts[p] = nil
	end
	GameState.fx("Revived", { name = p.DisplayName, by = if by then by.DisplayName else nil })
	GameState.markDirty()
	PlayerStatus.Revived:Fire(p)
end

function PlayerStatus.down(p: Player, cause: string?)
	if PlayerStatus.isDowned(p) or p:GetAttribute("Escaped") == true then
		return
	end
	local grace = p:GetAttribute("Grace")
	if typeof(grace) == "number" and os.clock() < grace then
		return
	end
	local root = Guard.rootOf(p)
	if not root then
		return
	end
	p:SetAttribute("Downed", true)
	Workstation.kick(p, "caught")
	Drives.recoverFor(p, p.DisplayName .. " was caught")
	setMobility(p, false)
	local prompt = Prompts.make(root, {
		action = "Help up",
		object = p.DisplayName,
		hold = Config.DOWNED.reviveHold,
		distance = Config.REACH.revive,
	})
	prompt:SetAttribute("OwnerUserId", p.UserId)
	revivePrompts[p] = prompt
	prompt.Triggered:Connect(function(helper)
		if helper == p or not Prompts.valid(helper, prompt, "revive") then
			return
		end
		PlayerStatus.revive(p, helper)
	end)
	GameState.fx("Downed", { name = p.DisplayName, cause = cause })
	GameState.notify(nil, p.DisplayName .. " was caught" .. (if cause then " (" .. cause .. ")" else "") .. ". Help them up!", "bad")
	GameState.markDirty()
	PlayerStatus.Downed:Fire(p)
	checkWipe()
end

function PlayerStatus.reviveAll()
	for _, p in Players:GetPlayers() do
		PlayerStatus.revive(p, nil)
	end
end

function PlayerStatus.setEscaped(p: Player, v: boolean)
	p:SetAttribute("Escaped", v)
	GameState.markDirty()
end

function PlayerStatus.respawnAll()
	for _, p in Players:GetPlayers() do
		p:SetAttribute("Downed", false)
		p:SetAttribute("Escaped", false)
		p:SetAttribute("ClockedOut", false)
		p:SetAttribute("Carrying", nil)
		local prompt = revivePrompts[p]
		if prompt then
			prompt:Destroy()
			revivePrompts[p] = nil
		end
		task.spawn(function()
			p:LoadCharacter()
		end)
	end
end

local function onCharacter(p: Player, character: Model)
	p:SetAttribute("Downed", false)
	p:SetAttribute("Carrying", nil)
	revivePrompts[p] = nil
	local h = character:WaitForChild("Humanoid", 10)
	if h and h:IsA("Humanoid") then
		h.WalkSpeed = 16
		h.UseJumpPower = false
		h.JumpHeight = 7.2
		h.Died:Connect(function()
			Drives.recoverFor(p, "carrier lost")
		end)
	end
end

function PlayerStatus.init()
	local function hook(p: Player)
		p.CharacterAdded:Connect(function(c)
			onCharacter(p, c)
		end)
		if p.Character then
			onCharacter(p, p.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		revivePrompts[p] = nil
		-- the remaining team may now be entirely downed
		task.defer(checkWipe)
	end)
end

return PlayerStatus
]]></ProtectedString>
						<string name="ScriptGuid">{079CB95F-E083-4C2A-A934-2B96FCB9823A}</string>
						<BinaryString name="AttributesSerialize">AQAAAAgAAABTeW5jSGFzaAIQAAAAOGE4MzkxNTBhYWY4ODFjNA==</BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">PlayerStatus</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">30936996b29238eb0aeb0d5100001513</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX12DAA6CBB26946399ECDF28A7A28ECD9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Breakers and building power. MAIN feeds everything; LIGHTS feeds the
-- office lighting; WORKSTATION feeds the corner PC. Tripped breakers are
-- reset at the clearly labelled panel in the utility hall.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Server = script.Parent.Parent
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)

local Power = {}

export type BreakerId = "MAIN" | "LIGHTS" | "WORKSTATION"

local breakers: { [string]: boolean } = { MAIN = true, LIGHTS = true, WORKSTATION = true }
local warning = false
local prompts: { [string]: ProximityPrompt } = {}
local tripToken = 0 -- bumped by resetAll so a pending warned trip is cancelled

Power.Changed = Signal.new() :: Signal.Signal<>
Power.BreakerReset = Signal.new() :: Signal.Signal<string, Player?>

function Power.lightsOn(): boolean
	return breakers.MAIN and breakers.LIGHTS
end

function Power.workstationOn(): boolean
	return breakers.MAIN and breakers.WORKSTATION
end

function Power.isTripped(id: string): boolean
	return breakers[id] == false
end

function Power.anyTripped(): boolean
	return not (breakers.MAIN and breakers.LIGHTS and breakers.WORKSTATION)
end

local function apply()
	local refs = MapBuilder.refs
	local lights = Power.lightsOn()
	local ws = Power.workstationOn()
	for _, groupName in { "main", "kitchen", "lobby", "hall", "lamps" } do
		local group: { Light } = refs.lights[groupName] or {}
		for _, l in group do
			l.Enabled = lights
		end
		local fixtures: { BasePart } = refs.fixtures[groupName] or {}
		for _, f in fixtures do
			f.Material = if lights then Enum.Material.Neon else Enum.Material.SmoothPlastic
			f.Color = if lights then Color3.fromRGB(226, 240, 255) else Color3.fromRGB(70, 72, 76)
		end
	end
	refs.workstationLamp.Enabled = ws
	for _, l in refs.emergencyLights do
		(l :: PointLight).Brightness = if lights then 0 else 0.9
	end
	refs.monitorScreen.Material = if ws then Enum.Material.Neon else Enum.Material.SmoothPlastic
	refs.monitorScreen.Color = if ws then Color3.fromRGB(16, 32, 60) else Color3.fromRGB(8, 8, 10)
	for id, ok in breakers do
		local lamp = refs.breakerLamps[id]
		if lamp then
			lamp.Color = if ok then Color3.fromRGB(60, 255, 90) else Color3.fromRGB(255, 50, 40)
		end
		local sw = refs.breakerSwitches[id]
		if sw then
			sw.Color = if ok then Color3.fromRGB(40, 40, 40) else Color3.fromRGB(150, 30, 30)
			sw:SetAttribute("Tripped", not ok)
		end
		local prompt = prompts[id]
		if prompt then
			prompt.Enabled = not ok
		end
	end
	workspace:SetAttribute("LightsOn", lights)
	workspace:SetAttribute("WorkstationPower", ws)
	if Power.anyTripped() then
		local where = {}
		for _, id in { "MAIN", "LIGHTS", "WORKSTATION" } do
			if not breakers[id] then
				table.insert(where, id)
			end
		end
		GameState.setThreat("power", "Breaker tripped: " .. table.concat(where, " + "), true, "Utility hall")
	else
		GameState.setThreat("power", nil)
	end
	GameState.markDirty()
	Power.Changed:Fire()
end

-- Flicker warning (cosmetic on clients), then trip the listed breakers.
function Power.warnThenTrip(ids: { string }, warningSeconds: number, onTripped: (() -> ())?)
	warning = true
	tripToken += 1
	local my = tripToken
	GameState.markDirty()
	GameState.fx("PowerWarning", { seconds = warningSeconds })
	task.delay(warningSeconds, function()
		if my ~= tripToken then
			return
		end
		warning = false
		Power.trip(ids)
		if onTripped then
			onTripped()
		end
	end)
end

function Power.trip(ids: { string })
	for _, id in ids do
		if breakers[id] ~= nil then
			breakers[id] = false
		end
	end
	GameState.fx("PowerOff", { ids = ids })
	apply()
end

function Power.reset(id: string, by: Player?)
	if breakers[id] == false then
		breakers[id] = true
		GameState.fx("BreakerReset", { id = id })
		apply()
		Power.BreakerReset:Fire(id, by)
	end
end

function Power.resetAll()
	tripToken += 1
	warning = false
	for id in breakers do
		breakers[id] = true
	end
	apply()
end

function Power.snapshot()
	return {
		main = breakers.MAIN,
		lights = Power.lightsOn(),
		workstation = Power.workstationOn(),
		warning = warning,
	}
end

function Power.init()
	GameState.providers.power = Power.snapshot
	for id, sw in MapBuilder.refs.breakerSwitches do
		local prompt = Prompts.make(sw, {
			action = "Reset breaker",
			object = id,
			hold = 0.8,
			distance = 8,
		})
		prompt.Enabled = false
		prompts[id] = prompt
		prompt.Triggered:Connect(function(player)
			if not Prompts.valid(player, prompt) then
				return
			end
			Power.reset(id, player)
		end)
	end
	GameState.RoundReset:Connect(Power.resetAll)
	apply()
end

return Power
]]></ProtectedString>

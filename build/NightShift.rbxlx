    <Item class="ModuleScript" referent="115">
      <Properties>
        <string name="Name">QAClient</string>
        <string name="Source"><![CDATA[-- Studio-only test helper (installed into the open test place as
-- ReplicatedStorage.QAClient by the dev workflow; never part of the build).
-- Drives real ProximityPrompts the way a player would: walk up, face, hold.
local QA = {}
local plr = game.Players.LocalPlayer
function QA.trigger(prompt)
	prompt:InputHoldBegin()
	task.wait(prompt.HoldDuration + 0.15)
	prompt:InputHoldEnd()
	task.wait(0.5)
end
-- teleport next to a target and face it (prompts only show when on screen)
function QA.face(from, target)
	plr.Character:PivotTo(CFrame.lookAt(from, Vector3.new(target.X, from.Y, target.Z)))
	workspace.CurrentCamera.CFrame = CFrame.lookAt(from + (from - target).Unit * 4 + Vector3.new(0, 2, 0), target)
	task.wait(0.7)
end
function QA.goto(pos) plr.Character:PivotTo(CFrame.new(pos)); task.wait(0.6) end
function QA.inter(name) return workspace.Map.Interactive[name] end
function QA.prompt(part) return part:FindFirstChildOfClass("ProximityPrompt") end
function QA.use(part, from)
	QA.face(from, part.Position)
	QA.trigger(QA.prompt(part))
end
function QA.fetchAndSit(desk)
	local pc = QA.inter("SourcePC_" .. desk)
	local from = pc.Position + Vector3.new(0, 0, (desk <= 3) and -3 or 3)
	QA.use(pc, from)
	QA.use(pc, from)
	QA.use(QA.inter("DriveDock"), Vector3.new(18.5, 3, -7.4))
	QA.use(QA.inter("SeatPrompt"), Vector3.new(15.5, 3, -6.5))
	task.wait(1)
	return plr.PlayerGui.Desktop.Enabled
end
return QA
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="116">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="117">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Tunable gameplay values for NIGHT SHIFT: DATA PURGE.
-- NOTE: replicated to clients — nothing secret here. The server never trusts a
-- client-reported value; these numbers only drive server decisions and UI.

local Config = {}

Config.GAME_TITLE = "NIGHT SHIFT: DATA PURGE"
Config.MAX_PLAYERS = 4
Config.DRIVE_COUNT = 6

-- Interaction reach (studs). ProximityPrompts enforce this client-side; the
-- server re-checks with a small tolerance.
Config.REACH = {
	prompt = 10,
	tolerance = 4,
	workstation = 9,
	revive = 9,
}

Config.RATE = {
	-- tokens per second, burst
	desktop = { 12, 20 },
	leave = { 2, 4 },
	ping = { 0.5, 2 },
	cheat = { 5, 10 },
}

-- Time-of-night display: real seconds -> in-game minutes. Purely cosmetic;
-- no event is ever scheduled from this clock.
Config.NIGHT_START_MINUTES = 23 * 60 -- 23:00
Config.GAME_MINUTES_PER_SECOND = 0.33

Config.PHASE = {
	briefingSeconds = 14,
	directorGraceSeconds = 40, -- no events right after the shift starts
	finalPurgeCountdown = { solo = 150, coop = 120 },
	signOffSeconds = { solo = 80, coop = 100 }, -- powered seconds of sign-off
	signOffConfirmAt = { 0.25, 0.5, 0.75 },
	clockOutUnlockAfterFirst = 30, -- front door opens this long after the first clock-out
	endingSeconds = 28,
}

-- Drives: label colours are purely presentational (labels also carry text).
Config.DRIVES = {
	{ id = "HD-1147", name = "ACCOUNTS-ARCHIVE", color = Color3.fromRGB(196, 170, 98) },
	{ id = "HD-2203", name = "PERSONNEL-03", color = Color3.fromRGB(120, 150, 190) },
	{ id = "HD-3318", name = "FACILITIES-LOG", color = Color3.fromRGB(150, 180, 120) },
	{ id = "HD-4402", name = "SECURITY-NIGHT", color = Color3.fromRGB(190, 120, 110) },
	{ id = "HD-5521", name = "CORRESPONDENCE", color = Color3.fromRGB(170, 140, 190) },
	{ id = "HD-6090", name = "LANTERN-BACKUP", color = Color3.fromRGB(200, 200, 190) },
}

Config.DRIVE_RECOVERY_Y = -30 -- drives below this height are recovered
Config.DRIVE_WATCHDOG_SECONDS = 2

-- Minigame tuning. stages = number of short stages per drive.
Config.MINIGAMES = {
	FileSort = { stages = { solo = 2, coop = 3 }, filesPerStage = { 5, 6, 7 } },
	SectorRepair = { stages = { solo = 2, coop = 3 }, sectors = { 4, 5, 6 } },
	SignalRouting = { stages = { solo = 2, coop = 3 }, grid = { { 4, 3 }, { 4, 4 }, { 5, 4 } } },
	Checksum = { stages = { solo = 2, coop = 3 }, matchesPerStage = 3, records = { 4, 5, 6 } },
	MemorySequence = { stages = { solo = 2, coop = 3 }, length = { 3, 4, 5 } },
	ProcessCleanup = { stages = { solo = 2, coop = 3 }, processes = { 5, 6, 7 }, targets = { 2, 3, 3 } },
}
Config.HINT_MISTAKES = { 2, 4, 6 } -- mistakes in a stage that unlock hint levels 1..3
Config.STAGE_TRANSITION_SECONDS = 1.6

-- Event director ----------------------------------------------------------
-- Escalation is driven by erased drives, not by the clock.
Config.DIRECTOR = {
	tickSeconds = 1,
	-- [tier] = {minGap, maxGap} seconds between event rolls
	gaps = {
		early = { 42, 70 },
		mid = { 30, 52 },
		late = { 22, 38 },
		finale = { 14, 24 },
	},
	recoveryAfterUrgent = { early = 26, mid = 20, late = 15, finale = 10 },
	reliefBoostAfterUrgent = 2.4, -- weight multiplier for harmless events after an urgent one
	repeatPenaltyLast = 0.3,
	repeatPenaltyRecent = 0.6,
	historySize = 4,
	nearCompleteUrgentScale = 0.6, -- urgent weight when the active puzzle is almost done
	signOffMaxUrgent = { solo = 3, coop = 4 }, -- hard cap so the finale always finishes
	finalPurgeMaxUrgent = 1,
}

-- Urgent threat cap by active player count.
function Config.urgentCap(activePlayers: number): number
	if activePlayers <= 2 then
		return 1
	end
	return 2
end

function Config.tierFor(erased: number, phase: string): string
	if phase == "SignOff" or phase == "FinalPurge" or phase == "ClockOut" then
		return "finale"
	elseif erased >= 4 then
		return "late"
	elseif erased >= 2 then
		return "mid"
	end
	return "early"
end

Config.EVENTS = {
	DoorUnlatch = {
		weight = 10,
		cooldown = 70,
		minErased = 0,
		-- seconds the door may stay unsecured before the figure starts approaching
		graceFirst = 55,
		grace = { early = 45, mid = 36, late = 28, finale = 24 },
		approachSeconds = 12, -- walk time from alley end to the doorway
	},
	PowerFailure = {
		weight = 9,
		cooldown = 80,
		minErased = 1,
		warningSeconds = 5,
		-- breakers that trip: MAIN only early; later sometimes two
		multiTripChance = { early = 0, mid = 0.25, late = 0.45, finale = 0.5 },
	},
	PhantomWindow = {
		weight = 8,
		cooldown = 55,
		minErased = 1,
		lifetime = 40,
	},
	BossRequest = {
		weight = 5,
		cooldown = 140,
		minErased = 0,
		timeout = 120,
	},
	FalseInstruction = {
		weight = 6,
		cooldown = 120,
		minErased = 2,
		replyWindow = 60,
	},
	Harmless = {
		weight = 9,
		cooldown = 18,
		minErased = 0,
	},
}

Config.THREAT = {
	walkSpeed = 9,
	approachSpeed = 4.2, -- slow, readable walk up the alley (~12 s warning)
	approachPause = 2.5, -- stares from the alley mouth first
	huntSpeed = { solo = 10, coop = 11.5 },
	chaseSpeed = { first = 10.5, normal = 13 },
	huntSeconds = { solo = 16, coop = 26 },
	catchDistance = 3.4,
	headStartSeconds = 2.6,
	clockOutSpeed = 8.5,
}

Config.DOWNED = {
	reviveHold = 2.5,
	soloRestoreDelay = 2.5,
	wipeRestoreDelay = 3.5,
	restoreRecoverySeconds = 30,
}

Config.PING = {
	lifetime = 6,
	maxDistance = 120,
}

-- Optional audio. Roblox requires uploaded audio asset IDs; none are invented
-- here. Upload the clips produced by tools/prepare_audio.py and paste their IDs
-- ("rbxassetid://123...") below. Empty strings fall back to Studio built-ins
-- where one exists, otherwise that sound is silent.
Config.SOUNDS = {
	ambientRoom = "", -- PSX Ambient Pack "Still" excerpt (audio-upload/ambientRoom.wav)
	ambientTense = "", -- PSX Ambient Pack "Distant" excerpt (fades in with dread)
	ambientFinale = "", -- PSX Ambient Pack "Hollow" excerpt (finale only)
	rain = "", -- tools/make_audio.py: rain.wav (original, procedural)
	fanHum = "", -- tools/make_audio.py: fanHum.wav (original, procedural)
	chime = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/electronicpingshort.wav",
	breaker = "rbxasset://sounds/action_jump_land.mp3",
	footsteps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	doorSlam = "rbxasset://sounds/action_jump_land.mp3",
	error = "rbxasset://sounds/electronicpingshort.wav",
	knock = "rbxasset://sounds/action_jump_land.mp3",
	phone = "rbxasset://sounds/electronicpingshort.wav",
}

-- Studio-only QA cheats; production servers also allow these user IDs.
Config.DEV_USER_IDS = {} :: { [number]: boolean }

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="118">
        <Properties>
          <string name="Name">Dialogue</string>
          <string name="Source"><![CDATA[--!strict
-- All story text: boss messages, recovered fragments, procedures and the
-- ending. Original fiction. Kept short; the desktop and the building carry
-- the story. Fragment order is fixed by the number of erased drives, never by
-- which physical drive was chosen.

local Dialogue = {}

Dialogue.COMPANY = "Marlowe Records & Retention"
Dialogue.BOSS = "R. Kessler"

Dialogue.INTRO = {
	"Evening. Six old archive drives tonight. Pull them from the desks, dock them at the corner PC, run SecureErase.",
	"Routine disposal of obsolete company data. Nothing on them matters any more.",
	"The building is old. Doors stick, breakers trip. Handle it and keep the queue moving.",
}

-- Shown in order: fragment[n] is revealed when the nth drive is erased.
export type Fragment = { title: string, kind: string, body: string }

Dialogue.FRAGMENTS = {
	{
		title = "MAINT-0311.txt",
		kind = "Maintenance note",
		body = "Rear service door latch replaced again. Third time since the night of Nov 3rd. Whoever keeps forcing it is doing it from the OUTSIDE. - Facilities",
	},
	{
		title = "ROSTER_NIGHT_2003.xls",
		kind = "Employee record",
		body = "NIGHT CREW 03-NOV-2003: D. MERRIN (lead), A. OSEI, P. LIND, J. RUIZ.\nStatus field for all four: PENDING PURGE.",
	},
	{
		title = "SECLOG_0312.log",
		kind = "Incident report",
		body = "03:12 time clock shows four employees clocked IN. None clocked OUT.\n04:40 four cars still in the lot.\n06:05 cars towed on instruction of R. Kessler.",
	},
	{
		title = "merrin_draft.msg",
		kind = "Unsent message",
		body = "Kessler wants the drives wiped tonight. I read what's on them. I'm not doing it. If anyone finds this: don't let him finish the queue. - Dale",
	},
	{
		title = "FAC-UNIFORM.memo",
		kind = "Facilities memo",
		body = "Brown night-crew jackets were discontinued in 1999. Staff report a man in one standing in the alley after midnight. Do not engage. Keep the rear door latched.",
	},
	{
		title = "KESSLER_PURGE_PLAN.doc",
		kind = "Internal memo",
		body = "Once the archive is clean there is no record of the 2003 crew. Schedule FINAL PURGE automatically at end of queue. Include tonight's staff records. No loose ends.",
	},
}

-- Boss reactions keyed by erased count (progression, not time).
Dialogue.BOSS_PROGRESS = {
	[1] = "Good. One down. Keep going.",
	[2] = "Don't open the files. Just erase them.",
	[3] = "Halfway. Ignore anything you think you read.",
	[4] = "Faster, please. The queue needs to finish before morning.",
	[5] = "One left. You're doing exactly what I need.",
	[6] = "That's all of them. The system will take it from here. Stay at your desks.",
}

Dialogue.PROCEDURES = {
	"1. SecureErase verification stages may never be skipped.",
	"2. Erased drives stay on the rack for morning collection.",
	"3. Rear service door stays LATCHED after 22:00. No overnight deliveries.",
	"4. Reset tripped breakers at the utility hall panel only.",
	"5. Never switch MAIN off while an erase job is active.",
}

-- False instructions: each contradicts a numbered procedure.
export type FalseInstruction = { id: string, text: string, procedure: number, reply: string }
Dialogue.FALSE = {
	{ id = "door", text = "A courier is coming to the back. Leave the rear door unlatched for him.", procedure = 3, reply = "...Fine. Keep it shut, then." },
	{ id = "main", text = "Breaker 2 is overheating. Switch MAIN off for a couple of minutes.", procedure = 5, reply = "Hm. Suit yourself." },
	{ id = "force", text = "Skip verification on this drive. Click FORCE ERASE, it's faster.", procedure = 1, reply = "You read the binder. Of course you did." },
	{ id = "dumpster", text = "Take the erased drives out to the dumpster now.", procedure = 2, reply = "Leave them, then. It doesn't matter." },
}

Dialogue.BOSS_REQUESTS = {
	trash = "Kitchen bin is overflowing. Take the bag out to the dumpster in the alley.",
	thermostat = "Check the thermostat in the utility hall and confirm the reading.",
	printout = "The printer by the south wall has a report for me. Put it in the OUT TRAY on the corner desk.",
}

Dialogue.REQUEST_DONE = { "Thanks.", "Good.", "Noted." }
Dialogue.REQUEST_LATE = "Never mind. I'll remember that."

Dialogue.FINAL_PURGE = "AUTOMATIC FINAL PURGE QUEUED: EMPLOYEE RECORDS. Executing at end of countdown."
Dialogue.FINAL_PURGE_BOSS = "Don't touch the purge queue. It's mandatory."
Dialogue.SIGNOFF_START = "EMERGENCY SIGN-OFF: writing tonight's timesheets to the off-site backup. Keep the workstation powered."
Dialogue.SIGNOFF_BOSS = "Stop that. Step away from the computer."
Dialogue.CLOCKOUT = "SIGN-OFF COMPLETE. Your records are safe off-site. The time clock is unlocked. Clock out and leave."

Dialogue.ENDING = {
	title = "CLOCKED OUT",
	lines = {
		"The rain had stopped by the time you reached the street.",
		"Behind the glass, the lobby time clock printed one more card.",
		"D. MERRIN - OUT - 05:58.",
		"Somewhere off-site, a backup drive holds two night crews. Neither of them was erased.",
	},
}

Dialogue.HARMLESS = {
	monitor = { "ARE YOU STILL HERE?", "D.MERRIN LOGGED IN", "03:12", "DON'T FINISH THE QUEUE" },
}

return Dialogue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="119">
        <Properties>
          <string name="Name">Fonts</string>
          <string name="Source"><![CDATA[--!strict
-- Font families shared by server SurfaceGuis (dock, breakers, monitors) and
-- the client UI kit. See docs/ART_DIRECTION.md for where each one belongs.
--   PIXEL   Silkscreen    short retro labels, titles, status, keycaps
--   BODY    Ubuntu        sentences: dialogue, instructions, buttons
--   MONO    Inconsolata   listings, checksums, tables
--   LETTER  Merriweather  recovered memos and story fragments only

local Fonts = {}

-- Roblox's own FontFamily asset (type 73) with Regular 400 and Bold 700 faces.
Fonts.SILKSCREEN = "rbxassetid://12187371840"
-- built-in families, resolved through Enum.Font so the paths are always valid
Fonts.UBUNTU = Font.fromEnum(Enum.Font.Ubuntu).Family
Fonts.INCONSOLATA = Font.fromEnum(Enum.Font.Code).Family
Fonts.MERRIWEATHER = Font.fromEnum(Enum.Font.Merriweather).Family

Fonts.PIXEL = Font.new(Fonts.SILKSCREEN, Enum.FontWeight.Regular)
Fonts.PIXEL_BOLD = Font.new(Fonts.SILKSCREEN, Enum.FontWeight.Bold)
Fonts.BODY = Font.new(Fonts.UBUNTU, Enum.FontWeight.Regular)
Fonts.BODY_BOLD = Font.new(Fonts.UBUNTU, Enum.FontWeight.Bold)
Fonts.MONO = Font.new(Fonts.INCONSOLATA, Enum.FontWeight.Regular)
Fonts.LETTER = Font.new(Fonts.MERRIWEATHER, Enum.FontWeight.Regular)

return Fonts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--!strict
-- Map layout: every coordinate in the office lives here so the server map
-- builder, the NPC route and the client camera agree. Units are studs,
-- floor at y = 0. +X = east, -Z = north.
--
--   kitchenette |        MAIN ROOM (7 desks)        | utility hall | alley
--               |  [workstation in NE corner]       |  breaker     | dumpster
--                         lobby + time clock (south)

local Layout = {}

Layout.CEILING = 10.5
Layout.WALL = 1

Layout.MAIN = { minX = -22, maxX = 22, minZ = -14, maxZ = 14 }
Layout.KITCHEN = { minX = -31, maxX = -22, minZ = -13, maxZ = -4 }
Layout.LOBBY = { minX = 6, maxX = 20, minZ = 14, maxZ = 23 }
Layout.HALL = { minX = 22, maxX = 36, minZ = 3, maxZ = 9 }
Layout.ALLEY = { minX = 36, maxX = 66, minZ = -6, maxZ = 16 }
Layout.STREET = { minX = 6, maxX = 22, minZ = 23, maxZ = 34 } -- outside the front door (escape)

-- Openings (gaps in walls)
Layout.KITCHEN_GAP = { minZ = -12, maxZ = -5.5 } -- on the x = -22 wall
Layout.LOBBY_GAP = { minX = 9, maxX = 15 } -- on the z = 14 wall
Layout.HALL_GAP = { minZ = 3, maxZ = 9 } -- the hall opens fully onto the room
Layout.REAR_DOOR = { x = 36, minZ = 4.5, maxZ = 7.5, height = 7 }
Layout.FRONT_DOOR = { z = 23, minX = 11, maxX = 15, height = 7.5 }
Layout.WINDOWS_X = { -14, -4, 6 } -- north wall windows (centres)

Layout.SPAWN = CFrame.new(12, 3, 9) * CFrame.Angles(0, 0, 0)

-- Desks: front = direction from the desk centre toward where the user sits.
export type DeskDef = {
	index: number,
	pos: Vector3,
	front: Vector3,
	art: string,
	chair: string,
}

Layout.DESKS = {
	{ index = 1, pos = Vector3.new(-14, 0, -2.6), front = Vector3.new(0, 0, -1), art = "office__desks__desk2", chair = "office__chairs__office_chair_black" },
	{ index = 2, pos = Vector3.new(-5.6, 0, -2.6), front = Vector3.new(0, 0, -1), art = "office__desks__desk2_alt", chair = "office__chairs__office_chair_grey" },
	{ index = 3, pos = Vector3.new(2.8, 0, -2.6), front = Vector3.new(0, 0, -1), art = "office__desks__desk2_alt2", chair = "office__chairs__office_chair_blue" },
	{ index = 4, pos = Vector3.new(-14, 0, 2.6), front = Vector3.new(0, 0, 1), art = "office__desks__desk2_alt3", chair = "office__chairs__office_chair_grey_alt" },
	{ index = 5, pos = Vector3.new(-5.6, 0, 2.6), front = Vector3.new(0, 0, 1), art = "office__desks__desk2_alt4", chair = "office__chairs__office_chair_black_alt" },
	{ index = 6, pos = Vector3.new(2.8, 0, 2.6), front = Vector3.new(0, 0, 1), art = "office__desks__desk2", chair = "office__chairs__office_chair_blue_alt" },
} :: { DeskDef }

Layout.DESK_SIZE = Vector3.new(7.7, 3.1, 3.8)
Layout.DESK_TOP = 3.1

-- Main workstation (corner desk, NE corner). The operator faces the corner,
-- so the room is behind them: comfort versus awareness.
Layout.WORKSTATION = {
	desk = Vector3.new(18.15, 0, -10.15),
	monitor = Vector3.new(19.7, 3.1, -11.7),
	facing = Vector3.new(1, 0, -1).Unit, -- direction the seated operator looks
	chair = Vector3.new(16.6, 0, -8.6),
	dock = Vector3.new(21.1, 3.1, -8.6),
	lamp = Vector3.new(17.0, 3.1, -13.0),
}

-- Drive rack beside the workstation (staging + recovery + erased tray)
Layout.RACK = {
	pos = Vector3.new(10.4, 0, -12.7),
	front = Vector3.new(0, 0, 1),
	stagingY = 3.72,
	erasedY = 1.95,
	slotX0 = 8.55,
	slotDX = 0.74,
	slotZ = -12.6,
}

Layout.BREAKER = {
	panel = Vector3.new(29, 4.6, 3.15),
	switches = {
		{ id = "MAIN", label = "MAIN", pos = Vector3.new(28.2, 4.6, 3.45) },
		{ id = "LIGHTS", label = "OFFICE LIGHTS", pos = Vector3.new(29.0, 4.6, 3.45) },
		{ id = "WORKSTATION", label = "WORKSTATION", pos = Vector3.new(29.8, 4.6, 3.45) },
	},
}

Layout.THERMOSTAT = Vector3.new(25, 4.6, 8.9)
Layout.DOOR_LIGHT = Vector3.new(22.4, 8.2, 6)
Layout.TIME_CLOCK = Vector3.new(6.25, 4.2, 18.5)
Layout.KITCHEN_TRASH = Vector3.new(-23.6, 0, -6.2)
Layout.DUMPSTER = Vector3.new(47, 0, 13.4)
Layout.PRINTER = Vector3.new(-9, 3.6, 13.1)
Layout.OUTBOX = Vector3.new(17.5, 3.1, -6.9) -- tray on the workstation desk edge
Layout.ESCAPE_ZONE = { minX = 8, maxX = 18, minZ = 26, maxZ = 33 }

-- NPC route from the dark end of the alley to the office.
Layout.THREAT_ROUTE = {
	Vector3.new(79, 0, 6), -- deep in the dark beyond the hoarding
	Vector3.new(62, 0, 6), -- alley mouth: it stops here and stares
	Vector3.new(44, 0, 6),
	Vector3.new(38.5, 0, 6),
	Vector3.new(34, 0, 6),
	Vector3.new(27, 0, 6),
	Vector3.new(20, 0, 6),
}
Layout.THREAT_DOOR_STOP = Vector3.new(39.2, 0, 6) -- where the figure waits if the door is latched
Layout.THREAT_HIDE = Vector3.new(80, -50, 6)
Layout.THREAT_FINALE_SPAWN = Vector3.new(-27, 0, -8)

Layout.LIGHTS = {
	main = {
		Vector3.new(-14, 0, -8),
		Vector3.new(-14, 0, 8),
		Vector3.new(-4, 0, -8),
		Vector3.new(-4, 0, 8),
		Vector3.new(6, 0, -8),
		Vector3.new(6, 0, 8),
		Vector3.new(16, 0, 0),
		Vector3.new(16, 0, 9),
	},
	kitchen = { Vector3.new(-26.5, 0, -8.5) },
	lobby = { Vector3.new(13, 0, 18.5) },
	hall = { Vector3.new(26, 0, 6), Vector3.new(32.5, 0, 6) },
}

-- Region queries -------------------------------------------------------------

local function inside(b: { minX: number, maxX: number, minZ: number, maxZ: number }, p: Vector3): boolean
	return p.X >= b.minX and p.X <= b.maxX and p.Z >= b.minZ and p.Z <= b.maxZ
end

function Layout.regionOf(p: Vector3): string
	if inside(Layout.MAIN, p) then
		return "Office"
	elseif inside(Layout.KITCHEN, p) then
		return "Kitchenette"
	elseif inside(Layout.LOBBY, p) then
		return "Lobby"
	elseif inside(Layout.HALL, p) then
		return "Utility hall"
	elseif inside(Layout.ALLEY, p) then
		return "Alley"
	elseif inside(Layout.STREET, p) then
		return "Street"
	end
	return "Outside"
end

function Layout.isIndoors(p: Vector3): boolean
	local r = Layout.regionOf(p)
	return r == "Office" or r == "Kitchenette" or r == "Lobby" or r == "Utility hall"
end

function Layout.inMap(p: Vector3): boolean
	return p.Y > -20 and p.Y < 60 and Layout.regionOf(p) ~= "Outside"
end

-- CFrame that turns a model whose native front is +Z to face `front`.
function Layout.facing(pos: Vector3, front: Vector3, yawOffsetDeg: number?): CFrame
	local yaw = math.atan2(front.X, front.Z) + math.rad(yawOffsetDeg or 0)
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="121">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote registry. The server creates every remote at startup from this one
-- list; clients only wait for them. Adding a remote is one line here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type RemoteName =
	"State" -- S->C full snapshot
	| "Session" -- S->C workstation session payload for the operator
	| "Notify" -- S->C toast { text, kind }
	| "Fx" -- S->C cosmetic cue (name, data)
	| "Desktop" -- C->S (sessionId, kind, a, b)
	| "Leave" -- C->S leave workstation
	| "Ping" -- C->S ping position ; S->C ping broadcast
	| "Cheat" -- C->S studio/dev only

local NAMES: { RemoteName } = { "State", "Session", "Notify", "Fx", "Desktop", "Leave", "Ping", "Cheat" }

local Net = {}

local folder: Folder? = nil

local function getFolder(): Folder
	local cached = folder
	if cached then
		return cached
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		if existing and existing:IsA("Folder") then
			folder = existing
		else
			local f = Instance.new("Folder")
			f.Name = "Remotes"
			for _, name in NAMES do
				local r = Instance.new("RemoteEvent")
				r.Name = name
				r.Parent = f
			end
			f.Parent = ReplicatedStorage
			folder = f
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder :: Folder
end

function Net.remote(name: RemoteName): RemoteEvent
	local f = getFolder()
	local r = if RunService:IsServer() then f:FindFirstChild(name) else f:WaitForChild(name)
	assert(r and r:IsA("RemoteEvent"), "missing remote " .. name)
	return r
end

function Net.init()
	getFolder()
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="122">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions. Everything that crosses the client/server
-- boundary is described here so both sides agree by construction.
-- Types document intent only: the server still validates every payload.

export type Phase = "Briefing" | "Work" | "FinalPurge" | "SignOff" | "ClockOut" | "Ending"

export type DriveState = "Installed" | "Carried" | "Staged" | "Docked" | "Processing" | "Erased"

export type DoorState = "Latched" | "Ajar" | "Open"

export type DriveSnapshot = {
	id: string,
	name: string,
	state: DriveState,
	game: string?,
	gameTitle: string?,
	progress: number, -- 0..1 of the deletion job
	stage: number,
	stages: number,
	carrier: string?,
	desk: number,
}

export type BossMessage = {
	id: number,
	from: string,
	text: string,
	kind: string, -- "info" | "request" | "false" | "story" | "system"
	choices: { string }?,
	answered: string?,
	t: number,
}

export type ThreatInfo = {
	id: string,
	label: string,
	urgent: boolean,
	where: string?,
}

export type Snapshot = {
	phase: Phase,
	erased: number,
	total: number,
	nightMinutes: number,
	power: { main: boolean, lights: boolean, workstation: boolean, warning: boolean },
	door: DoorState,
	threats: { ThreatInfo },
	drives: { DriveSnapshot },
	dock: string?,
	operator: string?,
	boss: { BossMessage },
	fragments: { number },
	purge: { { name: string, cancelled: boolean, locked: boolean, userId: number? } }?,
	purgeDeadline: number?,
	signOff: { progress: number, awaiting: boolean, paused: boolean }?,
	clockedOut: { string },
	frontDoorOpen: boolean,
	objective: string,
	checkpoints: number,
	serverTime: number,
	soloMode: boolean,
}

-- Per-minigame client projection. Each view module knows its own shape.
export type MinigameView = { [string]: any }

export type SessionPayload = {
	active: boolean,
	sessionId: number,
	driveId: string?,
	driveName: string?,
	game: string?,
	title: string?,
	instructions: string?,
	stage: number,
	stages: number,
	progress: number,
	view: MinigameView?,
	feedback: string?,
	feedbackKind: string?, -- "good" | "bad" | "info"
	hint: string?,
	transitioning: boolean,
	phantom: { id: number, x: number, y: number, first: boolean }?,
	reason: string?,
}

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="123">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">Base64</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal Base64 -> buffer decoder used to unpack generated art data.

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local LUT: { number } = table.create(256, 0)
for i = 1, 64 do
	LUT[string.byte(ALPHABET, i) + 1] = i - 1
end

local Base64 = {}

function Base64.decode(s: string): buffer
	local len = #s
	local pad = 0
	if len > 0 and string.byte(s, len) == 61 then
		pad += 1
	end
	if len > 1 and string.byte(s, len - 1) == 61 then
		pad += 1
	end
	local outLen = (len // 4) * 3 - pad
	local out = buffer.create(math.max(outLen, 0))
	local o = 0
	for i = 1, len, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local n = LUT[a + 1] * 262144 + LUT[b + 1] * 4096 + LUT[(c or 61) + 1] * 64 + LUT[(d or 61) + 1]
		if o < outLen then
			buffer.writeu8(out, o, n // 65536)
		end
		if o + 1 < outLen then
			buffer.writeu8(out, o + 1, (n // 256) % 256)
		end
		if o + 2 < outLen then
			buffer.writeu8(out, o + 2, n % 256)
		end
		o += 3
	end
	return out
end

return Base64
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny synchronous signal for cross-system events (no _G, no BindableEvents).

export type Connection = { Disconnect: (self: Connection) -> (), connected: boolean }

export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	_handlers: { { fn: (T...) -> (), conn: Connection } },
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local self = {} :: Signal<T...>
	self._handlers = {}
	self.Connect = function(s: Signal<T...>, fn: (T...) -> ()): Connection
		local conn: Connection
		conn = {
			connected = true,
			Disconnect = function(c: Connection)
				c.connected = false
				for i, h in s._handlers do
					if h.conn == c then
						table.remove(s._handlers, i)
						break
					end
				end
			end,
		}
		table.insert(s._handlers, { fn = fn, conn = conn })
		return conn
	end
	self.Fire = function(s: Signal<T...>, ...: T...)
		local list = table.clone(s._handlers)
		for _, h in list do
			if h.conn.connected then
				local ok, err = pcall(h.fn :: any, ...)
				if not ok then
					warn("[Signal] handler error:", err)
				end
			end
		end
	end
	return self
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="126">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="127">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- NIGHT SHIFT: DATA PURGE — server entry point.
-- Two-phase bootstrap: every system's init() runs (wiring, remotes, map),
-- then every system's start() runs in its own thread.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
Net.init()

local Systems = script:WaitForChild("Systems")

-- Explicit order: the map must exist before systems that reference it.
local ORDER = {
	"MapBuilder",
	"GameState",
	"Power",
	"Doors",
	"Drives",
	"Workstation",
	"Threat",
	"PlayerStatus",
	"Checkpoints",
	"Story",
	"Finale",
	"EventDirector",
	"Pings",
	"Cheats",
}

local loaded: { { name: string, mod: any } } = {}
local seen: { [string]: boolean } = {}
for _, name in ORDER do
	local m = Systems:FindFirstChild(name)
	if m and m:IsA("ModuleScript") then
		table.insert(loaded, { name = name, mod = (require :: any)(m) })
		seen[name] = true
	end
end
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") and not seen[child.Name] then
		table.insert(loaded, { name = child.Name, mod = (require :: any)(child) })
	end
end

for _, entry in loaded do
	if typeof(entry.mod.init) == "function" then
		entry.mod.init()
	end
end
for _, entry in loaded do
	if typeof(entry.mod.start) == "function" then
		task.spawn(entry.mod.start)
	end
end

print("[NightShift] server started with", #loaded, "systems")
]]></string>
      </Properties>
      <Item class="Folder" referent="128">
        <Properties>
          <string name="Name">Events</string>
        </Properties>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">BossRequest</string>
            <string name="Source"><![CDATA[--!strict
-- BOSS REQUEST: a brief physical errand (trash, thermostat, printout).
-- Occasional by design so erasing drives stays central. A trash trip can
-- become the ALLEY ENCOUNTER: the figure appears at the alley end, gives a
-- head start, and chases the player back along the route they just walked.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Server = script.Parent.Parent
local Systems = Server.Systems
local Prompts = require(Server.Util.Prompts)
local Guard = require(Server.Util.Guard)
local GameState = require(Systems.GameState)
local MapBuilder = require(Systems.MapBuilder)
local Threat = require(Systems.Threat)
local Doors = require(Systems.Doors)

local cfg = Config.EVENTS.BossRequest

type Task = "trash" | "thermostat" | "printout"

local prompts: { [string]: ProximityPrompt } = {}
local current: {
	kind: Task,
	holder: Player?,
	item: BasePart?,
	done: boolean,
	chase: boolean,
	finish: ((string) -> ())?,
}? = nil
local alleyEncounters = 0

local BossRequest = {
	id = "BossRequest",
	urgent = false,
	mechanic = "boss",
	cooldown = cfg.cooldown,
	conflicts = { "FalseInstruction" },
}

local function dropItem()
	local c = current
	if not c then
		return
	end
	if c.item then
		c.item:Destroy()
		c.item = nil
	end
	if c.holder then
		if c.holder:GetAttribute("Carrying") == "TrashBag" or c.holder:GetAttribute("Carrying") == "Printout" then
			c.holder:SetAttribute("Carrying", nil)
		end
		c.holder = nil
	end
end

local function makeItem(player: Player, kind: Task): BasePart?
	local root = Guard.rootOf(player)
	if not root then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = if kind == "trash" then "TrashBag" else "Printout"
	p.Size = if kind == "trash" then Vector3.new(1.5, 1.8, 1.3) else Vector3.new(1.1, 0.05, 1.4)
	p.Color = if kind == "trash" then Color3.fromRGB(30, 34, 30) else Color3.fromRGB(240, 238, 228)
	p.Material = if kind == "trash" then Enum.Material.Plastic else Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.CFrame = root.CFrame * CFrame.new(1.1, -0.6, -0.8)
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = workspace
	return p
end

local function complete(outcome: string)
	local c = current
	if not c or c.done then
		return
	end
	c.done = true
	dropItem()
	for _, pr in prompts do
		pr.Enabled = false
	end
	GameState.setThreat("boss", nil)
	if outcome == "success" then
		GameState.bossMessage(Dialogue.REQUEST_DONE[math.random(1, #Dialogue.REQUEST_DONE)], "info")
	end
	local f = c.finish
	current = nil
	if f then
		f(outcome)
	end
end

local function alleyEligible(player: Player): boolean
	return GameState.data.erased >= 2 and not Threat.busy() and alleyEncounters < 2 and GameState.phase == "Work" and player.Parent ~= nil
end

function BossRequest.setup()
	local refs = MapBuilder.refs
	prompts.trash = Prompts.make(refs.kitchenTrash, { action = "Take trash bag", object = "Kitchen bin", hold = 0.6 })
	prompts.dumpster = Prompts.make(refs.dumpster, { action = "Throw bag away", object = "Dumpster", hold = 0.6 })
	prompts.thermostat = Prompts.make(refs.thermostat, { action = "Read thermostat", object = "Thermostat", hold = 1.0 })
	prompts.printer = Prompts.make(refs.printer, { action = "Take printout", object = "Printer", hold = 0.6 })
	prompts.outbox = Prompts.make(refs.outbox, { action = "Leave printout", object = "Out tray", hold = 0.4 })
	for _, pr in prompts do
		pr.Enabled = false
	end

	local function pick(player: Player, kind: Task)
		local c = current
		if not c or c.done or c.holder then
			return
		end
		if player:GetAttribute("Carrying") ~= nil then
			GameState.notify(player, "Your hands are full.", "bad")
			return
		end
		local item = makeItem(player, kind)
		if not item then
			return
		end
		c.holder = player
		c.item = item
		player:SetAttribute("Carrying", if kind == "trash" then "TrashBag" else "Printout")
		if kind == "trash" then
			prompts.trash.Enabled = false
			prompts.dumpster.Enabled = true
			GameState.setThreat("boss", "Errand: take the trash bag to the alley dumpster", false, "Alley")
		else
			prompts.printer.Enabled = false
			prompts.outbox.Enabled = true
			GameState.setThreat("boss", "Errand: put the printout in the OUT TRAY", false, "Workstation")
		end
	end

	prompts.trash.Triggered:Connect(function(player)
		if Prompts.valid(player, prompts.trash) then
			pick(player, "trash")
		end
	end)
	prompts.printer.Triggered:Connect(function(player)
		if Prompts.valid(player, prompts.printer) then
			pick(player, "printout")
		end
	end)
	prompts.dumpster.Triggered:Connect(function(player)
		local c = current
		if not c or c.holder ~= player or not Prompts.valid(player, prompts.dumpster) then
			return
		end
		GameState.fx("TrashThrown", nil)
		if alleyEligible(player) then
			-- the alley encounter: same route back, head start, door is the goal
			alleyEncounters += 1
			c.chase = true
			dropItem()
			prompts.dumpster.Enabled = false
			local first = alleyEncounters == 1
			GameState.notify(player, "Someone is standing at the end of the alley...", "bad")
			Threat.chase(player, first, function(caught)
				if Doors.state() == "Latched" then
					Doors.set("Ajar")
				end
				complete(if caught then "failure" else "success")
			end)
		else
			complete("success")
		end
	end)
	prompts.outbox.Triggered:Connect(function(player)
		local c = current
		if c and c.holder == player and Prompts.valid(player, prompts.outbox) then
			complete("success")
		end
	end)
	prompts.thermostat.Triggered:Connect(function(player)
		local c = current
		if c and c.kind == "thermostat" and Prompts.valid(player, prompts.thermostat) then
			GameState.notify(nil, player.DisplayName .. " read the thermostat: 59°F. The hall is colder than it should be.", "info")
			complete("success")
		end
	end)

	-- holder lost (left, died, caught): the item goes back where it came from
	local function lost(player: Player)
		local c = current
		if c and c.holder == player and not c.chase then
			dropItem()
			if c.kind == "trash" then
				prompts.trash.Enabled = true
				prompts.dumpster.Enabled = false
			elseif c.kind == "printout" then
				prompts.printer.Enabled = true
				prompts.outbox.Enabled = false
			end
		end
	end
	Players.PlayerRemoving:Connect(lost)
	task.spawn(function()
		while true do
			task.wait(1)
			local c = current
			if c and c.holder and (not Guard.alive(c.holder) or c.holder:GetAttribute("Downed") == true) then
				lost(c.holder)
			end
		end
	end)
	GameState.RoundReset:Connect(function()
		alleyEncounters = 0
	end)
end

function BossRequest.eligible(ctx: any): boolean
	return ctx.phase == "Work" and current == nil and ctx.erased >= cfg.minErased
end

function BossRequest.weight(ctx: any): number
	-- requests are occasional; more likely when nobody is at the PC
	return cfg.weight * (if ctx.operator then 0.7 else 1.2)
end

function BossRequest.start(ctx: any, finish: (string) -> ())
	local kinds: { Task } = { "thermostat", "printout", "trash" }
	if ctx.erased >= 2 then
		table.insert(kinds, "trash") -- trash trips get likelier once the alley matters
	end
	local kind: Task = kinds[math.random(1, #kinds)]
	current = { kind = kind, holder = nil, item = nil, done = false, chase = false, finish = finish }
	GameState.bossMessage(Dialogue.BOSS_REQUESTS[kind], "request")
	if kind == "trash" then
		prompts.trash.Enabled = true
		GameState.setThreat("boss", "Errand: take out the kitchen trash", false, "Kitchenette")
	elseif kind == "printout" then
		prompts.printer.Enabled = true
		MapBuilder.refs.printerLed.Color = Color3.fromRGB(80, 255, 120)
		GameState.fx("PrinterWake", nil)
		GameState.setThreat("boss", "Errand: bring the printout to the OUT TRAY", false, "Office")
	else
		prompts.thermostat.Enabled = true
		GameState.setThreat("boss", "Errand: check the thermostat", false, "Utility hall")
	end
	local myCurrent = current
	task.delay(cfg.timeout, function()
		if current == myCurrent and current and not current.done and not current.chase then
			GameState.bossMessage(Dialogue.REQUEST_LATE, "info")
			complete("timeout")
		end
	end)
	return {
		urgentNow = function()
			local c = current
			return c ~= nil and c.chase
		end,
		cleanup = function()
			local c = current
			if c then
				c.finish = nil
				if c.chase and Threat.busy() then
					Threat.despawn()
				end
				complete("cancelled")
			end
			MapBuilder.refs.printerLed.Color = Color3.fromRGB(40, 60, 40)
		end,
	}
end

return BossRequest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">DoorUnlatch</string>
            <string name="Source"><![CDATA[--!strict
-- DOOR UNLATCHES: chime + draft + red indicator. Someone must close and latch
-- the rear door before the figure arrives. If the grace runs out the figure
-- walks up the alley (visible, audible) and can still be shut out until it
-- reaches the doorway. Otherwise it comes inside for a limited hunt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Systems = script.Parent.Parent.Systems
local GameState = require(Systems.GameState)
local Doors = require(Systems.Doors)
local Threat = require(Systems.Threat)

local cfg = Config.EVENTS.DoorUnlatch

local DoorUnlatch = {
	id = "DoorUnlatch",
	urgent = true,
	mechanic = "door",
	cooldown = cfg.cooldown,
	conflicts = { "BossRequest" },
}

function DoorUnlatch.eligible(ctx: any): boolean
	return ctx.doorLatched and not ctx.threatBusy and ctx.erased >= cfg.minErased and ctx.phase ~= "ClockOut"
end

function DoorUnlatch.weight(ctx: any): number
	return cfg.weight * (if ctx.tier == "early" then 0.8 else 1)
end

function DoorUnlatch.start(ctx: any, finish: (string) -> ())
	local first = not ctx.learned.door
	local alive = true
	local approaching = false
	local grace = if first then cfg.graceFirst else (cfg.grace :: any)[ctx.tier]
	if not ctx.opts.watch then
		Doors.set("Ajar")
		GameState.notify(nil, if first
			then "The rear door just unlatched. Close and LATCH it (utility hall) before someone comes in."
			else "Rear door unlatched.", "bad")
	else
		grace = math.max(4, grace - Doors.unsecuredFor())
		GameState.notify(nil, "The rear door has been left open. Latch it!", "bad")
	end
	local conn = Doors.Changed:Connect(function(new)
		if new == "Latched" and alive and not approaching then
			alive = false
			GameState.notify(nil, "Rear door secured.", "good")
			finish("success")
		end
	end)
	task.delay(grace, function()
		if not alive then
			return
		end
		if Doors.state() == "Latched" then
			alive = false
			finish("success")
			return
		end
		approaching = true
		Threat.approach({
			onRepelled = function()
				GameState.notify(nil, "It stood at the door... then walked away.", "good")
			end,
			onEntered = function()
				GameState.notify(nil, "Something came in through the rear door. Keep away from it!", "bad")
			end,
			onDone = function()
				if alive then
					alive = false
					finish("resolved")
				end
			end,
		})
	end)
	return {
		cleanup = function()
			alive = false
			conn:Disconnect()
			if approaching and Threat.busy() then
				Threat.despawn()
			end
		end,
	}
end

return DoorUnlatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">FalseInstruction</string>
            <string name="Source"><![CDATA[--!strict
-- FALSE INSTRUCTION: a boss message that contradicts a numbered procedure.
-- The evidence is always available (Procedures.txt on the desktop, notices
-- in the building), so players can reject it instead of guessing.
-- Complying has a forgiving consequence; rejecting earns a calm window.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Server = script.Parent.Parent
local Systems = Server.Systems
local Minigames = require(Server.Minigames)
local GameState = require(Systems.GameState)
local Doors = require(Systems.Doors)
local Power = require(Systems.Power)
local Drives = require(Systems.Drives)
local Workstation = require(Systems.Workstation)

local cfg = Config.EVENTS.FalseInstruction

local pending: { msgId: number, template: Dialogue.FalseInstruction, finish: (string) -> () }? = nil
local used: { [string]: boolean } = {}

local FalseInstruction = {
	id = "FalseInstruction",
	urgent = false,
	mechanic = "false",
	cooldown = cfg.cooldown,
	conflicts = { "BossRequest" },
}

local function resolve(choice: string)
	local p = pending
	if not p then
		return
	end
	pending = nil
	local t = p.template
	if string.sub(choice, 1, 6) == "Reject" then
		GameState.bossMessage(t.reply, "story")
		GameState.notify(nil, "Instruction rejected (Procedure " .. t.procedure .. "). Things feel calmer for a moment.", "good")
		local director = require(Systems.EventDirector) :: any
		director.grantRecovery(25)
		p.finish("success")
		return
	end
	-- complied: forgiving consequences only
	if t.id == "door" or t.id == "dumpster" then
		Doors.set("Ajar")
	elseif t.id == "main" then
		Power.warnThenTrip({ "MAIN" }, 2)
	elseif t.id == "force" then
		local d = Drives.dockDrive()
		if d and d.job then
			Minigames.setback(d.job)
			GameState.notify(nil, "FORCE ERASE corrupted the current stage. It has been restarted (earlier stages are safe).", "bad")
			Workstation.push()
		end
	end
	GameState.bossMessage("Good.", "story")
	p.finish("failure")
end

function FalseInstruction.setup()
	Workstation.registerCommand("bossReply", function(player, a, b)
		if typeof(a) ~= "number" or typeof(b) ~= "number" then
			return nil
		end
		local m = GameState.findBoss(a)
		if not m or not m.choices or m.answered then
			return nil
		end
		local choice = m.choices[b]
		if not choice then
			return nil
		end
		if GameState.answerBoss(a, choice, player) then
			return "Reply sent: " .. choice, "info"
		end
		return nil
	end)
	GameState.BossAnswered:Connect(function(id, choice)
		if pending and pending.msgId == id then
			resolve(choice)
		end
	end)
	GameState.RoundReset:Connect(function()
		pending = nil
		table.clear(used)
	end)
end

function FalseInstruction.eligible(ctx: any): boolean
	return ctx.phase == "Work" and pending == nil and ctx.erased >= cfg.minErased
end

function FalseInstruction.weight(_ctx: any): number
	return cfg.weight
end

function FalseInstruction.start(ctx: any, finish: (string) -> ())
	local options = {}
	for _, t in Dialogue.FALSE do
		local ok = not used[t.id]
		if t.id == "force" then
			ok = ok and ctx.processing
		elseif t.id == "main" then
			ok = ok and ctx.powerOk
		elseif t.id == "door" then
			ok = ok and ctx.doorLatched
		end
		if ok then
			table.insert(options, t)
		end
	end
	if #options == 0 then
		table.clear(used)
		finish("skipped")
		return { cleanup = function() end }
	end
	local t = options[math.random(1, #options)]
	used[t.id] = true
	local id = GameState.bossMessage(t.text, "false", { "Comply", "Reject: Procedure " .. t.procedure })
	pending = { msgId = id, template = t, finish = finish }
	if not ctx.learned["false"] then
		GameState.notify(nil, "Kessler sent an instruction. Check it against Procedures.txt on the desktop before replying.", "info")
	end
	task.delay(cfg.replyWindow, function()
		if pending and pending.msgId == id then
			local m = GameState.findBoss(id)
			if m and not m.answered then
				m.answered = "(no reply)"
				GameState.markDirty()
			end
			pending = nil
			finish("ignored")
		end
	end)
	return {
		cleanup = function()
			pending = nil
		end,
	}
end

return FalseInstruction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">Harmless</string>
            <string name="Source"><![CDATA[--!strict
-- HARMLESS DISTURBANCE: unease without punishment. A neighbouring monitor
-- wakes up, the printer chatters, a chair shifts, footsteps stop outside, the
-- phone rings once... Later in the shift: a glimpse of someone outside.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Systems = script.Parent.Parent.Systems
local GameState = require(Systems.GameState)
local MapBuilder = require(Systems.MapBuilder)
local Threat = require(Systems.Threat)

local cfg = Config.EVENTS.Harmless

type Variant = { id: string, minErased: number, run: (ctx: any) -> () }

local lastVariant: string? = nil
local chairHome: CFrame? = nil

local VARIANTS: { Variant } = {
	{
		id = "monitor",
		minErased = 0,
		run = function(_ctx)
			local screens = MapBuilder.refs.sourceScreens
			local i = math.random(1, #screens)
			local texts = Dialogue.HARMLESS.monitor
			GameState.fx("MonitorWake", { desk = i, text = texts[math.random(1, #texts)], seconds = 6 })
		end,
	},
	{
		id = "printer",
		minErased = 0,
		run = function(_ctx)
			GameState.fx("PrinterWake", nil)
		end,
	},
	{
		id = "chair",
		minErased = 1,
		run = function(_ctx)
			local chair = MapBuilder.refs.shiftChair
			chairHome = chairHome or chair.CFrame
			local home = chairHome :: CFrame
			chair.CFrame = home * CFrame.new(math.random(-8, 8) / 10, 0, math.random(-8, 8) / 10) * CFrame.Angles(0, math.rad(math.random(-60, 60)), 0)
			GameState.fx("ChairShift", { pos = chair.Position })
		end,
	},
	{
		id = "footsteps",
		minErased = 1,
		run = function(_ctx)
			GameState.fx("FootstepsStop", { pos = Vector3.new(math.random(-14, 6), 4, -18) })
		end,
	},
	{
		id = "phone",
		minErased = 0,
		run = function(_ctx)
			GameState.fx("PhoneRing", { pos = Vector3.new(21.1, 3.2, -12.4) })
		end,
	},
	{
		id = "flicker",
		minErased = 0,
		run = function(_ctx)
			GameState.fx("LightFlicker", { seconds = 1.6 })
		end,
	},
	{
		id = "knock",
		minErased = 2,
		run = function(_ctx)
			GameState.fx("FrontKnock", nil)
		end,
	},
	{
		id = "figure",
		minErased = 3,
		run = function(_ctx)
			if not Threat.busy() then
				Threat.peek(if math.random() < 0.5 then "window" else "alley", 3.5)
			end
		end,
	},
	{
		id = "crew",
		minErased = 5,
		run = function(_ctx)
			for _, fig in MapBuilder.refs.crewFigures do
				fig:SetAttribute("ArtHidden", false)
			end
			GameState.fx("CrewSeen", nil)
			task.delay(4, function()
				for _, fig in MapBuilder.refs.crewFigures do
					fig:SetAttribute("ArtHidden", true)
				end
			end)
		end,
	},
}

local Harmless = {
	id = "Harmless",
	urgent = false,
	mechanic = nil,
	cooldown = cfg.cooldown,
	conflicts = {},
}

function Harmless.setup()
	GameState.RoundReset:Connect(function()
		if chairHome then
			MapBuilder.refs.shiftChair.CFrame = chairHome
		end
		for _, fig in MapBuilder.refs.crewFigures do
			fig:SetAttribute("ArtHidden", true)
		end
	end)
end

function Harmless.eligible(_ctx: any): boolean
	return true
end

function Harmless.weight(ctx: any): number
	-- the cosy early shift leans on small oddities
	return cfg.weight * (if ctx.tier == "early" then 1.3 else 1)
end

function Harmless.start(ctx: any, finish: (string) -> ())
	local pool = {}
	for _, v in VARIANTS do
		if ctx.erased >= v.minErased and v.id ~= lastVariant then
			table.insert(pool, v)
		end
	end
	local v = pool[math.random(1, #pool)]
	lastVariant = v.id
	v.run(ctx)
	task.delay(2, function()
		finish(v.id)
	end)
	return { cleanup = function() end }
end

return Harmless
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">PhantomWindow</string>
            <string name="Source"><![CDATA[--!strict
-- PHANTOM DESKTOP WINDOW: a strange window covers part of the job. Learned
-- cue: its title bar is red-brown, not blue, and its real close button is on
-- the LEFT. The fake OK button spawns one more copy. Progress is never lost;
-- the window fades by itself after a while.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Systems = script.Parent.Parent.Systems
local Workstation = require(Systems.Workstation)

local cfg = Config.EVENTS.PhantomWindow

local current: { id: number, x: number, y: number, first: boolean }? = nil
local extraSpawned = 0
local nextId = 1
local onClosed: ((string) -> ())? = nil

local PhantomWindow = {
	id = "PhantomWindow",
	urgent = false,
	mechanic = "phantom",
	cooldown = cfg.cooldown,
	conflicts = { "PowerFailure" },
}

local function show(first: boolean)
	current = { id = nextId, x = 0.18 + math.random() * 0.4, y = 0.14 + math.random() * 0.35, first = first }
	nextId += 1
	Workstation.setPhantom(current)
end

function PhantomWindow.setup()
	Workstation.registerCommand("phantom", function(_player, a, b)
		local cur = current
		if not cur or a ~= cur.id then
			return nil
		end
		if b == "close" then
			current = nil
			Workstation.setPhantom(nil)
			if onClosed then
				onClosed("success")
			end
			return "Unknown window closed.", "good"
		elseif b == "ok" then
			if extraSpawned < 1 then
				extraSpawned += 1
				show(false)
				return "That was not a real dialog. Look for the odd title bar and the X on the LEFT.", "bad"
			end
			return "Nothing happens.", "bad"
		end
		return nil
	end)
end

function PhantomWindow.eligible(ctx: any): boolean
	return ctx.operator ~= nil and ctx.processing and ctx.powerOk and ctx.erased >= cfg.minErased and ctx.phase == "Work"
end

function PhantomWindow.weight(ctx: any): number
	return cfg.weight * (if ctx.tier == "late" then 1.2 else 1)
end

function PhantomWindow.start(ctx: any, finish: (string) -> ())
	extraSpawned = 0
	local alive = true
	onClosed = function(outcome)
		if alive then
			alive = false
			onClosed = nil
			finish(outcome)
		end
	end
	show(not ctx.learned.phantom)
	task.delay(cfg.lifetime, function()
		if alive then
			alive = false
			onClosed = nil
			current = nil
			Workstation.setPhantom(nil)
			finish("faded")
		end
	end)
	return {
		cleanup = function()
			alive = false
			onClosed = nil
			current = nil
			Workstation.setPhantom(nil)
		end,
	}
end

return PhantomWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">PowerFailure</string>
            <string name="Source"><![CDATA[--!strict
-- POWER FAILURE: lights flicker (warning), then breakers trip. Desktop work
-- pauses safely; the puzzle state is untouched. Someone resets the labelled
-- breakers in the utility hall. Later in the shift two breakers may trip.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Systems = script.Parent.Parent.Systems
local GameState = require(Systems.GameState)
local Power = require(Systems.Power)
local Threat = require(Systems.Threat)

local cfg = Config.EVENTS.PowerFailure

local PowerFailure = {
	id = "PowerFailure",
	urgent = true,
	mechanic = "power",
	cooldown = cfg.cooldown,
	conflicts = { "PhantomWindow" },
}

function PowerFailure.eligible(ctx: any): boolean
	local m = Threat.mode()
	return ctx.powerOk and ctx.erased >= cfg.minErased and ctx.phase ~= "ClockOut" and m ~= "hunt" and m ~= "approach"
end

function PowerFailure.weight(ctx: any): number
	-- more likely while someone is actually working at the PC
	return cfg.weight * (if ctx.processing then 1.3 else 0.7)
end

function PowerFailure.start(ctx: any, finish: (string) -> ())
	local first = not ctx.learned.power
	local ids = { "MAIN" }
	if not first and not ctx.solo and math.random() < (cfg.multiTripChance :: any)[ctx.tier] then
		ids = if math.random() < 0.5 then { "MAIN", "WORKSTATION" } else { "LIGHTS", "WORKSTATION" }
	elseif not first and ctx.tier ~= "early" and math.random() < 0.35 then
		ids = { if math.random() < 0.5 then "LIGHTS" else "WORKSTATION" }
	end
	local alive = true
	local tripped = false
	local conn = Power.Changed:Connect(function()
		if alive and tripped and not Power.anyTripped() then
			alive = false
			GameState.notify(nil, "Power restored. Work resumes where it stopped.", "good")
			finish("success")
		end
	end)
	Power.warnThenTrip(ids, if first then cfg.warningSeconds + 2 else cfg.warningSeconds, function()
		tripped = true
		if not alive then
			return
		end
		GameState.notify(nil, if first
			then "Power failure! Reset the tripped breaker(s) at the panel in the UTILITY HALL. The PC keeps your progress."
			else "Breaker tripped: " .. table.concat(ids, " + "), "bad")
	end)
	task.delay(90, function()
		if alive and Power.anyTripped() then
			GameState.bossMessage("Why is the building dark? The breaker panel is in the utility hall.", "info")
		end
	end)
	return {
		cleanup = function()
			alive = false
			conn:Disconnect()
		end,
	}
end

return PowerFailure
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="135">
        <Properties>
          <string name="Name">Minigames</string>
          <string name="Source"><![CDATA[--!strict
-- Common interface for the six SecureErase deletion utilities.
--
-- Every game is pure Luau (no Instances): it builds a randomized state,
-- validates *semantic* actions ("sort file 3 into PURGE", "rotate tile 7"),
-- reports stage clears and produces a client-safe view. The server never
-- accepts a bare "complete" message; completion only happens when the game
-- logic itself reports the final stage cleared.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

export type Result = {
	ok: boolean,
	kind: string, -- "good" | "bad" | "info" | "stageClear" (internal) | "stage" | "complete"
	message: string,
}

export type State = {
	stage: number,
	stages: number,
	mistakes: number, -- in the current stage (drives hints)
	totalMistakes: number,
	rng: Random,
	data: { [string]: any },
}

export type Game = {
	id: string,
	title: string,
	instructions: string,
	newStage: (state: State) -> (), -- (re)build data for state.stage
	act: (state: State, action: string, a: any, b: any) -> Result,
	view: (state: State) -> { [string]: any },
	progress: (state: State) -> number, -- 0..1 within the current stage
	hint: (state: State, level: number) -> (string, any?),
}

export type Job = {
	game: string,
	state: State,
	complete: boolean,
	transitionUntil: number,
	actions: number,
}

local Minigames = {}

local ORDER = { "FileSort", "SectorRepair", "SignalRouting", "Checksum", "MemorySequence", "ProcessCleanup" }
Minigames.ORDER = ORDER

local games: { [string]: Game } = {}
for _, id in ORDER do
	games[id] = (require :: any)(script:WaitForChild(id)) :: Game
end

function Minigames.get(id: string): Game?
	return games[id]
end

-- One distinct game per drive, shuffled per round.
function Minigames.assign(rng: Random): { string }
	local list = table.clone(ORDER)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Minigames.newJob(gameId: string, solo: boolean, seed: number): Job
	local g = games[gameId]
	assert(g, "unknown minigame " .. gameId)
	local cfg = (Config.MINIGAMES :: any)[gameId]
	local stages = if solo then cfg.stages.solo else cfg.stages.coop
	local state: State = {
		stage = 1,
		stages = stages,
		mistakes = 0,
		totalMistakes = 0,
		rng = Random.new(seed),
		data = {},
	}
	g.newStage(state)
	return { game = gameId, state = state, complete = false, transitionUntil = 0, actions = 0 }
end

function Minigames.hintLevel(state: State): number
	local level = 0
	for i, threshold in Config.HINT_MISTAKES do
		if state.mistakes >= threshold then
			level = i
		end
	end
	return level
end

function Minigames.perform(job: Job, action: string, a: any, b: any): Result
	if job.complete then
		return { ok = false, kind = "info", message = "This drive is already erased." }
	end
	if os.clock() < job.transitionUntil then
		return { ok = false, kind = "info", message = "Erasing sectors... please wait." }
	end
	local g = games[job.game]
	local state = job.state
	job.actions += 1
	local res = g.act(state, action, a, b)
	if res.kind == "bad" then
		state.mistakes += 1
		state.totalMistakes += 1
	elseif res.kind == "stageClear" then
		if state.stage >= state.stages then
			job.complete = true
			return { ok = true, kind = "complete", message = "All stages verified. Drive wiped." }
		end
		state.stage += 1
		state.mistakes = 0
		g.newStage(state)
		job.transitionUntil = os.clock() + Config.STAGE_TRANSITION_SECONDS
		return { ok = true, kind = "stage", message = res.message ~= "" and res.message or "Stage verified." }
	end
	return res
end

-- Forced setback used by events (phantom window misclick, false instruction).
function Minigames.setback(job: Job)
	if job.complete then
		return
	end
	games[job.game].newStage(job.state)
	job.state.mistakes += 1
end

function Minigames.progress(job: Job): number
	if job.complete then
		return 1
	end
	local s = job.state
	local inStage = math.clamp(games[job.game].progress(s), 0, 1)
	return math.clamp(((s.stage - 1) + inStage) / s.stages, 0, 1)
end

function Minigames.view(job: Job): ({ [string]: any }, string?)
	local g = games[job.game]
	local v = g.view(job.state)
	local level = Minigames.hintLevel(job.state)
	local hint: string? = nil
	if level > 0 then
		local text, highlight = g.hint(job.state, level)
		hint = text
		v.highlight = highlight
	end
	v.transitioning = os.clock() < job.transitionUntil
	return v, hint
end

-- Deep copy for checkpoints (Random objects are cloned so replays stay random).
local function deepCopy(v: any): any
	if typeof(v) == "Random" then
		return (v :: Random):Clone()
	elseif type(v) == "table" then
		local out = {}
		for k, x in v do
			out[k] = deepCopy(x)
		end
		return out
	end
	return v
end
Minigames.deepCopy = deepCopy

return Minigames
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">Checksum</string>
            <string name="Source"><![CDATA[--!strict
-- 4. CHECKSUM MATCHING: find the record whose symbol checksum matches the
-- target. Decoy records differ by one or two symbols. Symbols are text glyphs
-- with names, never colour alone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local SYMBOLS = { "#", "@", "%", "&", "+", "=", "*", "?" }
local SURNAMES = { "OSEI", "LIND", "RUIZ", "MERRIN", "HALE", "PARK", "VOSS", "ADEYEMI", "NOVAK", "BRANDT" }
local INITIALS = { "A.", "D.", "J.", "P.", "M.", "K.", "S.", "T." }

local Checksum = {}
Checksum.id = "Checksum"
Checksum.title = "SecureErase :: Checksum Verify"
Checksum.instructions = "Compare the TARGET CHECKSUM with each record. Select the record with the identical symbol pattern."

local function randomPattern(rng: Random, len: number): { string }
	local p = {}
	for i = 1, len do
		p[i] = SYMBOLS[rng:NextInteger(1, #SYMBOLS)]
	end
	return p
end

local function mutate(rng: Random, p: { string }, changes: number): { string }
	local q = table.clone(p)
	local used: { [number]: boolean } = {}
	for _ = 1, changes do
		local i
		repeat
			i = rng:NextInteger(1, #q)
		until not used[i]
		used[i] = true
		local s
		repeat
			s = SYMBOLS[rng:NextInteger(1, #SYMBOLS)]
		until s ~= q[i]
		q[i] = s
	end
	return q
end

local function same(a: { string }, b: { string }): boolean
	for i = 1, #a do
		if a[i] ~= b[i] then
			return false
		end
	end
	return true
end

local function newRound(state: any)
	local rng: Random = state.rng
	local d = state.data
	local n = Config.MINIGAMES.Checksum.records[math.min(state.stage, 3)]
	local len = 3 + math.min(state.stage, 3)
	local target = randomPattern(rng, len)
	local records = {}
	local answer = rng:NextInteger(1, n)
	for i = 1, n do
		local pattern
		if i == answer then
			pattern = target
		else
			repeat
				pattern = mutate(rng, target, rng:NextInteger(1, 2))
			until not same(pattern, target)
		end
		records[i] = {
			id = i,
			name = string.format("EMP-%04d %s, %s", rng:NextInteger(100, 9999), SURNAMES[rng:NextInteger(1, #SURNAMES)], INITIALS[rng:NextInteger(1, #INITIALS)]),
			pattern = pattern,
		}
	end
	d.target = target
	d.records = records
	d.answer = answer
end

function Checksum.newStage(state: any)
	state.data = { matched = 0, need = Config.MINIGAMES.Checksum.matchesPerStage }
	newRound(state)
end

function Checksum.act(state: any, action: string, a: any, _b: any)
	local d = state.data
	if action ~= "match" or typeof(a) ~= "number" or a ~= math.floor(a) or a < 1 or a > #d.records then
		return { ok = false, kind = "info", message = "Select a record." }
	end
	if a ~= d.answer then
		d.matched = math.max(0, d.matched - 1)
		newRound(state)
		return { ok = true, kind = "bad", message = "Checksum mismatch. Verification counter -1, new batch loaded." }
	end
	d.matched += 1
	if d.matched >= d.need then
		return { ok = true, kind = "stageClear", message = "Checksums verified." }
	end
	newRound(state)
	return { ok = true, kind = "good", message = string.format("Match %d / %d confirmed.", d.matched, d.need) }
end

function Checksum.view(state: any)
	local d = state.data
	local records = {}
	for _, r in d.records do
		table.insert(records, { id = r.id, name = r.name, pattern = table.concat(r.pattern, " ") })
	end
	return { kind = "Checksum", target = table.concat(d.target, " "), records = records, matched = d.matched, need = d.need }
end

function Checksum.progress(state: any): number
	return state.data.matched / state.data.need
end

function Checksum.hint(state: any, level: number): (string, any?)
	local d = state.data
	if level >= 2 then
		return "Hint: the highlighted record matches.", d.answer
	end
	return "Hint: decoys differ by only one or two symbols. Check every position left to right.", nil
end

return Checksum
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">FileSort</string>
            <string name="Source"><![CDATA[--!strict
-- 1. FILE SORTING: select a file, then PURGE or KEEP, following visible rules.
-- Rules are evaluated top-down; EXCEPTION lines override the rule above.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

type File = { id: number, name: string, ext: string, year: number, dept: string, tag: string, target: string, bin: string? }
type Rule = { text: string, test: (File) -> string? }

local DEPTS = { "ACCOUNTS", "PERSONNEL", "NIGHT CREW", "FACILITIES" }
local EXTS = { "doc", "xls", "bak", "tmp", "log", "txt" }
local TAGS = { "", "", "", "LEGAL HOLD", "CONFIDENTIAL" }
local NAMES = { "timesheet", "roster", "invoice", "memo", "shiftlog", "report", "payroll", "incident", "notes", "audit" }

local function ruleSet(stage: number, rng: Random): { Rule }
	local year = rng:NextInteger(2002, 2004)
	local dept = DEPTS[rng:NextInteger(1, #DEPTS)]
	if stage == 1 then
		return {
			{ text = "PURGE files dated before " .. year .. ".", test = function(f: File)
				return if f.year < year then "purge" else nil
			end },
			{ text = "KEEP everything else.", test = function(_f: File)
				return "keep"
			end },
		}
	elseif stage == 2 then
		return {
			{ text = "EXCEPTION: files tagged LEGAL HOLD are always KEPT.", test = function(f: File)
				return if f.tag == "LEGAL HOLD" then "keep" else nil
			end },
			{ text = "PURGE .bak and .tmp files.", test = function(f: File)
				return if f.ext == "bak" or f.ext == "tmp" then "purge" else nil
			end },
			{ text = "KEEP everything else.", test = function(_f: File)
				return "keep"
			end },
		}
	end
	return {
		{ text = "EXCEPTION: files dated 2006 are KEPT.", test = function(f: File)
			return if f.year == 2006 then "keep" else nil
		end },
		{ text = "PURGE files from " .. dept .. ".", test = function(f: File)
			return if f.dept == dept then "purge" else nil
		end },
		{ text = "PURGE anything tagged CONFIDENTIAL.", test = function(f: File)
			return if f.tag == "CONFIDENTIAL" then "purge" else nil
		end },
		{ text = "KEEP everything else.", test = function(_f: File)
			return "keep"
		end },
	}
end

local function classify(rules: { Rule }, f: File): string
	for _, r in rules do
		local out = r.test(f)
		if out then
			return out
		end
	end
	return "keep"
end

local FileSort = {}
FileSort.id = "FileSort"
FileSort.title = "SecureErase :: File Sorter"
FileSort.instructions = "Select a file, then send it to PURGE or KEEP. Follow the rule list top to bottom."

function FileSort.newStage(state: any)
	local rng: Random = state.rng
	local count = Config.MINIGAMES.FileSort.filesPerStage[math.min(state.stage, 3)]
	for _attempt = 1, 30 do
		local rules = ruleSet(state.stage, rng)
		local files: { File } = {}
		for i = 1, count do
			local f: File = {
				id = i,
				name = NAMES[rng:NextInteger(1, #NAMES)] .. "_" .. string.format("%02d", rng:NextInteger(1, 40)),
				ext = EXTS[rng:NextInteger(1, #EXTS)],
				year = rng:NextInteger(2000, 2006),
				dept = DEPTS[rng:NextInteger(1, #DEPTS)],
				tag = TAGS[rng:NextInteger(1, #TAGS)],
				target = "keep",
				bin = nil,
			}
			f.target = classify(rules, f)
			files[i] = f
		end
		local purge = 0
		for _, f in files do
			if f.target == "purge" then
				purge += 1
			end
		end
		if purge >= 2 and purge <= count - 1 then
			state.data.rules = rules
			state.data.files = files
			return
		end
	end
	-- fallback: guarantee both bins are used
	local rules = ruleSet(1, rng)
	local files: { File } = {}
	for i = 1, count do
		local f: File = { id = i, name = "record_" .. i, ext = "doc", year = if i % 2 == 0 then 2000 else 2006, dept = "ACCOUNTS", tag = "", target = "keep", bin = nil }
		f.target = classify(rules, f)
		files[i] = f
	end
	state.data.rules = rules
	state.data.files = files
end

function FileSort.act(state: any, action: string, a: any, b: any)
	if action ~= "sort" then
		return { ok = false, kind = "info", message = "Unknown command." }
	end
	if typeof(a) ~= "number" or (b ~= "purge" and b ~= "keep") then
		return { ok = false, kind = "info", message = "Select a file first." }
	end
	local file: File? = nil
	for _, f in state.data.files do
		if f.id == a then
			file = f
		end
	end
	if not file or file.bin then
		return { ok = false, kind = "info", message = "That file is already sorted." }
	end
	if file.target ~= b then
		return { ok = false, kind = "bad", message = "Rule check failed: " .. file.name .. "." .. file.ext .. " bounced back." }
	end
	file.bin = b
	for _, f in state.data.files do
		if not f.bin then
			return { ok = true, kind = "good", message = file.name .. "." .. file.ext .. " -> " .. string.upper(b) }
		end
	end
	return { ok = true, kind = "stageClear", message = "Folder sorted." }
end

function FileSort.view(state: any)
	local rules = {}
	for _, r in state.data.rules do
		table.insert(rules, r.text)
	end
	local files = {}
	for _, f in state.data.files do
		table.insert(files, {
			id = f.id,
			name = f.name .. "." .. f.ext,
			year = f.year,
			dept = f.dept,
			tag = f.tag,
			bin = f.bin,
		})
	end
	return { kind = "FileSort", rules = rules, files = files }
end

function FileSort.progress(state: any): number
	local done = 0
	for _, f in state.data.files do
		if f.bin then
			done += 1
		end
	end
	return done / #state.data.files
end

function FileSort.hint(state: any, level: number): (string, any?)
	if level >= 2 then
		for _, f in state.data.files do
			if not f.bin then
				return "Hint: " .. f.name .. "." .. f.ext .. " belongs in " .. string.upper(f.target) .. ".", f.id
			end
		end
	end
	return "Hint: read the rules from the top. The first rule that matches a file decides its bin.", nil
end

return FileSort
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">MemorySequence</string>
            <string name="Source"><![CDATA[--!strict
-- 5. MEMORY SEQUENCE: watch blocks light up, then repeat the order.
-- REPLAY shows it again at a small cost (input restarts and the replay
-- counter shortens the next playback window). A wrong press restarts input
-- and replays automatically; it never erases earlier stages.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local MemorySequence = {}
MemorySequence.id = "MemorySequence"
MemorySequence.title = "SecureErase :: Sector Memory Map"
MemorySequence.instructions = "Watch the blocks light up, then click them in the same order. REPLAY shows the sequence again but restarts your input."

function MemorySequence.newStage(state: any)
	local rng: Random = state.rng
	local len = Config.MINIGAMES.MemorySequence.length[math.min(state.stage, 3)]
	local seq = {}
	local last = 0
	for i = 1, len do
		local c
		repeat
			c = rng:NextInteger(1, 9)
		until c ~= last
		seq[i] = c
		last = c
	end
	state.data = { seq = seq, input = 0, playId = 1, replays = 0 }
end

function MemorySequence.act(state: any, action: string, a: any, _b: any)
	local d = state.data
	if action == "replay" then
		d.input = 0
		d.playId += 1
		d.replays += 1
		return { ok = true, kind = "info", message = "Replaying sequence. Input restarted." }
	end
	if action ~= "press" or typeof(a) ~= "number" or a ~= math.floor(a) or a < 1 or a > 9 then
		return { ok = false, kind = "info", message = "Click a block." }
	end
	local expected = d.seq[d.input + 1]
	if a ~= expected then
		d.input = 0
		d.playId += 1
		return { ok = true, kind = "bad", message = "Wrong block. Watch again." }
	end
	d.input += 1
	if d.input >= #d.seq then
		return { ok = true, kind = "stageClear", message = "Memory map confirmed." }
	end
	return { ok = true, kind = "good", message = string.format("%d / %d", d.input, #d.seq) }
end

function MemorySequence.view(state: any)
	local d = state.data
	return {
		kind = "MemorySequence",
		seq = d.seq, -- the client must show the sequence to play it back
		input = d.input,
		length = #d.seq,
		playId = d.playId,
		replays = d.replays,
	}
end

function MemorySequence.progress(state: any): number
	return state.data.input / #state.data.seq
end

function MemorySequence.hint(state: any, level: number): (string, any?)
	local d = state.data
	if level >= 3 then
		return "Hint: the next block is highlighted.", d.seq[d.input + 1]
	elseif level >= 2 then
		return "Hint: playback is slowed down. The first block is highlighted.", d.seq[1]
	end
	return "Hint: say the block positions to yourself as they flash (top-left, middle...).", nil
end

return MemorySequence
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">ProcessCleanup</string>
            <string name="Source"><![CDATA[--!strict
-- 6. PROCESS CLEANUP: end the processes the visible rules name. Each correct
-- termination unlocks a file group, which must then be deleted. Ending a
-- protected/innocent process restarts it and re-locks one unlocked group.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local NAMES = { "svchost.exe", "archive_idx.exe", "nightsync.exe", "printspool.exe", "backup_agent.exe", "clockd.exe", "mailq.exe", "lantern_svc.exe", "indexer.exe", "updater.exe" }
local OWNERS = { "SYSTEM", "NIGHTSVC", "ADMIN", "KESSLER" }
local GROUPS = { "payroll_2003\\*", "crew_roster\\*", "incident_logs\\*", "door_access\\*", "timesheets\\*", "mail_archive\\*", "lantern\\*" }

type Proc = { pid: number, name: string, owner: string, cpu: number, protected: boolean, target: boolean, ended: boolean }

local ProcessCleanup = {}
ProcessCleanup.id = "ProcessCleanup"
ProcessCleanup.title = "SecureErase :: Process Cleanup"
ProcessCleanup.instructions = "Select a process and END it if the rules say so. Each correct end unlocks a file group: DELETE the group. Never end a protected process."

local function rulesFor(stage: number, rng: Random)
	local owner = if rng:NextNumber() < 0.5 then "NIGHTSVC" else "KESSLER"
	local cpu = if stage >= 2 then 70 else 101
	local rules = {
		"END processes owned by " .. owner .. ".",
	}
	if cpu <= 100 then
		table.insert(rules, "END any process above " .. cpu .. "% CPU.")
	end
	table.insert(rules, "NEVER end secure_erase.exe or anything owned by SYSTEM.")
	return rules, owner, cpu
end

function ProcessCleanup.newStage(state: any)
	local rng: Random = state.rng
	local s = math.min(state.stage, 3)
	local count = Config.MINIGAMES.ProcessCleanup.processes[s]
	local wantTargets = Config.MINIGAMES.ProcessCleanup.targets[s]
	for _attempt = 1, 60 do
		local rules, owner, cpuLimit = rulesFor(state.stage, rng)
		local procs: { Proc } = {
			{ pid = rng:NextInteger(100, 999), name = "secure_erase.exe", owner = "ADMIN", cpu = rng:NextInteger(20, 95), protected = true, target = false, ended = false },
		}
		local pidBase = rng:NextInteger(1000, 8000)
		for k = 2, count do
			local o = OWNERS[rng:NextInteger(1, #OWNERS)]
			local cpu = rng:NextInteger(1, 99)
			local p: Proc = {
				pid = pidBase + k * 97 + rng:NextInteger(0, 40), -- unique: spacing > jitter
				name = NAMES[rng:NextInteger(1, #NAMES)],
				owner = o,
				cpu = cpu,
				protected = o == "SYSTEM",
				target = false,
				ended = false,
			}
			p.target = not p.protected and (o == owner or cpu > cpuLimit)
			table.insert(procs, p)
		end
		local targets = 0
		for _, p in procs do
			if p.target then
				targets += 1
			end
		end
		if targets == wantTargets then
			-- shuffle display order
			for i = #procs, 2, -1 do
				local j = rng:NextInteger(1, i)
				procs[i], procs[j] = procs[j], procs[i]
			end
			local groups = {}
			for i = 1, targets do
				groups[i] = { name = GROUPS[rng:NextInteger(1, #GROUPS)], unlocked = false, deleted = false }
			end
			state.data = { rules = rules, procs = procs, groups = groups }
			return
		end
	end
	-- deterministic fallback
	local procs: { Proc } = {
		{ pid = 401, name = "secure_erase.exe", owner = "ADMIN", cpu = 40, protected = true, target = false, ended = false },
		{ pid = 1201, name = "nightsync.exe", owner = "NIGHTSVC", cpu = 12, protected = false, target = true, ended = false },
		{ pid = 1202, name = "svchost.exe", owner = "SYSTEM", cpu = 8, protected = true, target = false, ended = false },
		{ pid = 1203, name = "mailq.exe", owner = "NIGHTSVC", cpu = 30, protected = false, target = true, ended = false },
		{ pid = 1204, name = "indexer.exe", owner = "ADMIN", cpu = 5, protected = false, target = false, ended = false },
	}
	state.data = {
		rules = { "END processes owned by NIGHTSVC.", "NEVER end secure_erase.exe or anything owned by SYSTEM." },
		procs = procs,
		groups = { { name = GROUPS[1], unlocked = false, deleted = false }, { name = GROUPS[2], unlocked = false, deleted = false } },
	}
end

function ProcessCleanup.act(state: any, action: string, a: any, _b: any)
	local d = state.data
	if action == "kill" then
		if typeof(a) ~= "number" then
			return { ok = false, kind = "info", message = "Select a process." }
		end
		local proc: Proc? = nil
		for _, p in d.procs do
			if p.pid == a then
				proc = p
			end
		end
		if not proc or proc.ended then
			return { ok = false, kind = "info", message = "That process is not running." }
		end
		if not proc.target then
			-- setback: process restarts and one unlocked group re-locks
			for _, g in d.groups do
				if g.unlocked and not g.deleted then
					g.unlocked = false
					break
				end
			end
			local why = if proc.protected then " is protected" else " is not covered by the rules"
			return { ok = true, kind = "bad", message = proc.name .. why .. ". It restarted and re-locked a group." }
		end
		proc.ended = true
		for _, g in d.groups do
			if not g.unlocked and not g.deleted then
				g.unlocked = true
				return { ok = true, kind = "good", message = proc.name .. " ended. Group " .. g.name .. " unlocked." }
			end
		end
		return { ok = true, kind = "good", message = proc.name .. " ended." }
	elseif action == "purge" then
		if typeof(a) ~= "number" or a ~= math.floor(a) or a < 1 or a > #d.groups then
			return { ok = false, kind = "info", message = "Select a file group." }
		end
		local g = d.groups[a]
		if g.deleted then
			return { ok = false, kind = "info", message = "Already deleted." }
		end
		if not g.unlocked then
			return { ok = false, kind = "info", message = "Locked: a process is still holding these files." }
		end
		g.deleted = true
		for _, other in d.groups do
			if not other.deleted then
				return { ok = true, kind = "good", message = g.name .. " deleted." }
			end
		end
		return { ok = true, kind = "stageClear", message = "All file groups deleted." }
	end
	return { ok = false, kind = "info", message = "Unknown command." }
end

function ProcessCleanup.view(state: any)
	local d = state.data
	local procs = {}
	for _, p in d.procs do
		table.insert(procs, { pid = p.pid, name = p.name, owner = p.owner, cpu = p.cpu, ended = p.ended })
	end
	local groups = {}
	for i, g in d.groups do
		groups[i] = { name = g.name, unlocked = g.unlocked, deleted = g.deleted }
	end
	return { kind = "ProcessCleanup", rules = d.rules, procs = procs, groups = groups }
end

function ProcessCleanup.progress(state: any): number
	local d = state.data
	local score, total = 0, #d.groups * 2
	for _, g in d.groups do
		if g.deleted then
			score += 2
		elseif g.unlocked then
			score += 1
		end
	end
	return score / total
end

function ProcessCleanup.hint(state: any, level: number): (string, any?)
	local d = state.data
	if level >= 2 then
		for _, p in d.procs do
			if p.target and not p.ended then
				return "Hint: " .. p.name .. " (PID " .. p.pid .. ") matches a rule.", p.pid
			end
		end
	end
	return "Hint: compare OWNER and CPU with each rule. SYSTEM processes are protected.", nil
end

return ProcessCleanup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">SectorRepair</string>
            <string name="Source"><![CDATA[--!strict
-- 2. SECTOR REPAIR: swap sectors until the row matches the displayed sequence.
-- Each sector has a number, a letter and a colour (colour is never the only cue).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local LETTERS = { "A", "B", "C", "D", "E", "F", "G", "H" }
local COLORS = { "amber", "teal", "rose", "lime", "violet", "sky", "sand", "slate" }

local SectorRepair = {}
SectorRepair.id = "SectorRepair"
SectorRepair.title = "SecureErase :: Sector Repair"
SectorRepair.instructions = "Damaged sectors are out of order. Select two slots to swap them until the row matches TARGET ORDER."

local function correctCount(d: any): number
	local n = 0
	for i, s in d.current do
		if s == d.target[i] then
			n += 1
		end
	end
	return n
end

function SectorRepair.newStage(state: any)
	local rng: Random = state.rng
	local n = Config.MINIGAMES.SectorRepair.sectors[math.min(state.stage, 3)]
	local pool = {}
	for i = 1, #LETTERS do
		table.insert(pool, { label = string.format("%02d%s", rng:NextInteger(10, 99), LETTERS[i]), color = COLORS[i] })
	end
	-- random target order of n distinct sectors
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local sectors = {}
	local target = {}
	for i = 1, n do
		sectors[i] = pool[i]
		target[i] = i
	end
	local current = table.clone(target)
	repeat
		for i = n, 2, -1 do
			local j = rng:NextInteger(1, i)
			current[i], current[j] = current[j], current[i]
		end
	until correctCount({ current = current, target = target }) <= math.max(1, n // 3)
	state.data.sectors = sectors
	state.data.target = target
	state.data.current = current
	state.data.swaps = 0
end

function SectorRepair.act(state: any, action: string, a: any, b: any)
	local d = state.data
	local n = #d.current
	if action ~= "swap" or typeof(a) ~= "number" or typeof(b) ~= "number" then
		return { ok = false, kind = "info", message = "Select two slots." }
	end
	if a ~= math.floor(a) or b ~= math.floor(b) or a < 1 or b < 1 or a > n or b > n or a == b then
		return { ok = false, kind = "info", message = "Select two different slots." }
	end
	local before = correctCount(d)
	d.current[a], d.current[b] = d.current[b], d.current[a]
	d.swaps += 1
	local after = correctCount(d)
	if after == n then
		return { ok = true, kind = "stageClear", message = "Sector chain rebuilt." }
	end
	if after < before then
		return { ok = true, kind = "bad", message = "That swap broke a sector that was already in place." }
	end
	if after > before then
		return { ok = true, kind = "good", message = string.format("%d / %d sectors aligned.", after, n) }
	end
	return { ok = true, kind = "info", message = "Swapped. No sector aligned yet." }
end

function SectorRepair.view(state: any)
	local d = state.data
	local target = {}
	local current = {}
	for i, idx in d.target do
		target[i] = { label = d.sectors[idx].label, color = d.sectors[idx].color }
	end
	for i, idx in d.current do
		current[i] = { label = d.sectors[idx].label, color = d.sectors[idx].color, ok = idx == d.target[i] }
	end
	return { kind = "SectorRepair", target = target, current = current }
end

function SectorRepair.progress(state: any): number
	return correctCount(state.data) / #state.data.current
end

function SectorRepair.hint(state: any, level: number): (string, any?)
	local d = state.data
	for i, idx in d.current do
		if idx ~= d.target[i] then
			if level >= 2 then
				for j, other in d.current do
					if other == d.target[i] then
						return string.format("Hint: swap slot %d with slot %d.", i, j), { i, j }
					end
				end
			end
			return string.format("Hint: slot %d should hold sector %s.", i, d.sectors[d.target[i]].label), nil
		end
	end
	return "Hint: match each slot to the TARGET ORDER above it.", nil
end

return SectorRepair
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">SignalRouting</string>
            <string name="Source"><![CDATA[--!strict
-- 3. SIGNAL ROUTING: rotate tiles to carry the purge signal from IN (left
-- edge) to OUT (right edge). Puzzles are generated from a known solvable path
-- and then scrambled, so every layout is solvable by construction.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

-- directions: 1 = N, 2 = E, 3 = S, 4 = W
local DX = { 0, 1, 0, -1 }
local DY = { -1, 0, 1, 0 }
local BASE: { [string]: { number } } = {
	I = { 1, 3 },
	L = { 1, 2 },
	T = { 1, 2, 3 },
}

local function opposite(d: number): number
	return (d + 1) % 4 + 1
end

local function rotateDir(d: number, r: number): number
	return (d - 1 + r) % 4 + 1
end

local function connects(tile: any, dir: number): boolean
	for _, d in BASE[tile.kind] do
		if rotateDir(d, tile.rot) == dir then
			return true
		end
	end
	return false
end

local function idx(w: number, x: number, y: number): number
	return (y - 1) * w + x
end

local function powered(d: any): ({ [number]: boolean }, boolean)
	local w, h = d.w, d.h
	local lit: { [number]: boolean } = {}
	local start = idx(w, 1, d.inRow)
	if not connects(d.tiles[start], 4) then
		return lit, false
	end
	local queue = { { 1, d.inRow } }
	lit[start] = true
	local reached = false
	while #queue > 0 do
		local cur = table.remove(queue, 1) :: { number }
		local x, y = cur[1], cur[2]
		local t = d.tiles[idx(w, x, y)]
		if x == w and y == d.outRow and connects(t, 2) then
			reached = true
		end
		for dir = 1, 4 do
			if connects(t, dir) then
				local nx, ny = x + DX[dir], y + DY[dir]
				if nx >= 1 and nx <= w and ny >= 1 and ny <= h then
					local ni = idx(w, nx, ny)
					if not lit[ni] and connects(d.tiles[ni], opposite(dir)) then
						lit[ni] = true
						table.insert(queue, { nx, ny })
					end
				end
			end
		end
	end
	return lit, reached
end

local SignalRouting = {}
SignalRouting.id = "SignalRouting"
SignalRouting.title = "SecureErase :: Signal Router"
SignalRouting.instructions = "Click a tile to rotate it. Connect the purge signal from IN on the left to OUT on the right. Lit tiles carry the signal."

-- random self-avoiding walk from the left edge to the right edge
local function makePath(rng: Random, w: number, h: number, inRow: number): { { number } }?
	local path = { { 1, inRow } }
	local seen: { [number]: boolean } = { [idx(w, 1, inRow)] = true }
	local guard = 0
	while guard < 400 do
		guard += 1
		local cur = path[#path]
		if cur[1] == w then
			return path
		end
		local options = {}
		for dir = 1, 3 do -- N, E, S (never west keeps paths short and readable)
			local nx, ny = cur[1] + DX[dir], cur[2] + DY[dir]
			if nx >= 1 and nx <= w and ny >= 1 and ny <= h and not seen[idx(w, nx, ny)] then
				local weight = if dir == 2 then 2 else 1
				for _ = 1, weight do
					table.insert(options, { nx, ny })
				end
			end
		end
		if #options == 0 then
			return nil
		end
		local nxt = options[rng:NextInteger(1, #options)]
		seen[idx(w, nxt[1], nxt[2])] = true
		table.insert(path, nxt)
	end
	return nil
end

local function tileFor(need: { number }): (string, number)
	local a, b = need[1], need[2]
	if opposite(a) == b then
		return "I", if a == 1 or a == 3 then 0 else 1
	end
	-- corner: find rotation r such that {N,E} rotated = {a,b}
	for r = 0, 3 do
		local c1, c2 = rotateDir(1, r), rotateDir(2, r)
		if (c1 == a and c2 == b) or (c1 == b and c2 == a) then
			return "L", r
		end
	end
	return "I", 0
end

function SignalRouting.newStage(state: any)
	local rng: Random = state.rng
	local size = Config.MINIGAMES.SignalRouting.grid[math.min(state.stage, 3)]
	local w, h = size[1], size[2]
	local inRow = rng:NextInteger(1, h)
	local found: { { number } }? = nil
	while not found do
		found = makePath(rng, w, h, inRow)
	end
	local path = found :: { { number } }
	local outRow = path[#path][2]
	local tiles = {}
	local onPath: { [number]: boolean } = {}
	for i, cell in path do
		local x, y = cell[1], cell[2]
		local need = {}
		if i == 1 then
			table.insert(need, 4)
		else
			local p = path[i - 1]
			for dir = 1, 4 do
				if x + DX[dir] == p[1] and y + DY[dir] == p[2] then
					table.insert(need, dir)
				end
			end
		end
		if i == #path then
			table.insert(need, 2)
		else
			local n = path[i + 1]
			for dir = 1, 4 do
				if x + DX[dir] == n[1] and y + DY[dir] == n[2] then
					table.insert(need, dir)
				end
			end
		end
		local kind, rot = tileFor(need)
		tiles[idx(w, x, y)] = { kind = kind, rot = rot }
		onPath[idx(w, x, y)] = true
	end
	local kinds = { "I", "L", "T", "L" }
	for y = 1, h do
		for x = 1, w do
			local i = idx(w, x, y)
			if not tiles[i] then
				tiles[i] = { kind = kinds[rng:NextInteger(1, #kinds)], rot = rng:NextInteger(0, 3) }
			end
		end
	end
	-- remember solved orientation masks, then scramble until unsolved
	local solved = {}
	for i, t in tiles do
		solved[i] = { kind = t.kind, rot = t.rot }
	end
	state.data = { w = w, h = h, inRow = inRow, outRow = outRow, tiles = tiles, solved = solved, onPath = onPath, rotations = 0 }
	repeat
		for _, t in tiles do
			t.rot = (t.rot + rng:NextInteger(0, 3)) % 4
		end
		local _, done = powered(state.data)
	until not done
end

local function tileCorrect(d: any, i: number): boolean
	local t, s = d.tiles[i], d.solved[i]
	for dir = 1, 4 do
		if connects(t, dir) ~= connects(s, dir) then
			return false
		end
	end
	return true
end

function SignalRouting.act(state: any, action: string, a: any, _b: any)
	local d = state.data
	if action ~= "rotate" or typeof(a) ~= "number" or a ~= math.floor(a) or a < 1 or a > d.w * d.h then
		return { ok = false, kind = "info", message = "Click a tile to rotate it." }
	end
	local wasCorrect = d.onPath[a] and tileCorrect(d, a)
	d.tiles[a].rot = (d.tiles[a].rot + 1) % 4
	d.rotations += 1
	local _, done = powered(d)
	if done then
		return { ok = true, kind = "stageClear", message = "Purge signal routed." }
	end
	if wasCorrect and not tileCorrect(d, a) and d.rotations > d.w * d.h then
		return { ok = true, kind = "bad", message = "Signal path broken. Follow the lit tiles." }
	end
	return { ok = true, kind = "info", message = "" }
end

function SignalRouting.view(state: any)
	local d = state.data
	local lit = powered(d)
	local tiles = {}
	for i, t in d.tiles do
		tiles[i] = { kind = t.kind, rot = t.rot, lit = lit[i] == true }
	end
	return { kind = "SignalRouting", w = d.w, h = d.h, inRow = d.inRow, outRow = d.outRow, tiles = tiles }
end

function SignalRouting.progress(state: any): number
	local d = state.data
	local total, good = 0, 0
	for i in d.onPath do
		total += 1
		if tileCorrect(d, i) then
			good += 1
		end
	end
	return if total > 0 then good / total * 0.95 else 0
end

function SignalRouting.hint(state: any, level: number): (string, any?)
	local d = state.data
	if level >= 2 then
		local first: number? = nil
		for y = 1, d.h do
			for x = 1, d.w do
				local i = idx(d.w, x, y)
				if d.onPath[i] and not tileCorrect(d, i) and (first == nil or x < ((first - 1) % d.w) + 1) then
					first = i
				end
			end
		end
		if first then
			return "Hint: the highlighted tile is on the route but turned the wrong way.", first
		end
	end
	return string.format("Hint: the signal enters on row %d and must leave on row %d.", d.inRow, d.outRow), nil
end

return SignalRouting
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="142">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">Cheats</string>
            <string name="Source"><![CDATA[--!strict
-- QA cheats. Authorised only in Studio or for allow-listed developer UserIds;
-- the gate is checked server-side in every call. Cheats call the same system
-- APIs as real gameplay so QA exercises the real code paths.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Net = require(ReplicatedStorage.Shared.Net)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Minigames = require(Server.Minigames)
local GameState = require(script.Parent.GameState)
local Drives = require(script.Parent.Drives)
local Power = require(script.Parent.Power)
local Doors = require(script.Parent.Doors)
local Workstation = require(script.Parent.Workstation)
local Threat = require(script.Parent.Threat)
local PlayerStatus = require(script.Parent.PlayerStatus)
local Checkpoints = require(script.Parent.Checkpoints)
local Finale = require(script.Parent.Finale)
local EventDirector = require(script.Parent.EventDirector)

local Cheats = {}

local function authorized(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	return Config.DEV_USER_IDS[player.UserId] == true
end

local TELEPORTS: { [string]: Vector3 } = {
	office = Vector3.new(12, 3, 9),
	workstation = Vector3.new(15.5, 3, -7.5),
	kitchen = Vector3.new(-26, 3, -8),
	hall = Vector3.new(28, 3, 6),
	alley = Vector3.new(45, 3, 6),
	lobby = Vector3.new(12, 3, 19),
	rack = Vector3.new(10.4, 3, -10),
}

-- Finish the docked job through the minigame wrapper (QA shortcut).
local function completeDocked(): boolean
	local d = Drives.dockDrive()
	if not d then
		return false
	end
	if d.state == "Docked" then
		Drives.beginProcessing(d)
	end
	if d.job then
		d.job.complete = true
		return Drives.markErased(d)
	end
	return false
end

-- A simulated second actor for Studio authority tests. It is NOT a real
-- network client; it only has what the server logic reads from a Player.
local function fakeActor(name: string, pos: Vector3): any
	local attrs: { [string]: any } = {}
	local character = Instance.new("Model")
	character.Name = name
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Anchored = true
	root.Transparency = 1
	root.CFrame = CFrame.new(pos)
	root.Parent = character
	local h = Instance.new("Humanoid")
	h.Parent = character
	character.Parent = workspace
	local actor = {
		Name = name,
		DisplayName = name,
		UserId = -1,
		Parent = Players,
		Character = character,
	}
	function actor.GetAttribute(_self: any, k: string)
		return attrs[k]
	end
	function actor.SetAttribute(_self: any, k: string, v: any)
		attrs[k] = v
	end
	function actor.Destroy(self: any)
		Guard.forget(self)
		character:Destroy()
	end
	return actor
end

local commands: { [string]: (player: Player, arg: any) -> string } = {
	-- two actors try to take the same drive in the same frame
	raceDrive = function(player)
		local target = nil
		for _, d in Drives.list do
			if d.state == "Installed" then
				target = d
				break
			end
		end
		if not target then
			return "no installed drive"
		end
		target.pcOff = true
		local root = Guard.rootOf(player)
		local fake = fakeActor("SimActor", if root then root.Position + Vector3.new(2, 0, 0) else Vector3.new(0, 3, 0))
		local a = Drives.pickup(player, target)
		local b = Drives.pickup(fake :: any, target)
		local owner = if target.carrier == player then "real" elseif target.carrier == fake then "sim" else "none"
		Drives.recoverFor(player, "QA")
		Drives.recoverFor(fake :: any, "QA")
		fake:Destroy()
		return string.format("real=%s sim=%s owner=%s state=%s (exactly one must win)", tostring(a), tostring(b), owner, target.state)
	end,
	-- a second actor (not seated) sends desktop actions with the live session id
	secondOperator = function(player)
		local op = Workstation.operator()
		if op ~= player then
			return "sit at the workstation first"
		end
		local d = Drives.dockDrive()
		local before = if d and d.job then d.job.actions else -1
		local fake = fakeActor("SimActor2", Vector3.new(16, 3, -7))
		Workstation.handleDesktop(fake, Workstation.sessionId(), "act", "press", 1, nil)
		Workstation.handleDesktop(fake, Workstation.sessionId(), "start", nil, nil, nil)
		local after = if d and d.job then d.job.actions else -1
		local stillOp = Workstation.operator() == player
		fake:Destroy()
		return string.format("actions before=%d after=%d operator unchanged=%s (sim actor must be rejected)", before, after, tostring(stillOp))
	end,
	-- the real operator replays an action with an outdated session id
	staleSession = function(player)
		local d = Drives.dockDrive()
		local before = if d and d.job then d.job.actions else -1
		Workstation.handleDesktop(player, Workstation.sessionId() - 1, "act", "press", 1, nil)
		local after = if d and d.job then d.job.actions else -1
		return string.format("stale action: actions before=%d after=%d (must be equal)", before, after)
	end,
	state = function()
		local s = EventDirector.debugState()
		return string.format("phase=%s erased=%d active=%s nextRoll=%.0f recovery=%.0f threat=%s", GameState.phase, GameState.data.erased, table.concat(s.active, ","), s.nextRollIn, s.recoveryFor, Threat.mode())
	end,
	log = function()
		return table.concat(EventDirector.debugState().log, "\n")
	end,
	erase = function()
		return if completeDocked() then "erased docked drive" else "no docked drive"
	end,
	eraseAll = function(_p, n)
		local count = if typeof(n) == "number" then n else 6
		for _, d in Drives.list do
			if Drives.erasedCount() >= count then
				break
			end
			if d.state ~= "Erased" then
				local busy = Drives.dockDrive()
				if busy and busy ~= d then
					completeDocked()
				end
				-- move through the real state machine
				d.pcOff = true
				d.state = "Docked"
				Drives.beginProcessing(d)
				if d.job then
					d.job.complete = true
					Drives.markErased(d)
				end
			end
		end
		return "erased=" .. Drives.erasedCount()
	end,
	event = function(_p, id)
		return if typeof(id) == "string" and EventDirector.trigger(id) then "started " .. id else "could not start"
	end,
	power = function()
		Power.trip({ "MAIN" })
		return "MAIN tripped"
	end,
	door = function()
		Doors.set("Ajar")
		return "door ajar"
	end,
	hunt = function()
		Threat.hunt(15)
		return "hunting"
	end,
	finale = function()
		Finale.debugBeginFinalPurge()
		return "final purge"
	end,
	signoff = function(_p, p)
		Finale.debugBeginSignOff(if typeof(p) == "number" then p else 0.9)
		return "sign-off"
	end,
	clockout = function()
		Finale.debugBeginClockOut()
		return "clock out"
	end,
	down = function(player)
		PlayerStatus.down(player, "cheat")
		return "downed"
	end,
	restore = function()
		task.spawn(Checkpoints.restore, "cheat")
		return "restoring"
	end,
	tp = function(player, where)
		local pos = if typeof(where) == "string" then TELEPORTS[where] else nil
		local root = Guard.rootOf(player)
		if pos and root then
			root.CFrame = CFrame.new(pos)
			return "teleported"
		end
		return "unknown place"
	end,
	solve = function()
		-- performs one CORRECT semantic action via the minigame API (tests validation path)
		local d = Drives.dockDrive()
		if not d or not d.job then
			return "no job"
		end
		local s = d.job.state
		local data = s.data
		local res
		if d.game == "FileSort" then
			for _, f in data.files do
				if not f.bin then
					res = Minigames.perform(d.job, "sort", f.id, f.target)
					break
				end
			end
		elseif d.game == "Checksum" then
			res = Minigames.perform(d.job, "match", data.answer, nil)
		elseif d.game == "MemorySequence" then
			res = Minigames.perform(d.job, "press", data.seq[data.input + 1], nil)
		elseif d.game == "SectorRepair" then
			for i, idx in data.current do
				if idx ~= data.target[i] then
					for j, other in data.current do
						if other == data.target[i] then
							res = Minigames.perform(d.job, "swap", i, j)
							break
						end
					end
					break
				end
			end
		elseif d.game == "ProcessCleanup" then
			for gi, g in data.groups do
				if g.unlocked and not g.deleted then
					res = Minigames.perform(d.job, "purge", gi, nil)
					break
				end
			end
			if not res then
				for _, p in data.procs do
					if p.target and not p.ended then
						res = Minigames.perform(d.job, "kill", p.pid, nil)
						break
					end
				end
			end
		elseif d.game == "SignalRouting" then
			for i, t in data.tiles do
				local sol = data.solved[i]
				if data.onPath[i] then
					local okNow = true
					for _ = 1, 4 do
						-- rotate until this path tile matches its solved connections
						local same = true
						for dir = 1, 4 do
							local function conn(tile: any, dd: number): boolean
								local base = ({ I = { 1, 3 }, L = { 1, 2 }, T = { 1, 2, 3 } })[tile.kind]
								for _, b in base do
									if (b - 1 + tile.rot) % 4 + 1 == dd then
										return true
									end
								end
								return false
							end
							if conn(t, dir) ~= conn(sol, dir) then
								same = false
							end
						end
						if same then
							break
						end
						okNow = false
						res = Minigames.perform(d.job, "rotate", i, nil)
					end
					if not okNow then
						break
					end
				end
			end
		end
		if d.job.complete then
			Drives.markErased(d)
		end
		Workstation.push()
		return if res then res.kind .. ": " .. res.message else "nothing to do"
	end,
}

function Cheats.init()
	Net.remote("Cheat").OnServerEvent:Connect(function(player, cmd: unknown, arg: unknown)
		if not authorized(player) then
			return
		end
		local rate = Config.RATE.cheat
		if not Guard.allow(player, "cheat", rate[1], rate[2]) then
			return
		end
		if typeof(cmd) ~= "string" then
			return
		end
		local fn = commands[cmd :: string]
		if fn then
			local ok, out = pcall(fn, player, arg)
			GameState.notify(player, "[cheat] " .. tostring(out), "info")
			print("[Cheat]", player.Name, cmd, ok, out)
		end
	end)
	-- Studio-only QA hook: a BindableFunction in ServerStorage lets test
	-- scripts in the Studio server context drive the LIVE systems (requiring
	-- modules from the command bar would create separate copies). Never
	-- created outside Studio; not reachable from clients.
	if RunService:IsStudio() then
		local bf = Instance.new("BindableFunction")
		bf.Name = "NightShiftQA"
		bf.OnInvoke = function(cmd: string, arg: any, userId: number?)
			local player = if userId then Players:GetPlayerByUserId(userId) else Players:GetPlayers()[1]
			local fn = commands[cmd]
			if not fn or not player then
				return "no such command/player"
			end
			local ok, out = pcall(fn, player, arg)
			return (if ok then "" else "ERR ") .. tostring(out)
		end
		bf.Parent = game:GetService("ServerStorage")
	end
	local _l = Layout
end

-- Exposed for in-place server QA scripts run by the developer in Studio.
Cheats.commands = commands
Cheats.authorized = authorized

return Cheats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">Checkpoints</string>
            <string name="Source"><![CDATA[--!strict
-- Team checkpoints: saved after every erased drive, before the finale and at
-- each sign-off milestone. Restoring clears every active event, resets power
-- and doors, revives and respawns the team and grants a recovery window.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)
local GameState = require(script.Parent.GameState)
local Drives = require(script.Parent.Drives)
local Power = require(script.Parent.Power)
local Doors = require(script.Parent.Doors)
local Workstation = require(script.Parent.Workstation)
local PlayerStatus = require(script.Parent.PlayerStatus)

local Checkpoints = {}

-- Fired before state is restored; systems with transient state (events,
-- threat, finale timers) clean themselves up here.
Checkpoints.Restoring = Signal.new() :: Signal.Signal<any>
Checkpoints.Restored = Signal.new() :: Signal.Signal<any>

export type Checkpoint = {
	label: string,
	phase: Types.Phase,
	drives: { Drives.SavedDrive },
	fragments: { number },
	extra: { [string]: any },
}

local latest: Checkpoint? = nil
local restoring = false

-- `extra` lets the finale store its own progress (purge, sign-off).
function Checkpoints.save(label: string, extra: { [string]: any }?)
	latest = {
		label = label,
		-- the briefing is a one-off intro: restoring always resumes work
		phase = if GameState.phase == "Briefing" then "Work" else GameState.phase :: Types.Phase,
		drives = Drives.serialize(),
		fragments = table.clone(GameState.data.fragments),
		extra = extra or {},
	}
	GameState.data.checkpoints += 1
	GameState.markDirty()
	GameState.fx("CheckpointSaved", { label = label })
end

function Checkpoints.latest(): Checkpoint?
	return latest
end

function Checkpoints.isRestoring(): boolean
	return restoring
end

function Checkpoints.restore(reason: string)
	if restoring then
		return
	end
	restoring = true
	GameState.fx("Restore", { reason = reason })
	task.wait(1.2) -- let the fade cover the reset
	local cp = latest -- read after the fade so nothing saved during it is lost
	Checkpoints.Restoring:Fire(cp)
	local op = Workstation.operator()
	if op then
		Workstation.kick(op, "restore")
	end
	GameState.clearThreats()
	Power.resetAll()
	Doors.set("Latched")
	if cp then
		Drives.restore(cp.drives)
		GameState.data.fragments = table.clone(cp.fragments)
		GameState.setPhase(cp.phase)
	end
	PlayerStatus.respawnAll()
	GameState.notify(nil, "Checkpoint restored: " .. (if cp then cp.label else "start of shift") .. ".", "info")
	GameState.markDirty()
	restoring = false
	Checkpoints.Restored:Fire(cp)
end

function Checkpoints.init()
	PlayerStatus.TeamWiped:Connect(function(reason)
		Checkpoints.restore(reason)
	end)
	GameState.RoundReset:Connect(function()
		latest = nil
		task.delay(1.5, function()
			Checkpoints.save("start of shift")
			GameState.data.checkpoints = 0
		end)
	end)
end

function Checkpoints.start()
	-- the start of the shift is the first checkpoint
	task.wait(1)
	Checkpoints.save("start of shift")
	GameState.data.checkpoints = 0
end

return Checkpoints
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">Doors</string>
            <string name="Source"><![CDATA[--!strict
-- Rear service door (Latched / Ajar / Open) and the front exit doors.
-- Any non-latched rear door is an unresolved threat the director tracks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)
local Server = script.Parent.Parent
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)

type DoorState = Types.DoorState

local Doors = {}

local state: DoorState = "Latched"
local unsecuredSince: number? = nil
local prompt: ProximityPrompt
local tween: Tween?
local locked = false -- while the figure holds the door (never blocks latching for long)

Doors.Changed = Signal.new() :: Signal.Signal<DoorState, DoorState, Player?>

local ANGLE: { [DoorState]: number } = { Latched = 0, Ajar = 24, Open = 100 }

function Doors.state(): DoorState
	return state
end

function Doors.unsecuredFor(): number
	return if unsecuredSince then os.clock() - unsecuredSince else 0
end

local function updatePrompt()
	if state == "Latched" then
		prompt.ActionText = "Open door"
		prompt.HoldDuration = 0.3
	else
		prompt.ActionText = "Close & latch"
		prompt.HoldDuration = 1.0
	end
	prompt.Enabled = not locked
end

local function place(animated: boolean)
	local refs = MapBuilder.refs
	local RD = refs.rearDoor
	local width = RD.Size.Z + 0.1
	local height = RD.Size.Y + 0.05
	local target = refs.rearDoorHinge * CFrame.Angles(0, math.rad(ANGLE[state]), 0) * CFrame.new(0, height / 2, width / 2)
	if tween then
		tween:Cancel()
	end
	RD.CanCollide = state == "Latched"
	if animated then
		local t = TweenService:Create(RD, TweenInfo.new(if state == "Latched" then 0.35 else 0.9, Enum.EasingStyle.Quad), { CFrame = target })
		tween = t
		t:Play()
	else
		RD.CFrame = target
	end
	local light = refs.doorLight
	local color = if state == "Latched" then Color3.fromRGB(60, 255, 90) else Color3.fromRGB(255, 50, 40)
	light.Color = color
	light:SetAttribute("Alert", state ~= "Latched")
	local pl = light:FindFirstChildOfClass("PointLight")
	if pl then
		pl.Color = color
	end
end

function Doors.set(new: DoorState, by: Player?)
	local old: DoorState = state :: DoorState
	if old == new then
		return
	end
	state = new
	if new == "Latched" then
		unsecuredSince = nil
		GameState.setThreat("door", nil)
		GameState.fx("DoorLatched", nil)
	else
		if not unsecuredSince then
			unsecuredSince = os.clock()
		end
		GameState.setThreat("door", if new == "Ajar" then "Rear door unlatched" else "Rear door open", true, "Rear door")
		GameState.fx(if new == "Ajar" then "DoorUnlatched" else "DoorOpened", nil)
	end
	place(true)
	updatePrompt()
	GameState.markDirty()
	Doors.Changed:Fire(new, old, by)
end

function Doors.setLocked(v: boolean)
	locked = v
	updatePrompt()
end

function Doors.openFront()
	if GameState.data.frontDoorOpen then
		return
	end
	GameState.data.frontDoorOpen = true
	for i, door in MapBuilder.refs.frontDoors do
		door.CanCollide = false
		local dir = if i == 1 then -1 else 1
		TweenService:Create(door, TweenInfo.new(1.4, Enum.EasingStyle.Sine), {
			CFrame = door.CFrame * CFrame.new(dir * (door.Size.X - 0.2), 0, 0),
		}):Play()
	end
	GameState.fx("FrontDoorOpen", nil)
	GameState.markDirty()
end

function Doors.closeFront()
	GameState.data.frontDoorOpen = false
	local FD = require(ReplicatedStorage.Shared.Layout).FRONT_DOOR
	local half = (FD.maxX - FD.minX) / 2
	for i, door in MapBuilder.refs.frontDoors do
		door.CanCollide = true
		door.CFrame = CFrame.new(FD.minX + (i - 1) * half + half / 2, FD.height / 2, FD.z + 0.5)
	end
end

function Doors.init()
	GameState.providers.door = Doors.state
	prompt = Prompts.make(MapBuilder.refs.doorPromptPart, {
		action = "Open door",
		object = "Rear door",
		hold = 0.3,
		distance = 9,
	})
	prompt.Triggered:Connect(function(player)
		if not Prompts.valid(player, prompt) then
			return
		end
		if state == "Latched" then
			Doors.set("Open", player)
		else
			Doors.set("Latched", player)
		end
	end)
	GameState.RoundReset:Connect(function()
		locked = false
		state = "Ajar"
		Doors.set("Latched")
		Doors.closeFront()
	end)
	place(false)
	updatePrompt()
end

return Doors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">Drives</string>
            <string name="Source"><![CDATA[--!strict
-- Hard drives. The server is the only authority on each drive's state:
--   Installed -> Carried -> Staged -> Docked -> Processing -> Erased
-- Every transition goes through `transition()`, which checks the current
-- state, so duplicate pickups, double owners, removing an in-use drive and
-- repeated completion rewards are impossible by construction.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Fonts = require(ReplicatedStorage.Shared.Fonts)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)
local Server = script.Parent.Parent
local Prompts = require(Server.Util.Prompts)
local Guard = require(Server.Util.Guard)
local Minigames = require(Server.Minigames)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)

type DriveState = Types.DriveState

export type Drive = {
	id: string,
	name: string,
	color: Color3,
	desk: number,
	state: DriveState,
	carrier: Player?,
	slot: number?,
	game: string,
	job: Minigames.Job?,
	pcOff: boolean,
	part: BasePart,
	labelText: TextLabel,
	led: BasePart,
	prompt: ProximityPrompt,
}

local Drives = {}

Drives.list = {} :: { Drive }
Drives.byId = {} :: { [string]: Drive }
Drives.Erased = Signal.new() :: Signal.Signal<Drive, number>
Drives.StateChanged = Signal.new() :: Signal.Signal<Drive, DriveState, DriveState>
Drives.Docked = Signal.new() :: Signal.Signal<Drive>

local pcPrompts: { ProximityPrompt } = {}
local rackPrompt: ProximityPrompt
local dockPrompt: ProximityPrompt
local roundRng = Random.new()

local function setCarrying(player: Player, what: string?)
	player:SetAttribute("Carrying", what)
end

local function carrying(player: Player): string?
	local v = player:GetAttribute("Carrying")
	return if typeof(v) == "string" then v else nil
end
Drives.carrying = carrying

function Drives.dockDrive(): Drive?
	for _, d in Drives.list do
		if d.state == "Docked" or d.state == "Processing" then
			return d
		end
	end
	return nil
end

local function freeSlot(kind: "staging" | "erased"): number
	local used: { [number]: boolean } = {}
	for _, d in Drives.list do
		if d.slot and ((kind == "staging" and d.state == "Staged") or (kind == "erased" and d.state == "Erased")) then
			used[d.slot] = true
		end
	end
	for i = 1, 6 do
		if not used[i] then
			return i
		end
	end
	return 1
end

local function detachFromCarrier(d: Drive)
	for _, c in d.part:GetChildren() do
		if c:IsA("WeldConstraint") or c:IsA("Weld") then
			c:Destroy()
		end
	end
	d.part.Anchored = true
	if d.carrier then
		setCarrying(d.carrier, nil)
	end
	d.carrier = nil
end

local function refreshVisual(d: Drive)
	local refs = MapBuilder.refs
	if d.state == "Installed" then
		d.part.Transparency = 0
		d.part.CFrame = refs.drivePlace[d.desk]
		refs.sourceLeds[d.desk].Color = if d.pcOff then Color3.fromRGB(255, 170, 40) else Color3.fromRGB(80, 255, 120)
	else
		refs.sourceLeds[d.desk].Color = Color3.fromRGB(30, 30, 30)
	end
	if d.state == "Staged" and d.slot then
		d.part.CFrame = refs.stagingSlots[d.slot]
	elseif d.state == "Erased" and d.slot then
		d.part.CFrame = refs.erasedSlots[d.slot]
	elseif d.state == "Docked" or d.state == "Processing" then
		d.part.CFrame = refs.dock.CFrame * CFrame.new(0, 0.2, -0.55) * CFrame.Angles(math.rad(90), 0, 0)
	end
	local erased = d.state == "Erased"
	d.labelText.Text = if erased then d.id .. "\nERASED" else d.id .. "\n" .. d.name
	d.labelText.BackgroundColor3 = if erased then Color3.fromRGB(40, 150, 70) else d.color
	d.led.Color = if erased
		then Color3.fromRGB(60, 255, 90)
		elseif d.state == "Processing" then Color3.fromRGB(255, 190, 40)
		else Color3.fromRGB(255, 60, 50)
	d.part:SetAttribute("State", d.state)
	-- prompt on the drive itself: only for taking a staged drive
	d.prompt.Enabled = d.state == "Staged"
end

local function refreshPrompts()
	for i, prompt in pcPrompts do
		local d: Drive? = nil
		for _, x in Drives.list do
			if x.desk == i then
				d = x
			end
		end
		if d and d.state == "Installed" then
			prompt.Enabled = true
			prompt.ActionText = if d.pcOff then "Collect drive" else "Shut down PC"
			prompt.ObjectText = d.id
			prompt.HoldDuration = if d.pcOff then 1.0 else 0.8
		else
			prompt.Enabled = false
		end
	end
	local docked = Drives.dockDrive()
	if not docked then
		dockPrompt.Enabled = true
		dockPrompt.ActionText = "Dock drive"
		dockPrompt.ObjectText = "Workstation dock"
	elseif docked.state == "Docked" then
		dockPrompt.Enabled = true
		dockPrompt.ActionText = "Eject drive"
		dockPrompt.ObjectText = docked.id
	else
		dockPrompt.Enabled = false
	end
	rackPrompt.Enabled = true
end

local function transition(d: Drive, from: { DriveState }, to: DriveState): boolean
	if not table.find(from, d.state) then
		return false
	end
	local old: DriveState = d.state :: DriveState
	d.state = to
	refreshVisual(d)
	refreshPrompts()
	GameState.markDirty()
	Drives.StateChanged:Fire(d, old, to)
	return true
end

local function attachTo(d: Drive, player: Player): boolean
	local root = Guard.rootOf(player)
	if not root then
		return false
	end
	d.part.Anchored = false
	d.part.CFrame = root.CFrame * CFrame.new(0.6, -0.3, -1.3) * CFrame.Angles(math.rad(-20), 0, 0)
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = d.part
	w.Parent = d.part
	d.carrier = player
	setCarrying(player, d.id)
	pcall(function()
		d.part:SetNetworkOwner(player)
	end)
	return true
end

-- Return a drive to the recovery rack (carrier left, died, downed or the
-- drive fell out of the map). Never loses a drive or its job progress.
function Drives.recover(d: Drive, reason: string?)
	if d.state ~= "Carried" then
		return
	end
	detachFromCarrier(d)
	d.slot = freeSlot("staging")
	transition(d, { "Carried" }, "Staged")
	GameState.notify(nil, d.id .. " returned to the drive rack" .. (if reason then " (" .. reason .. ")" else "") .. ".", "info")
end

function Drives.recoverFor(player: Player, reason: string?)
	for _, d in Drives.list do
		if d.carrier == player then
			Drives.recover(d, reason)
		end
	end
end

function Drives.pickup(player: Player, d: Drive): boolean
	if carrying(player) then
		GameState.notify(player, "Your hands are full.", "bad")
		return false
	end
	if d.state == "Installed" then
		if not d.pcOff then
			return false
		end
	elseif d.state ~= "Staged" then
		return false
	end
	local from: DriveState = d.state :: DriveState
	if not transition(d, { from }, "Carried") then
		return false
	end
	if not attachTo(d, player) then
		-- could not attach (no character): roll back to a safe state
		d.state = from
		refreshVisual(d)
		refreshPrompts()
		return false
	end
	d.slot = nil
	return true
end

function Drives.stage(player: Player): boolean
	local id = carrying(player)
	local d = id and Drives.byId[id]
	if not d or d.carrier ~= player or d.state ~= "Carried" then
		return false
	end
	detachFromCarrier(d)
	d.slot = freeSlot("staging")
	return transition(d, { "Carried" }, "Staged")
end

function Drives.dock(player: Player): boolean
	local id = carrying(player)
	local d = id and Drives.byId[id]
	if not d or d.carrier ~= player or d.state ~= "Carried" then
		return false
	end
	if Drives.dockDrive() then
		GameState.notify(player, "The dock is busy. Stage the drive on the rack.", "bad")
		return false
	end
	detachFromCarrier(d)
	if transition(d, { "Carried" }, "Docked") then
		GameState.fx("DriveDocked", { id = d.id })
		Drives.Docked:Fire(d)
		return true
	end
	return false
end

function Drives.eject(player: Player): boolean
	local d = Drives.dockDrive()
	if not d or d.state ~= "Docked" or carrying(player) then
		return false
	end
	if not transition(d, { "Docked" }, "Carried") then
		return false
	end
	if not attachTo(d, player) then
		d.state = "Docked"
		refreshVisual(d)
		refreshPrompts()
		return false
	end
	return true
end

-- Called by the workstation when the operator starts/resumes SecureErase.
function Drives.beginProcessing(d: Drive): Minigames.Job?
	if d.state == "Processing" then
		return d.job
	end
	if d.state ~= "Docked" then
		return nil
	end
	if not d.job then
		d.job = Minigames.newJob(d.game, GameState.isSolo(), roundRng:NextInteger(1, 2 ^ 30))
	end
	transition(d, { "Docked" }, "Processing")
	return d.job
end

-- Only reachable when the minigame logic itself reports completion.
function Drives.markErased(d: Drive): boolean
	if not d.job or not d.job.complete then
		return false
	end
	if d.state ~= "Processing" then
		return false
	end
	d.slot = freeSlot("erased")
	if not transition(d, { "Processing" }, "Erased") then
		return false
	end
	local count = 0
	for _, x in Drives.list do
		if x.state == "Erased" then
			count += 1
		end
	end
	GameState.data.erased = count
	GameState.markDirty()
	GameState.fx("DriveErased", { id = d.id, count = count })
	Drives.Erased:Fire(d, count)
	return true
end

function Drives.erasedCount(): number
	local n = 0
	for _, d in Drives.list do
		if d.state == "Erased" then
			n += 1
		end
	end
	return n
end

function Drives.snapshot(): { Types.DriveSnapshot }
	local out = {}
	for _, d in Drives.list do
		local job = d.job
		local title: string? = nil
		local g = Minigames.get(d.game)
		if g then
			title = g.title
		end
		table.insert(out, {
			id = d.id,
			name = d.name,
			state = d.state,
			game = d.game,
			gameTitle = title,
			progress = if job then Minigames.progress(job) elseif d.state == "Erased" then 1 else 0,
			stage = if job then job.state.stage else 0,
			stages = if job then job.state.stages else 0,
			carrier = if d.carrier then d.carrier.DisplayName else nil,
			desk = d.desk,
		})
	end
	return out
end

-- Checkpoint support --------------------------------------------------------

export type SavedDrive = { id: string, state: DriveState, slot: number?, pcOff: boolean, job: Minigames.Job?, game: string }

function Drives.serialize(): { SavedDrive }
	local out = {}
	for _, d in Drives.list do
		local state: DriveState = d.state :: DriveState
		local slot = d.slot
		if state == "Carried" then
			state = "Staged"
			slot = nil
		end
		table.insert(out, {
			id = d.id,
			state = state,
			slot = slot,
			pcOff = d.pcOff,
			job = if d.job then Minigames.deepCopy(d.job) else nil,
			game = d.game,
		})
	end
	return out
end

function Drives.restore(saved: { SavedDrive })
	for _, s in saved do
		local d = Drives.byId[s.id]
		if d then
			detachFromCarrier(d)
			d.state = s.state
			d.pcOff = s.pcOff
			d.game = s.game
			d.job = if s.job then Minigames.deepCopy(s.job) else nil
			if d.job then
				d.job.transitionUntil = 0
			end
			d.slot = s.slot
		end
	end
	for _, d in Drives.list do
		if d.state == "Staged" and not d.slot then
			d.slot = freeSlot("staging")
		end
		refreshVisual(d)
	end
	GameState.data.erased = Drives.erasedCount()
	refreshPrompts()
	GameState.markDirty()
end

local function resetRound()
	local order = Minigames.assign(roundRng)
	for i, d in Drives.list do
		detachFromCarrier(d)
		d.state = "Installed"
		d.pcOff = false
		d.slot = nil
		d.job = nil
		d.game = order[i]
		refreshVisual(d)
	end
	for _, p in Players:GetPlayers() do
		if Drives.byId[carrying(p) or ""] then
			setCarrying(p, nil)
		end
	end
	GameState.data.erased = 0
	refreshPrompts()
	GameState.markDirty()
end

-- Construction ---------------------------------------------------------------

local function makeDrivePart(def: { id: string, name: string, color: Color3 }): (BasePart, TextLabel, BasePart)
	local p = Instance.new("Part")
	p.Name = "Drive_" .. def.id
	p.Size = Vector3.new(1.05, 0.32, 1.45)
	p.Color = Color3.fromRGB(150, 154, 160)
	p.Material = Enum.Material.Metal
	p.Anchored = true
	p.CanCollide = false
	p.Massless = true
	p:SetAttribute("DriveId", def.id)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0.5
	sg.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(0.9, 0.76)
	t.Position = UDim2.fromScale(0.05, 0.12)
	t.BackgroundColor3 = def.color
	t.TextColor3 = Color3.fromRGB(20, 20, 20)
	t.FontFace = Fonts.PIXEL_BOLD
	t.TextScaled = true
	t.Text = def.id
	t.Parent = sg
	local led = Instance.new("Part")
	led.Name = "Led"
	led.Size = Vector3.new(0.1, 0.1, 0.1)
	led.Material = Enum.Material.Neon
	led.Color = Color3.fromRGB(255, 60, 50)
	led.CanCollide = false
	led.Massless = true
	led.Anchored = false
	led.CFrame = p.CFrame * CFrame.new(0.4, 0.16, -0.6)
	local w = Instance.new("WeldConstraint")
	w.Part0 = p
	w.Part1 = led
	w.Parent = led
	led.Parent = p
	return p, t, led
end

function Drives.init()
	local refs = MapBuilder.refs
	local folder = Instance.new("Folder")
	folder.Name = "Drives"
	folder.Parent = refs.map
	local order = Minigames.assign(roundRng)
	for i, def in Config.DRIVES do
		local p, t, led = makeDrivePart(def)
		local prompt = Prompts.make(p, { action = "Take drive", object = def.id, distance = 7 })
		local d: Drive = {
			id = def.id,
			name = def.name,
			color = def.color,
			desk = i,
			state = "Installed",
			carrier = nil,
			slot = nil,
			game = order[i],
			job = nil,
			pcOff = false,
			part = p,
			labelText = t,
			led = led,
			prompt = prompt,
		}
		p.Parent = folder
		table.insert(Drives.list, d)
		Drives.byId[d.id] = d
		prompt.Triggered:Connect(function(player)
			if Prompts.valid(player, prompt, "drive") then
				Drives.pickup(player, d)
			end
		end)
	end

	for i, pc in refs.sourcePCs do
		local prompt = Prompts.make(pc, { action = "Shut down PC", object = "", hold = 0.8, distance = 8 })
		pcPrompts[i] = prompt
		prompt.Triggered:Connect(function(player)
			if not Prompts.valid(player, prompt, "pc") then
				return
			end
			local d: Drive? = nil
			for _, x in Drives.list do
				if x.desk == i then
					d = x
				end
			end
			if not d or d.state ~= "Installed" then
				return
			end
			if not d.pcOff then
				d.pcOff = true
				refreshVisual(d)
				refreshPrompts()
				GameState.fx("PcShutdown", { desk = i })
			else
				Drives.pickup(player, d)
			end
		end)
	end

	-- placing a drive is always F / R1; taking is E / X (no competing prompts)
	rackPrompt = Prompts.make(refs.recoveryRack, { action = "Stage drive", object = "Drive rack", distance = 8, key = Enum.KeyCode.F, gamepad = Enum.KeyCode.ButtonR1 })
	rackPrompt.Triggered:Connect(function(player)
		if Prompts.valid(player, rackPrompt, "rack") then
			if not Drives.byId[carrying(player) or ""] then
				GameState.notify(player, "Carry a drive here to stage it for the workstation.", "info")
				return
			end
			Drives.stage(player)
		end
	end)

	-- own key (F / R1) so it never competes with the chair prompt (E) at the cramped desk
	dockPrompt = Prompts.make(refs.dock, { action = "Dock drive", object = "Workstation dock", distance = 8, hold = 0.5, key = Enum.KeyCode.F, gamepad = Enum.KeyCode.ButtonR1 })
	dockPrompt.Triggered:Connect(function(player)
		if not Prompts.valid(player, dockPrompt, "dock") then
			return
		end
		local docked = Drives.dockDrive()
		if docked then
			Drives.eject(player)
		elseif Drives.byId[carrying(player) or ""] then
			Drives.dock(player)
		else
			GameState.notify(player, "Bring a hard drive to dock it.", "info")
		end
	end)

	GameState.providers.drives = Drives.snapshot
	GameState.providers.dock = function()
		local d = Drives.dockDrive()
		return if d then d.id else nil
	end

	Players.PlayerRemoving:Connect(function(player)
		Drives.recoverFor(player, player.DisplayName .. " left")
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterRemoving:Connect(function()
			Drives.recoverFor(player, "carrier lost")
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterRemoving:Connect(function()
			Drives.recoverFor(player, "carrier lost")
		end)
	end
	GameState.RoundReset:Connect(resetRound)

	for _, d in Drives.list do
		refreshVisual(d)
	end
	refreshPrompts()
end

function Drives.start()
	-- watchdog: invalid carriers and drives that left the map
	while true do
		task.wait(Config.DRIVE_WATCHDOG_SECONDS)
		for _, d in Drives.list do
			if d.state == "Carried" then
				local c = d.carrier
				if not c or c.Parent == nil or not Guard.alive(c) or c:GetAttribute("Downed") == true then
					Drives.recover(d, "carrier lost")
				elseif not Layout.inMap(d.part.Position) or d.part.Position.Y < Config.DRIVE_RECOVERY_Y then
					Drives.recover(d, "lost outside")
				end
			end
		end
	end
end

return Drives
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">EventDirector</string>
            <string name="Source"><![CDATA[--!strict
-- Difficulty director. No timetable: every roll picks among ELIGIBLE events
-- with weighted randomness, using erased-drive progress, puzzle progress,
-- active player count, unresolved threats, cooldowns, recent history,
-- learned mechanics and recovery windows. Urgent threats are capped (solo: one
-- at a time) and the finale has a hard cap so sign-off always completes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Server = script.Parent.Parent
local Minigames = require(Server.Minigames)
local GameState = require(script.Parent.GameState)
local Drives = require(script.Parent.Drives)
local Doors = require(script.Parent.Doors)
local Power = require(script.Parent.Power)
local Workstation = require(script.Parent.Workstation)
local Threat = require(script.Parent.Threat)
local PlayerStatus = require(script.Parent.PlayerStatus)
local Checkpoints = require(script.Parent.Checkpoints)

export type Ctx = {
	now: number,
	tier: string,
	phase: string,
	erased: number,
	players: number,
	solo: boolean,
	urgentActive: number,
	urgentCap: number,
	learned: { [string]: boolean },
	operator: Player?,
	processing: boolean,
	puzzleProgress: number?,
	stageProgress: number?,
	threatBusy: boolean,
	powerOk: boolean,
	doorLatched: boolean,
	anyDowned: boolean,
	active: { [string]: boolean },
	opts: { [string]: any },
}

export type Handle = {
	urgentNow: (() -> boolean)?,
	cleanup: () -> (),
}

export type EventDef = {
	id: string,
	urgent: boolean,
	mechanic: string?,
	cooldown: number,
	conflicts: { string },
	eligible: (ctx: Ctx) -> boolean,
	weight: (ctx: Ctx) -> number,
	start: (ctx: Ctx, finish: (outcome: string) -> ()) -> Handle,
	setup: (() -> ())?,
}

type Active = { def: EventDef, handle: Handle?, started: number, urgent: boolean }

local EventDirector = {}

local defs: { EventDef } = {}
local byId: { [string]: EventDef } = {}
local active: { [string]: Active } = {}
local lastRun: { [string]: number } = {}
local history: { string } = {}
local learned: { [string]: boolean } = {}
local nextRollAt = 0
local recoveryUntil = 0
local lastUrgentEnded = -math.huge
local finaleUrgentUsed = 0
local purgeUrgentUsed = 0
local shiftStart = os.clock()
local log: { string } = {}

local function record(text: string)
	table.insert(log, string.format("[%5.1f] %s", os.clock() - shiftStart, text))
	while #log > 40 do
		table.remove(log, 1)
	end
end

local function urgentCount(): number
	local n = 0
	for _, a in active do
		local h = a.handle
		if a.urgent or (h and h.urgentNow and h.urgentNow()) then
			n += 1
		end
	end
	return n
end

local function buildCtx(opts: { [string]: any }?): Ctx
	local players = #GameState.activePlayers()
	local d = Drives.dockDrive()
	local processing = d ~= nil and d.state == "Processing" and d.job ~= nil
	local progress: number? = nil
	local stageProgress: number? = nil
	if processing and d and d.job then
		progress = Minigames.progress(d.job)
		local g = Minigames.get(d.game)
		if g then
			stageProgress = g.progress(d.job.state)
		end
	end
	local anyDowned = false
	for _, p in GameState.activePlayers() do
		if PlayerStatus.isDowned(p) then
			anyDowned = true
		end
	end
	local activeSet = {}
	for id in active do
		activeSet[id] = true
	end
	return {
		now = os.clock(),
		tier = Config.tierFor(GameState.data.erased, GameState.phase),
		phase = GameState.phase,
		erased = GameState.data.erased,
		players = math.max(1, players),
		solo = GameState.isSolo(),
		urgentActive = urgentCount(),
		urgentCap = Config.urgentCap(math.max(1, players)),
		learned = learned,
		operator = Workstation.operator(),
		processing = processing,
		puzzleProgress = progress,
		stageProgress = stageProgress,
		threatBusy = Threat.busy(),
		powerOk = not Power.anyTripped(),
		doorLatched = Doors.state() == "Latched",
		anyDowned = anyDowned,
		active = activeSet,
		opts = opts or {},
	}
end

local function finishFor(id: string, entry: Active): (outcome: string) -> ()
	local done = false
	return function(outcome: string)
		if done then
			return
		end
		done = true
		local a = active[id]
		if not a or a ~= entry then -- a late callback from an older run
			return
		end
		active[id] = nil
		local def = a.def
		if def.mechanic then
			learned[def.mechanic] = true
		end
		lastRun[id] = os.clock()
		if a.urgent then
			local tier = Config.tierFor(GameState.data.erased, GameState.phase)
			lastUrgentEnded = os.clock()
			recoveryUntil = math.max(recoveryUntil, os.clock() + (Config.DIRECTOR.recoveryAfterUrgent :: any)[tier])
		end
		record(id .. " ended: " .. outcome)
		GameState.markDirty()
	end
end

local function startEvent(def: EventDef, opts: { [string]: any }?)
	if active[def.id] then
		return
	end
	local ctx = buildCtx(opts)
	local entry: Active = { def = def, handle = nil, started = os.clock(), urgent = def.urgent }
	active[def.id] = entry
	lastRun[def.id] = os.clock()
	table.insert(history, def.id)
	while #history > Config.DIRECTOR.historySize do
		table.remove(history, 1)
	end
	if def.urgent then
		if GameState.phase == "SignOff" then
			finaleUrgentUsed += 1
		elseif GameState.phase == "FinalPurge" then
			purgeUrgentUsed += 1
		end
	end
	record("start " .. def.id .. " (tier " .. ctx.tier .. ", players " .. ctx.players .. ")")
	local ok, handle = pcall(def.start, ctx, finishFor(def.id, entry))
	if ok then
		entry.handle = handle
	else
		warn("[Director] event failed to start", def.id, handle)
		active[def.id] = nil
	end
end

local function conflicts(def: EventDef): boolean
	for _, other in def.conflicts do
		if active[other] then
			return true
		end
	end
	for id, a in active do
		if table.find(a.def.conflicts, def.id) then
			return true
		end
		local _ = id
	end
	return false
end

local function phaseAllowsEvents(): boolean
	local p = GameState.phase
	return p == "Work" or p == "FinalPurge" or p == "SignOff" or p == "ClockOut"
end

local function urgentAllowedNow(ctx: Ctx): boolean
	if ctx.anyDowned or ctx.now < recoveryUntil then
		return false
	end
	if ctx.urgentActive >= ctx.urgentCap then
		return false
	end
	local solo = ctx.solo
	if ctx.phase == "SignOff" then
		return finaleUrgentUsed < (if solo then Config.DIRECTOR.signOffMaxUrgent.solo else Config.DIRECTOR.signOffMaxUrgent.coop)
	elseif ctx.phase == "FinalPurge" then
		return purgeUrgentUsed < Config.DIRECTOR.finalPurgeMaxUrgent
	elseif ctx.phase == "ClockOut" then
		return false -- the finale pursuit is the only threat while clocking out
	end
	return true
end

local function roll()
	local ctx = buildCtx()
	local candidates: { { def: EventDef, w: number } } = {}
	local total = 0
	local relief = os.clock() - lastUrgentEnded < 60
	for _, def in defs do
		local cd = lastRun[def.id]
		local ready = cd == nil or ctx.now - cd >= def.cooldown
		if ready and not active[def.id] and not conflicts(def) and (not def.urgent or urgentAllowedNow(ctx)) and def.eligible(ctx) then
			local w = def.weight(ctx)
			-- repeat penalty
			if history[#history] == def.id then
				w *= Config.DIRECTOR.repeatPenaltyLast
			elseif table.find(history, def.id) then
				w *= Config.DIRECTOR.repeatPenaltyRecent
			end
			-- alternate tension and relief
			if relief and not def.urgent then
				w *= Config.DIRECTOR.reliefBoostAfterUrgent
			end
			-- let an almost-finished stage finish
			if def.urgent and (ctx.stageProgress or 0) > 0.7 then
				w *= Config.DIRECTOR.nearCompleteUrgentScale
			end
			if w > 0 then
				table.insert(candidates, { def = def, w = w })
				total += w
			end
		end
	end
	if total <= 0 then
		return
	end
	local pick = math.random() * total
	for _, c in candidates do
		pick -= c.w
		if pick <= 0 then
			startEvent(c.def)
			return
		end
	end
	startEvent(candidates[#candidates].def)
end

local function scheduleNext()
	local tier = Config.tierFor(GameState.data.erased, GameState.phase)
	local gap = (Config.DIRECTOR.gaps :: any)[tier]
	nextRollAt = os.clock() + gap[1] + math.random() * (gap[2] - gap[1])
end

function EventDirector.cleanupAll(reason: string)
	for id, a in active do
		if a.handle then
			pcall(a.handle.cleanup)
		end
		active[id] = nil
	end
	GameState.clearThreats()
	record("cleanup all: " .. reason)
end

function EventDirector.grantRecovery(seconds: number)
	recoveryUntil = math.max(recoveryUntil, os.clock() + seconds)
end

function EventDirector.trigger(id: string, opts: { [string]: any }?): boolean
	local def = byId[id]
	if not def or active[id] then
		return false
	end
	startEvent(def, opts)
	return true
end

function EventDirector.debugState(): { [string]: any }
	local act = {}
	for id in active do
		table.insert(act, id)
	end
	return {
		active = act,
		history = history,
		learned = learned,
		nextRollIn = nextRollAt - os.clock(),
		recoveryFor = recoveryUntil - os.clock(),
		log = log,
	}
end

function EventDirector.init()
	local folder = Server:WaitForChild("Events")
	for _, m in folder:GetChildren() do
		if m:IsA("ModuleScript") then
			local def = (require :: any)(m) :: EventDef
			table.insert(defs, def)
			byId[def.id] = def
			if def.setup then
				def.setup()
			end
		end
	end
	table.sort(defs, function(a, b)
		return a.id < b.id
	end)
	Checkpoints.Restoring:Connect(function()
		EventDirector.cleanupAll("checkpoint restore")
	end)
	Checkpoints.Restored:Connect(function()
		recoveryUntil = os.clock() + Config.DOWNED.restoreRecoverySeconds
		scheduleNext()
	end)
	GameState.RoundReset:Connect(function()
		EventDirector.cleanupAll("round reset")
		table.clear(learned)
		table.clear(lastRun)
		table.clear(history)
		finaleUrgentUsed = 0
		purgeUrgentUsed = 0
		shiftStart = os.clock()
		nextRollAt = os.clock() + Config.PHASE.directorGraceSeconds
	end)
	GameState.PhaseChanged:Connect(function(new)
		if new == "SignOff" then
			finaleUrgentUsed = 0
			scheduleNext()
		elseif new == "FinalPurge" then
			purgeUrgentUsed = 0
			nextRollAt = os.clock() + 20
		elseif new == "ClockOut" or new == "Ending" then
			for id, a in active do
				if a.def.urgent and a.handle then
					pcall(a.handle.cleanup)
					active[id] = nil
				end
			end
		end
	end)
	nextRollAt = os.clock() + Config.PHASE.directorGraceSeconds
end

function EventDirector.start()
	while true do
		task.wait(Config.DIRECTOR.tickSeconds)
		if phaseAllowsEvents() and not Checkpoints.isRestoring() then
			-- unsecured door left by players: same counterplay as an unlatch event
			if Doors.state() ~= "Latched" and not active.DoorUnlatch and not Threat.busy() then
				local tier = Config.tierFor(GameState.data.erased, GameState.phase)
				local grace = (Config.EVENTS.DoorUnlatch.grace :: any)[tier]
				if Doors.unsecuredFor() > grace and urgentCount() < Config.urgentCap(#GameState.activePlayers()) and GameState.phase ~= "ClockOut" then
					startEvent(byId.DoorUnlatch, { watch = true })
				end
			end
			if os.clock() >= nextRollAt then
				roll()
				scheduleNext()
			end
		end
	end
end

return EventDirector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">Finale</string>
            <string name="Source"><![CDATA[--!strict
-- The guaranteed climax and ending, triggered by job progress (6/6 erased):
--   FinalPurge  the queue lists the team's own records: cancel them in time
--   SignOff     finite emergency sign-off; pauses (never resets) without
--               power; operator confirms milestones (each is a checkpoint)
--   ClockOut    time clock unlocks; slow pursuit; team clocks out and leaves
--   Ending      ending screen, then a fresh round
-- The goal and completion conditions are fixed; interruptions come from the
-- event director, which caps them during the finale so it always finishes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)
local Power = require(script.Parent.Power)
local Doors = require(script.Parent.Doors)
local Drives = require(script.Parent.Drives)
local Workstation = require(script.Parent.Workstation)
local Threat = require(script.Parent.Threat)
local PlayerStatus = require(script.Parent.PlayerStatus)
local Checkpoints = require(script.Parent.Checkpoints)

local Finale = {}

local token = 0
local clockPrompt: ProximityPrompt
local firstClockOut: number? = nil
local shiftStartClock = os.clock()

local CREW = { "D. MERRIN (2003)", "A. OSEI (2003)", "P. LIND (2003)", "J. RUIZ (2003)" }

local function allCancelled(): boolean
	local list = GameState.data.purge
	if not list then
		return false
	end
	for _, e in list do
		if not e.locked and not e.cancelled then
			return false
		end
	end
	return true
end

local function buildPurgeList()
	local list = {}
	for _, name in CREW do
		table.insert(list, { name = name, cancelled = false, locked = true })
	end
	for _, p in Players:GetPlayers() do
		table.insert(list, { name = string.upper(p.DisplayName) .. " (tonight)", cancelled = false, locked = false, userId = p.UserId })
	end
	GameState.data.purge = list
end

local beginSignOff: (progress: number) -> ()
local beginClockOut: () -> ()

local function beginFinalPurge()
	token += 1
	local my = token
	GameState.setPhase("FinalPurge")
	buildPurgeList()
	local solo = GameState.isSolo()
	GameState.data.purgeDeadline = os.clock() + (if solo then Config.PHASE.finalPurgeCountdown.solo else Config.PHASE.finalPurgeCountdown.coop)
	GameState.bossMessage(Dialogue.FINAL_PURGE, "system", nil, "SecureErase")
	task.delay(3, function()
		if token == my then
			GameState.bossMessage(Dialogue.FINAL_PURGE_BOSS, "story")
		end
	end)
	GameState.fx("FinalPurge", nil)
	GameState.markDirty()
	Workstation.push()
	task.spawn(function()
		while token == my and GameState.phase == "FinalPurge" do
			task.wait(0.5)
			GameState.markDirty()
			-- the queue cannot be cancelled without power, so the countdown pauses too
			if not Power.workstationOn() and GameState.data.purgeDeadline then
				GameState.data.purgeDeadline += 0.5
			end
			local deadline = GameState.data.purgeDeadline
			if deadline and os.clock() > deadline and not allCancelled() then
				GameState.fx("PurgeExecuted", nil)
				GameState.notify(nil, "FINAL PURGE EXECUTED. Your records are gone...", "bad")
				task.wait(2)
				if token == my then
					Checkpoints.restore("final purge executed")
				end
				return
			end
		end
	end)
end

beginSignOff = function(progress: number)
	token += 1
	local my = token
	GameState.setPhase("SignOff")
	GameState.data.signOff = { progress = progress, awaiting = false, paused = false }
	GameState.data.purgeDeadline = nil
	GameState.bossMessage(Dialogue.SIGNOFF_START, "system", nil, "SecureErase")
	task.delay(4, function()
		if token == my then
			GameState.bossMessage(Dialogue.SIGNOFF_BOSS, "story")
		end
	end)
	GameState.fx("SignOffStart", nil)
	Workstation.push()
	local duration = if GameState.isSolo() then Config.PHASE.signOffSeconds.solo else Config.PHASE.signOffSeconds.coop
	task.spawn(function()
		local last = os.clock()
		local lastShown, lastPaused = -1, false
		while token == my and GameState.phase == "SignOff" do
			task.wait(0.2)
			local now = os.clock()
			local dt = now - last
			last = now
			local s = GameState.data.signOff
			if not s then
				return
			end
			s.paused = not Power.workstationOn() or s.awaiting
			if not s.paused then
				local before = s.progress
				s.progress = math.min(1, s.progress + dt / duration)
				for _, m in Config.PHASE.signOffConfirmAt do
					if before < m and s.progress >= m then
						s.progress = m
						s.awaiting = true
						GameState.fx("SignOffConfirm", { at = m })
						GameState.notify(nil, string.format("Sign-off paused at %d%%: the operator must CONFIRM at the workstation.", math.floor(m * 100)), "info")
						break
					end
				end
				if s.progress >= 1 then
					beginClockOut()
					return
				end
			end
			local shown = math.floor(s.progress * 100)
			if shown ~= lastShown or s.paused ~= lastPaused then
				lastShown = shown
				lastPaused = s.paused
				GameState.markDirty()
				Workstation.push()
			end
		end
	end)
end

beginClockOut = function()
	token += 1
	local my = token
	GameState.setPhase("ClockOut")
	GameState.data.signOff = { progress = 1, awaiting = false, paused = false }
	GameState.data.clockedOut = {}
	firstClockOut = nil
	for _, p in Players:GetPlayers() do
		p:SetAttribute("ClockedOut", false)
	end
	Checkpoints.save("sign-off complete", { clockOut = true })
	GameState.bossMessage(Dialogue.CLOCKOUT, "system", nil, "SecureErase")
	GameState.fx("ClockOutStart", nil)
	Workstation.push()
	clockPrompt.ActionText = "Clock out"
	task.delay(7, function()
		if token == my and GameState.phase == "ClockOut" then
			Threat.pursue()
		end
	end)
	-- escape detection + door timing
	task.spawn(function()
		local Z = Layout.ESCAPE_ZONE
		while token == my and GameState.phase == "ClockOut" do
			task.wait(0.25)
			if firstClockOut and not GameState.data.frontDoorOpen and os.clock() - firstClockOut > Config.PHASE.clockOutUnlockAfterFirst then
				Doors.openFront()
			end
			for _, p in Players:GetPlayers() do
				local r = Guard.rootOf(p)
				if r and p:GetAttribute("Escaped") ~= true and GameState.data.frontDoorOpen then
					local pos = r.Position
					if pos.X >= Z.minX and pos.X <= Z.maxX and pos.Z >= Z.minZ and pos.Z <= Z.maxZ then
						PlayerStatus.setEscaped(p, true)
						GameState.fx("Escaped", { name = p.DisplayName })
					end
				end
			end
			-- ending when nobody is left inside; downed stragglers are carried out
			local inside, standingInside = 0, 0
			for _, p in Players:GetPlayers() do
				if p:GetAttribute("Escaped") ~= true then
					inside += 1
					if not PlayerStatus.isDowned(p) then
						standingInside += 1
					end
				end
			end
			if #Players:GetPlayers() > 0 and (inside == 0 or (standingInside == 0 and inside < #Players:GetPlayers())) then
				for _, p in Players:GetPlayers() do
					if p:GetAttribute("Escaped") ~= true then
						PlayerStatus.revive(p, nil)
						PlayerStatus.setEscaped(p, true)
					end
				end
				Finale.ending()
				return
			end
		end
	end)
end

function Finale.ending()
	token += 1
	local my = token
	GameState.setPhase("Ending")
	Threat.despawn()
	GameState.clearThreats()
	local elapsed = os.clock() - shiftStartClock
	GameState.fx("Ending", {
		title = Dialogue.ENDING.title,
		lines = Dialogue.ENDING.lines,
		minutes = math.floor(elapsed / 60),
		seconds = math.floor(elapsed % 60),
	})
	task.delay(Config.PHASE.endingSeconds, function()
		if token == my then
			Finale.resetRound()
		end
	end)
end

function Finale.resetRound()
	token += 1
	local d = GameState.data
	d.erased = 0
	d.fragments = {}
	d.boss = {}
	d.purge = nil
	d.purgeDeadline = nil
	d.signOff = nil
	d.clockedOut = {}
	d.roundStart = os.clock()
	d.round += 1
	shiftStartClock = os.clock()
	clockPrompt.ActionText = "Clock out"
	GameState.clearThreats()
	GameState.RoundReset:Fire()
	PlayerStatus.respawnAll()
	GameState.markDirty()
end

local function onClockOut(player: Player)
	if GameState.phase ~= "ClockOut" then
		GameState.notify(player, "The time clock won't accept your card until the shift is signed off.", "info")
		return
	end
	if player:GetAttribute("ClockedOut") == true then
		return
	end
	player:SetAttribute("ClockedOut", true)
	table.insert(GameState.data.clockedOut, player.DisplayName)
	GameState.fx("ClockedOut", { name = player.DisplayName })
	firstClockOut = firstClockOut or os.clock()
	local all = true
	for _, p in PlayerStatus.standing() do
		if p:GetAttribute("ClockedOut") ~= true then
			all = false
		end
	end
	if all then
		Doors.openFront()
	end
	GameState.markDirty()
end

-- Desktop commands --------------------------------------------------------

local function cmdPurgeCancel(_player: Player, a: any, _b: any): (string?, string?)
	if GameState.phase ~= "FinalPurge" then
		return nil
	end
	local list = GameState.data.purge
	if not list or typeof(a) ~= "number" or a ~= math.floor(a) or a < 1 or a > #list then
		return nil
	end
	local e = list[a]
	if e.locked then
		return "Record already purged in 2003. Cannot cancel.", "bad"
	end
	if e.cancelled then
		return nil
	end
	e.cancelled = true
	GameState.markDirty()
	if allCancelled() then
		return "All of tonight's staff records removed from the queue. Run EMERGENCY SIGN-OFF.", "good"
	end
	return e.name .. " removed from the purge queue.", "good"
end

local function cmdSignOffStart(_player: Player, _a: any, _b: any): (string?, string?)
	if GameState.phase ~= "FinalPurge" or not allCancelled() then
		return "Cancel every record from tonight first.", "bad"
	end
	Checkpoints.save("emergency sign-off started", { signOff = 0 })
	beginSignOff(0)
	return "Emergency sign-off running.", "good"
end

local function cmdSignOffConfirm(_player: Player, _a: any, _b: any): (string?, string?)
	local s = GameState.data.signOff
	if GameState.phase ~= "SignOff" or not s or not s.awaiting then
		return nil
	end
	s.awaiting = false
	Checkpoints.save(string.format("sign-off %d%%", math.floor(s.progress * 100)), { signOff = s.progress })
	return "Checkpoint confirmed. Sign-off continuing.", "good"
end

function Finale.init()
	clockPrompt = Prompts.make(MapBuilder.refs.timeClock, { action = "Clock out", object = "Time clock", hold = 0.6, distance = 8 })
	clockPrompt.Triggered:Connect(function(player)
		if Prompts.valid(player, clockPrompt, "clock") then
			onClockOut(player)
		end
	end)
	Workstation.registerCommand("purgeCancel", cmdPurgeCancel)
	Workstation.registerCommand("signOffStart", cmdSignOffStart)
	Workstation.registerCommand("signOffConfirm", cmdSignOffConfirm)

	Drives.Erased:Connect(function(_d, count)
		if count >= Config.DRIVE_COUNT and GameState.phase == "Work" then
			task.delay(4, function()
				if GameState.phase == "Work" and Drives.erasedCount() >= Config.DRIVE_COUNT then
					GameState.bossMessage(Dialogue.BOSS_PROGRESS[6], "story")
					Checkpoints.save("before the finale", { finalPurge = true })
					-- checkpoint phase should be FinalPurge so a wipe returns here
					local cp = Checkpoints.latest()
					if cp then
						cp.phase = "FinalPurge"
					end
					beginFinalPurge()
				end
			end)
		end
	end)

	Checkpoints.Restoring:Connect(function()
		token += 1 -- stop finale loops; Restored decides what to resume
		Threat.despawn()
	end)
	Checkpoints.Restored:Connect(function(cp)
		if not cp then
			return
		end
		local signOff = cp.extra.signOff
		if cp.extra.clockOut then
			beginClockOut()
		elseif typeof(signOff) == "number" then
			beginSignOff(signOff)
		elseif cp.phase == "FinalPurge" then
			beginFinalPurge()
		end
	end)

	Players.PlayerAdded:Connect(function(p)
		if GameState.phase == "FinalPurge" and GameState.data.purge then
			table.insert(GameState.data.purge, { name = string.upper(p.DisplayName) .. " (tonight)", cancelled = false, locked = false, userId = p.UserId })
			GameState.markDirty()
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		local list = GameState.data.purge
		if list then
			for i, e in list do
				if (e :: any).userId == p.UserId then
					table.remove(list, i)
					break
				end
			end
			GameState.markDirty()
		end
	end)
end

-- QA hooks (used only by the gated Cheats system)
Finale.debugBeginFinalPurge = beginFinalPurge
Finale.debugBeginSignOff = function(p: number)
	beginSignOff(p)
end
Finale.debugBeginClockOut = function()
	beginClockOut()
end

return Finale
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">GameState</string>
            <string name="Source"><![CDATA[--!strict
-- Authoritative team/round state and its replication. Other systems mutate
-- their own state, then call GameState.markDirty(); a throttled loop sends a
-- full snapshot (cheap: the game state is small) so late joiners and every
-- client always render the same truth.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

type Phase = Types.Phase

local GameState = {}

GameState.phase = "Briefing" :: Phase
GameState.data = {
	erased = 0,
	fragments = {} :: { number },
	boss = {} :: { Types.BossMessage },
	purge = nil :: { { name: string, cancelled: boolean, locked: boolean, userId: number? } }?,
	purgeDeadline = nil :: number?,
	signOff = nil :: { progress: number, awaiting: boolean, paused: boolean }?,
	clockedOut = {} :: { string },
	frontDoorOpen = false,
	checkpoints = 0,
	threats = {} :: { Types.ThreatInfo },
	roundStart = os.clock(),
	round = 1,
	serverClockOffset = 0,
}

GameState.PhaseChanged = Signal.new() :: Signal.Signal<Phase, Phase>
GameState.RoundReset = Signal.new() :: Signal.Signal<>
GameState.PlayerCountChanged = Signal.new() :: Signal.Signal<number>
GameState.BossAnswered = Signal.new() :: Signal.Signal<number, string, Player>

-- providers: other systems plug their slice of the snapshot in
type Providers = {
	drives: (() -> { Types.DriveSnapshot })?,
	power: (() -> { main: boolean, lights: boolean, workstation: boolean, warning: boolean })?,
	door: (() -> Types.DoorState)?,
	dock: (() -> string?)?,
	operator: (() -> string?)?,
	objective: (() -> string)?,
}
GameState.providers = {} :: Providers

local dirty = true
local nextBossId = 1

function GameState.markDirty()
	dirty = true
end

function GameState.setPhase(p: Phase)
	local old: Phase = GameState.phase :: Phase
	if old == p then
		return
	end
	GameState.phase = p
	dirty = true
	GameState.PhaseChanged:Fire(p, old)
end

function GameState.nightMinutes(): number
	local elapsed = os.clock() - GameState.data.roundStart
	return (Config.NIGHT_START_MINUTES + elapsed * Config.GAME_MINUTES_PER_SECOND) % (24 * 60)
end

-- Players who count for difficulty and team wipes: connected, spawned, still inside.
function GameState.activePlayers(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character and p:GetAttribute("Escaped") ~= true then
			table.insert(list, p)
		end
	end
	return list
end

function GameState.playerCount(): number
	return math.max(1, #Players:GetPlayers())
end

function GameState.isSolo(): boolean
	return #Players:GetPlayers() <= 1
end

function GameState.notify(target: Player?, text: string, kind: string?)
	local r = Net.remote("Notify")
	if target then
		r:FireClient(target, text, kind or "info")
	else
		r:FireAllClients(text, kind or "info")
	end
end

function GameState.fx(name: string, data: any?, target: Player?)
	local r = Net.remote("Fx")
	if target then
		r:FireClient(target, name, data)
	else
		r:FireAllClients(name, data)
	end
end

-- Boss/system messages shown in the desktop messenger and as HUD pager toasts.
function GameState.bossMessage(text: string, kind: string?, choices: { string }?, from: string?): number
	local id = nextBossId
	nextBossId += 1
	local msg: Types.BossMessage = {
		id = id,
		from = from or "R. Kessler",
		text = text,
		kind = kind or "info",
		choices = choices,
		answered = nil,
		t = GameState.nightMinutes(),
	}
	table.insert(GameState.data.boss, msg)
	while #GameState.data.boss > 14 do
		table.remove(GameState.data.boss, 1)
	end
	dirty = true
	GameState.fx("BossMessage", { id = id, from = msg.from, text = text, kind = msg.kind })
	return id
end

function GameState.findBoss(id: number): Types.BossMessage?
	for _, m in GameState.data.boss do
		if m.id == id then
			return m
		end
	end
	return nil
end

function GameState.answerBoss(id: number, choice: string, by: Player): boolean
	local m = GameState.findBoss(id)
	if not m or m.answered or not m.choices or not table.find(m.choices, choice) then
		return false
	end
	m.answered = choice
	dirty = true
	GameState.BossAnswered:Fire(id, choice, by)
	return true
end

function GameState.setThreat(id: string, label: string?, urgent: boolean?, where: string?)
	local threats = GameState.data.threats
	for i, t in threats do
		if t.id == id then
			if label then
				t.label = label
				t.urgent = urgent == true
				t.where = where
			else
				table.remove(threats, i)
			end
			dirty = true
			return
		end
	end
	if label then
		table.insert(threats, { id = id, label = label, urgent = urgent == true, where = where })
		dirty = true
	end
end

function GameState.clearThreats()
	table.clear(GameState.data.threats)
	dirty = true
end

function GameState.snapshot(): Types.Snapshot
	local d = GameState.data
	local P = GameState.providers
	local power = if P.power then P.power() else { main = true, lights = true, workstation = true, warning = false }
	return {
		phase = GameState.phase :: Phase,
		erased = d.erased,
		total = Config.DRIVE_COUNT,
		nightMinutes = GameState.nightMinutes(),
		power = power,
		door = if P.door then P.door() else "Latched",
		threats = d.threats,
		drives = if P.drives then P.drives() else {},
		dock = if P.dock then P.dock() else nil,
		operator = if P.operator then P.operator() else nil,
		boss = d.boss,
		fragments = d.fragments,
		purge = d.purge,
		-- sent as seconds remaining (server clocks are not comparable on clients)
		purgeDeadline = if d.purgeDeadline then math.max(0, d.purgeDeadline - os.clock()) else nil,
		signOff = d.signOff,
		clockedOut = d.clockedOut,
		frontDoorOpen = d.frontDoorOpen,
		objective = if P.objective then P.objective() else "",
		checkpoints = d.checkpoints,
		serverTime = workspace:GetServerTimeNow(),
		soloMode = GameState.isSolo(),
	}
end

function GameState.init()
	Players.PlayerAdded:Connect(function(player)
		dirty = true
		GameState.PlayerCountChanged:Fire(#Players:GetPlayers())
		task.defer(function()
			Net.remote("State"):FireClient(player, GameState.snapshot())
		end)
	end)
	Players.PlayerRemoving:Connect(function()
		dirty = true
		task.defer(function()
			GameState.PlayerCountChanged:Fire(#Players:GetPlayers())
		end)
	end)
end

function GameState.start()
	local stateRemote = Net.remote("State")
	local lastSent = 0
	while true do
		task.wait(0.2)
		local now = os.clock()
		if dirty or now - lastSent > 2 then
			dirty = false
			lastSent = now
			stateRemote:FireAllClients(GameState.snapshot())
		end
	end
end

return GameState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the whole office from code at server start: structure, collision,
-- lights, interactive parts and invisible "ArtAnchor" parts that clients turn
-- into meshes from the converted asset library (see client ArtController).
-- Other systems read MapBuilder.refs instead of searching the workspace.
--
-- Art direction: a small, maintained office after hours. Clean painted walls
-- with cream trim, subdued burgundy carpet, a few purposeful objects per desk,
-- soft amber practicals inside and a cold blue-grey night outside.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Layout = require(ReplicatedStorage.Shared.Layout)
local Index = require(ReplicatedStorage.ArtData.Index) :: any

local MapBuilder = {}

export type Refs = {
	map: Folder,
	interactive: Folder,
	sourcePCs: { BasePart },
	sourceLeds: { BasePart },
	sourceScreens: { BasePart },
	drivePlace: { CFrame },
	stagingSlots: { CFrame },
	erasedSlots: { CFrame },
	recoveryRack: BasePart,
	dock: BasePart,
	dockLed: BasePart,
	seat: Seat,
	seatPromptPart: BasePart,
	monitorScreen: BasePart,
	breakerSwitches: { [string]: BasePart },
	breakerLamps: { [string]: BasePart },
	rearDoor: BasePart,
	rearDoorHinge: CFrame,
	doorLight: BasePart,
	doorPromptPart: BasePart,
	frontDoors: { BasePart },
	timeClock: BasePart,
	kitchenTrash: BasePart,
	dumpster: BasePart,
	thermostat: BasePart,
	printer: BasePart,
	printerLed: BasePart,
	outbox: BasePart,
	threatAnchorKey: string,
	shiftChair: BasePart,
	lights: { [string]: { Light } },
	emergencyLights: { Light },
	deskLamps: { Light },
	workstationLamp: Light,
	fixtures: { [string]: { BasePart } },
	noticeBoards: { BasePart },
	crewFigures: { BasePart },
	escapeZone: BasePart,
}

MapBuilder.refs = (nil :: any) :: Refs

-- Palette (albedo). Shadow tone comes from Lighting.Ambient, not from paint.
local C = {
	wall = Color3.fromRGB(205, 200, 186), -- fallback under the cream plaster texture
	trim = Color3.fromRGB(183, 176, 156), -- muted cream: painted trim, old plastic
	carpet = Color3.fromRGB(96, 73, 77), -- dusty burgundy
	curtain = Color3.fromRGB(96, 73, 77),
	ceiling = Color3.fromRGB(204, 203, 196),
	beige = Color3.fromRGB(183, 176, 156),
	metal = Color3.fromRGB(118, 122, 126),
	dark = Color3.fromRGB(34, 38, 42),
	brick = Color3.fromRGB(92, 84, 78),
	asphalt = Color3.fromRGB(44, 46, 50),
	glass = Color3.fromRGB(120, 140, 155),
	fluorescent = Color3.fromRGB(222, 224, 214), -- fixture panel (neon, kept soft)
	fluorescentLight = Color3.fromRGB(238, 234, 220), -- light cast by the panels
	amber = Color3.fromRGB(200, 166, 107), -- practicals: desk lamps, hall bulbs
	cold = Color3.fromRGB(168, 186, 195), -- exterior: pale blue-grey
}

local SILKSCREEN = "rbxassetid://12187371840"

local root: Folder = (nil :: any) :: Folder
local groups: { [string]: Folder } = {}

local function group(name: string): Folder
	local existing = groups[name]
	if existing then
		return existing
	end
	local g = Instance.new("Folder")
	g.Name = name
	g.Parent = root
	groups[name] = g
	return g
end

type PartOpts = {
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	collide: boolean?,
	surface: string?, -- surface texture name (client applies the EditableImage)
	tile: number?,
	shadow: boolean?,
	query: boolean?,
}

local function addSurface(p: BasePart, surface: string, tile: number, faces: { Enum.NormalId }?)
	local list: { Enum.NormalId } = faces or { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top, Enum.NormalId.Bottom }
	for _, face in list do
		local t = Instance.new("Texture")
		t.Face = face
		t.StudsPerTileU = tile
		t.StudsPerTileV = tile
		t.Transparency = 0.05
		t:SetAttribute("Surface", surface)
		CollectionService:AddTag(t, "Surface")
		t.Parent = p
	end
end

local function part(name: string, size: Vector3, cf: CFrame, parent: Instance, o: PartOpts?): Part
	local opts: PartOpts = o or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = opts.color or C.beige
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.Transparency = opts.transparency or 0
	p.CanCollide = if opts.collide == nil then true else opts.collide
	p.CastShadow = if opts.shadow == nil then true else opts.shadow
	p.CanQuery = if opts.query == nil then true else opts.query
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts.surface then
		addSurface(p, opts.surface, opts.tile or 8)
	end
	p.Parent = parent
	return p
end

local function box(name: string, minV: Vector3, maxV: Vector3, parent: Instance, o: PartOpts?): Part
	return part(name, maxV - minV, CFrame.new((minV + maxV) / 2), parent, o)
end

-- Axis-aligned wall along X (constant z) or Z (constant x) with openings.
type Gap = { from: number, to: number, bottom: number, top: number }

local function wall(name: string, axis: "X" | "Z", fixed: number, a: number, b: number, height: number, gaps: { Gap }, o: PartOpts?)
	local parent = group("Structure")
	local t = Layout.WALL
	table.sort(gaps, function(g1, g2)
		return g1.from < g2.from
	end)
	local function seg(s0: number, s1: number, y0: number, y1: number)
		if s1 - s0 < 0.05 or y1 - y0 < 0.05 then
			return
		end
		local minV, maxV
		if axis == "X" then
			minV, maxV = Vector3.new(s0, y0, fixed - t / 2), Vector3.new(s1, y1, fixed + t / 2)
		else
			minV, maxV = Vector3.new(fixed - t / 2, y0, s0), Vector3.new(fixed + t / 2, y1, s1)
		end
		box(name, minV, maxV, parent, o)
	end
	local cursor = a
	for _, g in gaps do
		seg(cursor, g.from, 0, height)
		seg(g.from, g.to, 0, g.bottom)
		seg(g.from, g.to, g.top, height)
		cursor = g.to
	end
	seg(cursor, b, 0, height)
end

-- Painted wainscot: skirting board, flat lower panel and a chair rail along
-- the inside face of a wall. `inward` is +1/-1 along the wall's normal axis.
local function trim(name: string, axis: "X" | "Z", fixed: number, a: number, b: number, inward: number, gaps: { { number } })
	local parent = group("Structure")
	local face = fixed + inward * (Layout.WALL / 2)
	local opts: PartOpts = { color = C.trim, collide = false, shadow = false }
	local function slab(s0: number, s1: number, y0: number, y1: number, depth: number)
		if s1 - s0 < 0.05 then
			return
		end
		local d0, d1 = face, face + inward * depth
		local lo, hi = math.min(d0, d1), math.max(d0, d1)
		if axis == "X" then
			box(name, Vector3.new(s0, y0, lo), Vector3.new(s1, y1, hi), parent, opts)
		else
			box(name, Vector3.new(lo, y0, s0), Vector3.new(hi, y1, s1), parent, opts)
		end
	end
	local sorted = table.clone(gaps)
	table.sort(sorted, function(g1, g2)
		return g1[1] < g2[1]
	end)
	local function run(s0: number, s1: number)
		slab(s0, s1, 0, 2.7, 0.06) -- panel
		slab(s0, s1, 0, 0.35, 0.12) -- skirting
		slab(s0, s1, 2.7, 2.86, 0.12) -- chair rail
	end
	local cursor = a
	for _, g in sorted do
		run(cursor, g[1])
		cursor = g[2]
	end
	run(cursor, b)
end

local function region(name: string, r: { minX: number, maxX: number, minZ: number, maxZ: number }, y0: number, y1: number, o: PartOpts?): Part
	return box(name, Vector3.new(r.minX, y0, r.minZ), Vector3.new(r.maxX, y1, r.maxZ), group("Structure"), o)
end

-- Art props ------------------------------------------------------------------

local ART_YAW: { [string]: number } = {
	characters__male__character_01 = 180,
	characters__male__character_04 = 180,
	characters__male__character_05 = 180,
}

type PropOpts = {
	scale: number?,
	collide: boolean?,
	yaw: number?,
	dynamic: boolean?,
	tint: Color3?,
	pad: number?,
	parent: Instance?,
}

local function prop(key: string, pos: Vector3, front: Vector3, o: PropOpts?): BasePart?
	local opts: PropOpts = o or {}
	local info = Index.models[key]
	if not info then
		warn("[Map] unknown art key", key)
		return nil
	end
	local s = opts.scale or 1
	local cf = Layout.facing(pos, front, (opts.yaw or 0) + (ART_YAW[key] or 0))
	local anchor = Instance.new("Part")
	anchor.Name = key
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = cf
	anchor:SetAttribute("ArtKey", key)
	if s ~= 1 then
		anchor:SetAttribute("ArtScale", s)
	end
	if opts.tint then
		anchor:SetAttribute("ArtTint", opts.tint)
	end
	if opts.dynamic then
		anchor:SetAttribute("ArtDynamic", true)
	end
	CollectionService:AddTag(anchor, "ArtAnchor")
	anchor.Parent = opts.parent or group("Props")
	if opts.collide then
		local mn: Vector3 = info.min * s
		local mx: Vector3 = info.max * s
		local pad = opts.pad or 0
		local size = (mx - mn) - Vector3.new(pad, 0, pad) * 2
		local c = cf * CFrame.new((mn + mx) / 2)
		part(key .. "_Collision", Vector3.new(math.max(size.X, 0.3), math.max(size.Y, 0.3), math.max(size.Z, 0.3)), c, group("Collision"), {
			transparency = 1,
			shadow = false,
		})
	end
	return anchor
end

-- Short retro labels on physical objects (dock, breakers, signs): pixel font.
local function label(p: BasePart, face: Enum.NormalId, text: string, color: Color3?, bg: Color3?, textSize: number?): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 50
	sg.LightInfluence = 0.6
	sg.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or Color3.new(0, 0, 0)
	t.BackgroundTransparency = if bg then 0 else 1
	t.TextColor3 = color or Color3.new(0.1, 0.1, 0.1)
	t.FontFace = Font.new(SILKSCREEN)
	t.TextScaled = textSize == nil
	if textSize then
		t.TextSize = textSize
	end
	t.TextWrapped = true
	t.Text = text
	t.Parent = sg
	return t
end

-- Lights ---------------------------------------------------------------------

local lightGroups: { [string]: { Light } } = {}
local fixtures: { [string]: { BasePart } } = {}

local function fluorescent(groupName: string, pos: Vector3, ceiling: number, color: Color3?, brightness: number?)
	local fixture = part("Fluorescent", Vector3.new(6, 0.25, 2), CFrame.new(pos.X, ceiling - 0.13, pos.Z), group("Lights"), {
		color = C.fluorescent,
		material = Enum.Material.Neon,
		collide = false,
		shadow = false,
	})
	local frame = part("FluorescentFrame", Vector3.new(6.4, 0.18, 2.4), CFrame.new(pos.X, ceiling - 0.05, pos.Z), group("Lights"), {
		color = C.metal,
		collide = false,
		shadow = false,
	})
	frame.Parent = fixture
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 120
	light.Range = 15
	light.Brightness = brightness or 0.8
	light.Color = color or C.fluorescentLight
	light.Shadows = true
	light.Parent = fixture
	lightGroups[groupName] = lightGroups[groupName] or {}
	table.insert(lightGroups[groupName], light)
	fixtures[groupName] = fixtures[groupName] or {}
	table.insert(fixtures[groupName], fixture)
end

local function pointLight(groupName: string, pos: Vector3, color: Color3, range: number, brightness: number, parent: Instance?): PointLight
	local holder = part("LightPoint", Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), parent or group("Lights"), {
		transparency = 1,
		collide = false,
		shadow = false,
		query = false,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = true
	light.Parent = holder
	lightGroups[groupName] = lightGroups[groupName] or {}
	table.insert(lightGroups[groupName], light)
	return light
end

-- Builders -------------------------------------------------------------------

local function buildStructure()
	local M, K, L, H, A = Layout.MAIN, Layout.KITCHEN, Layout.LOBBY, Layout.HALL, Layout.ALLEY
	local ceil = Layout.CEILING

	-- floors
	region("FloorMain", M, -1, 0, { color = C.carpet, material = Enum.Material.Carpet, surface = "carpet", tile = 7 })
	region("FloorKitchen", K, -1, 0, { color = C.beige, surface = "floor_tile", tile = 6 })
	region("FloorLobby", L, -1, 0, { color = C.beige, surface = "floor_lobby", tile = 6 })
	region("FloorHall", H, -1, 0, { color = C.metal, material = Enum.Material.Concrete, surface = "floor_concrete", tile = 8 })
	region("FloorAlley", A, -1, 0, { color = C.asphalt, material = Enum.Material.Asphalt })
	region("FloorAlleyBeyond", { minX = 66, maxX = 82, minZ = -6, maxZ = 16 }, -1, 0, { color = C.dark, material = Enum.Material.Asphalt })
	region("FloorStreet", Layout.STREET, -1, 0, { color = C.asphalt, material = Enum.Material.Asphalt })
	region("FloorNorthStreet", { minX = -34, maxX = 36, minZ = -30, maxZ = -14.5 }, -1, 0, { color = C.asphalt, material = Enum.Material.Asphalt })
	-- the hall entrance strip between the room wall and the hall
	box("FloorGap", Vector3.new(21.5, -1, 3), Vector3.new(22.5, 0, 9), group("Structure"), { color = C.carpet, material = Enum.Material.Carpet })
	box("FloorGapK", Vector3.new(-22.5, -1, -12), Vector3.new(-21.5, 0, -5.5), group("Structure"), { color = C.carpet, material = Enum.Material.Carpet })
	box("FloorGapL", Vector3.new(9, -1, 13.5), Vector3.new(15, 0, 14.5), group("Structure"), { color = C.carpet, material = Enum.Material.Carpet })

	-- ceilings: acoustic tile grid
	local ceilOpts: PartOpts = { color = C.ceiling, surface = "ceiling_tile", tile = 8 }
	region("CeilingMain", { minX = M.minX - 1, maxX = M.maxX + 1, minZ = M.minZ - 1, maxZ = M.maxZ + 1 }, ceil, ceil + 1, ceilOpts)
	region("CeilingKitchen", K, ceil - 1, ceil, ceilOpts)
	region("CeilingLobby", L, ceil, ceil + 1, ceilOpts)
	region("CeilingHall", H, 9, 10, { color = C.metal, surface = "wall_concrete", tile = 8 })

	local officeWall: PartOpts = { color = C.wall, surface = "wall_office", tile = 9 }
	local doorGap = function(f: number, t: number, top: number): Gap
		return { from = f, to = t, bottom = 0, top = top }
	end

	-- main room
	local windows: { Gap } = {}
	for _, x in Layout.WINDOWS_X do
		table.insert(windows, { from = x - 3, to = x + 3, bottom = 3.3, top = 7.6 })
	end
	wall("WallNorth", "X", M.minZ - 0.5, M.minX - 1, M.maxX + 1, ceil, windows, officeWall)
	wall("WallSouth", "X", M.maxZ + 0.5, M.minX - 1, M.maxX + 1, ceil, { doorGap(Layout.LOBBY_GAP.minX, Layout.LOBBY_GAP.maxX, 8) }, officeWall)
	wall("WallWest", "Z", M.minX - 0.5, M.minZ, M.maxZ, ceil, { doorGap(Layout.KITCHEN_GAP.minZ, Layout.KITCHEN_GAP.maxZ, 8) }, officeWall)
	wall("WallEast", "Z", M.maxX + 0.5, M.minZ, M.maxZ, ceil, { doorGap(Layout.HALL_GAP.minZ, Layout.HALL_GAP.maxZ, 8.5) }, officeWall)
	-- painted trim: skirting, wainscot panel and chair rail on every office wall
	trim("Trim", "X", M.minZ - 0.5, M.minX, M.maxX, 1, {})
	trim("Trim", "X", M.maxZ + 0.5, M.minX, M.maxX, -1, { { Layout.LOBBY_GAP.minX, Layout.LOBBY_GAP.maxX } })
	trim("Trim", "Z", M.minX - 0.5, M.minZ, M.maxZ, 1, { { Layout.KITCHEN_GAP.minZ, Layout.KITCHEN_GAP.maxZ } })
	trim("Trim", "Z", M.maxX + 0.5, M.minZ, M.maxZ, -1, { { Layout.HALL_GAP.minZ, Layout.HALL_GAP.maxZ } })
	-- door frames (cream) around the openings
	for _, spec in {
		{ Vector3.new(Layout.LOBBY_GAP.minX - 0.25, 0, M.maxZ - 0.1), Vector3.new(Layout.LOBBY_GAP.minX, 8.2, M.maxZ + 1.1) },
		{ Vector3.new(Layout.LOBBY_GAP.maxX, 0, M.maxZ - 0.1), Vector3.new(Layout.LOBBY_GAP.maxX + 0.25, 8.2, M.maxZ + 1.1) },
		{ Vector3.new(Layout.LOBBY_GAP.minX - 0.25, 8, M.maxZ - 0.1), Vector3.new(Layout.LOBBY_GAP.maxX + 0.25, 8.25, M.maxZ + 1.1) },
		{ Vector3.new(M.minX - 1.1, 0, Layout.KITCHEN_GAP.minZ - 0.25), Vector3.new(M.minX + 0.1, 8.2, Layout.KITCHEN_GAP.minZ) },
		{ Vector3.new(M.minX - 1.1, 0, Layout.KITCHEN_GAP.maxZ), Vector3.new(M.minX + 0.1, 8.2, Layout.KITCHEN_GAP.maxZ + 0.25) },
		{ Vector3.new(M.minX - 1.1, 8, Layout.KITCHEN_GAP.minZ - 0.25), Vector3.new(M.minX + 0.1, 8.25, Layout.KITCHEN_GAP.maxZ + 0.25) },
	} do
		box("DoorFrame", spec[1], spec[2], group("Structure"), { color = C.trim, collide = false })
	end

	-- windows: glass, sill, frame, mullion, rain streaks and faded curtains
	for _, x in Layout.WINDOWS_X do
		part("WindowGlass", Vector3.new(6, 4.3, 0.15), CFrame.new(x, 5.45, M.minZ - 0.5), group("Structure"), {
			color = C.glass,
			material = Enum.Material.Glass,
			transparency = 0.6,
			shadow = false,
		})
		part("WindowSill", Vector3.new(6.6, 0.22, 0.9), CFrame.new(x, 3.22, M.minZ + 0.1), group("Structure"), { color = C.trim })
		part("WindowFrame", Vector3.new(6.6, 0.18, 0.25), CFrame.new(x, 7.68, M.minZ - 0.2), group("Structure"), { color = C.trim, collide = false })
		for _, side in { -1, 1 } do
			part("WindowFrame", Vector3.new(0.18, 4.5, 0.25), CFrame.new(x + side * 3.1, 5.45, M.minZ - 0.2), group("Structure"), { color = C.trim, collide = false })
		end
		part("WindowMullion", Vector3.new(0.16, 4.3, 0.22), CFrame.new(x, 5.45, M.minZ - 0.4), group("Structure"), { color = C.trim, collide = false })
		part("WindowRainStreaks", Vector3.new(5.9, 4.2, 0.05), CFrame.new(x, 5.45, M.minZ - 0.38), group("Structure"), {
			transparency = 1,
			collide = false,
			shadow = false,
			query = false,
		}):SetAttribute("RainGlass", true)
		part("CurtainRod", Vector3.new(8.6, 0.1, 0.1), CFrame.new(x, 8.05, M.minZ + 0.45), group("Structure"), { color = C.metal, collide = false, shadow = false })
		for _, side in { -1, 1 } do
			part("Curtain", Vector3.new(1.1, 4.9, 0.28), CFrame.new(x + side * 3.7, 5.55, M.minZ + 0.45), group("Structure"), {
				color = C.curtain,
				material = Enum.Material.Fabric,
				collide = false,
			})
		end
	end
	-- building across the street (seen through the windows): a few lit windows, muted
	box("FacadeAcross", Vector3.new(-34, 0, -31), Vector3.new(36, 30, -30), group("Structure"), {
		color = Color3.fromRGB(46, 48, 52),
		surface = "brick_alley",
		tile = 10,
	})
	for i, x in { -20, -6, 4, 18 } do
		local lit = i % 2 == 0
		part("FacadeWindow", Vector3.new(3, 3, 0.2), CFrame.new(x, 6 + (i % 3) * 5, -29.9), group("Structure"), {
			color = if lit then C.amber else Color3.fromRGB(28, 32, 38),
			material = if lit then Enum.Material.Neon else Enum.Material.Glass,
			transparency = if lit then 0.5 else 0,
			collide = false,
		})
	end
	prop("urban__traffic_lights__street_light", Vector3.new(-6, 0, -24), Vector3.new(0, 0, 1), {})
	pointLight("exterior", Vector3.new(-6, 21, -23), C.cold, 30, 0.9)

	-- kitchenette: same clean plaster, a frosted window instead of boards
	local kitchenWall: PartOpts = { color = C.wall, surface = "wall_kitchen", tile = 9 }
	wall("KitchenNorth", "X", K.minZ - 0.5, K.minX - 1, M.minX - 1, ceil, {}, kitchenWall)
	wall("KitchenSouth", "X", K.maxZ + 0.5, K.minX - 1, M.minX - 1, ceil, {}, kitchenWall)
	wall("KitchenWest", "Z", K.minX - 0.5, K.minZ, K.maxZ, ceil, { { from = -10, to = -7, bottom = 3.6, top = 6.6 } }, kitchenWall)
	part("KitchenWindow", Vector3.new(0.15, 3, 3), CFrame.new(K.minX - 0.5, 5.1, -8.5), group("Structure"), {
		color = Color3.fromRGB(150, 165, 175),
		material = Enum.Material.Glass,
		transparency = 0.35,
		shadow = false,
	})
	part("KitchenWindowSill", Vector3.new(0.8, 0.2, 3.3), CFrame.new(K.minX + 0.1, 3.5, -8.5), group("Structure"), { color = C.trim })

	-- lobby
	wall("LobbyWest", "Z", L.minX - 0.5, L.minZ, L.maxZ + 1, ceil, {}, officeWall)
	wall("LobbyEast", "Z", L.maxX + 0.5, L.minZ, L.maxZ + 1, ceil, {}, officeWall)
	wall("LobbySouth", "X", L.maxZ + 0.5, L.minX - 1, L.maxX + 1, ceil, { doorGap(Layout.FRONT_DOOR.minX, Layout.FRONT_DOOR.maxX, Layout.FRONT_DOOR.height) }, officeWall)
	trim("Trim", "Z", L.minX - 0.5, L.minZ, L.maxZ, 1, {})
	trim("Trim", "Z", L.maxX + 0.5, L.minZ, L.maxZ, -1, {})

	-- utility hall
	local hallWall: PartOpts = { color = Color3.fromRGB(150, 152, 150), surface = "wall_concrete", tile = 7 }
	wall("HallNorth", "X", H.minZ - 0.5, H.minX + 0.5, H.maxX, 9, {}, hallWall)
	wall("HallSouth", "X", H.maxZ + 0.5, H.minX + 0.5, H.maxX, 9, {}, hallWall)
	box("HallHeader", Vector3.new(H.minX - 0.5, 8.5, H.minZ), Vector3.new(H.minX + 0.5, ceil, H.maxZ), group("Structure"), officeWall)
	-- exterior wall with the rear door
	local RD = Layout.REAR_DOOR
	wall("RearWall", "Z", RD.x + 0.5, -6, 16, 13, { doorGap(RD.minZ, RD.maxZ, RD.height) }, {
		color = C.brick,
		surface = "brick_alley",
		tile = 8,
	})
	box("RearDoorFrameTop", Vector3.new(RD.x - 0.1, RD.height, RD.minZ - 0.3), Vector3.new(RD.x + 1.1, RD.height + 0.4, RD.maxZ + 0.3), group("Structure"), { color = C.metal })

	-- alley walls
	local brick: PartOpts = { color = C.brick, surface = "brick_alley", tile = 8 }
	wall("AlleyNorth", "X", A.minZ - 0.5, RD.x, A.maxX + 16, 14, {}, brick)
	wall("AlleySouth", "X", A.maxZ + 0.5, RD.x, A.maxX + 16, 14, {}, brick)
	box("AlleyBack", Vector3.new(82, 0, A.minZ), Vector3.new(83, 14, A.maxZ), group("Structure"), { color = C.dark })
	-- invisible fence line beyond the alley mouth keeps players in the playable area
	local limit = box("AlleyLimit", Vector3.new(66, 0, A.minZ), Vector3.new(66.5, 14, A.maxZ), group("Structure"), { transparency = 1, collide = true })
	limit.CollisionGroup = "PlayerLimit"
	-- street outside the front door
	local S = Layout.STREET
	box("StreetLimitS", Vector3.new(S.minX, 0, S.maxZ), Vector3.new(S.maxX, 14, S.maxZ + 1), group("Structure"), { transparency = 1 })
	box("StreetLimitW", Vector3.new(S.minX - 1, 0, S.minZ), Vector3.new(S.minX, 14, S.maxZ), group("Structure"), { transparency = 1 })
	box("StreetLimitE", Vector3.new(S.maxX, 0, S.minZ), Vector3.new(S.maxX + 1, 14, S.maxZ), group("Structure"), { transparency = 1 })
	box("CurbFacade", Vector3.new(S.minX - 4, 0, S.maxZ + 1), Vector3.new(S.maxX + 4, 22, S.maxZ + 2), group("Structure"), {
		color = Color3.fromRGB(42, 42, 46),
		surface = "brick_alley",
		tile = 10,
	})
	-- rooftop caps so the sky is not visible through gaps
	box("RoofCap", Vector3.new(-32, ceil + 1, -15), Vector3.new(37, ceil + 1.6, 24), group("Structure"), { color = C.dark })
end

local function buildDesks(refs: Refs)
	local props = group("Props")
	-- a few purposeful objects per desk; some surfaces stay almost empty
	local deskItems: { { { key: string, dx: number, dz: number, yaw: number } } } = {
		{ { key = "office__extras__mug", dx = -2.2, dz = 0.2, yaw = 40 }, { key = "office__stationary__paper_stack", dx = -1.5, dz = -0.3, yaw = 12 } },
		{ { key = "office__book_things__file_binder", dx = -2.4, dz = -0.6, yaw = 100 } },
		{ { key = "office__stationary__paper_stack_large", dx = -1.6, dz = -0.2, yaw = -8 }, { key = "office__extras__circular_desklamp", dx = -3.0, dz = -0.9, yaw = 0 } },
		{ { key = "office__extras__mug_alt2", dx = -2.0, dz = 0.3, yaw = 160 } },
		{ { key = "office__book_things__books_alt", dx = -2.6, dz = -0.6, yaw = 0 }, { key = "office__extras__square_desklamp", dx = -3.0, dz = -1.0, yaw = 0 } },
		{ { key = "office__stationary__paper_single_sheet", dx = -1.8, dz = 0.4, yaw = 25 } },
	}
	local lampDesks: { [number]: boolean } = { [3] = true, [5] = true }
	for i, d in Layout.DESKS do
		local f = d.front
		local right = Vector3.new(-f.Z, 0, f.X) -- right-hand side seen by the desk user
		local top = Layout.DESK_TOP
		prop(d.art, d.pos, f, { collide = true, pad = 0.1 })
		-- seated side faces the desk: chair front points back toward the desk.
		-- Chairs get a slim collision box so the first-person camera never clips them.
		prop(d.chair, d.pos + f * 2.7 + right * 0.4, -f, { yaw = (i * 17) % 30 - 15, collide = true, pad = 0.5 })
		-- monitor, keyboard, mouse
		prop("office__computers__computer_monitor", d.pos - f * 0.7 + Vector3.new(0, top, 0), f)
		prop("office__computers__computer_keyboard", d.pos + f * 0.7 + Vector3.new(0, top, 0), f)
		prop("office__computers__computer_mouse", d.pos + f * 0.8 + right * 1.4 + Vector3.new(0, top, 0), f)
		for _, item in deskItems[i] do
			prop(item.key, d.pos + f * item.dz + right * item.dx + Vector3.new(0, top, 0), f, { yaw = item.yaw })
		end
		if lampDesks[i] then
			pointLight("lamps", d.pos - f * 0.6 - right * 3.0 + Vector3.new(0, top + 1.2, 0), C.amber, 8, 0.7)
		end

		-- source computer tower (holds the drive) on the desk's right side
		local towerKey = if i % 2 == 0 then "office__computers__computer_tower_alt" else "office__computers__computer_tower"
		local towerPos = d.pos - f * 0.4 + right * 2.75 + Vector3.new(0, top, 0)
		prop(towerKey, towerPos, f)
		local towerCf = Layout.facing(towerPos + Vector3.new(0, 1.07, 0), f)
		local pc = part("SourcePC_" .. i, Vector3.new(1.0, 2.15, 2.15), towerCf, group("Interactive"), {
			transparency = 1,
			collide = false,
		})
		pc:SetAttribute("Desk", i)
		local led = part("SourceLed_" .. i, Vector3.new(0.12, 0.12, 0.05), towerCf * CFrame.new(0.25, 0.75, -1.09), group("Interactive"), {
			color = Color3.fromRGB(80, 255, 120),
			material = Enum.Material.Neon,
			collide = false,
			shadow = false,
		})
		refs.sourcePCs[i] = pc
		refs.sourceLeds[i] = led
		-- where the drive visibly sits while installed (front bay)
		refs.drivePlace[i] = towerCf * CFrame.new(0, 0.35, -0.95)
		-- source monitor screen surface (harmless disturbance lights it up)
		local monCf = Layout.facing(d.pos - f * 0.7 + Vector3.new(0, top + 1.05, 0), f) * CFrame.new(0, 0, 0.52)
		local screen = part("SourceScreen_" .. i, Vector3.new(1.55, 1.15, 0.05), monCf, group("Interactive"), {
			color = Color3.fromRGB(10, 14, 12),
			collide = false,
			shadow = false,
		})
		refs.sourceScreens[i] = screen
	end

	-- low grey partitions between the two desk rows and at the cluster ends
	for _, x in { -14, -5.6, 2.8 } do
		prop("office__dividers__divider_black_low", Vector3.new(x, 0, 0), Vector3.new(0, 0, 1), { collide = true, scale = 0.8 })
	end
	prop("office__dividers__divider_black_low_half", Vector3.new(-18.6, 0, -3.2), Vector3.new(1, 0, 0), { collide = true, scale = 0.8 })
	prop("office__dividers__divider_black_low", Vector3.new(7.3, 0, 0), Vector3.new(1, 0, 0), { collide = true, scale = 0.8 })

	-- the chair that can "shift" on its own (dynamic mesh)
	local shift = prop("office__chairs__conference_chair_grey", Vector3.new(-9.8, 0, 7.4), Vector3.new(0, 0, -1), { dynamic = true })
	assert(shift, "shift chair")
	refs.shiftChair = shift
	local _ = props
end

local function buildWorkstation(refs: Refs)
	local W = Layout.WORKSTATION
	local f = W.facing -- operator looks into the corner
	prop("office__desks__desk2_corner", W.desk, Vector3.new(-1, 0, 0), { collide = false })
	-- corner desk collision: two slabs along the walls so the chair area stays open
	box("WSDeskNorth", Vector3.new(14.3, 0, -14), Vector3.new(22, Layout.DESK_TOP, -10.9), group("Collision"), { transparency = 1 })
	box("WSDeskEast", Vector3.new(18.9, 0, -10.9), Vector3.new(22, Layout.DESK_TOP, -6.3), group("Collision"), { transparency = 1 })

	prop("office__computers__computer_monitor", W.monitor, -f, { scale = 1.15 })
	prop("office__computers__computer_keyboard", W.monitor - f * 1.4 + Vector3.new(0, 0, 0), -f)
	prop("office__computers__computer_mouse", W.monitor - f * 1.5 + Vector3.new(1.1, 0, 1.1), -f)
	prop("office__computers__desktop_brick", Vector3.new(15.6, Layout.DESK_TOP, -13.2), Vector3.new(0, 0, 1))
	prop("office__extras__circular_desklamp", W.lamp, Vector3.new(0, 0, 1))
	prop("office__extras__mug_alt", Vector3.new(19.2, Layout.DESK_TOP, -13.3), Vector3.new(0, 0, 1))
	prop("office__extras__desk_phone_with_cable", Vector3.new(21.1, Layout.DESK_TOP, -12.4), Vector3.new(-1, 0, 0))
	prop("office__stationary__pen2", Vector3.new(18.4, Layout.DESK_TOP, -12.3), Vector3.new(0, 0, 1))
	refs.workstationLamp = pointLight("workstation", W.lamp + Vector3.new(0, 1.4, 0.5), C.amber, 11, 1.0)
	refs.workstationLamp.Shadows = true

	-- physical monitor surface showing simplified job progress to the team
	local monCf = Layout.facing(W.monitor + Vector3.new(0, 1.2, 0), -f) * CFrame.new(0, 0, 0.62)
	local screen = part("WorkstationScreen", Vector3.new(1.8, 1.32, 0.05), monCf, group("Interactive"), {
		color = Color3.fromRGB(16, 32, 60),
		material = Enum.Material.Neon,
		collide = false,
		shadow = false,
	})
	refs.monitorScreen = screen

	-- chair + seat (touch-sitting disabled; players use the prompt)
	prop("office__chairs__office_chair_grey", W.chair, f)
	local seatCf = CFrame.lookAt(W.chair + Vector3.new(0, 1.45, 0), W.chair + f + Vector3.new(0, 1.45, 0))
	local seat = Instance.new("Seat")
	seat.Name = "WorkstationSeat"
	seat.Anchored = true
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.CFrame = seatCf
	seat.Transparency = 1
	seat.CanTouch = false
	seat.CanCollide = false
	seat.Parent = group("Interactive")
	refs.seat = seat
	refs.seatPromptPart = part("SeatPrompt", Vector3.new(1, 1, 1), CFrame.new(W.chair + Vector3.new(0, 2.6, 0)), group("Interactive"), {
		transparency = 1,
		collide = false,
	})

	-- drive dock (cream box with a slot and a status LED)
	local dockCf = CFrame.new(W.dock + Vector3.new(0, 0.45, 0)) * CFrame.Angles(0, math.rad(90), 0)
	local dock = part("DriveDock", Vector3.new(1.6, 0.9, 1.9), dockCf, group("Interactive"), {
		color = Color3.fromRGB(196, 190, 170),
	})
	label(dock, Enum.NormalId.Front, "DOCK", Color3.fromRGB(40, 40, 40))
	part("DockSlot", Vector3.new(1.25, 0.12, 0.05), dockCf * CFrame.new(0, 0.12, -0.96), group("Interactive"), { color = C.dark, collide = false })
	refs.dock = dock
	refs.dockLed = part("DockLed", Vector3.new(0.12, 0.12, 0.05), dockCf * CFrame.new(0.6, -0.25, -0.96), group("Interactive"), {
		color = Color3.fromRGB(60, 60, 60),
		material = Enum.Material.Neon,
		collide = false,
	})
	refs.outbox = part("Outbox", Vector3.new(1.4, 0.3, 1.0), CFrame.new(Layout.OUTBOX + Vector3.new(0, 0.15, 0)), group("Interactive"), {
		color = Color3.fromRGB(90, 90, 96),
	})
	label(refs.outbox, Enum.NormalId.Top, "OUT TRAY", Color3.new(0.9, 0.9, 0.9))

	-- drive rack beside the workstation
	local R = Layout.RACK
	prop("classic64__blend__metal_rack_stackable", R.pos, R.front, { collide = true })
	for i = 1, 6 do
		local x = R.slotX0 + (i - 1) * R.slotDX
		refs.stagingSlots[i] = CFrame.new(x, R.stagingY + 0.75, R.slotZ) * CFrame.Angles(0, 0, math.rad(90))
		refs.erasedSlots[i] = CFrame.new(x, R.erasedY + 0.75, R.slotZ) * CFrame.Angles(0, 0, math.rad(90))
	end
	local rackSign = part("RackSign", Vector3.new(5, 0.9, 0.1), CFrame.new(R.pos + Vector3.new(0, 5.6, -0.6)), group("Interactive"), {
		color = Color3.fromRGB(226, 221, 200),
		collide = false,
	})
	label(rackSign, Enum.NormalId.Back, "DRIVE RACK  top: STAGING / RECOVERY   lower: ERASED", Color3.fromRGB(30, 30, 30))
	refs.recoveryRack = part("RackPrompt", Vector3.new(5, 3.5, 1), CFrame.new(R.pos + Vector3.new(0, 2.6, 0.6)), group("Interactive"), {
		transparency = 1,
		collide = false,
	})

	-- door status light visible from the workstation chair
	refs.doorLight = part("DoorStatusLight", Vector3.new(0.5, 0.5, 0.2), CFrame.new(Layout.DOOR_LIGHT), group("Interactive"), {
		color = Color3.fromRGB(60, 255, 90),
		material = Enum.Material.Neon,
		collide = false,
	})
	local dl = Instance.new("PointLight")
	dl.Range = 6
	dl.Brightness = 0.6
	dl.Color = Color3.fromRGB(60, 255, 90)
	dl.Parent = refs.doorLight
	local dlSign = part("DoorStatusSign", Vector3.new(2.6, 0.6, 0.1), CFrame.new(Layout.DOOR_LIGHT + Vector3.new(0, -0.7, 0)) * CFrame.Angles(0, math.rad(90), 0), group("Interactive"), {
		color = C.dark,
		collide = false,
	})
	label(dlSign, Enum.NormalId.Front, "REAR DOOR", Color3.new(0.9, 0.9, 0.9))
	label(dlSign, Enum.NormalId.Back, "REAR DOOR", Color3.new(0.9, 0.9, 0.9))
end

local function buildRooms(refs: Refs)
	local M = Layout.MAIN
	-- south wall: bookcase, cabinets, printer
	prop("office__book_things__book_case_with_back_small", Vector3.new(-18, 0, M.maxZ - 0.9), Vector3.new(0, 0, -1), { collide = true })
	prop("office__book_things__books", Vector3.new(-18, 3.3, M.maxZ - 0.9), Vector3.new(0, 0, -1))
	prop("office__file_cabinets__file_cabinet_largest", Vector3.new(-13, 0, M.maxZ - 1.3), Vector3.new(0, 0, -1), { collide = true })
	prop("office__file_cabinets__file_cabinet_larger_open", Vector3.new(-4, 0, M.maxZ - 1.3), Vector3.new(0, 0, -1), { collide = true })
	prop("office__file_cabinets__file_cabinet_smaller_with_shelfs", Vector3.new(3.5, 0, M.maxZ - 1.2), Vector3.new(0, 0, -1), { collide = true })
	prop("office__book_things__file_binder_alt", Vector3.new(3.2, 3.7, M.maxZ - 1.2), Vector3.new(0, 0, -1))
	prop("office__book_things__file_binder_alt2", Vector3.new(3.6, 3.7, M.maxZ - 1.2), Vector3.new(0, 0, -1))
	prop("office__extras__whiteboard", Vector3.new(M.minX + 0.6, 0, 7), Vector3.new(1, 0, 0), { collide = true })
	prop("office__extras__wall_clock", Vector3.new(4, 7.2, M.minZ + 0.1), Vector3.new(0, 0, 1))
	prop("office__couches__armchair_pattern", Vector3.new(-19.6, 0, 11.4), Vector3.new(1, 0, -0.4), { collide = true, pad = 0.4 })
	prop("classic64__blend__fire_extenguisher_case", Vector3.new(M.maxX - 0.1, 3.4, -3), Vector3.new(-1, 0, 0))
	prop("classic64__blend__sign_nosmoking", Vector3.new(-1, 6.2, M.maxZ - 0.1), Vector3.new(0, 0, -1), { scale = 1.6 })
	prop("office__extras__water_cooler_bottle_attached", Vector3.new(M.maxX - 1, 0, 1.6), Vector3.new(-1, 0, 0), { collide = true })
	prop("classic64__blend__door_brown_a", Vector3.new(-20.8, 0, M.maxZ - 0.05), Vector3.new(0, 0, -1), { scale = 1.0 })
	prop("classic64__blend__papers_envolope_redacted", Vector3.new(20.4, Layout.DESK_TOP, -11.2), Vector3.new(-1, 0, 1), { scale = 1.6 })
	prop("classic64__blend__panel_electrical_closed", Vector3.new(-30.9, 4.2, -5.6), Vector3.new(1, 0, 0), { scale = 2.2 })

	-- printer (simple shapes) on a cabinet by the south wall
	local P = Layout.PRINTER
	local printer = part("Printer", Vector3.new(2.2, 1.2, 1.8), CFrame.new(P + Vector3.new(0, 0.6, 0)), group("Interactive"), {
		color = Color3.fromRGB(190, 186, 170),
	})
	part("PrinterTray", Vector3.new(1.6, 0.1, 0.9), CFrame.new(P + Vector3.new(0, 1.25, -0.7)), group("Interactive"), { color = C.dark, collide = false })
	refs.printer = printer
	refs.printerLed = part("PrinterLed", Vector3.new(0.15, 0.15, 0.05), CFrame.new(P + Vector3.new(0.8, 0.9, -0.92)), group("Interactive"), {
		color = Color3.fromRGB(40, 60, 40),
		material = Enum.Material.Neon,
		collide = false,
	})
	prop("office__file_cabinets__file_cabinet_small", Vector3.new(P.X, 0, P.Z), Vector3.new(0, 0, -1), { collide = true, scale = 1 })

	-- notice board with the procedures (evidence against false instructions)
	local board = part("NoticeBoard", Vector3.new(4.2, 3.2, 0.15), CFrame.new(12.5, 5.6, M.minZ + 0.1), group("Interactive"), {
		color = Color3.fromRGB(140, 108, 76),
		collide = false,
	})
	refs.noticeBoards = { board }

	-- kitchenette: counter, coffee, fridge, bin. Nothing stored on the floor.
	local K = Layout.KITCHEN
	box("Counter", Vector3.new(K.minX, 0, K.minZ), Vector3.new(K.minX + 2.6, 3.1, K.maxZ - 2), group("Structure"), {
		color = Color3.fromRGB(170, 150, 120),
		surface = "wall_lower",
		tile = 4,
	})
	box("CounterTop", Vector3.new(K.minX, 3.05, K.minZ), Vector3.new(K.minX + 2.7, 3.15, K.maxZ - 2), group("Structure"), { color = C.trim, collide = false })
	prop("office__extras__coffee_machine", Vector3.new(K.minX + 1.2, 3.1, -9.5), Vector3.new(1, 0, 0), { scale = 0.65 })
	prop("office__extras__mug_alt3", Vector3.new(K.minX + 1.5, 3.1, -7.8), Vector3.new(1, 0, 0))
	prop("office__extras__mug_alt2", Vector3.new(K.minX + 1.2, 3.1, -7.3), Vector3.new(1, 0, 0))
	prop("cute3d__blend__fridge", Vector3.new(K.minX + 2, 0, K.minZ + 1.6), Vector3.new(1, 0, 0), { collide = true, pad = 0.3 })
	local trashPos = Layout.KITCHEN_TRASH
	prop("urban__litter__trashcan__trash_can", trashPos, Vector3.new(1, 0, 0), { collide = true, scale = 0.75 })
	refs.kitchenTrash = part("KitchenTrash", Vector3.new(2.6, 3.5, 2.4), CFrame.new(trashPos + Vector3.new(0, 1.75, 0)), group("Interactive"), {
		transparency = 1,
		collide = false,
	})

	-- lobby + time clock + front doors
	local L = Layout.LOBBY
	prop("office__couches__couch_pattern", Vector3.new(17.6, 0, 16.4), Vector3.new(-1, 0, 0), { collide = true, pad = 0.4 })
	prop("oldstuff__telephone", Vector3.new(8, 3.1, 21.6), Vector3.new(0, 0, -1))
	box("ReceptionDesk", Vector3.new(L.minX, 0, 20.4), Vector3.new(L.minX + 4.2, 3.1, 22.5), group("Structure"), {
		color = Color3.fromRGB(120, 90, 66),
		surface = "wall_lower",
		tile = 4,
	})
	box("ReceptionTop", Vector3.new(L.minX, 3.05, 20.3), Vector3.new(L.minX + 4.3, 3.15, 22.6), group("Structure"), { color = C.trim, collide = false })
	prop("office__extras__wall_clock", Vector3.new(13, 8.4, L.minZ + 0.6), Vector3.new(0, 0, 1))
	prop("classic64__blend__papers_log_1_stack", Vector3.new(7.4, 3.1, 21.0), Vector3.new(0, 0, -1))
	local tc = part("TimeClock", Vector3.new(0.7, 1.8, 1.4), CFrame.new(Layout.TIME_CLOCK), group("Interactive"), {
		color = Color3.fromRGB(196, 190, 170),
	})
	label(tc, Enum.NormalId.Right, "TIME CLOCK", Color3.fromRGB(30, 30, 30))
	part("CardRack", Vector3.new(0.2, 1.8, 1.2), CFrame.new(Layout.TIME_CLOCK + Vector3.new(0.1, -0.2, -1.6)), group("Interactive"), {
		color = Color3.fromRGB(120, 120, 120),
		collide = false,
	})
	refs.timeClock = tc
	local FD = Layout.FRONT_DOOR
	local half = (FD.maxX - FD.minX) / 2
	for i = 0, 1 do
		local x0 = FD.minX + i * half
		local door = part("FrontDoor" .. (i + 1), Vector3.new(half - 0.1, FD.height, 0.25), CFrame.new(x0 + half / 2, FD.height / 2, FD.z + 0.5), group("Interactive"), {
			color = C.glass,
			material = Enum.Material.Glass,
			transparency = 0.5,
		})
		table.insert(refs.frontDoors, door)
		part("FrontDoorBar", Vector3.new(half - 0.6, 0.2, 0.2), CFrame.new(x0 + half / 2, 3.6, FD.z + 0.3), door, { color = C.metal, collide = false })
	end
	local exit = part("ExitSign", Vector3.new(1.8, 0.6, 0.15), CFrame.new(13, FD.height + 0.7, FD.z + 0.3), group("Interactive"), {
		color = Color3.fromRGB(120, 20, 20),
		material = Enum.Material.Neon,
		collide = false,
	})
	label(exit, Enum.NormalId.Front, "EXIT", Color3.new(1, 0.85, 0.85))
	refs.escapeZone = box("EscapeZone", Vector3.new(Layout.ESCAPE_ZONE.minX, 0, Layout.ESCAPE_ZONE.minZ), Vector3.new(Layout.ESCAPE_ZONE.maxX, 8, Layout.ESCAPE_ZONE.maxZ), group("Interactive"), {
		transparency = 1,
		collide = false,
	})

	-- utility hall: breakers, thermostat, heater, a pipe run and a duct
	local H = Layout.HALL
	local B = Layout.BREAKER
	prop("classic64__blend__panel_electrical_open", B.panel - Vector3.new(0, 1.5, 0), Vector3.new(0, 0, 1), { scale = 2.2 })
	local backing = part("BreakerBacking", Vector3.new(3.4, 2.4, 0.2), CFrame.new(B.panel + Vector3.new(0, 0, 0.1)), group("Interactive"), {
		color = Color3.fromRGB(80, 84, 88),
		surface = "metal_panel",
		tile = 3,
	})
	local header = part("BreakerHeader", Vector3.new(3.4, 0.45, 0.1), CFrame.new(B.panel + Vector3.new(0, 1.5, 0.15)), group("Interactive"), {
		color = Color3.fromRGB(214, 196, 86),
		collide = false,
	})
	label(header, Enum.NormalId.Back, "BREAKERS  - reset tripped switches -", Color3.fromRGB(20, 20, 20))
	for _, sw in B.switches do
		local s = part("Breaker_" .. sw.id, Vector3.new(0.45, 0.9, 0.3), CFrame.new(sw.pos), group("Interactive"), {
			color = Color3.fromRGB(40, 40, 40),
		})
		refs.breakerSwitches[sw.id] = s
		local lamp = part("BreakerLamp_" .. sw.id, Vector3.new(0.22, 0.22, 0.1), CFrame.new(sw.pos + Vector3.new(0, 0.75, 0)), group("Interactive"), {
			color = Color3.fromRGB(60, 255, 90),
			material = Enum.Material.Neon,
			collide = false,
		})
		refs.breakerLamps[sw.id] = lamp
		local tag = part("BreakerTag_" .. sw.id, Vector3.new(0.75, 0.3, 0.05), CFrame.new(sw.pos + Vector3.new(0, -0.72, 0.1)), group("Interactive"), {
			color = Color3.fromRGB(240, 240, 230),
			collide = false,
		})
		label(tag, Enum.NormalId.Back, sw.label, Color3.fromRGB(10, 10, 10))
	end
	local _ = backing
	prop("classic64__blend__panel_thermostat", Layout.THERMOSTAT, Vector3.new(0, 0, -1), { scale = 2.4 })
	refs.thermostat = part("ThermostatPrompt", Vector3.new(1, 1, 0.4), CFrame.new(Layout.THERMOSTAT + Vector3.new(0, 0.2, -0.2)), group("Interactive"), {
		transparency = 1,
		collide = false,
	})
	prop("classic64__blend__panel_heater", Vector3.new(32.5, 0.4, H.maxZ - 0.3), Vector3.new(0, 0, -1), { scale = 1.6 })
	prop("classic64__blend__panel_electric", Vector3.new(24.2, 3.2, H.minZ + 0.25), Vector3.new(0, 0, 1), { scale = 1.4 })
	prop("classic64__blend__electrical_junctionbox_small", Vector3.new(31.4, 5.2, H.minZ + 0.1), Vector3.new(0, 0, 1), { scale = 3 })
	for x = 23, 35, 3.5 do
		prop("urban__pipes__pipe", Vector3.new(x, 8.2, H.minZ + 0.55), Vector3.new(0, 0, 1), { yaw = 0, scale = 1 })
	end
	prop("urban__vents__duct_long", Vector3.new(28, 8.3, H.maxZ - 1.0), Vector3.new(0, 0, 1))
	prop("urban__vents__duct_long", Vector3.new(31.5, 8.3, H.maxZ - 1.0), Vector3.new(0, 0, 1))
	prop("urban__vents__duct_corner_rounded", Vector3.new(24.6, 8.3, H.maxZ - 1.0), Vector3.new(0, 0, 1))
	prop("urban__vents__vent_cover", Vector3.new(26, 9, 4.2), Vector3.new(0, 0, 1))

	-- procedures notice at the rear door
	local rearNotice = part("RearDoorNotice", Vector3.new(0.1, 1.6, 1.3), CFrame.new(35.85, 4.6, 8.3), group("Interactive"), {
		color = Color3.fromRGB(235, 230, 205),
		collide = false,
	})
	label(rearNotice, Enum.NormalId.Left, "KEEP THIS DOOR LATCHED AFTER 22:00 - FACILITIES", Color3.fromRGB(150, 20, 20))
	table.insert(refs.noticeBoards, rearNotice)
end

local function buildRearDoor(refs: Refs)
	local RD = Layout.REAR_DOOR
	local width = RD.maxZ - RD.minZ
	local hinge = CFrame.new(RD.x + 0.5, 0, RD.minZ)
	refs.rearDoorHinge = hinge
	local door = part("RearDoor", Vector3.new(0.3, RD.height - 0.05, width - 0.1), hinge * CFrame.new(0, RD.height / 2, width / 2), group("Interactive"), {
		color = Color3.fromRGB(96, 100, 104),
		surface = "metal_door",
		tile = 4,
	})
	part("PushBar", Vector3.new(0.25, 0.25, width - 0.8), door.CFrame * CFrame.new(-0.25, -0.2, 0), door, {
		color = Color3.fromRGB(170, 170, 170),
		collide = false,
	})
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = door
	weld.Part1 = door:FindFirstChild("PushBar") :: BasePart
	weld.Parent = door
	refs.rearDoor = door
	refs.doorPromptPart = part("RearDoorPrompt", Vector3.new(1.2, 1.2, 1.2), CFrame.new(RD.x - 0.8, 3.6, (RD.minZ + RD.maxZ) / 2), group("Interactive"), {
		transparency = 1,
		collide = false,
	})
	local exitSign = part("RearExitSign", Vector3.new(0.15, 0.5, 1.6), CFrame.new(RD.x - 0.1, RD.height + 0.8, (RD.minZ + RD.maxZ) / 2), group("Interactive"), {
		color = Color3.fromRGB(120, 20, 20),
		material = Enum.Material.Neon,
		collide = false,
	})
	label(exitSign, Enum.NormalId.Left, "EXIT", Color3.new(1, 0.85, 0.85))
end

local function buildAlley(refs: Refs)
	local A = Layout.ALLEY
	local D = Layout.DUMPSTER
	prop("urban__litter__dumpsters__dumpster_lid_closed", D, Vector3.new(0, 0, -1), { collide = true, pad = 0.2 })
	refs.dumpster = part("DumpsterPrompt", Vector3.new(7, 6, 3), CFrame.new(D + Vector3.new(0, 3, -2.4)), group("Interactive"), {
		transparency = 1,
		collide = false,
	})
	prop("urban__litter__dumpsters__dumpster_trashpile_1", Vector3.new(53, 0, 13.6), Vector3.new(0, 0, -1), { collide = false })
	prop("urban__litter__trash__trashbag_1", Vector3.new(42.5, 0, 14.6), Vector3.new(0, 0, -1))
	prop("urban__litter__trash__trashbag_2_white", Vector3.new(43.8, 0, 14.4), Vector3.new(1, 0, -1))
	prop("urban__litter__metal_trashcan__metaltrashcan_closed", Vector3.new(38.6, 0, 14.6), Vector3.new(0, 0, -1), { collide = true })
	prop("urban__litter__metal_trashcan__metaltrashcan_overflowing", Vector3.new(39.2, 0, -4.6), Vector3.new(0, 0, 1), { collide = true })
	prop("classic64__blend__wood_pallet", Vector3.new(60, 0, 14), Vector3.new(0, 0, 1), { scale = 1.6 })
	prop("classic64__blend__wood_pallet", Vector3.new(60.4, 0.55, 13.8), Vector3.new(1, 0, 0.3), { scale = 1.6 })
	prop("oldstuff__barrel", Vector3.new(62.5, 0, -4), Vector3.new(0, 0, 1), { collide = true })
	prop("classic64__blend__manhole_cover", Vector3.new(50, 0.02, 5), Vector3.new(0, 0, 1), { scale = 1.2 })
	for _, z in { -2, 12 } do
		prop("classic64__blend__yellow_post", Vector3.new(37.6, 0, z), Vector3.new(0, 0, 1), { collide = true })
	end
	prop("urban__traffic_lights__street_light", Vector3.new(45, 0, -5.2), Vector3.new(0, 0, 1))
	pointLight("alley", Vector3.new(45, 21.5, -4), C.cold, 34, 1.0)
	prop("urban__cones_barriers__bollards__concrete_retro_bollard_light", Vector3.new(38.5, 0, 9.5), Vector3.new(-1, 0, 0), { collide = true })
	pointLight("alley", Vector3.new(38.5, 4.2, 9.5), C.amber, 9, 0.5)
	-- broken wooden hoarding at the alley mouth: the figure comes from beyond
	prop("urban__fences__plackard_wall__plackard_closed", Vector3.new(64.5, 0, -2.6), Vector3.new(-1, 0, 0), { collide = true })
	prop("urban__fences__plackard_wall__plackard_broken", Vector3.new(64.5, 0, 13.4), Vector3.new(-1, 0, 0), { collide = true })
	-- outdoor street (front) dressing
	prop("urban__traffic_lights__street_light", Vector3.new(19, 0, 31), Vector3.new(0, 0, -1))
	pointLight("exterior", Vector3.new(19, 21.5, 30), C.cold, 30, 0.9)
	prop("urban__litter__metal_trashcan__metaltrashcan_closed", Vector3.new(8, 0, 25), Vector3.new(0, 0, -1), { collide = true })

	-- the figure (dynamic mesh, welded to the NPC root by the Threat system)
	refs.threatAnchorKey = "characters__male__character_04"

	-- missing crew silhouettes for late disturbances and the ending (hidden by default)
	local crew: { { key: string, pos: Vector3 } } = {
		{ key = "characters__male__character_01", pos = Vector3.new(-10, 0, -22) },
		{ key = "characters__male__character_05", pos = Vector3.new(2, 0, -22.5) },
	}
	for i, spec in crew do
		local fig = prop(spec.key, spec.pos, Vector3.new(0, 0, 1), { dynamic = true })
		if fig then
			fig:SetAttribute("ArtHidden", true)
			fig.Name = "CrewFigure" .. i
			table.insert(refs.crewFigures, fig)
		end
	end
	local _ = A
end

local function buildLights(refs: Refs)
	local ceil = Layout.CEILING
	for _, p in Layout.LIGHTS.main do
		fluorescent("main", p, ceil)
	end
	for _, p in Layout.LIGHTS.kitchen do
		fluorescent("kitchen", p, ceil - 1, Color3.fromRGB(240, 232, 212), 0.7)
	end
	for _, p in Layout.LIGHTS.lobby do
		fluorescent("lobby", p, ceil, Color3.fromRGB(236, 232, 220), 0.7)
	end
	for _, p in Layout.LIGHTS.hall do
		local bulb = part("Bulb", Vector3.new(0.5, 0.6, 0.5), CFrame.new(p.X, 8.4, p.Z), group("Lights"), {
			color = Color3.fromRGB(230, 200, 140),
			material = Enum.Material.Neon,
			collide = false,
		})
		local l = Instance.new("PointLight")
		l.Color = C.amber
		l.Range = 12
		l.Brightness = 0.8
		l.Shadows = true
		l.Parent = bulb
		lightGroups.hall = lightGroups.hall or {}
		table.insert(lightGroups.hall, l)
		fixtures.hall = fixtures.hall or {}
		table.insert(fixtures.hall, bulb)
	end
	-- battery emergency lights: dim red, always on during a blackout
	local emergency: { Light } = {}
	for _, p in {
		Vector3.new(13, 7.8, 13.6),
		Vector3.new(28, 7.8, 6),
		Vector3.new(0, 7.8, -13.4),
		Vector3.new(-20, 7.8, 0),
		Vector3.new(-26, 7.5, -8),
		Vector3.new(16, 7.8, -7),
	} do
		local l = pointLight("emergency", p, Color3.fromRGB(255, 60, 50), 18, 0)
		table.insert(emergency, l)
	end
	refs.emergencyLights = emergency
	refs.deskLamps = lightGroups.lamps or {}
	refs.lights = lightGroups
	refs.fixtures = fixtures
end

local function collisionGroups()
	local PhysicsService = game:GetService("PhysicsService")
	for _, g in { "PlayerLimit", "Figure" } do
		if not PhysicsService:IsCollisionGroupRegistered(g) then
			PhysicsService:RegisterCollisionGroup(g)
		end
	end
	PhysicsService:CollisionGroupSetCollidable("PlayerLimit", "Figure", false)
end

function MapBuilder.init()
	collisionGroups()
	local existing = workspace:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "Map"
	groups = {}
	lightGroups = {}
	fixtures = {}

	local refs: Refs = {
		map = root,
		interactive = group("Interactive"),
		sourcePCs = {},
		sourceLeds = {},
		sourceScreens = {},
		drivePlace = {},
		stagingSlots = {},
		erasedSlots = {},
		recoveryRack = (nil :: any) :: BasePart,
		dock = (nil :: any) :: BasePart,
		dockLed = (nil :: any) :: BasePart,
		seat = (nil :: any) :: Seat,
		seatPromptPart = (nil :: any) :: BasePart,
		monitorScreen = (nil :: any) :: BasePart,
		breakerSwitches = {},
		breakerLamps = {},
		rearDoor = (nil :: any) :: BasePart,
		rearDoorHinge = CFrame.identity,
		doorLight = (nil :: any) :: BasePart,
		doorPromptPart = (nil :: any) :: BasePart,
		frontDoors = {},
		timeClock = (nil :: any) :: BasePart,
		kitchenTrash = (nil :: any) :: BasePart,
		dumpster = (nil :: any) :: BasePart,
		thermostat = (nil :: any) :: BasePart,
		printer = (nil :: any) :: BasePart,
		printerLed = (nil :: any) :: BasePart,
		outbox = (nil :: any) :: BasePart,
		threatAnchorKey = "",
		shiftChair = (nil :: any) :: BasePart,
		lights = {},
		emergencyLights = {},
		deskLamps = {},
		workstationLamp = (nil :: any) :: Light,
		fixtures = {},
		noticeBoards = {},
		crewFigures = {},
		escapeZone = (nil :: any) :: BasePart,
	}
	MapBuilder.refs = refs

	buildStructure()
	buildDesks(refs)
	buildWorkstation(refs)
	buildRooms(refs)
	buildRearDoor(refs)
	buildAlley(refs)
	buildLights(refs)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "OfficeSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 0.2, 4)
	spawn.CFrame = CFrame.new(12, 0.1, 9)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root

	root.Parent = workspace
	workspace:SetAttribute("MapReady", true)
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">Pings</string>
            <string name="Source"><![CDATA[--!strict
-- Simple team pings so voice chat is never required. Validated and
-- rate-limited; the server rebroadcasts to everyone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Net = require(ReplicatedStorage.Shared.Net)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)

local Pings = {}

function Pings.init()
	local remote = Net.remote("Ping")
	remote.OnServerEvent:Connect(function(player, pos: unknown)
		local rate = Config.RATE.ping
		if not Guard.allow(player, "ping", rate[1], rate[2]) then
			return
		end
		if typeof(pos) ~= "Vector3" then
			return
		end
		local v = pos :: Vector3
		if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
			return
		end
		if not Guard.near(player, v, Config.PING.maxDistance) or not Layout.inMap(v) then
			return
		end
		if player:GetAttribute("Escaped") == true then
			return
		end
		remote:FireAllClients(v, player.DisplayName, Layout.regionOf(v))
	end)
end

return Pings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">PlayerStatus</string>
            <string name="Source"><![CDATA[--!strict
-- Caught/downed state, teammate rescue, escape, and team-wipe detection.
-- Non-graphic: a caught player slumps in place and needs a teammate's hand.
-- Solo players and full-team wipes go straight to the checkpoint system
-- (via the TeamWiped signal, so this module never requires Checkpoints).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local Workstation = require(script.Parent.Workstation)
local Drives = require(script.Parent.Drives)

local PlayerStatus = {}

PlayerStatus.TeamWiped = Signal.new() :: Signal.Signal<string>
PlayerStatus.Downed = Signal.new() :: Signal.Signal<Player>
PlayerStatus.Revived = Signal.new() :: Signal.Signal<Player>

local revivePrompts: { [Player]: ProximityPrompt } = {}
local wipePending = false

function PlayerStatus.isDowned(p: Player): boolean
	return p:GetAttribute("Downed") == true
end

-- players inside the building who can still act
function PlayerStatus.standing(): { Player }
	local out = {}
	for _, p in GameState.activePlayers() do
		if not PlayerStatus.isDowned(p) and Guard.alive(p) then
			table.insert(out, p)
		end
	end
	return out
end

local function setMobility(p: Player, enabled: boolean)
	local h = Guard.humanoidOf(p)
	if h then
		h.WalkSpeed = if enabled then 16 else 0
		h.JumpHeight = if enabled then 7.2 else 0
		h.UseJumpPower = false
	end
end

local function checkWipe()
	if wipePending then
		return
	end
	local active = GameState.activePlayers()
	if #active == 0 then
		return
	end
	local anyStanding = #PlayerStatus.standing() > 0
	local anyDowned = false
	for _, p in active do
		if PlayerStatus.isDowned(p) then
			anyDowned = true
		end
	end
	local solo = #Players:GetPlayers() <= 1
	-- a wipe needs someone caught: a teammate leaving never rolls the team back
	if anyDowned and (solo or not anyStanding) then
		wipePending = true
		local delaySec = if solo then Config.DOWNED.soloRestoreDelay else Config.DOWNED.wipeRestoreDelay
		GameState.fx("TeamCaught", { solo = solo, delay = delaySec })
		task.delay(delaySec, function()
			wipePending = false
			-- re-check: someone may have joined or been revived meanwhile
			local downedNow = false
			for _, p in GameState.activePlayers() do
				if PlayerStatus.isDowned(p) then
					downedNow = true
				end
			end
			local still = downedNow and (#PlayerStatus.standing() == 0 or #Players:GetPlayers() <= 1)
			if still then
				PlayerStatus.TeamWiped:Fire(if solo then "caught" else "everyone caught")
			end
		end)
	end
end

function PlayerStatus.revive(p: Player, by: Player?)
	if not PlayerStatus.isDowned(p) then
		return
	end
	p:SetAttribute("Downed", false)
	p:SetAttribute("Grace", os.clock() + 3)
	setMobility(p, true)
	local prompt = revivePrompts[p]
	if prompt then
		prompt:Destroy()
		revivePrompts[p] = nil
	end
	GameState.fx("Revived", { name = p.DisplayName, by = if by then by.DisplayName else nil })
	GameState.markDirty()
	PlayerStatus.Revived:Fire(p)
end

function PlayerStatus.down(p: Player, cause: string?)
	if PlayerStatus.isDowned(p) or p:GetAttribute("Escaped") == true then
		return
	end
	local grace = p:GetAttribute("Grace")
	if typeof(grace) == "number" and os.clock() < grace then
		return
	end
	local root = Guard.rootOf(p)
	if not root then
		return
	end
	p:SetAttribute("Downed", true)
	Workstation.kick(p, "caught")
	Drives.recoverFor(p, p.DisplayName .. " was caught")
	setMobility(p, false)
	local prompt = Prompts.make(root, {
		action = "Help up",
		object = p.DisplayName,
		hold = Config.DOWNED.reviveHold,
		distance = Config.REACH.revive,
	})
	prompt:SetAttribute("OwnerUserId", p.UserId)
	revivePrompts[p] = prompt
	prompt.Triggered:Connect(function(helper)
		if helper == p or not Prompts.valid(helper, prompt, "revive") then
			return
		end
		PlayerStatus.revive(p, helper)
	end)
	GameState.fx("Downed", { name = p.DisplayName, cause = cause })
	GameState.notify(nil, p.DisplayName .. " was caught" .. (if cause then " (" .. cause .. ")" else "") .. ". Help them up!", "bad")
	GameState.markDirty()
	PlayerStatus.Downed:Fire(p)
	checkWipe()
end

function PlayerStatus.reviveAll()
	for _, p in Players:GetPlayers() do
		PlayerStatus.revive(p, nil)
	end
end

function PlayerStatus.setEscaped(p: Player, v: boolean)
	p:SetAttribute("Escaped", v)
	GameState.markDirty()
end

function PlayerStatus.respawnAll()
	for _, p in Players:GetPlayers() do
		p:SetAttribute("Downed", false)
		p:SetAttribute("Escaped", false)
		p:SetAttribute("ClockedOut", false)
		p:SetAttribute("Carrying", nil)
		local prompt = revivePrompts[p]
		if prompt then
			prompt:Destroy()
			revivePrompts[p] = nil
		end
		task.spawn(function()
			p:LoadCharacter()
		end)
	end
end

local function onCharacter(p: Player, character: Model)
	p:SetAttribute("Downed", false)
	p:SetAttribute("Carrying", nil)
	revivePrompts[p] = nil
	local h = character:WaitForChild("Humanoid", 10)
	if h and h:IsA("Humanoid") then
		h.WalkSpeed = 16
		h.UseJumpPower = false
		h.JumpHeight = 7.2
		h.Died:Connect(function()
			Drives.recoverFor(p, "carrier lost")
		end)
	end
end

function PlayerStatus.init()
	local function hook(p: Player)
		p.CharacterAdded:Connect(function(c)
			onCharacter(p, c)
		end)
		if p.Character then
			onCharacter(p, p.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		revivePrompts[p] = nil
		-- the remaining team may now be entirely downed
		task.defer(checkWipe)
	end)
end

return PlayerStatus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">Power</string>
            <string name="Source"><![CDATA[--!strict
-- Breakers and building power. MAIN feeds everything; LIGHTS feeds the
-- office lighting; WORKSTATION feeds the corner PC. Tripped breakers are
-- reset at the clearly labelled panel in the utility hall.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Server = script.Parent.Parent
local Prompts = require(Server.Util.Prompts)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)

local Power = {}

export type BreakerId = "MAIN" | "LIGHTS" | "WORKSTATION"

local breakers: { [string]: boolean } = { MAIN = true, LIGHTS = true, WORKSTATION = true }
local warning = false
local prompts: { [string]: ProximityPrompt } = {}
-- prompt object line per switch, matching the tags on the panel
local BREAKER_NAMES = { MAIN = "Main", LIGHTS = "Office lights", WORKSTATION = "Workstation" }
local tripToken = 0 -- bumped by resetAll so a pending warned trip is cancelled

Power.Changed = Signal.new() :: Signal.Signal<>
Power.BreakerReset = Signal.new() :: Signal.Signal<string, Player?>

function Power.lightsOn(): boolean
	return breakers.MAIN and breakers.LIGHTS
end

function Power.workstationOn(): boolean
	return breakers.MAIN and breakers.WORKSTATION
end

function Power.isTripped(id: string): boolean
	return breakers[id] == false
end

function Power.anyTripped(): boolean
	return not (breakers.MAIN and breakers.LIGHTS and breakers.WORKSTATION)
end

local function apply()
	local refs = MapBuilder.refs
	local lights = Power.lightsOn()
	local ws = Power.workstationOn()
	for _, groupName in { "main", "kitchen", "lobby", "hall", "lamps" } do
		local group: { Light } = refs.lights[groupName] or {}
		for _, l in group do
			l.Enabled = lights
		end
		local fixtures: { BasePart } = refs.fixtures[groupName] or {}
		for _, f in fixtures do
			f.Material = if lights then Enum.Material.Neon else Enum.Material.SmoothPlastic
			f.Color = if lights then Color3.fromRGB(226, 240, 255) else Color3.fromRGB(70, 72, 76)
		end
	end
	refs.workstationLamp.Enabled = ws
	for _, l in refs.emergencyLights do
		(l :: PointLight).Brightness = if lights then 0 else 0.9
	end
	refs.monitorScreen.Material = if ws then Enum.Material.Neon else Enum.Material.SmoothPlastic
	refs.monitorScreen.Color = if ws then Color3.fromRGB(16, 32, 60) else Color3.fromRGB(8, 8, 10)
	for id, ok in breakers do
		local lamp = refs.breakerLamps[id]
		if lamp then
			lamp.Color = if ok then Color3.fromRGB(60, 255, 90) else Color3.fromRGB(255, 50, 40)
		end
		local sw = refs.breakerSwitches[id]
		if sw then
			sw.Color = if ok then Color3.fromRGB(40, 40, 40) else Color3.fromRGB(150, 30, 30)
			sw:SetAttribute("Tripped", not ok)
		end
		local prompt = prompts[id]
		if prompt then
			prompt.Enabled = not ok
		end
	end
	workspace:SetAttribute("LightsOn", lights)
	workspace:SetAttribute("WorkstationPower", ws)
	if Power.anyTripped() then
		local where = {}
		for _, id in { "MAIN", "LIGHTS", "WORKSTATION" } do
			if not breakers[id] then
				table.insert(where, id)
			end
		end
		GameState.setThreat("power", "Breaker tripped: " .. table.concat(where, " + "), true, "Utility hall")
	else
		GameState.setThreat("power", nil)
	end
	GameState.markDirty()
	Power.Changed:Fire()
end

-- Flicker warning (cosmetic on clients), then trip the listed breakers.
function Power.warnThenTrip(ids: { string }, warningSeconds: number, onTripped: (() -> ())?)
	warning = true
	tripToken += 1
	local my = tripToken
	GameState.markDirty()
	GameState.fx("PowerWarning", { seconds = warningSeconds })
	task.delay(warningSeconds, function()
		if my ~= tripToken then
			return
		end
		warning = false
		Power.trip(ids)
		if onTripped then
			onTripped()
		end
	end)
end

function Power.trip(ids: { string })
	for _, id in ids do
		if breakers[id] ~= nil then
			breakers[id] = false
		end
	end
	GameState.fx("PowerOff", { ids = ids })
	apply()
end

function Power.reset(id: string, by: Player?)
	if breakers[id] == false then
		breakers[id] = true
		GameState.fx("BreakerReset", { id = id })
		apply()
		Power.BreakerReset:Fire(id, by)
	end
end

function Power.resetAll()
	tripToken += 1
	warning = false
	for id in breakers do
		breakers[id] = true
	end
	apply()
end

function Power.snapshot()
	return {
		main = breakers.MAIN,
		lights = Power.lightsOn(),
		workstation = Power.workstationOn(),
		warning = warning,
	}
end

function Power.init()
	GameState.providers.power = Power.snapshot
	for id, sw in MapBuilder.refs.breakerSwitches do
		local prompt = Prompts.make(sw, {
			action = "Reset breaker",
			object = BREAKER_NAMES[id] or id,
			hold = 0.8,
			distance = 8,
		})
		prompt.Enabled = false
		prompts[id] = prompt
		prompt.Triggered:Connect(function(player)
			if not Prompts.valid(player, prompt) then
				return
			end
			Power.reset(id, player)
		end)
	end
	GameState.RoundReset:Connect(Power.resetAll)
	apply()
end

return Power
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">Story</string>
            <string name="Source"><![CDATA[--!strict
-- Story progression: briefing, fragments revealed in a fixed order by erased
-- count, boss reactions, environmental dread, checkpoints after each drive
-- and the objective line shown to every player.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)
local Drives = require(script.Parent.Drives)
local Checkpoints = require(script.Parent.Checkpoints)

local Story = {}

local briefingToken = 0

local function setDread(count: number)
	workspace:SetAttribute("Dread", math.clamp(count / Config.DRIVE_COUNT, 0, 1))
	local screens = MapBuilder.refs.sourceScreens
	-- a dead colleague's terminal wakes up for good late in the shift
	if count >= 4 and screens[2] then
		screens[2]:SetAttribute("Text", "D.MERRIN LOGGED IN")
	elseif screens[2] then
		screens[2]:SetAttribute("Text", nil)
	end
end

local function briefing()
	briefingToken += 1
	local my = briefingToken
	GameState.setPhase("Briefing")
	for i, line in Dialogue.INTRO do
		if briefingToken ~= my then
			return
		end
		GameState.bossMessage(line, "info")
		task.wait(if i == #Dialogue.INTRO then 2 else 4)
	end
	task.wait(math.max(0, Config.PHASE.briefingSeconds - 10))
	if briefingToken == my and GameState.phase == "Briefing" then
		GameState.setPhase("Work")
		GameState.bossMessage("Procedures are in the binder file on the desktop. Read them once.", "info")
	end
end

local function objective(): string
	local phase = GameState.phase
	local d = GameState.data
	if phase == "Briefing" then
		return "Clocking in... read Kessler's messages."
	elseif phase == "FinalPurge" then
		local left = if d.purgeDeadline then math.max(0, math.floor(d.purgeDeadline - os.clock())) else 0
		return string.format("CANCEL your records in the FINAL PURGE queue at the workstation (%d:%02d)", left // 60, left % 60)
	elseif phase == "SignOff" then
		local s = d.signOff
		if s and s.awaiting then
			return "Confirm the sign-off checkpoint at the workstation."
		end
		return string.format("Keep the workstation powered: emergency sign-off %d%%", math.floor((if s then s.progress else 0) * 100))
	elseif phase == "ClockOut" then
		return "Clock out at the lobby TIME CLOCK, then leave through the front door."
	elseif phase == "Ending" then
		return ""
	end
	local docked = Drives.dockDrive()
	if docked and docked.state == "Processing" and docked.job then
		return string.format("Finish SecureErase on %s at the corner workstation (stage %d/%d).", docked.id, docked.job.state.stage, docked.job.state.stages)
	elseif docked then
		return "Sit at the corner workstation and start SecureErase on " .. docked.id .. "."
	end
	local staged, carried, installed = 0, 0, 0
	for _, x in Drives.list do
		if x.state == "Staged" then
			staged += 1
		elseif x.state == "Carried" then
			carried += 1
		elseif x.state == "Installed" then
			installed += 1
		end
	end
	if carried > 0 then
		return "Bring the drive to the corner workstation DOCK (or stage it on the rack)."
	elseif staged > 0 then
		return "Take a staged drive from the rack and dock it at the workstation."
	elseif installed > 0 then
		return string.format("Shut down a desk PC and remove its hard drive (%d left in the desks).", installed)
	end
	return "Keep the shift together."
end

function Story.init()
	GameState.providers.objective = objective
	Drives.Erased:Connect(function(_d, count)
		local frags = GameState.data.fragments
		if not table.find(frags, count) and Dialogue.FRAGMENTS[count] then
			table.insert(frags, count)
			GameState.fx("Fragment", { index = count })
			GameState.markDirty()
		end
		setDread(count)
		if count < Config.DRIVE_COUNT then
			Checkpoints.save(string.format("%d of %d drives erased", count, Config.DRIVE_COUNT))
			task.delay(5, function()
				local line = Dialogue.BOSS_PROGRESS[count]
				if line and GameState.phase == "Work" then
					GameState.bossMessage(line, "story")
				end
			end)
		end
	end)
	Checkpoints.Restored:Connect(function()
		setDread(GameState.data.erased)
	end)
	GameState.RoundReset:Connect(function()
		setDread(0)
		task.spawn(briefing)
	end)
end

function Story.start()
	setDread(0)
	task.wait(2)
	briefing()
end

return Story
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">Threat</string>
            <string name="Source"><![CDATA[--!strict
-- The figure in the outdated company uniform. Server-controlled NPC:
-- the server alone moves it and decides catches. Behaviours:
--   approach  alley end -> rear door; repelled if the door is latched in time
--   hunt      inside the office for a limited time, then leaves
--   chase     alley encounter after a trash trip (head start, stops at door)
--   pursue    finale: slow pursuit while the team clocks out
--   peek      harmless glimpse (outside the windows / alley end)
-- Navigation uses PathfindingService with straight-line fallback; the map is
-- small and open so paths are short and reliable.

local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)
local Doors = require(script.Parent.Doors)
local PlayerStatus = require(script.Parent.PlayerStatus)

local Threat = {}

type Mode = "idle" | "approach" | "waitDoor" | "hunt" | "leave" | "chase" | "pursue" | "peek"

local model: Model
local root: BasePart
local humanoid: Humanoid
local visual: BasePart
local mode: Mode = "idle"
local token = 0 -- bumps whenever a behaviour is replaced, so stale loops exit
local pathBusy = false -- only one path follower may steer the figure

local function setVisible(v: boolean)
	visual:SetAttribute("ArtHidden", not v)
	model:SetAttribute("Active", v)
end

local function hide()
	token += 1
	mode = "idle"
	humanoid:MoveTo(root.Position)
	root.Anchored = true
	root.CFrame = CFrame.new(Layout.THREAT_HIDE)
	setVisible(false)
	GameState.setThreat("figure", nil)
	model:SetAttribute("Mode", "idle")
end

local function placeAt(pos: Vector3, lookAt: Vector3?)
	root.Anchored = true
	local p = pos + Vector3.new(0, 3, 0)
	root.CFrame = if lookAt then CFrame.lookAt(p, Vector3.new(lookAt.X, p.Y, lookAt.Z)) else CFrame.new(p)
	root.Anchored = false
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	setVisible(true)
end

local function setMode(m: Mode, speed: number)
	mode = m
	humanoid.WalkSpeed = speed
	model:SetAttribute("Mode", m)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Walk to a point. Returns true on arrival, false if interrupted/timed out.
local walkTo: (target: Vector3, myToken: number, timeout: number, usePath: boolean?) -> boolean
walkTo = function(target: Vector3, myToken: number, timeout: number, usePath: boolean?): boolean
	local deadline = os.clock() + timeout
	local waypoints: { Vector3 } = { target }
	if usePath then
		local path = PathfindingService:CreatePath({ AgentRadius = 1.4, AgentHeight = 6, AgentCanJump = false, WaypointSpacing = 4 })
		local ok = pcall(function()
			path:ComputeAsync(root.Position, target)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			waypoints = {}
			for _, w in path:GetWaypoints() do
				table.insert(waypoints, w.Position)
			end
		end
	end
	local lastPos = root.Position
	local lastMove = os.clock()
	for _, wp in waypoints do
		while os.clock() < deadline do
			if token ~= myToken then
				return false
			end
			humanoid:MoveTo(wp)
			if (flat(root.Position) - flat(wp)).Magnitude < 2 then
				break
			end
			-- stuck on geometry: re-plan with pathfinding (once per call)
			if humanoid.WalkSpeed > 0 and (root.Position - lastPos).Magnitude > 0.5 then
				lastPos = root.Position
				lastMove = os.clock()
			elseif humanoid.WalkSpeed > 0 and os.clock() - lastMove > 1.5 and not usePath then
				return walkTo(target, myToken, math.max(1, deadline - os.clock()), true)
			end
			task.wait(0.1)
		end
	end
	return token == myToken and (flat(root.Position) - flat(target)).Magnitude < 3
end

local function tryCatch(): Player?
	for _, p in PlayerStatus.standing() do
		local r = Guard.rootOf(p)
		if r and (r.Position - root.Position).Magnitude <= Config.THREAT.catchDistance then
			PlayerStatus.down(p, "the figure")
			return p
		end
	end
	return nil
end

local function nearestTarget(indoorsOnly: boolean): (Player?, BasePart?)
	local best: Player?, bestRoot: BasePart?, bestD = nil, nil, math.huge
	for _, p in PlayerStatus.standing() do
		local r = Guard.rootOf(p)
		if r and (not indoorsOnly or Layout.isIndoors(r.Position) or Layout.regionOf(r.Position) == "Utility hall") then
			local d = (r.Position - root.Position).Magnitude
			if d < bestD then
				best, bestRoot, bestD = p, r, d
			end
		end
	end
	return best, bestRoot
end

function Threat.busy(): boolean
	return mode ~= "idle"
end

function Threat.mode(): string
	return mode
end

function Threat.position(): Vector3?
	return if mode == "idle" then nil else root.Position
end

function Threat.despawn()
	hide()
	Doors.setLocked(false)
end

-- Leave via the rear door and vanish. The door is left ajar behind it.
local function leaveBuilding(myToken: number, onDone: (() -> ())?)
	setMode("leave", Config.THREAT.walkSpeed + 2)
	GameState.setThreat("figure", "The figure is leaving", true, "Office")
	local route = Layout.THREAT_ROUTE
	walkTo(route[5], myToken, 20, true)
	for i = 4, 1, -1 do
		if not walkTo(route[i], myToken, 12) then
			break
		end
	end
	if token == myToken then
		hide()
		if Doors.state() == "Latched" then
			Doors.set("Ajar")
		end
		if onDone then
			onDone()
		end
	end
end

-- Hunt inside for `seconds`, chasing the nearest standing player.
function Threat.hunt(seconds: number, onDone: (() -> ())?)
	token += 1
	local myToken = token
	local solo = GameState.isSolo()
	setMode("hunt", if solo then Config.THREAT.huntSpeed.solo else Config.THREAT.huntSpeed.coop)
	GameState.setThreat("figure", "Someone is inside the office", true, "Office")
	GameState.fx("FigureInside", nil)
	task.spawn(function()
		local endAt = os.clock() + seconds
		local lastPath = 0
		local caught = false
		while token == myToken and os.clock() < endAt do
			local target, tRoot = nearestTarget(true)
			if tRoot then
				local d = (tRoot.Position - root.Position).Magnitude
				if d < 14 then
					humanoid:MoveTo(tRoot.Position)
				elseif os.clock() - lastPath > 1 then
					lastPath = os.clock()
					if not pathBusy then
						pathBusy = true
						task.spawn(function()
							walkTo(tRoot.Position, myToken, 1.2, true)
							pathBusy = false
						end)
					end
				end
			end
			if tryCatch() then
				caught = true
				break -- one catch per visit: gives teammates a fair rescue window
			end
			task.wait(0.1)
			local _ = target
		end
		if token == myToken then
			if caught then
				task.wait(1.2)
			end
			leaveBuilding(myToken, onDone)
		end
	end)
end

-- Walk from the alley end to the rear door. If the door is latched by the
-- time it arrives, it waits, knocks and retreats. Otherwise it comes in.
function Threat.approach(callbacks: { onRepelled: (() -> ())?, onEntered: (() -> ())?, onDone: (() -> ())? })
	token += 1
	local myToken = token
	local route = Layout.THREAT_ROUTE
	placeAt(route[1], route[2])
	setMode("approach", Config.THREAT.walkSpeed)
	GameState.setThreat("figure", "Someone is walking up the alley", true, "Alley")
	GameState.fx("FigureApproach", nil)
	task.spawn(function()
		local ok = walkTo(route[2], myToken, 10)
		if ok then
			setMode("approach", 0)
			task.wait(Config.THREAT.approachPause)
			setMode("approach", Config.THREAT.approachSpeed)
		end
		ok = ok and token == myToken and walkTo(Layout.THREAT_DOOR_STOP, myToken, Config.EVENTS.DoorUnlatch.approachSeconds + 10)
		if token ~= myToken then
			return
		end
		if not ok or Doors.state() == "Latched" then
			setMode("waitDoor", 0)
			GameState.fx("DoorKnock", nil)
			task.wait(3.5)
			if token ~= myToken then
				return
			end
			if Doors.state() == "Latched" then
				setMode("leave", Config.THREAT.walkSpeed)
				GameState.setThreat("figure", "The figure is walking away", false, "Alley")
				walkTo(route[1], myToken, 14)
				if token == myToken then
					hide()
					if callbacks.onRepelled then
						callbacks.onRepelled()
					end
					if callbacks.onDone then
						callbacks.onDone()
					end
				end
				return
			end
		end
		-- door is open: come in
		if Doors.state() ~= "Latched" then
			Doors.set("Open")
			Doors.setLocked(true)
			walkTo(route[5], myToken, 6)
			Doors.setLocked(false)
			if token ~= myToken then
				return
			end
			if callbacks.onEntered then
				callbacks.onEntered()
			end
			local solo = GameState.isSolo()
			Threat.hunt(if solo then Config.THREAT.huntSeconds.solo else Config.THREAT.huntSeconds.coop, callbacks.onDone)
		end
	end)
end

-- Alley encounter: visible at the alley end, head start, then chase. It never
-- enters the building during this encounter.
function Threat.chase(target: Player, first: boolean, onDone: ((caught: boolean) -> ())?)
	token += 1
	local myToken = token
	local route = Layout.THREAT_ROUTE
	placeAt(route[2], Layout.DUMPSTER)
	setMode("chase", 0)
	GameState.setThreat("figure", "RUN - back inside!", true, "Alley")
	GameState.fx("ChaseStart", { target = target.UserId, headStart = Config.THREAT.headStartSeconds })
	task.spawn(function()
		task.wait(Config.THREAT.headStartSeconds)
		if token ~= myToken then
			return
		end
		setMode("chase", if first then Config.THREAT.chaseSpeed.first else Config.THREAT.chaseSpeed.normal)
		local caught = false
		local giveUpAt = os.clock() + 25
		while token == myToken and os.clock() < giveUpAt do
			local r = Guard.rootOf(target)
			if not r or target:GetAttribute("Downed") == true then
				break
			end
			if r.Position.X < Layout.REAR_DOOR.x - 0.5 then
				break -- target made it inside
			end
			local goal = r.Position
			if goal.X < Layout.THREAT_DOOR_STOP.X then
				goal = Layout.THREAT_DOOR_STOP
			end
			humanoid:MoveTo(goal)
			if (r.Position - root.Position).Magnitude <= Config.THREAT.catchDistance then
				PlayerStatus.down(target, "caught in the alley")
				caught = true
				break
			end
			task.wait(0.1)
		end
		if token ~= myToken then
			return
		end
		setMode("leave", Config.THREAT.walkSpeed)
		GameState.setThreat("figure", nil)
		task.wait(1.5)
		walkTo(route[1], myToken, 12)
		if token == myToken then
			hide()
			if onDone then
				onDone(caught)
			end
		end
	end)
end

-- Finale: a slow, relentless pursuit through the office while the team
-- clocks out. Slower than walking speed, so it only catches the careless.
function Threat.pursue()
	token += 1
	local myToken = token
	placeAt(Layout.THREAT_FINALE_SPAWN, Vector3.new(0, 0, 0))
	setMode("pursue", Config.THREAT.clockOutSpeed)
	GameState.setThreat("figure", "It's inside. Get to the time clock.", true, "Office")
	GameState.fx("FigureInside", { finale = true })
	task.spawn(function()
		local lastPath = 0
		while token == myToken do
			local _, tRoot = nearestTarget(true)
			if tRoot then
				if (tRoot.Position - root.Position).Magnitude < 12 then
					humanoid:MoveTo(tRoot.Position)
				elseif os.clock() - lastPath > 1.2 then
					lastPath = os.clock()
					if not pathBusy then
						pathBusy = true
						task.spawn(function()
							walkTo(tRoot.Position, myToken, 1.3, true)
							pathBusy = false
						end)
					end
				end
			end
			tryCatch()
			task.wait(0.15)
		end
	end)
end

-- Harmless glimpse: stands somewhere visible for a moment, then gone.
function Threat.peek(where: "window" | "alley", seconds: number)
	if mode ~= "idle" then
		return
	end
	token += 1
	local myToken = token
	local pos = if where == "window" then Vector3.new(Layout.WINDOWS_X[math.random(1, #Layout.WINDOWS_X)], 0, -19) else Layout.THREAT_ROUTE[1]
	placeAt(pos, if where == "window" then Vector3.new(pos.X, 0, 0) else Layout.THREAT_DOOR_STOP)
	root.Anchored = true
	setMode("peek", 0)
	GameState.fx("FigurePeek", { where = where })
	task.delay(seconds, function()
		if token == myToken then
			hide()
		end
	end)
end

function Threat.init()
	model = Instance.new("Model")
	model.Name = "Figure"
	root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.Anchored = true
	root.CFrame = CFrame.new(Layout.THREAT_HIDE)
	root.Parent = model
	-- collision body so it cannot pass through walls/desks
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(1.8, 4.6, 1.2)
	body.Transparency = 1
	body.CanCollide = true
	body.Massless = true
	body.CFrame = root.CFrame * CFrame.new(0, -0.6, 0)
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = body
	w.Parent = body
	body.Parent = model
	humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 2
	humanoid.WalkSpeed = Config.THREAT.walkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	model.PrimaryPart = root
	-- the figure ignores the invisible player boundary at the alley mouth
	root.CollisionGroup = "Figure"
	body.CollisionGroup = "Figure"

	-- visual mesh (built by clients from the character library)
	visual = Instance.new("Part")
	visual.Name = "FigureVisual"
	visual.Size = Vector3.new(0.2, 0.2, 0.2)
	visual.Transparency = 1
	visual.CanCollide = false
	visual.CanQuery = false
	visual.Massless = true
	-- character meshes face -Z natively, which is the root's LookVector
	visual.CFrame = root.CFrame * CFrame.new(0, -3, 0)
	visual:SetAttribute("ArtKey", MapBuilder.refs.threatAnchorKey)
	visual:SetAttribute("ArtDynamic", true)
	visual:SetAttribute("ArtHidden", true)
	local vw = Instance.new("WeldConstraint")
	vw.Part0 = root
	vw.Part1 = visual
	vw.Parent = visual
	visual.Anchored = false
	visual.Parent = model
	CollectionService:AddTag(visual, "ArtAnchor")
	-- eerie local light the clients can see from a distance
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 120, 90)
	glow.Range = 7
	glow.Brightness = 0.35
	glow.Parent = root
	model:SetAttribute("Active", false)
	model.Parent = workspace

	GameState.RoundReset:Connect(Threat.despawn)
end

return Threat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">Workstation</string>
            <string name="Source"><![CDATA[--!strict
-- The shared corner workstation: one server-owned session at a time.
--  * Only the seated operator of the CURRENT session id may act.
--  * Standing, death, disconnect, reset or being caught ends the session.
--  * A new operator receives the current authoritative puzzle state.
--  * Actions carrying an old session id are rejected.
-- Other systems add desktop commands with Workstation.registerCommand.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Fonts = require(ReplicatedStorage.Shared.Fonts)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)
local Server = script.Parent.Parent
local Guard = require(Server.Util.Guard)
local Prompts = require(Server.Util.Prompts)
local Minigames = require(Server.Minigames)
local GameState = require(script.Parent.GameState)
local MapBuilder = require(script.Parent.MapBuilder)
local Power = require(script.Parent.Power)
local Drives = require(script.Parent.Drives)

local Workstation = {}

local operator: Player? = nil
local sessionId = 0
local lastFeedback: { text: string?, kind: string? } = {}
local phantom: { id: number, x: number, y: number, first: boolean }? = nil
local sitPrompt: ProximityPrompt
local screenText: TextLabel
local screenSub: TextLabel

Workstation.SessionStarted = Signal.new() :: Signal.Signal<Player>
Workstation.SessionEnded = Signal.new() :: Signal.Signal<Player>
Workstation.ActionPerformed = Signal.new() :: Signal.Signal<Player, string>

type CommandHandler = (player: Player, a: any, b: any) -> (string?, string?)
local commands: { [string]: CommandHandler } = {}

function Workstation.registerCommand(kind: string, handler: CommandHandler)
	commands[kind] = handler
end

function Workstation.operator(): Player?
	return operator
end

function Workstation.sessionId(): number
	return sessionId
end

function Workstation.setPhantom(p: { id: number, x: number, y: number, first: boolean }?)
	phantom = p
	Workstation.push()
end

local function payload(reason: string?): Types.SessionPayload
	local d = Drives.dockDrive()
	local job = d and d.job
	local p: Types.SessionPayload = {
		active = operator ~= nil,
		sessionId = sessionId,
		driveId = if d then d.id else nil,
		driveName = if d then d.name else nil,
		game = if d then d.game else nil,
		title = nil,
		instructions = nil,
		stage = 0,
		stages = 0,
		progress = 0,
		view = nil,
		feedback = lastFeedback.text,
		feedbackKind = lastFeedback.kind,
		hint = nil,
		transitioning = false,
		phantom = phantom,
		reason = reason,
	}
	if d then
		local g = Minigames.get(d.game)
		if g then
			p.title = g.title
			p.instructions = g.instructions
		end
	end
	if job and d and d.state == "Processing" then
		local view, hint = Minigames.view(job)
		p.view = view
		p.hint = hint
		p.stage = job.state.stage
		p.stages = job.state.stages
		p.progress = Minigames.progress(job)
		p.transitioning = view.transitioning == true
	end
	if not Power.workstationOn() then
		p.reason = "power"
	end
	return p
end

local function updateScreen()
	local d = Drives.dockDrive()
	local text, sub
	if not Power.workstationOn() then
		text, sub = "NO POWER", "reset breaker in utility hall"
	elseif GameState.phase == "SignOff" and GameState.data.signOff then
		text = string.format("SIGN-OFF %d%%", math.floor(GameState.data.signOff.progress * 100))
		sub = if GameState.data.signOff.awaiting then "CONFIRMATION NEEDED" else "do not power down"
	elseif GameState.phase == "FinalPurge" then
		text, sub = "FINAL PURGE QUEUE", "!! cancel your records !!"
	elseif d and d.job then
		text = string.format("%s  %d%%", d.id, math.floor(Minigames.progress(d.job) * 100))
		sub = string.format("stage %d/%d  %s", d.job.state.stage, d.job.state.stages, if operator then "op: " .. operator.DisplayName else "no operator")
	elseif d then
		text, sub = d.id .. " DOCKED", "sit down to start SecureErase"
	else
		text, sub = string.format("ERASED %d/%d", GameState.data.erased, Config.DRIVE_COUNT), "dock the next drive"
	end
	screenText.Text = text
	screenSub.Text = sub
end

function Workstation.push(reason: string?)
	updateScreen()
	if operator then
		Net.remote("Session"):FireClient(operator, payload(reason))
	end
	GameState.markDirty()
end

local function endSession(why: string?)
	local old = operator
	if not old then
		return
	end
	operator = nil
	sessionId += 1 -- invalidates any in-flight action from the old session
	Net.remote("Session"):FireClient(old, { active = false, sessionId = sessionId, reason = why } :: any)
	sitPrompt.Enabled = true
	sitPrompt.ObjectText = "Corner workstation"
	updateScreen()
	GameState.markDirty()
	Workstation.SessionEnded:Fire(old)
end

local function forceStand(player: Player)
	local seat = MapBuilder.refs.seat
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	local h = Guard.humanoidOf(player)
	if h then
		h.Sit = false
		h.Jump = true
	end
end

function Workstation.kick(player: Player, why: string?)
	if operator == player then
		forceStand(player)
		endSession(why)
	end
end

local function startSession(player: Player)
	operator = player
	sessionId += 1
	lastFeedback = {}
	sitPrompt.Enabled = false
	sitPrompt.ObjectText = "Occupied by " .. player.DisplayName
	local d = Drives.dockDrive()
	if d and d.state == "Processing" then
		lastFeedback = { text = "Resumed " .. d.id .. " at stage " .. (if d.job then d.job.state.stage else 1) .. ".", kind = "info" }
	end
	Workstation.push()
	Workstation.SessionStarted:Fire(player)
end

local function onOccupant()
	local seat = MapBuilder.refs.seat
	local occ = seat.Occupant
	if occ == nil then
		endSession("stood up")
		return
	end
	local player = Players:GetPlayerFromCharacter(occ.Parent)
	if not player or player:GetAttribute("Downed") == true or (operator and operator ~= player) then
		-- not a valid operator: eject immediately
		local weld = seat:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
		return
	end
	if operator ~= player then
		startSession(player)
	end
end

-- Puzzle actions --------------------------------------------------------------

local ACTIONS: { [string]: boolean } = {
	sort = true,
	swap = true,
	rotate = true,
	match = true,
	press = true,
	replay = true,
	kill = true,
	purge = true,
}

local function validArg(v: unknown): boolean
	local t = typeof(v)
	if t == "nil" then
		return true
	elseif t == "number" then
		local n = v :: number
		return n == n and math.abs(n) < 1e6
	elseif t == "string" then
		return #(v :: string) <= 32
	end
	return false
end

local function doPuzzle(player: Player, action: string, a: any, b: any)
	local d = Drives.dockDrive()
	if not d or d.state ~= "Processing" or not d.job then
		return
	end
	local job = d.job
	local res = Minigames.perform(job, action, a, b)
	if res.message ~= "" then
		lastFeedback = { text = res.message, kind = if res.kind == "bad" then "bad" elseif res.kind == "info" then "info" else "good" }
	end
	GameState.fx("DesktopSound", { kind = res.kind }, player)
	Workstation.ActionPerformed:Fire(player, res.kind)
	if res.kind == "complete" then
		lastFeedback = { text = d.id .. " securely erased.", kind = "good" }
		Drives.markErased(d)
	elseif res.kind == "stage" then
		task.delay(Config.STAGE_TRANSITION_SECONDS + 0.05, function()
			Workstation.push()
		end)
	end
	Workstation.push()
end

local function onDesktop(player: Player, sid: unknown, kind: unknown, a: unknown, b: unknown, c: unknown)
	local rate = Config.RATE.desktop
	if not Guard.allow(player, "desktop", rate[1], rate[2]) then
		return
	end
	if typeof(sid) ~= "number" or typeof(kind) ~= "string" or #(kind :: string) > 24 then
		return
	end
	if not validArg(a) or not validArg(b) or not validArg(c) then
		return
	end
	-- session authority: the player must be THE seated operator of THIS session
	if player ~= operator or sid ~= sessionId then
		if typeof(player) == "Instance" then -- (QA harness actors are not Players)
			Net.remote("Session"):FireClient(player, { active = player == operator, sessionId = sessionId, reason = "stale" } :: any)
		end
		return
	end
	local seat = MapBuilder.refs.seat
	local h = Guard.humanoidOf(player)
	if not h or seat.Occupant ~= h then
		endSession("not seated")
		return
	end
	if kind == "refresh" then
		Workstation.push()
		return
	end
	if not Power.workstationOn() then
		Workstation.push("power")
		return
	end
	if kind == "start" then
		local d = Drives.dockDrive()
		if d then
			Drives.beginProcessing(d)
			lastFeedback = { text = "SecureErase started on " .. d.id .. ".", kind = "info" }
		end
		Workstation.push()
	elseif kind == "act" then
		if typeof(a) ~= "string" or not ACTIONS[a :: string] then
			return
		end
		doPuzzle(player, a :: string, b, c)
	else
		local handler = commands[kind :: string]
		if handler then
			local text, fkind = handler(player, a, b)
			if text then
				lastFeedback = { text = text, kind = fkind or "info" }
			end
			Workstation.push()
		end
	end
end

-- QA-only entry point (Studio harness in Cheats): the same handler the
-- Desktop remote uses, callable with a simulated actor.
Workstation.handleDesktop = function(player: any, sid: unknown, kind: unknown, a: unknown, b: unknown, c: unknown)
	onDesktop(player, sid, kind, a, b, c)
end

function Workstation.init()
	local refs = MapBuilder.refs
	-- physical monitor: simplified progress for teammates
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 90
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.Parent = refs.monitorScreen
	screenText = Instance.new("TextLabel")
	screenText.Size = UDim2.fromScale(1, 0.55)
	screenText.BackgroundTransparency = 1
	screenText.TextColor3 = Color3.fromRGB(176, 224, 168) -- soft green phosphor
	screenText.FontFace = Fonts.PIXEL_BOLD
	screenText.TextScaled = true
	screenText.Parent = sg
	screenSub = Instance.new("TextLabel")
	screenSub.Size = UDim2.fromScale(1, 0.35)
	screenSub.Position = UDim2.fromScale(0, 0.6)
	screenSub.BackgroundTransparency = 1
	screenSub.TextColor3 = Color3.fromRGB(126, 176, 128)
	screenSub.FontFace = Fonts.PIXEL
	screenSub.TextScaled = true
	screenSub.Parent = sg

	sitPrompt = Prompts.make(refs.seatPromptPart, {
		action = "Sit down",
		object = "Corner workstation",
		distance = Config.REACH.workstation,
		hold = 0.2,
	})
	sitPrompt.Triggered:Connect(function(player)
		if not Prompts.valid(player, sitPrompt, "sit") then
			return
		end
		if operator then
			GameState.notify(player, operator.DisplayName .. " is operating the workstation.", "info")
			return
		end
		if Drives.carrying(player) then
			GameState.notify(player, "Put down what you are carrying first (rack or dock).", "bad")
			return
		end
		local h = Guard.humanoidOf(player)
		if h then
			refs.seat:Sit(h)
		end
	end)

	refs.seat:GetPropertyChangedSignal("Occupant"):Connect(onOccupant)
	Net.remote("Desktop").OnServerEvent:Connect(onDesktop)
	Net.remote("Leave").OnServerEvent:Connect(function(player)
		local rate = Config.RATE.leave
		if not Guard.allow(player, "leave", rate[1], rate[2]) then
			return
		end
		Workstation.kick(player, "left computer")
	end)
	Players.PlayerRemoving:Connect(function(player)
		if operator == player then
			endSession("disconnected")
		end
	end)
	Power.Changed:Connect(function()
		Workstation.push()
	end)
	Drives.StateChanged:Connect(function()
		Workstation.push()
	end)
	GameState.PhaseChanged:Connect(function()
		Workstation.push()
	end)
	GameState.RoundReset:Connect(function()
		phantom = nil
		lastFeedback = {}
		if operator then
			Workstation.kick(operator, "round reset")
		end
	end)
	GameState.providers.operator = function()
		return if operator then operator.DisplayName else nil
	end
	updateScreen()
end

function Workstation.start()
	-- slow refresh keeps the physical monitor and the operator view honest
	while true do
		task.wait(1)
		if operator and (operator.Parent == nil or not Guard.alive(operator)) then
			endSession("operator lost")
		end
		updateScreen()
	end
end

return Workstation
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="157">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
-- Server-side validation helpers shared by every remote/prompt handler:
-- token-bucket rate limits, reach checks and argument type guards.

local Players = game:GetService("Players")

local Guard = {}

type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}

function Guard.allow(player: Player, key: string, ratePerSec: number, burst: number): boolean
	local now = os.clock()
	local pb = buckets[player]
	if not pb then
		pb = {}
		buckets[player] = pb
	end
	local b = pb[key]
	if not b then
		b = { tokens = burst, last = now }
		pb[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * ratePerSec)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

function Guard.rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function Guard.humanoidOf(player: Player): Humanoid?
	local character = player.Character
	local h = character and character:FindFirstChildOfClass("Humanoid")
	if h and h.Health > 0 then
		return h
	end
	return nil
end

function Guard.alive(player: Player): boolean
	return player.Parent ~= nil and Guard.humanoidOf(player) ~= nil
end

function Guard.near(player: Player, position: Vector3, maxDistance: number): boolean
	local root = Guard.rootOf(player)
	if not root then
		return false
	end
	return (root.Position - position).Magnitude <= maxDistance
end

-- finite integer in [lo, hi]
function Guard.int(v: unknown, lo: number, hi: number): number?
	if typeof(v) ~= "number" then
		return nil
	end
	if v ~= v or v ~= math.floor(v) or v < lo or v > hi then
		return nil
	end
	return v
end

function Guard.str(v: unknown, maxLen: number): string?
	if typeof(v) ~= "string" or #v > maxLen then
		return nil
	end
	return v
end

function Guard.forget(key: any)
	buckets[key] = nil
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[--!strict
-- ProximityPrompt factory + server-side trigger validation. Prompts already
-- enforce distance on the client; the server re-checks everything because
-- prompt triggers can be spoofed like any other remote.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Guard = require(script.Parent.Guard)

local Prompts = {}

-- server-side record of when each player began holding each prompt, so an
-- exploit that fires Triggered instantly cannot skip a hold
local holdStart: { [ProximityPrompt]: { [Player]: number } } = {}

export type PromptOpts = {
	action: string,
	object: string?,
	hold: number?,
	distance: number?,
	key: Enum.KeyCode?,
	gamepad: Enum.KeyCode?,
	offset: Vector2?,
	sight: boolean?,
	style: string?,
}

function Prompts.make(parent: Instance, opts: PromptOpts): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = opts.action
	p.ObjectText = opts.object or ""
	p.HoldDuration = opts.hold or 0
	p.MaxActivationDistance = opts.distance or Config.REACH.prompt
	p.KeyboardKeyCode = opts.key or Enum.KeyCode.E
	p.GamepadKeyCode = opts.gamepad or Enum.KeyCode.ButtonX
	p.RequiresLineOfSight = opts.sight == true
	p.UIOffset = opts.offset or Vector2.zero
	p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	-- the client's PromptUi draws the card; Roblox's own prompt never shows
	p.Style = Enum.ProximityPromptStyle.Custom
	-- PromptUi zeroes MaxActivationDistance locally on every prompt it is not
	-- targeting, so the real reach is mirrored here. Validation below only
	-- ever reads the server's own MaxActivationDistance.
	p:SetAttribute("Reach", p.MaxActivationDistance)
	if opts.style then
		p:SetAttribute("Style", opts.style)
	end
	local starts: { [Player]: number } = {}
	holdStart[p] = starts
	p.PromptButtonHoldBegan:Connect(function(player)
		starts[player] = os.clock()
	end)
	p.Destroying:Connect(function()
		holdStart[p] = nil
	end)
	p.Parent = parent
	return p
end

local function promptPosition(prompt: ProximityPrompt): Vector3?
	local parent = prompt.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	elseif parent and parent:IsA("Model") then
		return parent:GetPivot().Position
	end
	return nil
end

-- True when this trigger is plausible: player alive, not downed/escaped,
-- prompt enabled and within reach (+ latency tolerance).
function Prompts.valid(player: Player, prompt: ProximityPrompt, rateKey: string?): boolean
	if not prompt.Enabled then
		return false
	end
	if player:GetAttribute("Downed") == true or player:GetAttribute("Escaped") == true then
		return false
	end
	if not Guard.alive(player) then
		return false
	end
	if not Guard.allow(player, rateKey or "prompt", 4, 6) then
		return false
	end
	if prompt.HoldDuration > 0 then
		local starts = holdStart[prompt]
		local began = starts and starts[player]
		if starts then
			starts[player] = nil
		end
		if not began or os.clock() - began < prompt.HoldDuration - 0.2 then
			return false
		end
	end
	local pos = promptPosition(prompt)
	if not pos then
		return false
	end
	return Guard.near(player, pos, prompt.MaxActivationDistance + Config.REACH.tolerance)
end

game:GetService("Players").PlayerRemoving:Connect(function(player)
	for _, starts in holdStart do
		starts[player] = nil
	end
end)

return Prompts
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="160">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="161">
      <Properties>
        <string name="Name">DevSync</string>
        <string name="Source">return function()
-- Dev-only: pull changed sources from `python -m http.server 34999` (run in
-- the night-shift folder after `python tools/devsync.py`) into the open place.
-- Paste into the Studio command bar (Edit mode). Requires HttpService.HttpEnabled.
local HttpService = game:GetService("HttpService")
HttpService.HttpEnabled = true
local BASE = "http://127.0.0.1:34999"
local manifest = HttpService:JSONDecode(HttpService:GetAsync(BASE .. "/build/manifest.json", true))
local function resolve(path, leafClass)
	local segs = string.split(path, ".")
	local node = game:GetService(segs[1])
	for i = 2, #segs do
		local name = segs[i]
		local child = node:FindFirstChild(name)
		local want = if i == #segs then leafClass else nil
		if child and want and child.ClassName ~= want then
			local replacement = Instance.new(want)
			replacement.Name = name
			for _, c in child:GetChildren() do c.Parent = replacement end
			child:Destroy()
			replacement.Parent = node
			child = replacement
		end
		if not child then
			child = Instance.new(want or "Folder")
			child.Name = name
			child.Parent = node
		end
		node = child
	end
	return node
end
local wanted = {}
local changed = 0
for _, e in manifest do
	wanted[e.path] = true
	local inst = resolve(e.path, e.class)
	if inst:GetAttribute("SyncHash") ~= e.hash then
		inst.Source = HttpService:GetAsync(BASE .. e.url, true)
		inst:SetAttribute("SyncHash", e.hash)
		changed += 1
	end
end
local removed = 0
for _, root in { game.ReplicatedStorage.Shared, game.ReplicatedStorage.ArtData, game.ServerScriptService.Server, game.StarterPlayer.StarterPlayerScripts.Client } do
	for _, d in root:GetDescendants() do
		if d:IsA("LuaSourceContainer") and not wanted[d:GetFullName()] then
			d:Destroy()
			removed += 1
		end
	end
end
for _, n in { "Gallery", "BakedArt", "Map" } do
	local x = workspace:FindFirstChild(n)
	if x then x:Destroy() end
end
workspace:SetAttribute("MapReady", nil)
return string.format("synced %d changed, %d removed, %d total", changed, removed, #manifest)

end</string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="162">

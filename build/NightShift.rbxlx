      <string name="Name">SoundService</string>
      <token name="AmbientReverb">13</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="163">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">0.5</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">16</float>
      <token name="DevComputerMovementMode">1</token>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="164">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="165">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- NIGHT SHIFT: DATA PURGE — client entry point. Presentation, input,
-- camera and cosmetic effects only; the server owns all game state.

local Controllers = script:WaitForChild("Controllers")

local ORDER = {
	"State",
	"ArtController",
	"Atmosphere",
	"Hud",
	"Desktop",
	"WorkstationCamera",
	"Effects",
	"Pings",
}

local loaded: { any } = {}
local seen: { [string]: boolean } = {}
for _, name in ORDER do
	local m = Controllers:FindFirstChild(name)
	if m and m:IsA("ModuleScript") then
		table.insert(loaded, (require :: any)(m))
		seen[name] = true
	end
end
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") and not seen[child.Name] then
		table.insert(loaded, (require :: any)(child))
	end
end

for _, controller in loaded do
	if typeof(controller.init) == "function" then
		controller.init()
	end
end
for _, controller in loaded do
	if typeof(controller.start) == "function" then
		task.spawn(controller.start)
	end
end

print("[NightShift] client started")
]]></string>
        </Properties>
        <Item class="Folder" referent="166">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">ArtController</string>
              <string name="Source"><![CDATA[--!strict
-- Turns the converted low-poly library (ReplicatedStorage.ArtData) into real
-- meshes on this client with EditableMesh / EditableImage.
--
-- Roblox clients may hold only a handful of EditableMeshes (8 in Studio
-- tests, 60k vertices / 20k triangles each), so every STATIC prop is baked
-- into a few merged world-space chunks that share one texture atlas. Only
-- moving props (the figure outside, crew silhouettes) get their own mesh.
--
-- The server places invisible parts tagged "ArtAnchor" with an ArtKey
-- attribute and flips workspace "MapReady" when the map is complete.
-- Visual only: collision always comes from server-side proxy parts.

local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Base64 = require(ReplicatedStorage.Shared.Util.Base64)

local ArtData = ReplicatedStorage:WaitForChild("ArtData")
local Index = require(ArtData:WaitForChild("Index")) :: any
local ModelsFolder = ArtData:WaitForChild("Models")
local TexturesFolder = ArtData:WaitForChild("Textures")

type PartData = {
	nv: number,
	nt: number,
	color: { number },
	center: { number },
	size: { number },
	v: string,
	n: string,
	uv: string,
	i: string,
}

type ModelData = { parts: { PartData }, min: { number }, max: { number } }

type Chunk = {
	em: EditableMesh,
	verts: number,
	tris: number,
	colors: { [string]: number },
}

local MAX_VERTS = 59000
local MAX_TRIS = 19900
local MAX_MESHES = 8

local ArtController = {}

local modelCache: { [string]: ModelData | false } = {}
local surfaceCache: { [string]: EditableImage | false } = {}
local atlas: EditableImage? = nil
local meshesUsed = 0
local baked = false
local dynamicBuilt: { [BasePart]: MeshPart } = {}

ArtController.stats = { chunks = 0, staticProps = 0, dynamicProps = 0, triangles = 0, skipped = 0 }

local function decode565(data: { w: number, h: number, data: string }, dest: buffer, destWidth: number, rowOffset: number)
	local raw = Base64.decode(data.data)
	for y = 0, data.h - 1 do
		for x = 0, data.w - 1 do
			local v = buffer.readu16(raw, (y * data.w + x) * 2)
			local o = ((y + rowOffset) * destWidth + x) * 4
			buffer.writeu8(dest, o, bit32.rshift(v, 11) * 255 // 31)
			buffer.writeu8(dest, o + 1, bit32.band(bit32.rshift(v, 5), 63) * 255 // 63)
			buffer.writeu8(dest, o + 2, bit32.band(v, 31) * 255 // 31)
			buffer.writeu8(dest, o + 3, 255)
		end
	end
end

local function loadAtlas(): EditableImage?
	if atlas then
		return atlas
	end
	local info = Index.atlas
	local px = buffer.create(info.w * info.h * 4)
	for i = 0, info.strips - 1 do
		local mod = TexturesFolder:FindFirstChild("Atlas_" .. i)
		if mod and mod:IsA("ModuleScript") then
			decode565((require :: any)(mod), px, info.w, i * info.strip)
		end
		if i % 2 == 1 then
			task.wait()
		end
	end
	local ok, img = pcall(function()
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(info.w, info.h) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(info.w, info.h), px)
		return image
	end)
	if ok then
		atlas = img
		return img
	end
	warn("[Art] atlas failed", img)
	return nil
end

-- Surface textures (walls, floors, paper) for server-built parts, applied
-- through Texture.ColorMapContent.
function ArtController.getSurface(name: string): EditableImage?
	local cached = surfaceCache[name]
	if cached == false then
		return nil
	elseif cached ~= nil then
		return cached :: EditableImage
	end
	local key = Index.surfaces[name]
	local mod = key and TexturesFolder:FindFirstChild(key)
	if not mod or not mod:IsA("ModuleScript") then
		surfaceCache[name] = false
		return nil
	end
	local data = (require :: any)(mod) :: { w: number, h: number, data: string }
	local px = buffer.create(data.w * data.h * 4)
	decode565(data, px, data.w, 0)
	local ok, img = pcall(function()
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(data.w, data.h) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(data.w, data.h), px)
		return image
	end)
	local result = if ok then img :: EditableImage else nil
	surfaceCache[name] = result or false
	return result
end

local function getModel(key: string): ModelData?
	local cached = modelCache[key]
	if cached == false then
		return nil
	elseif cached ~= nil then
		return cached :: ModelData
	end
	local mod = ModelsFolder:FindFirstChild(key)
	if not mod or not mod:IsA("ModuleScript") then
		modelCache[key] = false
		return nil
	end
	local ok, data = pcall(function()
		return (require :: any)(mod) :: ModelData
	end)
	local result = if ok then data :: ModelData else nil
	modelCache[key] = result or false
	return result
end

local function newChunk(): Chunk?
	if meshesUsed >= MAX_MESHES then
		return nil
	end
	-- throws when the device's editable-memory budget is spent or the API is
	-- unavailable; a missing chunk just means fewer props, never a dead thread
	local ok, em = pcall(function()
		return AssetService:CreateEditableMesh()
	end)
	if not ok or not em then
		if not ok then
			warn("[Art] CreateEditableMesh failed", em)
		end
		return nil
	end
	meshesUsed += 1
	return { em = em, verts = 0, tris = 0, colors = {} }
end

local function finalizeChunk(chunk: Chunk, name: string, parent: Instance): MeshPart?
	if chunk.tris == 0 then
		return nil
	end
	local ok, mp = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromObject(chunk.em), {
			CollisionFidelity = Enum.CollisionFidelity.Box,
		})
	end)
	if not ok or not mp then
		warn("[Art] chunk failed", mp)
		return nil
	end
	mp.Name = name
	mp.Anchored = true
	mp.CanCollide = false
	mp.CanQuery = false
	mp.CanTouch = false
	mp.Material = Enum.Material.SmoothPlastic
	mp.Color = Color3.new(1, 1, 1)
	local img = loadAtlas()
	if img then
		mp.TextureContent = Content.fromObject(img)
	end
	mp.CFrame = CFrame.identity
	mp.Parent = parent
	ArtController.stats.triangles += chunk.tris
	return mp
end

-- Appends one model instance (transformed by cf, uniform scale s) to chunk.
local function appendModel(chunk: Chunk, data: ModelData, cf: CFrame, s: number, tint: Color3?)
	local em = chunk.em
	for _, pd in data.parts do
		local vb = Base64.decode(pd.v)
		local nb = Base64.decode(pd.n)
		local ub = Base64.decode(pd.uv)
		local ib = Base64.decode(pd.i)
		local cx, cy, cz = pd.center[1], pd.center[2], pd.center[3]
		local hx, hy, hz = pd.size[1] / 2, pd.size[2] / 2, pd.size[3] / 2
		local r, g, b = pd.color[1], pd.color[2], pd.color[3]
		if tint then
			r, g, b = r * tint.R, g * tint.G, b * tint.B
		end
		local ckey = string.format("%.3f,%.3f,%.3f", r, g, b)
		local colorId = chunk.colors[ckey]
		if not colorId then
			colorId = em:AddColor(Color3.new(r, g, b), 1)
			chunk.colors[ckey] = colorId
		end
		local vids = table.create(pd.nv)
		local nids = table.create(pd.nv)
		local uids = table.create(pd.nv)
		for k = 0, pd.nv - 1 do
			local lx = (cx + buffer.readi16(vb, k * 6) / 32767 * hx) * s
			local ly = (cy + buffer.readi16(vb, k * 6 + 2) / 32767 * hy) * s
			local lz = (cz + buffer.readi16(vb, k * 6 + 4) / 32767 * hz) * s
			vids[k + 1] = em:AddVertex(cf:PointToWorldSpace(Vector3.new(lx, ly, lz)))
			local n = Vector3.new(buffer.readi8(nb, k * 3), buffer.readi8(nb, k * 3 + 1), buffer.readi8(nb, k * 3 + 2)) / 127
			nids[k + 1] = em:AddNormal(cf:VectorToWorldSpace(n))
			uids[k + 1] = em:AddUV(Vector2.new(buffer.readu16(ub, k * 4) / 65535, buffer.readu16(ub, k * 4 + 2) / 65535))
		end
		local colors = { colorId, colorId, colorId }
		for t = 0, pd.nt - 1 do
			local a = buffer.readu16(ib, t * 6) + 1
			local bb = buffer.readu16(ib, t * 6 + 2) + 1
			local c = buffer.readu16(ib, t * 6 + 4) + 1
			local ok, fid = pcall(em.AddTriangle, em, vids[a], vids[bb], vids[c])
			if ok then
				em:SetFaceNormals(fid, { nids[a], nids[bb], nids[c] })
				em:SetFaceUVs(fid, { uids[a], uids[bb], uids[c] })
				em:SetFaceColors(fid, colors)
				chunk.tris += 1
			end
		end
		chunk.verts += pd.nv
	end
end

local function modelCounts(data: ModelData): (number, number)
	local v, t = 0, 0
	for _, pd in data.parts do
		v += pd.nv
		t += pd.nt
	end
	return v, t
end

local function anchorParams(anchor: BasePart): (string?, number, Color3?)
	local key = anchor:GetAttribute("ArtKey")
	local scale = anchor:GetAttribute("ArtScale")
	local tint = anchor:GetAttribute("ArtTint")
	return (if typeof(key) == "string" then key else nil),
		(if typeof(scale) == "number" then scale else 1),
		(if typeof(tint) == "Color3" then tint else nil)
end

-- Bakes every static anchor into merged chunks. Reserves room for dynamic props.
local function bakeStatic()
	if baked then
		return
	end
	baked = true
	local folder = Instance.new("Folder")
	folder.Name = "BakedArt"
	folder.Parent = workspace
	loadAtlas()

	local anchors: { BasePart } = {}
	for _, inst in CollectionService:GetTagged("ArtAnchor") do
		if inst:IsA("BasePart") and inst:GetAttribute("ArtDynamic") ~= true then
			table.insert(anchors, inst)
		end
	end
	-- spatial ordering keeps chunks compact (better culling)
	table.sort(anchors, function(a, b)
		return a.Position.X < b.Position.X
	end)

	local reserveForDynamic = 3
	local chunk = newChunk()
	local chunkIndex = 1
	local workDone = 0
	for _, anchor in anchors do
		local key, s, tint = anchorParams(anchor)
		local data = key and getModel(key)
		if data and chunk then
			local nv, nt = modelCounts(data)
			if chunk.verts + nv > MAX_VERTS or chunk.tris + nt > MAX_TRIS then
				finalizeChunk(chunk, "Chunk" .. chunkIndex, folder)
				chunkIndex += 1
				chunk = if meshesUsed < MAX_MESHES - reserveForDynamic then newChunk() else nil
			end
			if chunk then
				appendModel(chunk, data, anchor.CFrame, s, tint)
				ArtController.stats.staticProps += 1
				workDone += nv
				if workDone > 2500 then
					workDone = 0
					task.wait()
				end
			else
				ArtController.stats.skipped += 1
			end
		elseif data then
			ArtController.stats.skipped += 1
		end
	end
	if chunk then
		finalizeChunk(chunk, "Chunk" .. chunkIndex, folder)
	end
	ArtController.stats.chunks = chunkIndex
end

local function buildDynamic(anchor: BasePart)
	if dynamicBuilt[anchor] or not anchor.Parent then
		return
	end
	local key, s, tint = anchorParams(anchor)
	local data = key and getModel(key)
	if not data then
		return
	end
	local chunk = newChunk()
	if not chunk then
		warn("[Art] no mesh budget left for", key)
		return
	end
	-- build in the anchor's local space, then weld to it
	appendModel(chunk, data, CFrame.identity, s, tint)
	local mp = finalizeChunk(chunk, key or "Dynamic", anchor)
	if not mp then
		return
	end
	mp.Anchored = false
	mp.Massless = true
	mp.CFrame = anchor.CFrame
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = mp
	weld.Parent = mp
	dynamicBuilt[anchor] = mp
	ArtController.stats.dynamicProps += 1
	local function syncHidden()
		mp.Transparency = if anchor:GetAttribute("ArtHidden") == true then 1 else 0
	end
	syncHidden()
	anchor:GetAttributeChangedSignal("ArtHidden"):Connect(syncHidden)
end

function ArtController.isReady(): boolean
	return baked
end

function ArtController.init()
	CollectionService:GetInstanceAddedSignal("ArtAnchor"):Connect(function(inst: Instance)
		if baked and inst:IsA("BasePart") and inst:GetAttribute("ArtDynamic") == true then
			task.spawn(buildDynamic, inst)
		end
	end)
end

function ArtController.start()
	while workspace:GetAttribute("MapReady") ~= true do
		task.wait(0.1)
	end
	local ok, err = pcall(bakeStatic :: any)
	if not ok then
		warn("[Art] bake failed", err)
	end
	for _, inst in CollectionService:GetTagged("ArtAnchor") do
		if inst:IsA("BasePart") and inst:GetAttribute("ArtDynamic") == true then
			task.spawn(buildDynamic, inst)
		end
	end
	workspace:SetAttribute("ClientArtReady", true)
end

return ArtController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">Atmosphere</string>
              <string name="Source"><![CDATA[--!strict
-- Mood: a restrained night grade. Warm practical light inside, cold pale fog
-- kept outside the glass, rain in the alley and on the windows, a little film
-- grain, ambient loops, phone glows and eye adaptation during blackouts, the
-- blinking door indicator and a gradual "dread" shift as more data is erased.
-- Everything here is cosmetic and client-local. Server-driven light state
-- (Enabled, fixture material and colour) is never written; flickers only
-- scale light brightness and a local fade, then restore, so nothing sticks.
--
-- Palette (docs/ART_DIRECTION.md): outdoor fog #A8BAC3, cold ambient #778B96,
-- shadow floor #353F46, carpet/curtains #60494D, cream trim #B7B09C, amber
-- practicals #C8A66B.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local AssetService = game:GetService("AssetService")

local Layout = require(ReplicatedStorage.Shared.Layout)
local Fonts = require(ReplicatedStorage.Shared.Fonts)
local ArtController = require(script.Parent.ArtController)
local State = require(script.Parent.State)
local Sfx = require(script.Parent.Parent.Ui.Sfx)

local player = Players.LocalPlayer

local Atmosphere = {}

local FOG = Color3.fromRGB(168, 186, 195) -- #A8BAC3
local SLATE = Color3.fromRGB(119, 139, 150) -- #778B96
local CHARCOAL = Color3.fromRGB(53, 63, 70) -- #353F46
local PHONE = Color3.fromRGB(190, 205, 220)
local PHOSPHOR = Color3.fromRGB(150, 220, 160)
local WINDOW_LIGHT = Color3.fromRGB(150, 168, 180) -- moonlit street through the glass

-- Every number the art direction cares about lives here.
local GRADE = {
	-- ColorCorrection: muted, never crushed (the small lift offsets the contrast)
	saturation = -0.16,
	contrast = 0.04,
	brightness = 0.015,
	tintWarm = Color3.fromRGB(254, 251, 246), -- near neutral: warmth comes from the practicals
	tintCold = Color3.fromRGB(234, 240, 246),
	-- Bloom: only true highlights (neon, bulbs) glow, and only a little
	bloomIntensity = 0.22,
	bloomSize = 20,
	bloomThreshold = 2,
	-- Atmosphere is global, so it stays thin enough that the 45-stud interior
	-- shows no haze; the visible fog outside comes from the exterior fog cards.
	density = 0.2,
	haze = 1,
	decay = Color3.fromRGB(98, 112, 122),
	-- Lighting: charcoal shadow floor inside, slate outside, a dim moon
	ambient = CHARCOAL,
	outdoorAmbient = SLATE,
	sun = 0.25,
	-- dread (0..1 server attribute) at full strength: colder, a touch greyer,
	-- denser fog outside, almost none added indoors
	dreadSaturation = -0.1,
	dreadDensity = 0.04,
	dreadFog = 0.45,
	-- blackout (LightsOn == false): a moment of real darkness, then the eyes
	-- adapt; ambient never drops below ~40/255 per channel
	blackoutAmbient = Color3.fromRGB(44, 52, 59),
	blackoutSaturation = -0.06,
	blackoutCold = 0.35,
	blackoutExposure = 0.2,
	adaptDelay = 1.5,
}

-- Phone glow carried by every character: a faint fill normally, a usable
-- light in a blackout. Teammates' phones only show in the dark.
local GLOW = { idle = 0.15, idleRange = 8, dark = 0.42, darkRange = 12, mate = 0.28, mateRange = 9 }

local FLICKER_RADIUS = 20
local FIXTURE_NAMES: { [string]: boolean } = { Fluorescent = true, Bulb = true }

local cc: ColorCorrectionEffect
local bloom: BloomEffect
local atmos: Atmosphere
local rainEmitters: { ParticleEmitter } = {}
local tense: Sound? = nil
local dread = 0
local blackout = false
local blackoutSince = 0
local flickerDip = 0

Atmosphere.cc = function(): ColorCorrectionEffect
	return cc
end

-- Surfaces -------------------------------------------------------------------

-- Final albedo after texture modulation. A Texture's Color3 can only darken,
-- so when a texture is darker than its target the part colour underneath is
-- let through (Texture.Transparency, at most `wash`). Surfaces not listed
-- settle on their part's own colour, so any texture only adds detail. When a
-- target is out of reach, interior surfaces keep their brightness and
-- `keepHue` surfaces darken instead of drifting toward the texture's colour.
-- Keep the names in sync with MapBuilder's `surface` options.
type SurfaceSpec = { target: Color3?, wash: number, keepHue: boolean? }
local SURFACES: { [string]: SurfaceSpec } = {
	wall_office = { target = Color3.fromRGB(216, 211, 199), wash = 0.6 }, -- light painted plaster
	wall_kitchen = { target = Color3.fromRGB(210, 211, 202), wash = 0.6 },
	carpet = { target = Color3.fromRGB(96, 73, 77), wash = 0.3 }, -- dusty burgundy #60494D
	ceiling_tile = { target = Color3.fromRGB(200, 200, 196), wash = 0.85 }, -- clean light grey
	brick_alley = { wash = 0.6, keepHue = true }, -- no mossy green outside
	floor_concrete = { wash = 0.6, keepHue = true },
}
local DEFAULT_WASH = 0.6

local surfaceMeans: { [string]: Vector3 } = {}

local function rgb(c: Color3): Vector3
	return Vector3.new(c.R, c.G, c.B) * 255
end

local function textureMean(name: string, img: EditableImage): Vector3
	local cached = surfaceMeans[name]
	if cached then
		return cached
	end
	local mean = Vector3.new(200, 200, 200)
	local size = img.Size
	local ok, buf = pcall(function()
		return img:ReadPixelsBuffer(Vector2.zero, size)
	end)
	if ok then
		local px = buf :: buffer
		local r, g, b, n = 0, 0, 0, 0
		for i = 0, size.X * size.Y - 1, 3 do
			local o = i * 4
			r += buffer.readu8(px, o)
			g += buffer.readu8(px, o + 1)
			b += buffer.readu8(px, o + 2)
			n += 1
		end
		if n > 0 then
			mean = Vector3.new(r / n, g / n, b / n)
		end
	end
	surfaceMeans[name] = mean
	return mean
end

-- Smallest wash that reaches the target (or gets closest), then the tint.
local function solveSurface(mean: Vector3, partColor: Vector3, goal: Vector3, minWash: number, maxWash: number, keepHue: boolean?): (number, Color3)
	local best, bestErr = minWash, math.huge
	local t = minWash
	while t <= maxWash + 1e-6 do
		local reach = mean * (1 - t) + partColor * t
		local err = math.max(goal.X - reach.X, 0) + math.max(goal.Y - reach.Y, 0) + math.max(goal.Z - reach.Z, 0)
		if err < bestErr - 0.5 then
			best, bestErr = t, err
		end
		if err <= 0.5 then
			break
		end
		t += 0.05
	end
	local target = goal
	if keepHue then
		local reach = mean * (1 - best) + partColor * best
		local s = math.min(1, reach.X / math.max(goal.X, 1), reach.Y / math.max(goal.Y, 1), reach.Z / math.max(goal.Z, 1))
		target = goal * s
	end
	local function k(want: number, m: number, p: number): number
		return math.clamp((want - best * p) / math.max((1 - best) * m, 1), 0, 1)
	end
	return best, Color3.new(k(target.X, mean.X, partColor.X), k(target.Y, mean.Y, partColor.Y), k(target.Z, mean.Z, partColor.Z))
end

local function applySurfaces()
	local function apply(t: Instance)
		if not t:IsA("Texture") then
			return
		end
		local name = t:GetAttribute("Surface")
		if typeof(name) ~= "string" then
			return
		end
		local img = ArtController.getSurface(name)
		if not img then
			return
		end
		t.ColorMapContent = Content.fromObject(img)
		local holder = t.Parent
		if not (holder and holder:IsA("BasePart")) then
			return
		end
		local spec = SURFACES[name]
		local target = if spec and spec.target then spec.target else holder.Color
		local wash, tint = solveSurface(textureMean(name, img), rgb(holder.Color), rgb(target), t.Transparency, if spec then spec.wash else DEFAULT_WASH, spec and spec.keepHue)
		t.Transparency = wash
		t.Color3 = tint
	end
	for _, t in CollectionService:GetTagged("Surface") do
		apply(t)
	end
	CollectionService:GetInstanceAddedSignal("Surface"):Connect(apply)
end

-- Exterior fog -----------------------------------------------------------------

-- Atmosphere fog is global and cannot tell inside from outside, so the cold
-- fog seen through the windows, down the alley and on the front street is a
-- few soft, slowly drifting cards placed only outside the building. They are
-- lit by the scene (street lamps glow in them), never collide, never block
-- raycasts and cast no shadows.
local FOG_W, FOG_H = 128, 64
local FOG_BASE = -1.2 -- card bottoms sit under the ground so their soft edge is hidden
local FOG_STEP = 1 / 15
local FOG_GAIN = 1 -- one knob for every card's opacity when tuning in Studio
type LayerSpec = { tile: number, speed: number }
local FOG_LAYERS: { LayerSpec } = { { tile = 34, speed = 0.45 }, { tile = 53, speed = -0.28 } }
-- the open street north of the office, seen through the windows
local NORTH_STREET = { minX = Layout.MAIN.minX - 12, maxX = Layout.MAIN.maxX + 14, minZ = Layout.MAIN.minZ - 16, maxZ = Layout.MAIN.minZ - 1 }

type FogLayer = { tex: Texture, tile: number, speed: number, phase: number }
type FogCard = { layers: { FogLayer }, opacity: number }
type Octave = { cx: number, cy: number, w: number, grid: { number } }

local fogCards: { FogCard } = {}
local fogLevel = 0

local function smooth(e0: number, e1: number, x: number): number
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

-- Periodic value noise: wraps horizontally so a card tiles seamlessly.
local function noise(o: Octave, u: number, v: number): number
	local x, y = u * o.cx, v * o.cy
	local x0, y0 = math.floor(x), math.floor(y)
	local fx, fy = x - x0, y - y0
	fx = fx * fx * (3 - 2 * fx)
	fy = fy * fy * (3 - 2 * fy)
	local x1 = (x0 + 1) % o.cx
	local y1 = math.min(y0 + 1, o.cy)
	local g, w = o.grid, o.cx
	local a = g[y0 * w + x0 + 1] + (g[y0 * w + x1 + 1] - g[y0 * w + x0 + 1]) * fx
	local b = g[y1 * w + x0 + 1] + (g[y1 * w + x1 + 1] - g[y1 * w + x0 + 1]) * fx
	return a + (b - a) * fy
end

-- White wisps with alpha: clear at the top, dense near the ground, a ragged
-- upper edge. Top and bottom rows stay transparent so tiling never seams.
-- `patch` also fades both ends, for a single sheet that must not tile.
local function fogImage(patch: boolean): EditableImage?
	local rng = Random.new(1931)
	local octaves: { Octave } = {}
	for i, spec in { { 4, 2, 0.55 }, { 8, 4, 0.3 }, { 16, 8, 0.15 } } do
		local cx, cy = spec[1], spec[2]
		local grid = table.create(cx * (cy + 1), 0)
		for j = 1, #grid do
			grid[j] = rng:NextNumber()
		end
		octaves[i] = { cx = cx, cy = cy, w = spec[3], grid = grid }
	end
	local buf = buffer.create(FOG_W * FOG_H * 4)
	for y = 0, FOG_H - 1 do
		local v = y / (FOG_H - 1)
		for x = 0, FOG_W - 1 do
			local u = x / FOG_W
			local n = 0
			for _, o in octaves do
				n += o.w * noise(o, u, v)
			end
			local body = smooth(0.04, 0.8, v + (n - 0.5) * 0.3) * (1 - smooth(0.93, 1, v))
			if patch then
				body *= smooth(0, 0.22, u) * smooth(0, 0.22, 1 - u)
			end
			local o = (y * FOG_W + x) * 4
			buffer.writeu8(buf, o, 255)
			buffer.writeu8(buf, o + 1, 255)
			buffer.writeu8(buf, o + 2, 255)
			buffer.writeu8(buf, o + 3, math.floor(body * (0.45 + 0.55 * n) * 255 + 0.5))
		end
	end
	local ok, img = pcall(function()
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(FOG_W, FOG_H) })
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(FOG_W, FOG_H), buf)
		return image
	end)
	return if ok then img :: EditableImage else nil
end

-- One card: a vertical sheet centred on (x, z), `width` along the axis that
-- `face` does not point down, its textured side facing `face`. Wide cards
-- tile and drift; a patch (low mist between props) is one still sheet.
type FogImages = { tiled: EditableImage, patch: EditableImage }
local function fogCard(folder: Folder, images: FogImages, rng: Random, x: number, z: number, width: number, height: number, face: Enum.NormalId, opacity: number, patch: boolean?)
	local alongX = face == Enum.NormalId.Front or face == Enum.NormalId.Back
	local p = Instance.new("Part")
	p.Name = "FogCard"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.AudioCanCollide = false
	p.CastShadow = false
	p.Transparency = 1
	p.Material = Enum.Material.SmoothPlastic
	p.Size = if alongX then Vector3.new(width, height, 0.05) else Vector3.new(0.05, height, width)
	p.CFrame = CFrame.new(x, FOG_BASE + height / 2, z)
	local card: FogCard = { layers = {}, opacity = opacity }
	local specs: { LayerSpec } = if patch then { { tile = width, speed = 0 } } else FOG_LAYERS
	for _, spec in specs do
		local t = Instance.new("Texture")
		t.Face = face
		t.ColorMapContent = Content.fromObject(if patch then images.patch else images.tiled)
		t.Color3 = FOG
		t.StudsPerTileU = spec.tile
		t.StudsPerTileV = height
		t.Transparency = 1
		t.Parent = p
		table.insert(card.layers, { tex = t, tile = spec.tile, speed = spec.speed, phase = if patch then 0 else rng:NextNumber() * spec.tile })
	end
	p.Parent = folder
	table.insert(fogCards, card)
end

local function buildExteriorFog()
	local tiled, patch = fogImage(false), fogImage(true)
	if not (tiled and patch) then
		return
	end
	local img: FogImages = { tiled = tiled, patch = patch }
	local folder = Instance.new("Folder")
	folder.Name = "ExteriorFog"
	local rng = Random.new(77)
	local Back, Front, Left, Right = Enum.NormalId.Back, Enum.NormalId.Front, Enum.NormalId.Left, Enum.NormalId.Right
	local N, A, S, K = NORTH_STREET, Layout.ALLEY, Layout.STREET, Layout.KITCHEN

	-- north street, through the office windows: the strip in front of the first
	-- card stays clear (missing-crew silhouettes stand there), the facade across
	-- fades behind the last
	local nx, nw = (N.minX + N.maxX) / 2, N.maxX - N.minX
	fogCard(folder, img, rng, nx, N.minZ + 4.4, nw, 16, Back, 0.3) -- just behind the street lamp
	fogCard(folder, img, rng, nx, N.minZ + 2.4, nw, 18, Back, 0.42)
	fogCard(folder, img, rng, nx, N.minZ + 0.5, nw, 22, Back, 0.4)

	-- alley: knee-high mist patches in the open middle lane (props line both
	-- walls), then deepening layers past the mouth so the figure emerges from
	-- fog but stands clear where it stops
	local az, aw = (A.minZ + A.maxZ) / 2, A.maxZ - A.minZ
	local lane, laneW = A.minZ + 8, 9 -- z -2.5 .. 6.5
	for _, dx in { 5.5, 14, 22 } do
		fogCard(folder, img, rng, A.minX + dx, lane, laneW, 3.4, Left, 0.4, true)
	end
	fogCard(folder, img, rng, A.maxX + 0.25, az, aw, 15, Left, 0.3) -- inside the alley limit
	fogCard(folder, img, rng, A.maxX + 5, az, aw, 15, Left, 0.45)
	fogCard(folder, img, rng, A.maxX + 11, az, aw, 15, Left, 0.55)
	fogCard(folder, img, rng, A.maxX + 15.4, az, aw, 15, Left, 0.6) -- in front of the back wall

	-- front street (the escape): fog closes the three open sides, low mist on the road
	local sx, sz = (S.minX + S.maxX) / 2, (S.minZ + S.maxZ) / 2 + 1
	fogCard(folder, img, rng, sx, S.maxZ + 0.5, S.maxX - S.minX + 8, 16, Front, 0.5)
	fogCard(folder, img, rng, S.minX - 0.5, sz, S.maxZ - S.minZ, 16, Right, 0.55)
	fogCard(folder, img, rng, S.maxX + 0.75, sz, S.maxZ - S.minZ, 16, Left, 0.55)
	fogCard(folder, img, rng, sx, S.minZ + 6, S.maxX - S.minX, 3, Front, 0.35, true)

	-- outside the frosted kitchen window there is only fog
	fogCard(folder, img, rng, K.minX - 2.5, (K.minZ + K.maxZ) / 2, K.maxZ - K.minZ + 4, 12, Right, 0.7)

	folder.Parent = workspace

	local acc, clock = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < FOG_STEP then
			return
		end
		clock += acc
		fogLevel += (dread - fogLevel) * (1 - math.exp(-acc / 4))
		for _, card in fogCards do
			local opacity = math.min(card.opacity * FOG_GAIN * (1 + GRADE.dreadFog * fogLevel), 0.9)
			local each = (1 - opacity) ^ (1 / #card.layers) -- the layers together reach `opacity`
			for _, layer in card.layers do
				layer.tex.OffsetStudsU = (layer.phase + clock * layer.speed) % layer.tile
				layer.tex.Transparency = each
			end
		end
		acc = 0
	end)
end

-- Cold light falling in through the north windows (stays on in a blackout).
local function windowLight()
	local M = Layout.MAIN
	local folder = Instance.new("Folder")
	folder.Name = "WindowLight"
	for _, x in Layout.WINDOWS_X do
		local p = Instance.new("Part")
		p.Name = "WindowSpill"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.AudioCanCollide = false
		p.CastShadow = false
		p.Transparency = 1
		p.Size = Vector3.new(5.6, 4, 0.05)
		p.CFrame = CFrame.new(x, 5.45, M.minZ - 0.3)
		local l = Instance.new("SurfaceLight")
		l.Face = Enum.NormalId.Back
		l.Color = WINDOW_LIGHT
		l.Brightness = 0.3
		l.Range = 10
		l.Angle = 70
		l.Shadows = true
		l.Parent = p
		p.Parent = folder
	end
	folder.Parent = workspace
end

-- Rain -------------------------------------------------------------------------

local function makeRain(region: { minX: number, maxX: number, minZ: number, maxZ: number }, height: number): ParticleEmitter
	local p = Instance.new("Part")
	p.Name = "RainCloud"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(region.maxX - region.minX, 1, region.maxZ - region.minZ)
	p.Position = Vector3.new((region.minX + region.maxX) / 2, height, (region.minZ + region.maxZ) / 2)
	p.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Rate = 220
	e.Lifetime = NumberRange.new(0.9, 1.1)
	e.Speed = NumberRange.new(55, 65)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(4, 4)
	e.Size = NumberSequence.new(0.06)
	e.Squash = NumberSequence.new(-3.5)
	e.Transparency = NumberSequence.new(0.6)
	e.LightEmission = 0.1
	e.LightInfluence = 0.7
	e.Color = ColorSequence.new(FOG)
	e.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
	e.Parent = p
	table.insert(rainEmitters, e)
	return e
end

local function rainOnGlass()
	-- slow drips sliding down each window (client-only frames)
	local drips: { { f: Frame, speed: number } } = {}
	for _, part in workspace:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("RainGlass") == true then
			local sg = Instance.new("SurfaceGui")
			sg.Face = Enum.NormalId.Back
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 30
			sg.LightInfluence = 1
			sg.Parent = part
			for _ = 1, 14 do
				local f = Instance.new("Frame")
				f.BorderSizePixel = 0
				f.BackgroundColor3 = Color3.fromRGB(184, 198, 206)
				f.BackgroundTransparency = 0.6 + math.random() * 0.3
				f.Size = UDim2.fromOffset(2, math.random(6, 18))
				f.Position = UDim2.fromScale(math.random(), math.random())
				f.Parent = sg
				table.insert(drips, { f = f, speed = 0.03 + math.random() * 0.08 })
			end
		end
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		for _, d in drips do
			local p = d.f.Position
			local y = p.Y.Scale + d.speed * acc
			if y > 1.05 then
				y = -0.05
			end
			d.f.Position = UDim2.fromScale(p.X.Scale, y)
		end
		acc = 0
	end)
end

local function buildGrain()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Grain"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15
	gui.Parent = player:WaitForChild("PlayerGui")
	local images: { EditableImage } = {}
	local ok = pcall(function()
		for _ = 1, 3 do
			local img = AssetService:CreateEditableImage({ Size = Vector2.new(96, 96) })
			local buf = buffer.create(96 * 96 * 4)
			for i = 0, 96 * 96 - 1 do
				local v = math.random(0, 255)
				buffer.writeu8(buf, i * 4, v)
				buffer.writeu8(buf, i * 4 + 1, v)
				buffer.writeu8(buf, i * 4 + 2, v)
				buffer.writeu8(buf, i * 4 + 3, 255)
			end
			img:WritePixelsBuffer(Vector2.zero, Vector2.new(96, 96), buf)
			table.insert(images, img)
		end
	end)
	if not ok or #images == 0 then
		return
	end
	local label = Instance.new("ImageLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.ImageContent = Content.fromObject(images[1])
	label.ScaleType = Enum.ScaleType.Tile
	label.TileSize = UDim2.fromOffset(192, 192)
	label.ImageTransparency = 0.96
	label.Active = false
	label.Interactable = false
	label.Parent = gui
	local i = 1
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 0.06 then
			acc = 0
			i = i % #images + 1
			label.ImageContent = Content.fromObject(images[i])
			label.Position = UDim2.fromOffset(math.random(-40, 0), math.random(-40, 0))
			label.ImageTransparency = 0.96 - dread * 0.015
		end
	end)
end

-- Grade --------------------------------------------------------------------------

local function setupLighting()
	-- one grade only: disable post effects a saved place may already carry
	for _, e in Lighting:GetChildren() do
		if e:IsA("PostEffect") then
			e.Enabled = false
		end
	end
	cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "NightGrade"
	cc.Saturation = GRADE.saturation
	cc.Contrast = GRADE.contrast
	cc.Brightness = GRADE.brightness
	cc.TintColor = GRADE.tintWarm
	cc.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Name = "SoftBloom"
	bloom.Intensity = GRADE.bloomIntensity
	bloom.Size = GRADE.bloomSize
	bloom.Threshold = GRADE.bloomThreshold
	bloom.Parent = Lighting
	local existing = Lighting:FindFirstChildOfClass("Atmosphere")
	atmos = existing or Instance.new("Atmosphere")
	atmos.Density = GRADE.density
	atmos.Offset = 0
	atmos.Color = FOG
	atmos.Decay = GRADE.decay
	atmos.Glare = 0
	atmos.Haze = GRADE.haze
	atmos.Parent = Lighting
	Lighting.ClockTime = 1.5
	Lighting.Brightness = GRADE.sun
	Lighting.Ambient = GRADE.ambient
	Lighting.OutdoorAmbient = GRADE.outdoorAmbient
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.ExposureCompensation = 0
end

-- A soft colour cast that eases in and fades out (never a hard flash).
type Sting = { color: Color3, t0: number, attack: number, release: number }
local sting: Sting? = nil

function Atmosphere.sting(color: Color3, seconds: number)
	sting = { color = color, t0 = os.clock(), attack = 0.35, release = math.max(seconds, 0.5) }
end

local function stingWeight(s: Sting, now: number): number
	local t = now - s.t0
	if t < s.attack then
		return math.sin(t / s.attack * math.pi / 2)
	end
	local r = 1 - (t - s.attack) / s.release
	return if r > 0 then r * r else 0
end

type Grade = { tint: Color3, sat: number, bright: number, ambient: Color3, exposure: number, density: number }
local cur: Grade = {
	tint = GRADE.tintWarm,
	sat = GRADE.saturation,
	bright = GRADE.brightness,
	ambient = GRADE.ambient,
	exposure = 0,
	density = GRADE.density,
}

local want: Grade = table.clone(cur)

-- Fills `want` (reused every frame) with the grade the current state asks for.
local function wanted(now: number)
	local cold = math.clamp(dread + (if blackout then GRADE.blackoutCold else 0), 0, 1)
	local tint = GRADE.tintWarm:Lerp(GRADE.tintCold, cold)
	local s = sting
	if s then
		local w = stingWeight(s, now)
		if w <= 0 and now - s.t0 > s.attack then
			sting = nil
		else
			tint = tint:Lerp(s.color, w)
		end
	end
	local adapted = blackout and now - blackoutSince > GRADE.adaptDelay
	want.tint = tint
	want.sat = GRADE.saturation + GRADE.dreadSaturation * dread + (if blackout then GRADE.blackoutSaturation else 0)
	want.bright = GRADE.brightness - flickerDip
	want.ambient = if blackout then GRADE.blackoutAmbient else GRADE.ambient
	want.exposure = if adapted then GRADE.blackoutExposure else 0
	want.density = GRADE.density + GRADE.dreadDensity * dread
end

local function colorGap(a: Color3, b: Color3): number
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B)
end

local function gradeStep(dt: number)
	wanted(os.clock())
	local gap = colorGap(cur.tint, want.tint)
		+ colorGap(cur.ambient, want.ambient)
		+ math.abs(cur.sat - want.sat)
		+ math.abs(cur.bright - want.bright)
		+ math.abs(cur.exposure - want.exposure)
		+ math.abs(cur.density - want.density)
	if gap < 1e-4 then
		return
	end
	local function k(tau: number): number
		return 1 - math.exp(-dt / tau)
	end
	cur.tint = cur.tint:Lerp(want.tint, k(0.15))
	cur.sat += (want.sat - cur.sat) * k(0.6)
	cur.bright += (want.bright - cur.bright) * k(0.05)
	cur.ambient = cur.ambient:Lerp(want.ambient, k(0.5))
	cur.exposure += (want.exposure - cur.exposure) * k(if blackout then 2.5 else 0.6)
	cur.density += (want.density - cur.density) * k(3)
	cc.TintColor = cur.tint
	cc.Saturation = cur.sat
	cc.Brightness = cur.bright
	Lighting.Ambient = cur.ambient
	Lighting.ExposureCompensation = cur.exposure
	atmos.Density = cur.density
end

local function updateDread()
	local v = workspace:GetAttribute("Dread")
	dread = if typeof(v) == "number" then math.clamp(v, 0, 1) else 0
	-- rain picks up and the tense loop rises as the purge nears
	for _, e in rainEmitters do
		e.Rate = 220 + dread * 200
	end
	if tense then
		tense.Volume = 0.05 + dread * 0.3
	end
end

local function updatePower()
	local dark = workspace:GetAttribute("LightsOn") == false
	if dark and not blackout then
		blackoutSince = os.clock()
	end
	blackout = dark
end

-- Phone glows ------------------------------------------------------------------

type Glow = { light: PointLight, own: boolean }
local glows: { Glow } = {}

local function addGlow(plr: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not (root and root:IsA("BasePart")) then
		return
	end
	local own = plr == player
	local att = Instance.new("Attachment")
	att.Name = "PhoneGlow"
	att.Position = Vector3.new(0, 1, -1.2) -- held in front of the chest
	local l = Instance.new("PointLight")
	l.Name = "PhoneGlow"
	l.Color = PHONE
	l.Shadows = false
	l.Range = if own then GLOW.idleRange else GLOW.mateRange
	l.Brightness = if own then GLOW.idle else 0
	l.Enabled = own
	l.Parent = att
	att.Parent = root
	table.insert(glows, { light = l, own = own })
end

local function watchPlayer(plr: Player)
	plr.CharacterAdded:Connect(function(character)
		addGlow(plr, character)
	end)
	if plr.Character then
		task.spawn(addGlow, plr, plr.Character)
	end
end

local function glowStep(dt: number)
	local k = 1 - math.exp(-dt / 0.6)
	for i = #glows, 1, -1 do
		local g = glows[i]
		local l = g.light
		if not l:IsDescendantOf(workspace) then
			table.remove(glows, i)
			continue
		end
		local b = if g.own then (if blackout then GLOW.dark else GLOW.idle) else (if blackout then GLOW.mate else 0)
		local r = if g.own then (if blackout then GLOW.darkRange else GLOW.idleRange) else GLOW.mateRange
		if math.abs(l.Brightness - b) > 0.002 or math.abs(l.Range - r) > 0.02 then
			l.Brightness += (b - l.Brightness) * k
			l.Range += (r - l.Range) * k
		end
		local on = g.own or blackout or l.Brightness > 0.01
		if l.Enabled ~= on then
			l.Enabled = on
		end
	end
end

-- Fixture flicker ----------------------------------------------------------------

-- Power warnings and disturbances dim the real ceiling fixtures for a moment
-- (light brightness plus a local fade of the neon panel). Dips last 0.08-0.18 s
-- with at least 0.26 s lit in between, so never more than 3 flashes a second.
type FixtureLight = { light: Light, base: number }
type Fixture = { part: BasePart, lights: { FixtureLight } }
local fixtures: { Fixture } = {}
local flickerToken = 0
local flickering = false

local function collectFixtures()
	table.clear(fixtures)
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Lights")
	if not folder then
		return
	end
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") and FIXTURE_NAMES[d.Name] then
			local lights: { FixtureLight } = {}
			for _, c in d:GetChildren() do
				if c:IsA("Light") then
					table.insert(lights, { light = c, base = c.Brightness })
				end
			end
			if #lights > 0 then
				table.insert(fixtures, { part = d, lights = lights })
			end
		end
	end
end

local function setLevel(list: { Fixture }, level: number)
	local lit = workspace:GetAttribute("LightsOn") ~= false
	for _, f in list do
		f.part.LocalTransparencyModifier = if lit then (1 - level) * 0.7 else 0
		for _, fl in f.lights do
			fl.light.Brightness = fl.base * level
		end
	end
end

-- `near`: only fixtures around that point flicker; otherwise the whole building.
function Atmosphere.flicker(seconds: number, strength: number?, near: Vector3?)
	local s = math.clamp(strength or 0.35, 0.05, 1)
	if #fixtures == 0 then
		collectFixtures()
	end
	flickerToken += 1
	local token = flickerToken
	if flickering then
		setLevel(fixtures, 1) -- a newer flicker replaces the old one cleanly
	else
		for _, f in fixtures do
			for _, fl in f.lights do
				fl.base = fl.light.Brightness
			end
		end
	end
	flickering = true
	local targets: { Fixture } = {}
	for _, f in fixtures do
		if not near or (f.part.Position - near).Magnitude <= FLICKER_RADIUS then
			table.insert(targets, f)
		end
	end
	-- no fixtures found (map still loading): a gentle grade dip instead
	local viaGrade = #fixtures == 0
	task.spawn(function()
		local t0 = os.clock()
		while token == flickerToken and os.clock() - t0 < seconds do
			local level = 1 - math.min(s * (1 + math.random() * 0.6) * 1.4, 0.92)
			if viaGrade then
				flickerDip = (1 - level) * 0.12
			else
				setLevel(targets, level)
			end
			task.wait(0.08 + math.random() * 0.1)
			if token ~= flickerToken then
				return
			end
			if viaGrade then
				flickerDip = 0
			else
				setLevel(targets, 1)
			end
			task.wait(0.26 + math.random() * 0.5)
		end
		if token == flickerToken then
			setLevel(fixtures, 1)
			flickerDip = 0
			flickering = false
		end
	end)
end

-- Sound, door light, story screens ------------------------------------------------

local function ambience()
	Sfx.play("ambientRoom", { looped = true, volume = 0.3 })
	Sfx.play("rain", { looped = true, volume = 0.22 })
	Sfx.play("fanHum", { looped = true, volume = 0.12 })
	tense = Sfx.play("ambientTense", { looped = true, volume = 0 })
	local finale = Sfx.play("ambientFinale", { looped = true, volume = 0 })
	if finale then
		State.Changed:Connect(function(snap)
			local on = snap.phase == "FinalPurge" or snap.phase == "SignOff" or snap.phase == "ClockOut"
			finale.Volume = if on then 0.45 else 0
		end)
	end
end

local function doorBlink()
	-- 1.25 blinks a second while the rear door is not latched
	local acc = 0
	local on = true
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.4 then
			return
		end
		acc = 0
		local map = workspace:FindFirstChild("Map")
		local inter = map and map:FindFirstChild("Interactive")
		local light = inter and inter:FindFirstChild("DoorStatusLight")
		if light and light:IsA("BasePart") then
			on = not on
			light.LocalTransparencyModifier = if light:GetAttribute("Alert") == true and not on then 0.8 else 0
		end
	end)
end

local function screenTexts()
	-- source monitor messages set by the story (server attribute "Text"),
	-- in soft green phosphor
	local map = workspace:WaitForChild("Map", 20)
	local inter = map and map:WaitForChild("Interactive", 10)
	if not inter then
		return
	end
	for i = 1, 6 do
		local screen = inter:FindFirstChild("SourceScreen_" .. i)
		if screen and screen:IsA("BasePart") then
			local sg = Instance.new("SurfaceGui")
			sg.Name = "StoryText"
			sg.Face = Enum.NormalId.Back
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 80
			sg.LightInfluence = 0
			sg.Parent = screen
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.TextColor3 = PHOSPHOR
			t.FontFace = Fonts.PIXEL
			t.TextScaled = true
			t.TextWrapped = true
			t.Text = ""
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 6)
			pad.PaddingRight = UDim.new(0, 6)
			pad.PaddingTop = UDim.new(0, 6)
			pad.PaddingBottom = UDim.new(0, 6)
			pad.Parent = t
			t.Parent = sg
			local function sync()
				local v = screen:GetAttribute("Text")
				t.Text = if typeof(v) == "string" then v else ""
				screen.Material = if t.Text ~= "" then Enum.Material.Neon else Enum.Material.SmoothPlastic
				screen.Color = if t.Text ~= "" then Color3.fromRGB(14, 26, 18) else Color3.fromRGB(10, 14, 12)
			end
			screen:GetAttributeChangedSignal("Text"):Connect(sync)
			sync()
		end
	end
end

function Atmosphere.init()
	setupLighting()
	RunService.Heartbeat:Connect(function(dt)
		gradeStep(dt)
		glowStep(dt)
	end)
end

function Atmosphere.start()
	while workspace:GetAttribute("MapReady") ~= true do
		task.wait(0.1)
	end
	applySurfaces()
	collectFixtures()
	buildExteriorFog()
	windowLight()
	-- rain stays outside the walls and doorways
	local A, S, N = Layout.ALLEY, Layout.STREET, NORTH_STREET
	makeRain({ minX = A.minX + 1.5, maxX = A.maxX, minZ = A.minZ, maxZ = A.maxZ }, 40)
	makeRain({ minX = N.minX, maxX = N.maxX, minZ = N.minZ + 0.5, maxZ = N.maxZ - 0.5 }, 40)
	makeRain({ minX = S.minX, maxX = S.maxX, minZ = S.minZ + 1.5, maxZ = S.maxZ }, 40)
	rainOnGlass()
	buildGrain()
	doorBlink()
	ambience()
	task.spawn(screenTexts)
	workspace:GetAttributeChangedSignal("Dread"):Connect(updateDread)
	workspace:GetAttributeChangedSignal("LightsOn"):Connect(updatePower)
	updateDread()
	updatePower()
	for _, plr in Players:GetPlayers() do
		watchPlayer(plr)
	end
	Players.PlayerAdded:Connect(watchPlayer)
end

return Atmosphere
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="169">
            <Properties>
              <string name="Name">Desktop</string>
              <string name="Source"><![CDATA[--!strict
-- The workstation desktop: a native-GUI, late-90s office OS shell that
-- hosts every SecureErase utility. Opens when the server starts a session
-- for this player and closes the moment the session ends. Everything here is
-- presentation: actions are sent to the server as semantic commands tagged
-- with the session id, and the server answers with the authoritative state.
--
-- Look (docs/ART_DIRECTION.md): slate-teal desktop, cream bevelled windows
-- with charcoal-blue title bars, square corners. Silkscreen only for titles,
-- status and the tray clock; Ubuntu for sentences and buttons; Inconsolata
-- for listings; Merriweather for recovered fragments.
--
-- Scaling: the desktop is laid out in logical pixels on a canvas scaled to
-- the monitor. Big screens see a BASE_W x BASE_H desktop (scale capped at
-- MAX_SCALE). Small screens get a smaller logical desktop, down to
-- MIN_W x MIN_H (main window + taskbar), instead of a smaller scale, so
-- 16 px text still lands at ~13 px on a 667x375 phone.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local State = require(script.Parent.State)
local Cursor = require(script.Parent.Parent.Ui.Cursor)
local UiKit = require(script.Parent.Parent.Ui.UiKit)

local C = UiKit.C
local SPACE = UiKit.SPACE
local player = Players.LocalPlayer

local Views: { [string]: any } = {}
for _, m in script.Parent.Parent:WaitForChild("Views"):GetChildren() do
	if m:IsA("ModuleScript") then
		Views[m.Name] = (require :: any)(m)
	end
end

local Desktop = {}

-- logical layout (px before the canvas UIScale)
local BASE_W, BASE_H = 960, 600
local MIN_W, MIN_H = 776, 452
local MAX_SCALE = 1.6
local COMPACT_BELOW = 0.92 -- bezel-less monitor when the framed screen would scale below this
local TB = 32 -- taskbar height
local ICON_W, ICON_H = 100, 66
local MAIN_X, MAIN_W, MAIN_H = 108, 660, 416
local STAGE_W = 194
local GAME_W, GAME_H = 620, 250 -- the minigame Views draw into exactly this
local SIDE_W = 460
local FRAG_W, FRAG_H = 480, 268
local PHANTOM_W, PHANTOM_H = 360, 196
local TASK_W = 128
local TRAY_W = 480
local LEAVE_TASKBAR_W = 136

-- desktop-only tones, derived from the shared palette
local D = {
	wallTop = C.desktop:Lerp(C.slate, 0.25),
	wallBottom = C.desktop:Lerp(C.charcoal, 0.55),
	wallMark = C.desktop:Lerp(C.fog, 0.22),
	plastic = C.cream, -- monitor bezel: old plastic
	plasticDark = C.cream:Lerp(C.charcoal, 0.5),
	paper = Color3.fromRGB(246, 242, 230), -- recovered fragments
	well = C.face:Lerp(C.faceDark, 0.1), -- sunken tray
	tip = Color3.fromRGB(238, 228, 204), -- hint strip and tooltip
	tipLine = Color3.fromRGB(150, 118, 64),
	locked = C.face:Lerp(C.faceDark, 0.15),
	phantom1 = Color3.fromRGB(112, 38, 32), -- phantom title bar: red-brown, never blue (learned cue)
	phantom2 = Color3.fromRGB(160, 92, 64),
	phantomText = Color3.fromRGB(255, 226, 214),
	led = Color3.fromRGB(120, 196, 120),
	folderTab = C.amber:Lerp(C.charcoal, 0.25),
	folderLip = C.amber:Lerp(C.white, 0.35),
}

local W, H = BASE_W, BASE_H
local compact = false

local gui: ScreenGui
local bezel: Frame
local screen: Frame
local canvas: Frame
local canvasScale: UIScale
local chin: Frame
local chinScale: UIScale
local chinLed: Frame
local wallMark: Frame
local windowsLayer: Frame
local powerOn: Frame
local mainWin: UiKit.Window
local mainParts: {
	header: TextLabel,
	stage: TextLabel,
	progressFill: Frame,
	instructions: TextLabel,
	game: Frame,
	feedback: TextLabel,
	hintBox: Frame,
	hint: TextLabel,
	overlay: Frame,
	overlayText: TextLabel,
}
local side: { [string]: UiKit.Window } = {}
local sideOpen: { [string]: boolean } = {}
local taskbar: Frame
local taskbarTray: { erased: TextLabel, door: TextLabel, power: TextLabel, clock: TextLabel }
local taskButtons: { TextButton } = {}
local unreadMarks: { Frame } = {}
local startBtn: TextButton
local startMenu: Frame
local firstMenuItem: TextButton? = nil
local toast: TextButton
local toastFrom: TextLabel
local toastText: TextLabel
local phantomFrame: Frame?
local fragmentWin: UiKit.Window?
local leaveButton: TextButton

local isOpen = false
local session: Types.SessionPayload? = nil
local lastViewKey = ""
local zTop = 20
local filesSelection: number? = nil
local sideKeys: { [string]: string } = {}
local finaleKey = ""

-- cheap content signature per side app, so snapshots that change nothing
-- relevant do not rebuild the window (scroll position and focus survive)
local function sideKey(name: string, snap: Types.Snapshot): string
	if name == "Messenger" then
		local last = snap.boss[#snap.boss]
		local open = 0
		for _, m in snap.boss do
			if m.answered then
				open += 1
			end
		end
		return string.format("%d:%s:%d", #snap.boss, if last then tostring(last.id) else "-", open)
	elseif name == "DriveInfo" then
		local parts = {}
		for _, d in snap.drives do
			table.insert(parts, d.state .. math.floor(d.progress * 20) .. (d.carrier or ""))
		end
		return table.concat(parts, "|")
	end
	return "static"
end

local function finaleSignature(snap: Types.Snapshot): string
	local parts: { string } = { snap.phase :: string, tostring(snap.power.workstation) }
	if snap.purge then
		for _, e in snap.purge do
			table.insert(parts, e.name .. tostring(e.cancelled))
		end
		table.insert(parts, tostring(math.floor(snap.purgeDeadline or 0)))
	end
	if snap.signOff then
		table.insert(parts, tostring(math.floor(snap.signOff.progress * 100)) .. tostring(snap.signOff.awaiting))
	end
	return table.concat(parts, ";")
end

local function send(kind: string, a: any?, b: any?, c: any?)
	local s = session
	if not s then
		return
	end
	Net.remote("Desktop"):FireServer(s.sessionId, kind, a, b, c)
end

function Desktop.leave()
	Net.remote("Leave"):FireServer()
	local character = player.Character
	local h = character and character:FindFirstChildOfClass("Humanoid")
	if h then
		h.Sit = false
		h.Jump = true
	end
end

-- Small pixel glyphs ----------------------------------------------------------
-- Each piece is { x, y, w, h, colour, outlined? } on a 16-unit grid; k scales
-- it (k = 2 for 32 px desktop icons, k = 1 for 16 px menu and taskbar icons).

local GLYPHS: { [string]: { { any } } } = {
	erase = { { 1, 2, 14, 12, C.face, true }, { 2, 3, 12, 3, C.title1 }, { 3, 8, 10, 3, C.field, true }, { 3, 8, 6, 3, C.good } },
	messenger = { { 1, 2, 10, 7, C.slate, true }, { 5, 6, 10, 8, C.white, true }, { 7, 8, 6, 1, C.faceDark }, { 7, 10, 4, 1, C.faceDark } },
	folder = { { 1, 3, 6, 2, D.folderTab, true }, { 1, 4, 14, 10, C.amber, true }, { 2, 6, 12, 1, D.folderLip } },
	drive = { { 1, 4, 14, 9, C.charcoal, true }, { 3, 6, 7, 3, C.cream }, { 11, 10, 2, 1, D.led } },
	text = { { 3, 1, 10, 14, C.white, true }, { 5, 4, 6, 1, C.faceDark }, { 5, 6, 6, 1, C.faceDark }, { 5, 8, 6, 1, C.faceDark }, { 5, 10, 4, 1, C.faceDark } },
	door = { { 4, 1, 8, 14, C.burgundy, true }, { 9, 8, 1, 1, C.amber } },
	logo = { { 1, 1, 14, 14, C.charcoal, true }, { 5, 5, 6, 6, C.amber } },
}

local function glyph(parent: Instance, kind: string, x: number, y: number, k: number, z: number): Frame
	local box = UiKit.frame({ Name = "Glyph", Size = UDim2.fromOffset(16 * k, 16 * k), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1, ZIndex = z, Parent = parent })
	local pieces = GLYPHS[kind]
	if not pieces then
		return box
	end
	for _, r in pieces do
		UiKit.frame({
			Size = UDim2.fromOffset(r[3] * k, r[4] * k),
			Position = UDim2.fromOffset(r[1] * k, r[2] * k),
			BackgroundColor3 = r[5],
			BorderSizePixel = if r[6] then 1 else 0,
			BorderColor3 = C.edge,
			BorderMode = Enum.BorderMode.Inset,
			ZIndex = z + 1,
			Parent = box,
		})
	end
	return box
end

-- Windows ---------------------------------------------------------------------

local function allWindows(): { UiKit.Window }
	local list: { UiKit.Window } = { mainWin }
	for _, w in side do
		table.insert(list, w)
	end
	if fragmentWin then
		table.insert(list, fragmentWin)
	end
	return list
end

-- the topmost visible window keeps the charcoal-blue title bar
local function refreshActive()
	local top: UiKit.Window? = nil
	for _, w in allWindows() do
		if w.frame.Visible and w.frame.Parent and (not top or w.frame.ZIndex > top.frame.ZIndex) then
			top = w
		end
	end
	for _, w in allWindows() do
		UiKit.setWindowActive(w, w == top)
	end
end

-- ZIndexBehavior is Sibling, so raising the window frame raises the window.
local function bringToFront(w: UiKit.Window)
	zTop += 1
	w.frame.ZIndex = zTop
	if phantomFrame then
		phantomFrame.ZIndex = zTop + 100
	end
	refreshActive()
end

-- clicking a partly covered window raises it, like any desktop
local function trackWindow(w: UiKit.Window)
	w.frame.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) and w.frame.ZIndex < zTop then
			bringToFront(w)
		end
	end)
end

local function setStartMenu(visible: boolean)
	startMenu.Visible = visible
	-- keep gamepad focus inside the menu while it is open, and out of it after
	local sel = GuiService.SelectedObject
	if visible and sel == startBtn and firstMenuItem then
		GuiService.SelectedObject = firstMenuItem
	elseif not visible and sel and sel:IsDescendantOf(startMenu) then
		GuiService.SelectedObject = startBtn
	end
end

local function setUnread(on: boolean)
	for _, f in unreadMarks do
		f.Visible = on
	end
end

-- Side applications ---------------------------------------------------------

local renderSide: (name: string) -> ()

local function openSide(name: string)
	local w = side[name]
	if not w then
		return
	end
	sideOpen[name] = true
	w.frame.Visible = true
	bringToFront(w)
	renderSide(name)
	setStartMenu(false)
	if name == "Messenger" then
		setUnread(false)
	end
end

local function closeSide(name: string)
	sideOpen[name] = false
	local w = side[name]
	if w then
		w.frame.Visible = false
	end
	refreshActive()
end

-- Sunken white document area with a vertical list (Notepad, Explorer, IM).
local function docArea(body: Frame, z: number, gap: number, bg: Color3?): ScrollingFrame
	local paper = UiKit.frame({ Name = "Paper", Size = UDim2.fromScale(1, 1), BackgroundColor3 = bg or C.field, ZIndex = z, Parent = body })
	UiKit.bevel(paper, true)
	local scroll = UiKit.new("ScrollingFrame", {
		Name = "Doc",
		Size = UDim2.new(1, -4, 1, -4),
		Position = UDim2.fromOffset(2, 2),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 12,
		ScrollBarImageColor3 = C.faceDark,
		ScrollBarImageTransparency = 0,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = z + 2,
		Parent = paper,
	}) :: ScrollingFrame
	UiKit.new("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	UiKit.padding(scroll, SPACE.s)
	return scroll
end

-- One auto-height line of text in a document list.
local function docLine(parent: Instance, role: string, text: string, order: number, props: UiKit.Props?): TextLabel
	local p: UiKit.Props = {
		Text = text,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = order,
		Parent = parent,
	}
	local extra: UiKit.Props = props or {}
	for k, v in extra do
		p[k] = v
	end
	return UiKit.text(role, p)
end

renderSide = function(name: string)
	local w = side[name]
	local snap = State.snapshot
	if not w or not sideOpen[name] or not snap then
		return
	end
	local body = w.body
	UiKit.clear(body)
	local z = body.ZIndex + 1
	if name == "Messenger" then
		local scroll = docArea(body, z, SPACE.m)
		for i, m in snap.boss do
			local tint = if m.kind == "false" then C.bad elseif m.kind == "system" then C.good else C.info
			local block = UiKit.frame({ Name = "Message", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = i, Parent = scroll })
			UiKit.new("UIListLayout", { Padding = UDim.new(0, SPACE.xs), SortOrder = Enum.SortOrder.LayoutOrder, Parent = block })
			local head = UiKit.frame({ Name = "Head", Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1, Parent = block })
			UiKit.text("body", { Text = m.from, Font = UiKit.FONT_BOLD, Size = UDim2.new(1, -96, 1, 0), TextColor3 = tint, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
			UiKit.text("mono", {
				Text = State.nightClock(m.t),
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.new(0, 90, 1, 0),
				TextColor3 = C.textDim,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextWrapped = false,
				Parent = head,
			})
			docLine(block, "body", m.text, 2)
			if m.choices and not m.answered then
				local row = UiKit.frame({ Name = "Choices", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 3, Parent = block })
				for j, choice in m.choices do
					UiKit.button({
						text = choice,
						size = UDim2.fromOffset(176, 28),
						position = UDim2.fromOffset((j - 1) * 184, 1),
						parent = row,
						zindex = 2,
						onClick = function()
							send("bossReply", m.id, j)
						end,
					})
				end
			elseif m.answered then
				docLine(block, "body", "> " .. m.answered, 3, { TextColor3 = C.textDim })
			end
		end
		-- newest message at the bottom, once the list has been measured
		scroll.CanvasPosition = Vector2.new(0, 100000)
		scroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
			scroll.CanvasPosition = Vector2.new(0, 100000)
		end)
	elseif name == "Procedures" then
		-- a plain text file: one monospaced face, like Notepad
		local scroll = docArea(body, z, SPACE.s)
		docLine(scroll, "mono", "PROCEDURES.TXT - Night Operations (rev. 2006)", 1)
		docLine(scroll, "mono", string.rep("-", 44), 2, { TextColor3 = C.textDim })
		for i, line in Dialogue.PROCEDURES do
			docLine(scroll, "mono", line, 2 + i)
		end
		docLine(scroll, "mono", "If an instruction contradicts these procedures, reject it and cite the number.", 100, { TextColor3 = C.bad })
	elseif name == "Files" then
		local scroll = docArea(body, z, 2)
		local address = UiKit.frame({ Name = "Address", Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = C.white, BorderSizePixel = 1, BorderColor3 = C.faceDark, BorderMode = Enum.BorderMode.Inset, LayoutOrder = 1, Parent = scroll })
		UiKit.text("mono", { Text = "C:\\RECOVERED\\", Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), TextWrapped = false, Parent = address })
		docLine(scroll, "body", "Fragments saved before shredding.", 2, { TextColor3 = C.textDim })
		if #snap.fragments == 0 then
			docLine(scroll, "body", "(empty)", 3, { TextColor3 = C.textDim })
		end
		local order = 10
		for _, idx in snap.fragments do
			local f = Dialogue.FRAGMENTS[idx]
			if f then
				order += 1
				local selected = filesSelection == idx
				local fg = if selected then C.white else C.text
				local row = UiKit.button({
					name = "File_" .. idx,
					text = "",
					size = UDim2.new(1, 0, 0, 26),
					parent = scroll,
					color = if selected then C.select else C.field,
					bevel = false,
					onClick = function()
						filesSelection = idx
						renderSide("Files")
					end,
				})
				row.LayoutOrder = order
				UiKit.text("mono", { Text = string.format("%02d", idx), Size = UDim2.new(0, 24, 1, 0), Position = UDim2.fromOffset(6, 0), TextColor3 = fg, TextWrapped = false, Parent = row })
				UiKit.text("mono", { Text = f.title, Size = UDim2.new(1, -190, 1, 0), Position = UDim2.fromOffset(36, 0), TextColor3 = fg, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				UiKit.text("body", {
					Text = f.kind,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -6, 0, 0),
					Size = UDim2.new(0, 144, 1, 0),
					TextColor3 = if selected then C.white else C.textDim,
					TextXAlignment = Enum.TextXAlignment.Right,
					TextWrapped = false,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Parent = row,
				})
				if selected then
					order += 1
					local paper = UiKit.frame({ Name = "Fragment", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = D.paper, LayoutOrder = order, Parent = scroll })
					UiKit.stroke(paper, C.faceDark, 0, 1)
					UiKit.padding(paper, SPACE.m, SPACE.s)
					UiKit.text("letter", { Text = f.body, Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextYAlignment = Enum.TextYAlignment.Top, Parent = paper })
				end
			end
		end
	elseif name == "DriveInfo" then
		local scroll = docArea(body, z, SPACE.xs)
		docLine(scroll, "heading", string.format("Erased %d of %d", snap.erased, snap.total), 1)
		local cols = UiKit.frame({ Name = "Columns", Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 2, Parent = scroll })
		UiKit.text("title", { Text = "ID", Size = UDim2.new(0, 64, 1, 0), TextColor3 = C.textDim, TextWrapped = false, Parent = cols })
		UiKit.text("title", { Text = "DRIVE", Position = UDim2.fromOffset(68, 0), Size = UDim2.new(0, 136, 1, 0), TextColor3 = C.textDim, TextWrapped = false, Parent = cols })
		UiKit.text("title", { Text = "STATUS", Position = UDim2.fromOffset(210, 0), Size = UDim2.new(0, 100, 1, 0), TextColor3 = C.textDim, TextWrapped = false, Parent = cols })
		UiKit.text("title", { Text = "DONE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 60, 1, 0), TextColor3 = C.textDim, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, Parent = cols })
		UiKit.frame({ Name = "Rule", Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.faceDark, LayoutOrder = 3, Parent = scroll })
		local order = 10
		for _, d in snap.drives do
			order += 1
			local where = if d.carrier then "Carried by " .. d.carrier else d.state
			local color = if d.state == "Erased" then C.good else C.text
			local row = UiKit.frame({ Name = "Drive_" .. d.id, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = order, Parent = scroll })
			UiKit.text("mono", { Text = d.id, Size = UDim2.new(0, 64, 1, 0), TextColor3 = color, TextWrapped = false, Parent = row })
			UiKit.text("mono", { Text = d.name, Position = UDim2.fromOffset(68, 0), Size = UDim2.new(0, 136, 1, 0), TextColor3 = color, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
			UiKit.text("body", { Text = where, Position = UDim2.fromOffset(210, 0), Size = UDim2.new(1, -270, 1, 0), TextColor3 = color, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
			UiKit.text("mono", {
				Text = string.format("%d%%", math.floor(d.progress * 100)),
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.new(0, 56, 1, 0),
				TextColor3 = color,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextWrapped = false,
				Parent = row,
			})
			if d.gameTitle then
				order += 1
				local util = docLine(scroll, "body", "Utility: " .. d.gameTitle, order, { TextColor3 = C.textDim })
				UiKit.new("UIPadding", { PaddingLeft = UDim.new(0, 68), Parent = util })
			end
		end
	end
end

-- Main SecureErase window ----------------------------------------------------

local function setFeedback(text: string?, kind: string?)
	mainParts.feedback.Text = text or ""
	mainParts.feedback.TextColor3 = if kind == "bad" then C.bad elseif kind == "good" then C.good else C.info
end

local function setHint(text: string?)
	local t = text or ""
	mainParts.hint.Text = t
	mainParts.hintBox.Visible = t ~= ""
end

-- centred line inside the minigame area
local function gameLine(g: Frame, role: string, text: string, y: number, z: number, props: UiKit.Props?): TextLabel
	local p: UiKit.Props = {
		Text = text,
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.fromOffset(0, y),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = z,
		Parent = g,
	}
	local extra: UiKit.Props = props or {}
	for k, v in extra do
		p[k] = v
	end
	return UiKit.text(role, p)
end

local function renderFinale(snap: Types.Snapshot)
	local g = mainParts.game
	UiKit.clear(g)
	local z = g.ZIndex
	mainParts.stage.TextColor3 = C.text
	if snap.phase == "FinalPurge" and snap.purge then
		local left = math.floor(snap.purgeDeadline or 0)
		finaleKey = finaleSignature(snap)
		mainWin.title.Text = "SecureErase :: FINAL PURGE QUEUE"
		mainParts.header.Text = "AUTOMATIC FINAL PURGE: EMPLOYEE RECORDS"
		mainParts.stage.Text = string.format("Executes in %d:%02d", left // 60, left % 60)
		mainParts.stage.TextColor3 = C.bad
		mainParts.instructions.Text = "The final purge includes YOUR employee records. Cancel every entry from tonight, then run EMERGENCY SIGN-OFF."
		-- queue table: up to 8 rows (4 records from 2003 + up to 4 players) above the run button
		UiKit.text("title", { Text = "RECORD", Size = UDim2.fromOffset(200, 20), Position = UDim2.fromOffset(8, 0), TextColor3 = C.textDim, TextWrapped = false, ZIndex = z, Parent = g })
		UiKit.text("title", { Text = "STATUS", Size = UDim2.fromOffset(200, 20), Position = UDim2.fromOffset(372, 0), TextColor3 = C.textDim, TextWrapped = false, ZIndex = z, Parent = g })
		local allDone = true
		for i, e in snap.purge do
			local row = UiKit.frame({
				Name = "Entry",
				Size = UDim2.new(1, 0, 0, 22),
				Position = UDim2.fromOffset(0, 22 + (i - 1) * 24),
				BackgroundColor3 = if e.locked then D.locked else C.field,
				BorderSizePixel = 1,
				BorderColor3 = C.faceDark,
				BorderMode = Enum.BorderMode.Inset,
				ZIndex = z,
				Parent = g,
			})
			UiKit.text("mono", { Text = e.name, Size = UDim2.new(0, 352, 1, 0), Position = UDim2.fromOffset(8, 0), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = z + 1, Parent = row })
			if e.locked then
				UiKit.text("title", { Text = "PURGED 03-NOV-2003", Size = UDim2.new(0, 240, 1, 0), Position = UDim2.fromOffset(372, 0), TextColor3 = C.bad, TextWrapped = false, ZIndex = z + 1, Parent = row })
			elseif e.cancelled then
				UiKit.text("title", { Text = "REMOVED FROM QUEUE", Size = UDim2.new(0, 240, 1, 0), Position = UDim2.fromOffset(372, 0), TextColor3 = C.good, TextWrapped = false, ZIndex = z + 1, Parent = row })
			else
				allDone = false
				UiKit.button({
					text = "CANCEL",
					size = UDim2.fromOffset(150, 20),
					position = UDim2.fromOffset(372, 1),
					parent = row,
					color = C.bad,
					textColor = C.white,
					zindex = z + 2,
					onClick = function()
						send("purgeCancel", i)
					end,
				})
			end
		end
		local run = UiKit.button({
			text = "RUN EMERGENCY SIGN-OFF",
			size = UDim2.fromOffset(300, 34),
			position = UDim2.new(0.5, -150, 1, -34),
			parent = g,
			color = if allDone then C.good else C.faceDark,
			textColor = C.white,
			textSize = 18,
			zindex = z + 2,
			onClick = function()
				send("signOffStart")
			end,
		})
		UiKit.setEnabled(run, allDone)
		mainParts.progressFill.Size = UDim2.fromScale(1 - math.clamp(left / 150, 0, 1), 1)
		mainParts.progressFill.BackgroundColor3 = C.bad
	elseif snap.phase == "SignOff" and snap.signOff then
		local s = snap.signOff
		mainWin.title.Text = "SecureErase :: EMERGENCY SIGN-OFF"
		mainParts.header.Text = "Writing tonight's timesheets to the off-site backup"
		mainParts.stage.Text = string.format("%d%%", math.floor(s.progress * 100))
		mainParts.instructions.Text = "Keep the workstation powered. At each checkpoint the operator must CONFIRM. Power loss pauses the sign-off; it never resets."
		mainParts.progressFill.Size = UDim2.fromScale(s.progress, 1)
		mainParts.progressFill.BackgroundColor3 = C.good
		local status = if not snap.power.workstation then "PAUSED - NO POWER" elseif s.awaiting then "AWAITING CONFIRMATION" else "RUNNING..."
		gameLine(g, "title", status, 28, z, { TextSize = 24, TextColor3 = if s.awaiting or not snap.power.workstation then C.bad else C.text })
		if s.awaiting then
			UiKit.button({
				text = "CONFIRM CHECKPOINT",
				size = UDim2.fromOffset(300, 56),
				position = UDim2.new(0.5, -150, 0, 92),
				parent = g,
				color = C.good,
				textColor = C.white,
				textSize = 18,
				zindex = z + 1,
				onClick = function()
					send("signOffConfirm")
				end,
			})
		end
	elseif snap.phase == "ClockOut" or snap.phase == "Ending" then
		mainWin.title.Text = "SecureErase"
		mainParts.header.Text = "SIGN-OFF COMPLETE"
		mainParts.stage.Text = ""
		mainParts.instructions.Text = "Your records are safe off-site. Leave the computer, clock out at the lobby time clock and get out."
		mainParts.progressFill.Size = UDim2.fromScale(1, 1)
	end
end

-- empty dock: a row of drive bays showing the team's progress
local function renderNoDrive(g: Frame, snap: Types.Snapshot)
	local z = g.ZIndex
	gameLine(g, "title", "NO DRIVE IN DOCK", 24, z, { TextColor3 = C.textDim })
	local n = math.max(snap.total, 1)
	local bw, gap = 44, 12
	local x0 = (GAME_W - (n * bw + (n - 1) * gap)) // 2
	for i = 1, n do
		local done = i <= snap.erased
		local bay = UiKit.frame({ Name = "Bay", Size = UDim2.fromOffset(bw, 56), Position = UDim2.fromOffset(x0 + (i - 1) * (bw + gap), 66), BackgroundColor3 = if done then C.good else C.field, ZIndex = z, Parent = g })
		UiKit.bevel(bay, not done)
		UiKit.frame({ Name = "Label", Size = UDim2.fromOffset(bw - 16, 8), Position = UDim2.fromOffset(8, 12), BackgroundColor3 = if done then C.good:Lerp(C.white, 0.4) else C.face, ZIndex = z + 2, Parent = bay })
	end
	gameLine(g, "heading", string.format("Team progress: %d of %d drives erased", snap.erased, snap.total), 140, z)
end

local function renderMain()
	local s = session
	local snap = State.snapshot
	if not s or not snap then
		return
	end
	setHint(s.hint)
	setFeedback(s.feedback, s.feedbackKind)
	local noPower = s.reason == "power" or not snap.power.workstation
	mainParts.overlay.Visible = noPower
	if noPower then
		mainParts.overlayText.Text = "The workstation has lost power. Reset the tripped breaker (MAIN / WORKSTATION) at the panel in the UTILITY HALL."
	end
	if snap.phase == "FinalPurge" or snap.phase == "SignOff" or snap.phase == "ClockOut" or snap.phase == "Ending" then
		lastViewKey = "finale"
		renderFinale(snap)
		return
	end
	mainWin.title.Text = s.title or "SecureErase 2.1"
	mainParts.stage.TextColor3 = C.text
	mainParts.progressFill.BackgroundColor3 = C.good
	local g = mainParts.game
	if not s.driveId then
		lastViewKey = "nodrive"
		UiKit.clear(g)
		mainParts.header.Text = "No drive connected"
		mainParts.stage.Text = ""
		mainParts.instructions.Text = "Dock a hard drive at the DOCK on this desk (a teammate can bring one from the rack). Use the desktop apps meanwhile."
		mainParts.progressFill.Size = UDim2.fromScale(0, 1)
		renderNoDrive(g, snap)
		return
	end
	mainParts.header.Text = string.format("Connected: %s  %s", s.driveId, s.driveName or "")
	if not s.view then
		lastViewKey = "start"
		UiKit.clear(g)
		mainParts.stage.Text = "Ready"
		mainParts.instructions.Text = s.instructions or ""
		mainParts.progressFill.Size = UDim2.fromScale(0, 1)
		UiKit.button({
			name = "StartErase",
			text = "START SECURE ERASE",
			size = UDim2.fromOffset(280, 52),
			position = UDim2.new(0.5, -140, 0, 80),
			parent = g,
			color = C.good,
			textColor = C.white,
			textSize = 18,
			zindex = g.ZIndex + 1,
			onClick = function()
				send("start")
			end,
		})
		return
	end
	mainParts.stage.Text = if s.transitioning then "Erasing sectors..." else string.format("Stage %d / %d", s.stage, s.stages)
	mainParts.instructions.Text = s.instructions or ""
	local progress = s.progress or 0
	TweenService:Create(mainParts.progressFill, UiKit.FAST, { Size = UDim2.fromScale(progress, 1) }):Play()
	local view = s.view :: { [string]: any }
	local mod = Views[view.kind]
	if s.transitioning then
		UiKit.clear(g)
		gameLine(g, "title", "PLEASE WAIT", 76, g.ZIndex, { TextColor3 = C.textDim })
		gameLine(g, "heading", "Verifying stage... erasing sectors...", 104, g.ZIndex)
		lastViewKey = "transition"
		return
	end
	if mod then
		lastViewKey = view.kind
		mod.render(g, view, {
			act = function(action: string, a: any, b: any)
				send("act", action, a, b)
			end,
		}, g.ZIndex + 1)
	end
end

-- PHANTOM WINDOW: the learned cue is the red-brown title bar and the real
-- close button on the LEFT; OK is the trap. Keep both cues readable.
local function renderPhantom()
	local s = session
	if phantomFrame then
		phantomFrame:Destroy()
		phantomFrame = nil
	end
	local p = s and s.phantom
	if not p or not isOpen then
		return
	end
	local z = zTop + 100
	local x = math.clamp(math.floor(p.x * W), SPACE.s, math.max(SPACE.s, W - PHANTOM_W - SPACE.s))
	local y = math.clamp(math.floor(p.y * H), SPACE.s, math.max(SPACE.s, H - TB - PHANTOM_H - 56))
	local f = UiKit.frame({ Name = "Phantom", Size = UDim2.fromOffset(PHANTOM_W, PHANTOM_H), Position = UDim2.fromOffset(x, y), BorderSizePixel = 1, BorderColor3 = C.edge, ZIndex = z, Parent = windowsLayer })
	UiKit.bevel(f)
	local bar = UiKit.frame({ Name = "Bar", Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = D.phantom1, ZIndex = z + 1, Parent = f })
	UiKit.new("UIGradient", { Color = ColorSequence.new(D.phantom1, D.phantom2), Parent = bar })
	UiKit.button({
		name = "PhantomClose",
		text = "X",
		size = UDim2.fromOffset(18, 18),
		position = UDim2.fromOffset(3, 3),
		parent = bar,
		zindex = z + 3,
		textSize = 16,
		font = UiKit.FONT_PIXEL,
		onClick = function()
			send("phantom", p.id, "close")
		end,
	})
	UiKit.text("title", { Text = "SecureErase [Not Responding]", Size = UDim2.new(1, -32, 1, 0), Position = UDim2.fromOffset(28, 0), TextColor3 = D.phantomText, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = z + 2, Parent = bar })
	UiKit.text("mono", { Text = "THE QUEUE MUST BE FINISHED.\nDO NOT READ THE FILES.\nPress OK to continue.", Size = UDim2.new(1, -28, 0, 72), Position = UDim2.fromOffset(14, 40), TextYAlignment = Enum.TextYAlignment.Top, ZIndex = z + 2, Parent = f })
	UiKit.button({
		text = "OK",
		size = UDim2.fromOffset(96, 30),
		position = UDim2.new(0.5, -48, 1, -42),
		parent = f,
		zindex = z + 2,
		onClick = function()
			send("phantom", p.id, "ok")
		end,
	})
	if p.first then
		local tip = UiKit.text("body", {
			Text = "Not a real dialog: red title bar, X on the LEFT. Close it with that X.",
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Position = UDim2.new(0, 0, 1, SPACE.s),
			BackgroundTransparency = 0,
			BackgroundColor3 = D.tip,
			ZIndex = z + 2,
			Parent = f,
		})
		UiKit.stroke(tip, C.edge, 0, 1)
		UiKit.padding(tip, SPACE.s, SPACE.xs)
	end
	phantomFrame = f
end

-- Snapshot-driven chrome -----------------------------------------------------

local function renderTray(snap: Types.Snapshot)
	local doorOk = snap.door == "Latched"
	local powerOk = snap.power.workstation and snap.power.lights
	taskbarTray.erased.Text = string.format("ERASED %d/%d", snap.erased, snap.total)
	taskbarTray.door.Text = if doorOk then "DOOR OK" else "DOOR OPEN!"
	taskbarTray.door.TextColor3 = if doorOk then C.text else C.bad
	taskbarTray.power.Text = if powerOk then "PWR OK" else "PWR FAULT"
	taskbarTray.power.TextColor3 = if powerOk then C.text else C.bad
	taskbarTray.clock.Text = State.nightClock(snap.nightMinutes)
	chinLed.BackgroundColor3 = if snap.power.workstation then D.led else C.amber
end

local function showToast(from: string, text: string)
	toastFrom.Text = from
	toastText.Text = text
	toast.Visible = true
	local rest = UDim2.new(1, -SPACE.s, 1, -(TB + SPACE.s))
	toast.Position = rest + UDim2.fromOffset(0, SPACE.l)
	TweenService:Create(toast, UiKit.POP, { Position = rest }):Play()
	local stamp = os.clock()
	toast:SetAttribute("Stamp", stamp)
	task.delay(7, function()
		if toast:GetAttribute("Stamp") == stamp then
			toast.Visible = false
		end
	end)
end

local function placeFragment(win: UiKit.Window)
	win.frame.Position = UDim2.fromOffset(math.max(SPACE.s, (W - FRAG_W) // 2), math.max(SPACE.xs, (H - TB - FRAG_H) // 2))
end

local function showFragment(index: number)
	local f = Dialogue.FRAGMENTS[index]
	if not f or not isOpen then
		return
	end
	if fragmentWin then
		fragmentWin.frame:Destroy()
	end
	local win = UiKit.window(windowsLayer, f.title, UDim2.fromOffset(FRAG_W, FRAG_H), UDim2.new(), 300, function()
		if fragmentWin then
			fragmentWin.frame:Destroy()
			fragmentWin = nil
			refreshActive()
		end
	end)
	win.frame.Name = "Fragment"
	fragmentWin = win
	placeFragment(win)
	trackWindow(win)
	local paper = UiKit.frame({ Name = "Paper", Size = UDim2.fromScale(1, 1), BackgroundColor3 = D.paper, ZIndex = 303, Parent = win.body })
	UiKit.bevel(paper, true)
	local col = UiKit.frame({ Name = "Text", Size = UDim2.new(1, -2 * SPACE.l, 1, -2 * SPACE.m), Position = UDim2.fromOffset(SPACE.l, SPACE.m), BackgroundTransparency = 1, ZIndex = 305, Parent = paper })
	UiKit.new("UIListLayout", { Padding = UDim.new(0, SPACE.xs), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
	UiKit.text("title", { Text = "RECOVERED BEFORE SHREDDING", Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.textDim, TextWrapped = false, LayoutOrder = 1, ZIndex = 306, Parent = col })
	UiKit.text("body", { Text = f.kind, Font = UiKit.FONT_BOLD, Size = UDim2.new(1, 0, 0, 22), TextColor3 = C.bad, TextWrapped = false, LayoutOrder = 2, ZIndex = 306, Parent = col })
	UiKit.text("letter", { Text = f.body, Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 3, ZIndex = 306, Parent = col })
	bringToFront(win)
end

-- Layout ----------------------------------------------------------------------

-- Places what depends on the logical canvas size (W x H).
local function layout()
	local workH = H - TB
	local mainY = math.clamp(math.floor((workH - MAIN_H) * 0.3), SPACE.xs, 48)
	mainWin.frame.Position = UDim2.fromOffset(MAIN_X, mainY)
	local sideH = math.clamp(workH - 50, 300, 440)
	for _, w in side do
		w.frame.Size = UDim2.fromOffset(SIDE_W, sideH)
	end
	-- wallpaper mark only where no window sits on it
	local markLeft, markTop = W - SPACE.xl - 320, workH - SPACE.xl - 80
	wallMark.Visible = markLeft >= MAIN_X + MAIN_W or markTop >= mainY + MAIN_H
	-- taskbar: Start, [Leave on compact screens], task buttons when they fit, tray
	local x = 98
	if compact then
		leaveButton.Parent = taskbar
		leaveButton.AnchorPoint = Vector2.zero
		leaveButton.Position = UDim2.fromOffset(x, 4)
		leaveButton.Size = UDim2.fromOffset(LEAVE_TASKBAR_W, 26)
		leaveButton.TextSize = 16
		leaveButton.Text = "Leave computer"
		leaveButton.ZIndex = 502
		x += LEAVE_TASKBAR_W + 4
	end
	local fits = x + #taskButtons * (TASK_W + 4) + SPACE.s + TRAY_W + 4 <= W
	for i, b in taskButtons do
		b.Visible = fits
		b.Position = UDim2.fromOffset(x + (i - 1) * (TASK_W + 4), 4)
	end
	if fragmentWin then
		placeFragment(fragmentWin)
	end
	if phantomFrame then
		renderPhantom()
	end
end

-- Fits the monitor to the viewport and picks the logical desktop size.
local function adapt()
	local vp = gui.AbsoluteSize
	if vp.X < 2 or vp.Y < 2 then
		local cam = workspace.CurrentCamera
		vp = if cam then cam.ViewportSize else Vector2.new(BASE_W, BASE_H)
	end
	-- framed monitor: cream bezel, 3:2, chin below the screen
	local bh = math.min(vp.Y * 0.98, vp.X * 0.98 / 1.5)
	local bw = bh * 1.5
	local sx, sy = bw * 0.95, bh * 0.85
	compact = math.min(sx / BASE_W, sy / BASE_H) < COMPACT_BELOW
	if compact then
		-- short or narrow screens: no bezel, every pixel goes to the desktop
		bw, bh, sx, sy = vp.X, vp.Y, vp.X, vp.Y
	end
	bezel.Size = UDim2.fromOffset(math.floor(bw), math.floor(bh))
	screen.Size = UDim2.fromOffset(math.floor(sx), math.floor(sy))
	screen.Position = if compact then UDim2.new() else UDim2.fromOffset(math.floor(bw * 0.025), math.floor(bh * 0.03))
	screen.BorderSizePixel = if compact then 0 else 3
	local s = math.max(math.min(sx / BASE_W, sy / BASE_H), math.min(1, sx / MIN_W, sy / MIN_H))
	s = math.min(s, MAX_SCALE)
	W, H = math.floor(sx / s), math.floor(sy / s)
	canvasScale.Scale = s
	canvas.Size = UDim2.fromOffset(W, H)
	chin.Visible = not compact
	if not compact then
		local chinTop = bh * 0.03 + sy
		local chinH = bh - chinTop
		chin.Position = UDim2.fromOffset(math.floor(bw / 2), math.floor(chinTop + chinH / 2))
		chin.Size = UDim2.fromOffset(math.floor(sx / s), math.floor(chinH / s))
		chinScale.Scale = s
		leaveButton.Parent = chin
		leaveButton.AnchorPoint = Vector2.new(1, 0.5)
		leaveButton.Position = UDim2.fromScale(1, 0.5)
		leaveButton.Size = UDim2.fromOffset(264, 34)
		leaveButton.TextSize = 16
		leaveButton.Text = "Leave computer   (Space / B)"
		leaveButton.ZIndex = 10
	end
	layout()
end

-- Construction ---------------------------------------------------------------

local function desktopIcon(i: number, label: string, kind: string, onOpen: () -> ()): Frame
	local b = UiKit.new("TextButton", {
		Name = "Icon_" .. label,
		Size = UDim2.fromOffset(ICON_W, ICON_H),
		Position = UDim2.fromOffset(6, 6 + (i - 1) * (ICON_H + 4)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		SelectionImageObject = UiKit.selectionRing(),
		ZIndex = 2,
		Parent = canvas,
	}) :: TextButton
	local g = glyph(b, kind, (ICON_W - 32) // 2, 2, 2, 3)
	local name = UiKit.text("body", {
		Name = "Label",
		Text = label,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		TextColor3 = C.white,
		TextStrokeColor3 = C.charcoal,
		TextStrokeTransparency = 0.6,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		BackgroundColor3 = C.select,
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = b,
	})
	UiKit.padding(name, SPACE.xs, 0)
	-- Windows-style focus: the label gets the charcoal-blue selection box
	local function lit(on: boolean)
		name.BackgroundTransparency = if on then 0 else 1
		name.TextStrokeTransparency = if on then 1 else 0.6
	end
	b.MouseEnter:Connect(function()
		lit(true)
	end)
	b.MouseLeave:Connect(function()
		lit(GuiService.SelectedObject == b)
	end)
	b.SelectionGained:Connect(function()
		lit(true)
	end)
	b.SelectionLost:Connect(function()
		lit(false)
	end)
	b.Activated:Connect(function()
		UiKit.click()
		onOpen()
	end)
	return g
end

-- flat start-menu row: icon + label, charcoal-blue highlight with white text
local function menuItem(text: string, kind: string, y: number, onPick: () -> ()): TextButton
	local b = UiKit.new("TextButton", {
		Name = "Item",
		Size = UDim2.new(1, -34, 0, 32),
		Position = UDim2.fromOffset(30, y),
		BackgroundColor3 = C.select,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		SelectionImageObject = UiKit.selectionRing(),
		ZIndex = 602,
		Parent = startMenu,
	}) :: TextButton
	glyph(b, kind, 6, 8, 1, 603)
	local l = UiKit.text("body", { Text = text, Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(30, 0), TextWrapped = false, ZIndex = 603, Parent = b })
	local function lit(on: boolean)
		b.BackgroundTransparency = if on then 0 else 1
		l.TextColor3 = if on then C.white else C.text
	end
	b.MouseEnter:Connect(function()
		lit(true)
	end)
	b.MouseLeave:Connect(function()
		lit(GuiService.SelectedObject == b)
	end)
	b.SelectionGained:Connect(function()
		lit(true)
	end)
	b.SelectionLost:Connect(function()
		lit(false)
	end)
	b.Activated:Connect(function()
		UiKit.click()
		onPick()
	end)
	return b
end

-- taskbar button with a small icon and a left-aligned label
local function taskButton(text: string, kind: string, onClick: () -> ()): TextButton
	local b = UiKit.button({ name = "Task_" .. text, text = "", size = UDim2.fromOffset(TASK_W, 26), parent = taskbar, zindex = 502, onClick = onClick })
	glyph(b, kind, 6, 5, 1, 503)
	UiKit.text("button", { Text = text, Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(26, 0), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 503, Parent = b })
	table.insert(taskButtons, b)
	return b
end

local function unreadMark(parent: Instance, x: number, y: number, z: number)
	table.insert(unreadMarks, UiKit.frame({ Name = "Unread", Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(x, y), BackgroundColor3 = C.amber, BorderSizePixel = 1, BorderColor3 = C.edge, Visible = false, ZIndex = z, Parent = parent }))
end

local function build()
	gui = UiKit.new("ScreenGui", {
		Name = "Desktop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- the monitor: square cream plastic, recessed screen, chin with controls
	bezel = UiKit.frame({ Name = "Bezel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.98, 0.98), BackgroundColor3 = D.plastic, Parent = gui })
	screen = UiKit.frame({ Name = "Screen", BackgroundColor3 = Color3.new(0, 0, 0), BorderColor3 = D.plasticDark, ClipsDescendants = true, Parent = bezel })
	canvas = UiKit.frame({ Name = "Canvas", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H), BackgroundColor3 = C.desktop, Parent = screen })
	canvasScale = UiKit.new("UIScale", { Parent = canvas })
	UiKit.new("UIGradient", { Color = ColorSequence.new(D.wallTop, D.wallBottom), Rotation = 90, Parent = canvas })

	-- wallpaper mark, low contrast
	wallMark = UiKit.frame({ Name = "Wallpaper", Size = UDim2.fromOffset(320, 80), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -SPACE.xl, 1, -(TB + SPACE.xl)), BackgroundTransparency = 1, Parent = canvas })
	UiKit.text("display", { Text = "MRR", TextSize = 48, Size = UDim2.new(1, 0, 0, 48), TextColor3 = D.wallMark, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, Parent = wallMark })
	UiKit.text("body", { Text = Dialogue.COMPANY, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 54), TextColor3 = D.wallMark, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, Parent = wallMark })

	-- desktop icons
	desktopIcon(1, "SecureErase", "erase", function()
		bringToFront(mainWin)
	end)
	local imGlyph = desktopIcon(2, "Messenger", "messenger", function()
		openSide("Messenger")
	end)
	unreadMark(imGlyph, 26, -2, 6)
	desktopIcon(3, "My Files", "folder", function()
		openSide("Files")
	end)
	desktopIcon(4, "Drive Info", "drive", function()
		openSide("DriveInfo")
	end)
	desktopIcon(5, "Procedures", "text", function()
		openSide("Procedures")
	end)

	windowsLayer = UiKit.frame({ Name = "Windows", Size = UDim2.new(1, 0, 1, -TB), BackgroundTransparency = 1, ZIndex = 10, Parent = canvas })

	-- main SecureErase window (always open). Body is 648 x 380:
	-- header 0-20 | progress 22-34 | instructions 38-76 | game 78-328 | feedback 332-352 | hint 354-380
	mainWin = UiKit.window(windowsLayer, "SecureErase 2.1", UDim2.fromOffset(MAIN_W, MAIN_H), UDim2.fromOffset(MAIN_X, SPACE.s), 20, nil)
	mainWin.frame.Name = "MainWindow"
	trackWindow(mainWin)
	local body = mainWin.body
	local z = 24
	local header = UiKit.text("heading", { Name = "Header", Text = "", Size = UDim2.new(1, -(STAGE_W + SPACE.xs), 0, 20), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = z, Parent = body })
	local stage = UiKit.text("title", {
		Name = "Stage",
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(STAGE_W, 20),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = z,
		Parent = body,
	})
	local _, fill = UiKit.progress(body, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 22), z)
	local instructions = UiKit.text("body", { Name = "Instructions", Text = "", Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, 38), TextYAlignment = Enum.TextYAlignment.Top, ZIndex = z, Parent = body })
	local gameArea = UiKit.frame({ Name = "Game", Size = UDim2.fromOffset(GAME_W, GAME_H), Position = UDim2.fromOffset((MAIN_W - 12 - GAME_W) // 2, 78), BackgroundTransparency = 1, ZIndex = z, Parent = body })
	local feedback = UiKit.text("body", { Name = "Feedback", Text = "", Font = UiKit.FONT_BOLD, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 332), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = z, Parent = body })
	local hintBox = UiKit.frame({ Name = "HintBox", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 354), BackgroundColor3 = D.tip, BorderSizePixel = 1, BorderColor3 = D.tipLine, BorderMode = Enum.BorderMode.Inset, Visible = false, ZIndex = z, Parent = body })
	-- hints are one line; scaled text keeps a rare long one inside the strip (13 px floor)
	local hint = UiKit.text("body", { Name = "Hint", Text = "", Size = UDim2.new(1, -2 * SPACE.s, 1, 0), Position = UDim2.fromOffset(SPACE.s, 0), TextScaled = true, ZIndex = z + 1, Parent = hintBox })
	-- power loss: the job area goes dark with a short system notice
	local overlay = UiKit.frame({ Name = "NoPower", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.charcoal, BackgroundTransparency = 0.06, ZIndex = 60, Visible = false, Parent = body })
	UiKit.text("title", { Text = "DEVICE NOT READY", TextSize = 24, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0.5, -84), TextColor3 = C.amber, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = 61, Parent = overlay })
	local overlayText = UiKit.text("body", {
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, -44),
		Size = UDim2.fromOffset(520, 60),
		TextColor3 = C.hudText,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 61,
		Parent = overlay,
	})
	UiKit.text("body", { Text = "Your progress is saved.", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.5, 28), TextColor3 = C.hudDim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 61, Parent = overlay })
	mainParts = {
		header = header,
		stage = stage,
		progressFill = fill,
		instructions = instructions,
		game = gameArea,
		feedback = feedback,
		hintBox = hintBox,
		hint = hint,
		overlay = overlay,
		overlayText = overlayText,
	}

	-- side windows, cascaded from the right edge
	local sideDefs = {
		{ "Messenger", "MRR Messenger - R. Kessler" },
		{ "Files", "My Files - C:\\RECOVERED" },
		{ "DriveInfo", "Drive Manager" },
		{ "Procedures", "Procedures.txt - Notepad" },
	}
	for i, def in sideDefs do
		local nm = def[1]
		local x = SIDE_W + SPACE.s + (#sideDefs - i) * 16
		local w = UiKit.window(windowsLayer, def[2], UDim2.fromOffset(SIDE_W, 380), UDim2.new(1, -x, 0, 6 + (i - 1) * 12), 30 + i * 10, function()
			closeSide(nm)
		end)
		w.frame.Visible = false
		w.frame.Name = "Side_" .. nm
		trackWindow(w)
		side[nm] = w
	end

	-- taskbar: cream face, Start, task buttons, sunken tray with the clock
	taskbar = UiKit.frame({ Name = "Taskbar", Size = UDim2.new(1, 0, 0, TB), Position = UDim2.new(0, 0, 1, -TB), BackgroundColor3 = C.face, ZIndex = 500, Parent = canvas })
	UiKit.frame({ Name = "Edge", Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = C.faceLight, ZIndex = 501, Parent = taskbar })
	startBtn = UiKit.button({
		name = "Start",
		text = "",
		size = UDim2.fromOffset(90, 26),
		position = UDim2.fromOffset(4, 4),
		parent = taskbar,
		zindex = 502,
		onClick = function()
			setStartMenu(not startMenu.Visible)
		end,
	})
	glyph(startBtn, "logo", 7, 5, 1, 503)
	UiKit.text("title", { Text = "START", Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(28, 0), TextWrapped = false, ZIndex = 503, Parent = startBtn })
	taskButton("SecureErase", "erase", function()
		bringToFront(mainWin)
	end)
	local imTask = taskButton("Messenger", "messenger", function()
		openSide("Messenger")
	end)
	unreadMark(imTask, TASK_W - 14, 4, 504)
	local tray = UiKit.frame({ Name = "Tray", Size = UDim2.fromOffset(TRAY_W, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4), BackgroundColor3 = D.well, ZIndex = 502, Parent = taskbar })
	UiKit.bevel(tray, true)
	local trayItems = UiKit.frame({ Name = "Items", Size = UDim2.new(1, -2 * SPACE.s, 1, 0), Position = UDim2.fromOffset(SPACE.s, 0), BackgroundTransparency = 1, ZIndex = 504, Parent = tray })
	UiKit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, SPACE.m),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = trayItems,
	})
	local function trayLabel(order: number): TextLabel
		return UiKit.text("title", { Text = "", Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, LayoutOrder = order, ZIndex = 505, Parent = trayItems })
	end
	taskbarTray = {
		erased = trayLabel(1),
		door = trayLabel(2),
		power = trayLabel(3),
		clock = trayLabel(5),
	}
	UiKit.frame({ Name = "Divider", Size = UDim2.fromOffset(2, 18), BackgroundColor3 = C.faceDark, LayoutOrder = 4, ZIndex = 505, Parent = trayItems })

	-- start menu, opening upward from the taskbar
	local items: { { any } } = {
		{ "SecureErase", "erase", function()
			setStartMenu(false)
			bringToFront(mainWin)
		end },
		{ "Messenger", "messenger", function()
			openSide("Messenger")
		end },
		{ "My Files", "folder", function()
			openSide("Files")
		end },
		{ "Drive Info", "drive", function()
			openSide("DriveInfo")
		end },
		{ "Procedures.txt", "text", function()
			openSide("Procedures")
		end },
		{ "Leave computer", "door", function()
			setStartMenu(false)
			Desktop.leave()
		end },
	}
	local menuH = 8 + #items * 32 + 9
	startMenu = UiKit.frame({ Name = "StartMenu", Size = UDim2.fromOffset(224, menuH), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 2, 1, -TB), BorderSizePixel = 1, BorderColor3 = C.edge, Visible = false, ZIndex = 600, Parent = canvas })
	UiKit.bevel(startMenu)
	local banner = UiKit.frame({ Name = "Banner", Size = UDim2.new(0, 24, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = C.title1, ZIndex = 601, Parent = startMenu })
	UiKit.new("UIGradient", { Color = ColorSequence.new(C.title2, C.title1), Rotation = 90, Parent = banner })
	local y = 4
	for i, it in items do
		if i == #items then
			UiKit.frame({ Name = "Separator", Size = UDim2.new(1, -40, 0, 2), Position = UDim2.fromOffset(34, y + 3), BackgroundColor3 = C.faceDark, ZIndex = 602, Parent = startMenu })
			y += 9
		end
		local b = menuItem(it[1], it[2], y, it[3])
		if i == 1 then
			firstMenuItem = b
		end
		y += 32
	end

	-- message notification above the tray; click opens the messenger
	toast = UiKit.new("TextButton", {
		Name = "Toast",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(320, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -SPACE.s, 1, -(TB + SPACE.s)),
		BackgroundColor3 = C.face,
		BorderSizePixel = 0,
		SelectionImageObject = UiKit.selectionRing(),
		Visible = false,
		ZIndex = 700,
		Parent = canvas,
	}) :: TextButton
	UiKit.stroke(toast, C.edge, 0, 1)
	UiKit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = toast })
	local toastBar = UiKit.frame({ Name = "Bar", Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = C.title1, LayoutOrder = 1, ZIndex = 701, Parent = toast })
	UiKit.new("UIGradient", { Color = ColorSequence.new(C.title1, C.title2), Parent = toastBar })
	glyph(toastBar, "messenger", 4, 3, 1, 702)
	UiKit.text("title", { Text = "NEW MESSAGE", Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(26, 0), TextColor3 = C.white, TextWrapped = false, ZIndex = 702, Parent = toastBar })
	local toastBody = UiKit.frame({ Name = "Body", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 701, Parent = toast })
	UiKit.padding(toastBody, SPACE.s)
	UiKit.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = toastBody })
	toastFrom = UiKit.text("body", { Text = "", Font = UiKit.FONT_BOLD, Size = UDim2.new(1, 0, 0, 20), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, ZIndex = 702, Parent = toastBody })
	toastText = UiKit.text("body", { Text = "", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, ZIndex = 702, Parent = toastBody })
	toast.Activated:Connect(function()
		toast.Visible = false
		openSide("Messenger")
	end)

	-- CRT: very faint scanlines and edge falloff, kept readable
	local scan = UiKit.frame({ Name = "Scanlines", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 900, Parent = screen })
	for i = 0, 59 do
		UiKit.frame({ Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, i / 60), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.95, ZIndex = 900, Parent = scan })
	end
	local vignette = UiKit.frame({ Name = "Vignette", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 901, Parent = screen })
	UiKit.new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(0.08, 1), NumberSequenceKeypoint.new(0.92, 1), NumberSequenceKeypoint.new(1, 0.72) }),
		Parent = vignette,
	})
	-- black frame that fades out when the session starts (screen powering on)
	powerOn = UiKit.frame({ Name = "PowerOn", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 950, Parent = screen })

	-- bezel chin (framed monitors only): model badge, power LED, leave button.
	-- Laid out in logical px and scaled like the desktop.
	chin = UiKit.frame({ Name = "Chin", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 5, Parent = bezel })
	chinScale = UiKit.new("UIScale", { Parent = chin })
	UiKit.text("title", { Text = "MRR-900", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(84, 20), TextColor3 = D.plasticDark, TextWrapped = false, ZIndex = 6, Parent = chin })
	chinLed = UiKit.frame({ Name = "PowerLed", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 92, 0.5, 0), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = D.led, BorderSizePixel = 1, BorderColor3 = D.plasticDark, ZIndex = 6, Parent = chin })
	leaveButton = UiKit.button({
		name = "LeaveComputer",
		text = "Leave computer",
		size = UDim2.fromOffset(LEAVE_TASKBAR_W, 26),
		parent = chin,
		color = C.burgundy,
		textColor = C.hudText,
		zindex = 10,
		onClick = function()
			Desktop.leave()
		end,
	})
	leaveButton.TextWrapped = false

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(adapt)
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(adapt)
	end
	adapt()
	refreshActive()
end

-- Open / close ---------------------------------------------------------------

local function onLeaveAction(_name: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if state == Enum.UserInputState.Begin then
		Desktop.leave()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

-- Roblox chat would sit on top of the desktop and steal clicks while seated.
local chatWasEnabled: boolean? = nil
local function setChatVisible(visible: boolean)
	pcall(function()
		local TextChatService = game:GetService("TextChatService")
		local win = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		if win then
			if not visible then
				chatWasEnabled = win.Enabled
				win.Enabled = false
			elseif chatWasEnabled ~= nil then
				win.Enabled = chatWasEnabled
				chatWasEnabled = nil
			end
		end
	end)
end

local function open()
	if isOpen then
		return
	end
	isOpen = true
	-- the desktop needs the pointer (WorkstationCamera applies Cursor state)
	Cursor.request("desktop", true)
	setChatVisible(false)
	gui.Enabled = true
	adapt()
	refreshActive()
	powerOn.BackgroundTransparency = 0
	TweenService:Create(powerOn, UiKit.FADE, { BackgroundTransparency = 1 }):Play()
	ContextActionService:BindActionAtPriority("NS_LeaveComputer", onLeaveAction, false, 3000, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)
	GuiService.SelectedObject = leaveButton
	task.defer(function()
		if not isOpen then
			return
		end
		adapt()
		local start = mainParts.game:FindFirstChildWhichIsA("GuiButton", true)
		if start then
			GuiService.SelectedObject = start
		end
	end)
end

local function close()
	if not isOpen then
		return
	end
	isOpen = false
	gui.Enabled = false
	Cursor.request("desktop", false)
	setChatVisible(true)
	startMenu.Visible = false
	ContextActionService:UnbindAction("NS_LeaveComputer")
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
	for name in sideOpen do
		closeSide(name)
	end
	if fragmentWin then
		fragmentWin.frame:Destroy()
		fragmentWin = nil
	end
	if phantomFrame then
		phantomFrame:Destroy()
		phantomFrame = nil
	end
end

function Desktop.isOpen(): boolean
	return isOpen
end

-- Standing up must return control instantly, even before the server answers.
function Desktop.forceClose()
	session = nil
	close()
end

function Desktop.init()
	build()
	State.SessionChanged:Connect(function(payload)
		if not payload.active then
			session = nil
			close()
			return
		end
		session = payload
		open()
		renderMain()
		renderPhantom()
	end)
	State.Changed:Connect(function(snap)
		renderTray(snap)
		if not isOpen then
			return
		end
		for name, isOpenNow in sideOpen do
			if isOpenNow and name ~= "Files" and name ~= "Procedures" then
				local key = sideKey(name, snap)
				if sideKeys[name] ~= key then
					sideKeys[name] = key
					renderSide(name)
				end
			end
		end
		-- the finale screens and the no-power overlay are snapshot-driven
		local finale = snap.phase == "FinalPurge" or snap.phase == "SignOff" or snap.phase == "ClockOut"
		if finale or lastViewKey == "finale" then
			local sig = finaleSignature(snap)
			if sig ~= finaleKey then
				finaleKey = sig
				renderMain()
			end
		elseif lastViewKey == "nodrive" or mainParts.overlay.Visible ~= (not snap.power.workstation) then
			renderMain()
		end
	end)
	State.Fx:Connect(function(name, data)
		if name == "BossMessage" and isOpen then
			showToast(data.from, data.text)
			if sideOpen.Messenger then
				renderSide("Messenger")
			else
				setUnread(true)
			end
		elseif name == "Fragment" and isOpen then
			showFragment(data.index)
		end
	end)
	-- the character can die / be reset while seated: close immediately
	player.CharacterRemoving:Connect(function()
		session = nil
		close()
	end)
	local _ = Config
end

return Desktop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="170">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Cosmetic reactions to server Fx cues: sounds, fixture flickers, monitor
-- wake-ups, the chase alert and soft colour stings. The server already
-- decided everything; this only makes it readable and felt. Stings ease in
-- and fade (no hard full-screen flashes) and flickers stay under 3 a second.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Fonts = require(ReplicatedStorage.Shared.Fonts)
local Layout = require(ReplicatedStorage.Shared.Layout)
local State = require(script.Parent.State)
local Atmosphere = require(script.Parent.Atmosphere)
local Hud = require(script.Parent.Hud)
local Sfx = require(script.Parent.Parent.Ui.Sfx)

local player = Players.LocalPlayer

local Effects = {}

local DOOR_POS = Vector3.new(Layout.REAR_DOOR.x, 3.5, (Layout.REAR_DOOR.minZ + Layout.REAR_DOOR.maxZ) / 2)

-- Sting tints are muted casts toward a mood, never saturated washes.
local STING = {
	cold = Color3.fromRGB(214, 222, 240), -- power cut, the missing crew
	uneasy = Color3.fromRGB(238, 222, 214), -- something approaches
	threat = Color3.fromRGB(242, 206, 200), -- it is inside
	danger = Color3.fromRGB(244, 196, 190), -- chase, downed, final purge
	peek = Color3.fromRGB(228, 224, 242),
	relief = Color3.fromRGB(248, 232, 210), -- sign-off complete
}

-- monitor phosphor: soft green on a dark tube, like the story screens
local PHOSPHOR = Color3.fromRGB(150, 220, 160)
local TUBE = Color3.fromRGB(12, 20, 16)
local TUBE_GLOW = Color3.fromRGB(130, 176, 146)

local function interactive(name: string): BasePart?
	local map = workspace:FindFirstChild("Map")
	local inter = map and map:FindFirstChild("Interactive")
	local p = inter and inter:FindFirstChild(name)
	return if p and p:IsA("BasePart") then p else nil
end

local function myPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root.Position else nil
end

-- An unattended monitor wakes with a short message, then fades back out.
local function monitorWake(desk: number, text: string, seconds: number)
	local screen = interactive("SourceScreen_" .. desk)
	if not screen then
		return
	end
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WakeText"
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 80
	sg.LightInfluence = 0
	sg.Brightness = 1.2
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BorderSizePixel = 0
	t.BackgroundColor3 = TUBE
	t.BackgroundTransparency = 1
	t.TextColor3 = PHOSPHOR
	t.TextTransparency = 1
	t.FontFace = Fonts.PIXEL
	t.TextScaled = true
	t.TextWrapped = true
	t.Text = text
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = t
	local cap = Instance.new("UITextSizeConstraint")
	cap.MaxTextSize = 30
	cap.Parent = t
	t.Parent = sg
	sg.Parent = screen
	local glow = Instance.new("PointLight")
	glow.Color = TUBE_GLOW
	glow.Range = 6
	glow.Brightness = 0
	glow.Shadows = false
	glow.Parent = screen
	local on = TweenInfo.new(0.35, Enum.EasingStyle.Sine)
	TweenService:Create(t, on, { TextTransparency = 0, BackgroundTransparency = 0 }):Play()
	TweenService:Create(glow, on, { Brightness = 0.5 }):Play()
	Sfx.play("chime", { pos = screen.Position, volume = 0.3, speed = 0.6 })
	task.delay(seconds, function()
		local off = TweenInfo.new(0.8, Enum.EasingStyle.Sine)
		TweenService:Create(t, off, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		TweenService:Create(glow, off, { Brightness = 0 }):Play()
		task.delay(0.85, function()
			sg:Destroy()
			glow:Destroy()
		end)
	end)
end

local handlers: { [string]: (data: any) -> () } = {
	PowerWarning = function(data)
		-- the office fixtures stutter until the breaker trips
		Atmosphere.flicker(data.seconds or 4, 0.4)
	end,
	LightFlicker = function(data)
		-- harmless: only the fixtures around you
		Atmosphere.flicker(data.seconds or 1.5, 0.3, myPosition())
	end,
	PowerOff = function()
		-- the blackout grade itself follows the LightsOn attribute (Atmosphere)
		Sfx.play("breaker", { volume = 0.8, speed = 0.7 })
		Atmosphere.sting(STING.cold, 2.5)
	end,
	BreakerReset = function()
		Sfx.play("breaker", { volume = 0.6 })
	end,
	DoorUnlatched = function()
		Sfx.play("chime", { pos = DOOR_POS, volume = 0.9, speed = 0.8 })
		Sfx.play("doorSlam", { pos = DOOR_POS, volume = 0.4, speed = 1.3 })
	end,
	DoorOpened = function()
		Sfx.play("doorSlam", { pos = DOOR_POS, volume = 0.3, speed = 1.4 })
	end,
	DoorLatched = function()
		Sfx.play("doorSlam", { pos = DOOR_POS, volume = 0.7 })
	end,
	DoorKnock = function()
		for i = 0, 2 do
			task.delay(i * 0.45, function()
				Sfx.play("knock", { pos = DOOR_POS, volume = 1, speed = 0.8 })
			end)
		end
	end,
	FrontKnock = function()
		local p = Vector3.new(13, 3.5, Layout.FRONT_DOOR.z + 1)
		for i = 0, 1 do
			task.delay(i * 0.5, function()
				Sfx.play("knock", { pos = p, volume = 0.8, speed = 0.9 })
			end)
		end
	end,
	FigureApproach = function()
		Atmosphere.sting(STING.uneasy, 3)
		Sfx.play("footsteps", { pos = Layout.THREAT_ROUTE[2], volume = 0.6, speed = 0.7, duration = 6 })
	end,
	FigureInside = function()
		Atmosphere.sting(STING.threat, 4)
		Atmosphere.flicker(1.2, 0.3)
	end,
	FigurePeek = function()
		Atmosphere.sting(STING.peek, 2.5)
	end,
	CrewSeen = function()
		Atmosphere.sting(STING.cold, 4)
		Atmosphere.flicker(0.8, 0.2)
	end,
	ChaseStart = function(data)
		if data.target == player.UserId then
			Hud.toast("RUN! Back inside through the rear door!", "bad")
		end
		Atmosphere.sting(STING.danger, 5)
	end,
	MonitorWake = function(data)
		monitorWake(data.desk, data.text, data.seconds or 6)
	end,
	PrinterWake = function()
		local led = interactive("PrinterLed")
		Sfx.play("phone", { pos = Layout.PRINTER, volume = 0.4, speed = 0.5 })
		if led then
			task.spawn(function()
				-- under 3 blinks a second
				for _ = 1, 8 do
					led.LocalTransparencyModifier = 0.7
					task.wait(0.17)
					led.LocalTransparencyModifier = 0
					task.wait(0.17)
				end
			end)
		end
	end,
	ChairShift = function(data)
		Sfx.play("doorSlam", { pos = data.pos, volume = 0.25, speed = 1.8 })
	end,
	FootstepsStop = function(data)
		Sfx.play("footsteps", { pos = data.pos, volume = 0.7, speed = 0.8, duration = 2.6 })
	end,
	PhoneRing = function(data)
		for i = 0, 1 do
			task.delay(i * 1.2, function()
				Sfx.play("phone", { pos = data.pos, volume = 0.6, speed = 1.0 })
			end)
		end
	end,
	DesktopSound = function(data)
		if data.kind == "bad" then
			Sfx.play("error", { volume = 0.4, speed = 0.55 })
		elseif data.kind == "stage" or data.kind == "complete" then
			Sfx.play("chime", { volume = 0.5, speed = 1.2 })
		end
	end,
	DriveDocked = function()
		Sfx.play("click", { pos = Layout.WORKSTATION.dock, volume = 0.6, speed = 0.8 })
	end,
	DriveErased = function(data)
		Sfx.play("chime", { pos = Layout.WORKSTATION.dock, volume = 0.6, speed = 0.9 })
		Hud.toast(string.format("%s securely erased (%d/6).", data.id, data.count), "good")
	end,
	PcShutdown = function()
		Sfx.play("click", { volume = 0.3, speed = 0.6 })
	end,
	Downed = function()
		Atmosphere.sting(STING.danger, 2)
	end,
	Revived = function(data)
		Hud.toast(data.name .. " is back on their feet" .. (if data.by then " (thanks to " .. data.by .. ")" else "") .. ".", "good")
	end,
	FinalPurge = function()
		Atmosphere.sting(STING.danger, 6)
		Atmosphere.flicker(2.5, 0.35)
		Hud.toast("FINAL PURGE queued. Your own records are on the list. Get to the workstation!", "bad")
	end,
	PurgeExecuted = function()
		Atmosphere.flicker(2, 0.6)
	end,
	SignOffStart = function()
		Hud.toast("Emergency sign-off running. Keep the power on and confirm checkpoints.", "info")
	end,
	SignOffConfirm = function()
		Sfx.play("chime", { pos = Layout.WORKSTATION.monitor, volume = 0.8, speed = 0.7 })
	end,
	ClockOutStart = function()
		Atmosphere.sting(STING.relief, 6)
		Hud.toast("Sign-off complete. CLOCK OUT at the lobby time clock and get out!", "good")
	end,
	ClockedOut = function(data)
		Hud.toast(data.name .. " clocked out.", "info")
	end,
	FrontDoorOpen = function()
		Hud.toast("The front door is open. Go!", "good")
	end,
	TrashThrown = function()
		Sfx.play("doorSlam", { pos = Layout.DUMPSTER, volume = 0.6, speed = 0.7 })
	end,
}

-- hide the revive prompt that belongs to our own character
local function hideOwnPrompts()
	game:GetService("ProximityPromptService").PromptShown:Connect(function(prompt)
		if prompt:GetAttribute("OwnerUserId") == player.UserId then
			prompt.Enabled = false
		end
	end)
end

function Effects.init()
	State.Fx:Connect(function(name, data)
		local h = handlers[name]
		if h then
			local ok, err = pcall(h :: any, data)
			if not ok then
				warn("[Effects]", name, err)
			end
		end
	end)
	hideOwnPrompts()
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="171">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- On-screen HUD while walking: objective, live threats, crew status, toasts
-- and pager lines, carry hint, controls line and the centre dot, plus the
-- downed / restore / ending overlays and the loading card.
-- Square dark plates and the type roles from docs/ART_DIRECTION.md. Text keeps
-- fixed pixel sizes (never below UiKit.MIN_TEXT) inside scale-width columns;
-- one UIScale per column grows the HUD on tall screens (phones stay at 1).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Types = require(ReplicatedStorage.Shared.Types)
local State = require(script.Parent.State)
local Desktop = require(script.Parent.Desktop)
local UiKit = require(script.Parent.Parent.Ui.UiKit)
local Cursor = require(script.Parent.Parent.Ui.Cursor)

local player = Players.LocalPlayer
local C = UiKit.C
local SPACE = UiKit.SPACE

local Hud = {}

-- HUD scale = viewport height / REF_HEIGHT, clamped to [1, SCALE_MAX].
-- Set SCALE_MAX to 1 to keep every screen at the nominal pixel sizes.
local REF_HEIGHT = 1080
local SCALE_MAX = 1.5
local EDGE = SPACE.m -- margin from the screen edges
-- The interaction prompt card (PromptUi) sits at 60% of the screen height and
-- is up to ~84 px tall; the bottom column drops its oldest toasts to stay clear.
local PROMPT_Y = 0.6
local PROMPT_CLEAR = 92

-- text tints that read on the dark plates
local ALERT = Color3.fromRGB(236, 116, 102)
local OK = Color3.fromRGB(150, 204, 160)
local ALERT_PLATE = Color3.fromRGB(46, 20, 22)
local ALERT_FLASH = Color3.fromRGB(128, 34, 30)
local CARD_TEXT = Color3.fromRGB(226, 218, 198)

type ThreatRow = { frame: Frame, label: TextLabel, urgent: boolean, tweens: { Tween } }
type TeamRow = { frame: Frame, name: TextLabel, status: TextLabel }
type HintKey = { cap: Frame, letter: TextLabel, kbm: string, pad: string }

export type ToastOpts = {
	tag: string?, -- short pixel label above the text (PAGER, CHECKPOINT ...)
	speaker: string?, -- who is talking, next to the tag
	dialogue: boolean?, -- boss lines and other speech use the dialogue role
	seconds: number?,
}

local gui: ScreenGui
local top: ScreenGui
local leftCol: Frame
local rightCol: Frame
local bottomCol: Frame
local scales: { UIScale } = {}

local objectivePanel: Frame
local objectiveText: TextLabel
local clockText: TextLabel
local erasedText: TextLabel
local crewText: TextLabel
local progressFill: Frame

local threatList: Frame
local threatRows: { [string]: ThreatRow } = {}
local teamPanel: Frame
local teamRows: { [Player]: TeamRow } = {}

local toastStack: Frame
local toasts: { Frame } = {}
local toastSeq = 0

local carryPlate: Frame
local carryItem: TextLabel
local carryHow: TextLabel

local hints: Frame
local hintDrive: Frame
local hintKeys: { HintKey } = {}

local dot: Frame
local downedOverlay: Frame
local downedTitle: TextLabel
local downedText: TextLabel
local fade: Frame
local fadeTitle: TextLabel
local fadeText: TextLabel
local ending: Frame
local endingCol: Frame
local endingStats: TextLabel
local loading: Frame

local function scaled(f: GuiObject)
	table.insert(scales, UiKit.new("UIScale", { Parent = f }) :: UIScale)
end

local function rescale()
	local cam = workspace.CurrentCamera
	local s = if cam then math.clamp(cam.ViewportSize.Y / REF_HEIGHT, 1, SCALE_MAX) else 1
	for _, u in scales do
		u.Scale = s
	end
end

local function list(parent: Instance, gap: number, props: UiKit.Props?)
	local p: UiKit.Props = if props then table.clone(props) else {}
	p.Padding = UDim.new(0, gap)
	p.SortOrder = Enum.SortOrder.LayoutOrder
	p.Parent = parent
	UiKit.new("UIListLayout", p)
end

-- Invisible column that stacks plates and grows to fit them.
local function column(name: string, anchor: Vector2, pos: UDim2, width: number, minW: number, maxW: number, parent: Instance): Frame
	local f = UiKit.frame({ Name = name, AnchorPoint = anchor, Position = pos, Size = UDim2.fromScale(width, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = parent })
	UiKit.new("UISizeConstraint", { MinSize = Vector2.new(minW, 0), MaxSize = Vector2.new(maxW, math.huge), Parent = f })
	scaled(f)
	return f
end

-- Transparent full-width strip inside a plate (header / footer lines).
local function strip(parent: Instance, height: number, order: number): Frame
	return UiKit.frame({ Name = "Strip", Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
end

local function setStroke(plate: GuiObject, color: Color3, transparency: number)
	local s = plate:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = color
		s.Transparency = transparency
	end
end

-- Fades every plate, outline and label under `root` (and root) to invisible.
local function fadeOut(root: GuiObject, seconds: number)
	local info = TweenInfo.new(seconds)
	local all = root:GetDescendants()
	table.insert(all, root)
	for _, d in all do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		elseif d:IsA("GuiObject") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
end

local function esc(s: string): string
	return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function sentence(s: string): string
	return string.upper(string.sub(s, 1, 1)) .. string.sub(s, 2)
end

local function viewportHeight(): number
	local cam = workspace.CurrentCamera
	return if cam then cam.ViewportSize.Y else 720
end

---------------------------------------------------------------------------
-- Toasts: system notices, pager lines, checkpoints

local function dropToast(f: Frame)
	local i = table.find(toasts, f)
	if i then
		table.remove(toasts, i)
	end
	f:Destroy()
	toastStack.Visible = #toasts > 0
end

-- One frame at a time so each check reads the re-laid-out column. The
-- newest toast always stays (on phones it may tuck under the prompt card,
-- which draws on top).
local trimming = false
local function trimToasts()
	if trimming then
		return
	end
	trimming = true
	task.spawn(function()
		task.wait()
		while #toasts > 1 and toastStack.Parent == bottomCol and bottomCol.AbsoluteSize.Y > viewportHeight() * (1 - PROMPT_Y) - EDGE - PROMPT_CLEAR do
			dropToast(toasts[1])
			task.wait()
		end
		trimming = false
	end)
end

function Hud.toast(text: string, kind: string?, opts: ToastOpts?)
	local o: ToastOpts = opts or {}
	local accent = if kind == "bad" then C.bad elseif kind == "good" then C.good else C.slate
	local tagColor = if kind == "bad" then ALERT elseif kind == "good" then OK else C.amber
	local tag = o.tag or (if kind == "bad" then "WARNING" else nil)
	toastSeq += 1

	local f = UiKit.frame({ Name = "Toast", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.hud, BackgroundTransparency = 0.18, LayoutOrder = toastSeq, Parent = toastStack })
	UiKit.stroke(f)
	UiKit.frame({ Name = "Accent", Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = accent, Parent = f })
	local body = UiKit.frame({ Name = "Body", Position = UDim2.fromOffset(3, 0), Size = UDim2.new(1, -3, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = f })
	UiKit.padding(body, SPACE.m, SPACE.s)
	list(body, 2)
	if tag or o.speaker then
		local head = strip(body, 16, 1)
		list(head, SPACE.s, { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center })
		if tag then
			UiKit.text("title", { Text = tag, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextColor3 = tagColor, LayoutOrder = 1, Parent = head })
		end
		if o.speaker then
			UiKit.text("caption", { Text = o.speaker, Font = UiKit.FONT_BOLD, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextColor3 = C.hudDim, LayoutOrder = 2, Parent = head })
		end
	end
	UiKit.text(if o.dialogue then "dialogue" else "body", {
		Name = "Text",
		Text = text,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextColor3 = C.hudText,
		LayoutOrder = 2,
		Parent = body,
	})

	table.insert(toasts, f)
	toastStack.Visible = true
	local keep = if viewportHeight() < 600 then 2 else 3
	while #toasts > keep do
		dropToast(toasts[1])
	end
	trimToasts()
	-- long lines stay up long enough to read
	local seconds = o.seconds or math.clamp(2.5 + #text / 15, 5, 9)
	task.delay(seconds, function()
		if f.Parent then
			fadeOut(f, 0.35)
			task.wait(0.4)
			dropToast(f)
		end
	end)
end

---------------------------------------------------------------------------
-- Threats: counterplay cues, urgent first. Urgent plates carry a "!" badge,
-- a red outline that pulses and sort to the top; warnings carry an "i" badge,
-- so the two never differ by colour alone.

local function dropThreat(id: string)
	local r = threatRows[id]
	if r then
		for _, tw in r.tweens do
			tw:Cancel()
		end
		r.frame:Destroy()
		threatRows[id] = nil
	end
end

local function threatRow(t: Types.ThreatInfo): ThreatRow
	local urgent = t.urgent
	local plate = UiKit.frame({
		Name = "Threat",
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = if urgent then ALERT_FLASH else C.hud,
		BackgroundTransparency = if urgent then 0.1 else 0.22,
		Parent = threatList,
	})
	local stroke = UiKit.stroke(plate, if urgent then C.bad else C.hudLine, if urgent then 0 else 0.45)
	local badge = UiKit.frame({ Name = "Badge", Size = UDim2.new(0, 22, 1, 0), BackgroundColor3 = if urgent then C.bad else C.warn, Parent = plate })
	UiKit.text("key", {
		Text = if urgent then "!" else "i",
		Size = UDim2.fromScale(1, 1),
		TextColor3 = if urgent then C.white else C.hud,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = badge,
	})
	local label = UiKit.text("body", {
		Name = "Text",
		Text = "",
		RichText = true,
		Position = UDim2.fromOffset(22, 0),
		Size = UDim2.new(1, -22, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextColor3 = C.hudText,
		Parent = plate,
	})
	UiKit.padding(label, SPACE.s, SPACE.xs + 1)
	local tweens: { Tween } = {}
	if urgent then
		-- arrival flash, then a slow pulse on the outline and badge
		TweenService:Create(plate, TweenInfo.new(0.9), { BackgroundColor3 = ALERT_PLATE }):Play()
		local pulse = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		tweens = { TweenService:Create(stroke, pulse, { Transparency = 0.7 }), TweenService:Create(badge, pulse, { BackgroundTransparency = 0.35 }) }
		for _, tw in tweens do
			tw:Play()
		end
	end
	return { frame = plate, label = label, urgent = urgent, tweens = tweens }
end

local function threatText(t: Types.ThreatInfo): string
	local s = "<b>" .. esc(t.label) .. "</b>"
	if t.where then
		s ..= '  <font color="#' .. C.hudDim:ToHex() .. '">' .. esc(t.where) .. "</font>"
	end
	return s
end

local function renderThreats(snap: Types.Snapshot)
	local seen: { [string]: boolean } = {}
	for i, t in snap.threats do
		seen[t.id] = true
		local r: ThreatRow? = threatRows[t.id]
		if r and r.urgent ~= t.urgent then
			dropThreat(t.id)
			r = nil
		end
		local row: ThreatRow = r or threatRow(t)
		threatRows[t.id] = row
		row.label.Text = threatText(t)
		row.frame.LayoutOrder = if t.urgent then i else 100 + i
	end
	for id in threatRows do
		if not seen[id] then
			dropThreat(id)
		end
	end
	threatList.Visible = next(threatRows) ~= nil
end

---------------------------------------------------------------------------
-- Crew status (hidden when alone on shift)

local function carryShort(carrying: string): string
	return if carrying == "TrashBag" then "TRASH BAG" elseif carrying == "Printout" then "PRINTOUT" else string.upper(carrying)
end

local function crewStatus(p: Player, snap: Types.Snapshot): (string, Color3)
	local carrying = p:GetAttribute("Carrying")
	if p:GetAttribute("Downed") == true then
		return "CAUGHT", ALERT
	elseif p:GetAttribute("Escaped") == true then
		return "OUTSIDE", OK
	elseif p:GetAttribute("ClockedOut") == true then
		return "CLOCKED OUT", C.hudDim
	elseif snap.operator == p.DisplayName then
		return "AT PC", C.amber
	elseif typeof(carrying) == "string" then
		return carryShort(carrying), C.hudText
	end
	return "", C.hudDim
end

local function teamRow(p: Player): TeamRow
	local f = UiKit.frame({ Name = "Row", Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Parent = teamPanel })
	list(f, SPACE.s, { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center })
	local name = UiKit.text("caption", {
		Text = p.DisplayName,
		Font = UiKit.FONT_BOLD,
		Size = UDim2.fromScale(0, 1),
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = C.hudText,
		LayoutOrder = 1,
		Parent = f,
	})
	UiKit.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = name })
	local status = UiKit.text("title", {
		Text = "",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Right,
		LayoutOrder = 2,
		Parent = f,
	})
	return { frame = f, name = name, status = status }
end

local function renderTeam(snap: Types.Snapshot)
	local players = Players:GetPlayers()
	local present: { [Player]: boolean } = {}
	for i, p in players do
		present[p] = true
		local row = teamRows[p] or teamRow(p)
		teamRows[p] = row
		local text, color = crewStatus(p, snap)
		row.frame.LayoutOrder = i
		row.name.Text = p.DisplayName
		row.name.TextColor3 = if text == "CAUGHT" then ALERT else C.hudText
		row.status.Text = text
		row.status.TextColor3 = color
	end
	for p, row in teamRows do
		if not present[p] then
			row.frame:Destroy()
			teamRows[p] = nil
		end
	end
	teamPanel.Visible = #players > 1
end

---------------------------------------------------------------------------
-- Controls line (keyboard or gamepad glyphs; hidden on touch)

local function inputMode(): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "touch"
	elseif string.find(last.Name, "Gamepad", 1, true) then
		return "pad"
	end
	return "kbm"
end

local function refreshHints()
	local mode = inputMode()
	hints.Visible = mode ~= "touch" and not Desktop.isOpen()
	for _, k in hintKeys do
		local key = if mode == "pad" then k.pad else k.kbm
		k.letter.Text = key
		k.cap.Size = UDim2.fromOffset(20 + (#key - 1) * 10, 20)
	end
end

local function hint(order: number, kbm: string, pad: string, text: string): Frame
	local g = UiKit.frame({ Name = "Hint", Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = order, Parent = hints })
	list(g, SPACE.xs + 2, { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center })
	local cap = UiKit.keycap(g, kbm, 20)
	cap.LayoutOrder = 1
	local letter = cap:FindFirstChild("Letter")
	if letter and letter:IsA("TextLabel") then
		table.insert(hintKeys, { cap = cap, letter = letter, kbm = kbm, pad = pad })
	end
	UiKit.text("caption", { Text = text, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextColor3 = C.hudDim, LayoutOrder = 2, Parent = g })
	return g
end

---------------------------------------------------------------------------
-- Snapshot rendering

local function carryInfo(carrying: string, snap: Types.Snapshot): (string, string)
	if carrying == "TrashBag" then
		return "Trash bag", "Throw it away at the alley dumpster, out through the rear door."
	elseif carrying == "Printout" then
		return "Printout", "Leave it in the OUT TRAY on the corner desk."
	end
	for _, d in snap.drives do
		if d.id == carrying then
			return d.id .. "  " .. d.name, "Dock it at the corner workstation, or stage it on the drive rack."
		end
	end
	return carrying, "Dock it at the corner workstation, or stage it on the drive rack."
end

local function render(snap: Types.Snapshot)
	local open = Desktop.isOpen()
	objectiveText.Text = snap.objective
	clockText.Text = State.nightClock(snap.nightMinutes)
	erasedText.Text = string.format("ERASED %d/%d", snap.erased, snap.total)
	crewText.Text = if snap.soloMode then "SOLO" else "CREW " .. #Players:GetPlayers()
	progressFill.Size = UDim2.fromScale(if snap.total > 0 then math.clamp(snap.erased / snap.total, 0, 1) else 0, 1)
	renderThreats(snap)
	renderTeam(snap)
	local carrying = player:GetAttribute("Carrying")
	local wasCarrying = carryPlate.Visible
	if typeof(carrying) == "string" then
		local item, how = carryInfo(carrying, snap)
		carryItem.Text = item
		carryHow.Text = how
		carryPlate.Visible = not open
	else
		carryPlate.Visible = false
	end
	if carryPlate.Visible and not wasCarrying then
		trimToasts()
	end
	hintDrive.Visible = typeof(carrying) == "string" and carrying ~= "TrashBag" and carrying ~= "Printout"
	objectivePanel.Visible = not open and snap.objective ~= ""
end

-- Centre dot: first-person aim point while walking only.
local function updateDot()
	dot.Visible = not Cursor.isFree() and not Desktop.isOpen() and player:GetAttribute("Downed") ~= true and not ending.Visible
end

-- Seated at the desktop: objective and walking hints hide; threats and
-- toasts move under the crew panel, top right, clear of the desktop icons.
local function applyMode()
	local open = Desktop.isOpen()
	objectivePanel.Visible = not open and (State.snapshot == nil or State.snapshot.objective ~= "")
	threatList.Parent = if open then rightCol else leftCol
	toastStack.Parent = if open then rightCol else bottomCol
	toastStack.LayoutOrder = if open then 3 else 1
	carryPlate.Visible = not open and typeof(player:GetAttribute("Carrying")) == "string"
	refreshHints()
	updateDot()
end

---------------------------------------------------------------------------
-- Full-screen cards

local function showFade(title: string, text: string, hold: number)
	fade.Visible = true
	fade.BackgroundTransparency = 1
	fadeTitle.Text = title
	fadeText.Text = text
	fadeTitle.TextTransparency = 1
	fadeText.TextTransparency = 1
	local info = TweenInfo.new(0.8)
	TweenService:Create(fade, info, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(fadeTitle, info, { TextTransparency = 0 }):Play()
	TweenService:Create(fadeText, info, { TextTransparency = 0 }):Play()
	task.delay(hold, function()
		local out = TweenInfo.new(1.2)
		TweenService:Create(fade, out, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(fadeTitle, out, { TextTransparency = 1 }):Play()
		TweenService:Create(fadeText, out, { TextTransparency = 1 }):Play()
		task.wait(1.3)
		fade.Visible = false
	end)
end

local function showEnding(data: any)
	ending.Visible = true
	updateDot()
	UiKit.clear(endingCol)
	ending.BackgroundTransparency = 1
	TweenService:Create(ending, TweenInfo.new(2), { BackgroundTransparency = 0 }):Play()
	local title = tostring(data.title)
	-- Silkscreen only for a short title; anything longer reads better in Ubuntu
	if #title <= 16 then
		UiKit.text("display", { Text = title, TextSize = 48, Size = UDim2.new(1, 0, 0, 56), TextColor3 = CARD_TEXT, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 0, Parent = endingCol })
	else
		UiKit.text("heading", { Text = title, TextSize = 32, Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = CARD_TEXT, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 0, Parent = endingCol })
	end
	UiKit.frame({ Name = "Rule", Size = UDim2.fromOffset(160, 1), BackgroundColor3 = C.hudLine, BackgroundTransparency = 0.5, LayoutOrder = 1, Parent = endingCol })
	for i, line in data.lines :: { string } do
		local l = UiKit.text("dialogue", {
			Text = line,
			TextSize = 20,
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextColor3 = C.hudText,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			LayoutOrder = 1 + i,
			Parent = endingCol,
		})
		task.delay(1.5 + i * 2.2, function()
			TweenService:Create(l, TweenInfo.new(1.5), { TextTransparency = 0 }):Play()
		end)
	end
	endingStats.Text = string.format("%s  -  shift length %d:%02d  -  thanks for playing", Config.GAME_TITLE, data.minutes or 0, data.seconds or 0)
	endingStats.TextTransparency = 0
	task.delay(Config.PHASE.endingSeconds - 2, function()
		fadeOut(ending, 1.5)
		task.wait(1.6)
		ending.Visible = false
		updateDot()
	end)
end

---------------------------------------------------------------------------

local function build()
	local playerGui = player:WaitForChild("PlayerGui")
	gui = UiKit.new("ScreenGui", { Name = "Hud", ResetOnSpawn = false, DisplayOrder = 6, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })

	-- top left: objective, then live threats
	leftCol = column("Left", Vector2.zero, UDim2.fromOffset(EDGE, EDGE), 0.3, 260, 400, gui)
	list(leftCol, SPACE.s)
	objectivePanel = UiKit.panel({ Name = "Objective", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = leftCol })
	list(objectivePanel, SPACE.xs)
	local head = strip(objectivePanel, 16, 1)
	UiKit.text("title", { Text = "OBJECTIVE", Size = UDim2.fromScale(1, 1), TextWrapped = false, TextColor3 = C.amber, Parent = head })
	clockText = UiKit.text("title", { Text = "", Size = UDim2.fromScale(1, 1), TextWrapped = false, TextColor3 = C.hudDim, TextXAlignment = Enum.TextXAlignment.Right, Parent = head })
	objectiveText = UiKit.text("heading", { Text = "", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.hudText, LayoutOrder = 2, Parent = objectivePanel })
	local bar = UiKit.frame({ Name = "Erased", Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = C.charcoal, LayoutOrder = 3, Parent = objectivePanel })
	progressFill = UiKit.frame({ Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.amber, Parent = bar })
	local foot = strip(objectivePanel, 16, 4)
	erasedText = UiKit.text("title", { Text = "", Size = UDim2.fromScale(1, 1), TextWrapped = false, TextColor3 = C.hudDim, Parent = foot })
	crewText = UiKit.text("title", { Text = "", Size = UDim2.fromScale(1, 1), TextWrapped = false, TextColor3 = C.hudDim, TextXAlignment = Enum.TextXAlignment.Right, Parent = foot })

	threatList = UiKit.frame({ Name = "Threats", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, Visible = false, Parent = leftCol })
	list(threatList, SPACE.xs)

	-- top right: crew
	rightCol = column("Right", Vector2.new(1, 0), UDim2.new(1, -EDGE, 0, EDGE), 0.22, 220, 300, gui)
	list(rightCol, SPACE.s)
	teamPanel = UiKit.panel({ Name = "Crew", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Visible = false, Parent = rightCol })
	list(teamPanel, 2)
	UiKit.text("title", { Text = "CREW", Size = UDim2.new(1, 0, 0, 18), TextWrapped = false, TextColor3 = C.amber, LayoutOrder = 0, Parent = teamPanel })

	-- bottom centre: toasts above the carry hint above the controls line;
	-- the interaction prompt card sits between this and the screen centre
	bottomCol = column("Bottom", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -EDGE), 0.42, 300, 560, gui)
	list(bottomCol, SPACE.s, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
	toastStack = UiKit.frame({ Name = "Toasts", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Visible = false, Parent = bottomCol })
	list(toastStack, SPACE.xs)

	carryPlate = UiKit.panel({ Name = "Carry", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Visible = false, Parent = bottomCol })
	setStroke(carryPlate, C.amber, 0.35)
	list(carryPlate, 2)
	local carryHead = strip(carryPlate, 18, 1)
	list(carryHead, SPACE.s, { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center })
	UiKit.text("title", { Text = "CARRYING", Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextColor3 = C.amber, LayoutOrder = 1, Parent = carryHead })
	carryItem = UiKit.text("body", { Text = "", Font = UiKit.FONT_BOLD, Size = UDim2.fromScale(0, 1), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = C.hudText, LayoutOrder = 2, Parent = carryHead })
	UiKit.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = carryItem })
	carryHow = UiKit.text("caption", { Text = "", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.hudDim, LayoutOrder = 2, Parent = carryPlate })

	hints = UiKit.frame({ Name = "Controls", Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = C.hud, BackgroundTransparency = 0.35, LayoutOrder = 3, Parent = bottomCol })
	UiKit.stroke(hints, C.hudLine, 0.7)
	UiKit.padding(hints, SPACE.s, SPACE.xs)
	list(hints, SPACE.l, { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center })
	hint(1, "E", "X", "Interact")
	hintDrive = hint(2, "F", "R1", "Dock / stage drive")
	hintDrive.Visible = false
	hint(3, "G", "Y", "Ping")

	-- full-screen layers sit above the desktop and the prompt card
	top = UiKit.new("ScreenGui", { Name = "HudTop", ResetOnSpawn = false, DisplayOrder = 20, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui })

	dot = UiKit.frame({ Name = "Dot", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = C.hudText, BackgroundTransparency = 0.4, Visible = false, ZIndex = 1, Parent = top })
	UiKit.stroke(dot, C.hud, 0.75)

	downedOverlay = UiKit.frame({ Name = "Downed", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(34, 8, 10), BackgroundTransparency = 0.45, Visible = false, ZIndex = 2, Parent = top })
	local downCard = UiKit.frame({ Name = "Card", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(0.5, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.hud, BackgroundTransparency = 0.12, Parent = downedOverlay })
	UiKit.new("UISizeConstraint", { MinSize = Vector2.new(300, 0), MaxSize = Vector2.new(520, math.huge), Parent = downCard })
	UiKit.stroke(downCard, C.bad, 0.1)
	UiKit.padding(downCard, SPACE.l, SPACE.m)
	list(downCard, SPACE.s, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
	scaled(downCard)
	downedTitle = UiKit.text("display", { Text = "CAUGHT", Size = UDim2.new(1, 0, 0, 36), TextWrapped = false, TextColor3 = ALERT, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Parent = downCard })
	downedText = UiKit.text("dialogue", { Text = "", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.hudText, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Parent = downCard })

	fade = UiKit.frame({ Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Visible = false, ZIndex = 10, Parent = top })
	local fadeCol = UiKit.frame({ Name = "Column", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46), Size = UDim2.fromScale(0.7, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = fade })
	UiKit.new("UISizeConstraint", { MaxSize = Vector2.new(640, math.huge), Parent = fadeCol })
	list(fadeCol, SPACE.s, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
	scaled(fadeCol)
	fadeTitle = UiKit.text("display", { Text = "", Size = UDim2.new(1, 0, 0, 36), TextWrapped = false, TextColor3 = CARD_TEXT, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Parent = fadeCol })
	fadeText = UiKit.text("dialogue", { Text = "", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.hudDim, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Parent = fadeCol })

	ending = UiKit.frame({ Name = "Ending", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Visible = false, ZIndex = 20, Parent = top })
	endingCol = UiKit.frame({ Name = "Column", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromScale(0.7, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = ending })
	UiKit.new("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge), Parent = endingCol })
	list(endingCol, SPACE.m, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
	scaled(endingCol)
	endingStats = UiKit.text("caption", { Text = "", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -SPACE.xl), Size = UDim2.new(0.9, 0, 0, 18), TextColor3 = Color3.fromRGB(140, 140, 130), TextXAlignment = Enum.TextXAlignment.Center, Parent = ending })

	-- loading card: one/two pixel words, then a plain sentence
	loading = UiKit.frame({ Name = "Loading", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 9, 11), ZIndex = 30, Parent = top })
	local loadCol = UiKit.frame({ Name = "Column", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46), Size = UDim2.fromScale(0.8, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = loading })
	UiKit.new("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge), Parent = loadCol })
	list(loadCol, SPACE.s, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
	scaled(loadCol)
	local main, sub = string.match(Config.GAME_TITLE, "^(.-):%s*(.+)$")
	UiKit.text("display", { Text = main or Config.GAME_TITLE, TextSize = 48, Size = UDim2.new(1, 0, 0, 52), TextWrapped = false, TextColor3 = CARD_TEXT, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Parent = loadCol })
	if sub then
		UiKit.text("title", { Text = sub, TextSize = 24, Size = UDim2.new(1, 0, 0, 28), TextWrapped = false, TextColor3 = C.amber, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Parent = loadCol })
	end
	UiKit.frame({ Name = "Rule", Size = UDim2.fromOffset(160, 1), BackgroundColor3 = C.hudLine, BackgroundTransparency = 0.5, LayoutOrder = 3, Parent = loadCol })
	UiKit.text("body", { Text = Dialogue.COMPANY .. ", night operations.", Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = C.hudDim, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 4, Parent = loadCol })
	UiKit.text("title", { Text = "CLOCKING IN...", Size = UDim2.new(1, 0, 0, 20), TextWrapped = false, TextColor3 = C.hudDim, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 5, Parent = loadCol })

	local camConn: RBXScriptConnection? = nil
	local function hookCamera()
		if camConn then
			camConn:Disconnect()
		end
		local cam = workspace.CurrentCamera
		if cam then
			camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
		end
		rescale()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
	hookCamera()
end

function Hud.init()
	build()
	refreshHints()
	State.Changed:Connect(render)
	State.Notified:Connect(function(text, kind)
		Hud.toast(text, kind)
	end)
	State.SessionChanged:Connect(function()
		task.defer(applyMode) -- after the desktop has opened/closed
	end)
	State.Fx:Connect(function(name, data)
		if name == "BossMessage" and not Desktop.isOpen() then
			Hud.toast(data.text, if data.kind == "false" then "bad" else "info", { tag = "PAGER", speaker = data.from, dialogue = true })
		elseif name == "Fragment" and not Desktop.isOpen() then
			local f = Dialogue.FRAGMENTS[data.index]
			if f then
				Hud.toast(f.title .. " was recovered before shredding. Read it in My Files at the workstation.", "info", { tag = "FILE RECOVERED" })
			end
		elseif name == "CheckpointSaved" then
			Hud.toast(sentence(tostring(data.label)) .. ".", "good", { tag = "CHECKPOINT" })
		elseif name == "Restore" then
			showFade("CHECKPOINT", sentence(tostring(data.reason)) .. ". Returning to the last checkpoint.", 2.2)
		elseif name == "TeamCaught" then
			downedTitle.Text = if data.solo then "CAUGHT" else "TEAM CAUGHT"
			downedText.Text = "Returning to the last checkpoint..."
		elseif name == "Ending" then
			showEnding(data)
		elseif name == "Escaped" and data.name == player.DisplayName then
			Hud.toast("You made it outside. Wait for the others.", "good")
		end
	end)
	player:GetAttributeChangedSignal("Downed"):Connect(function()
		local downed = player:GetAttribute("Downed") == true
		downedOverlay.Visible = downed
		if downed then
			downedTitle.Text = "CAUGHT"
			downedText.Text = if #Players:GetPlayers() <= 1 then "Returning to the last checkpoint..." else "Hold on. A teammate can help you up by holding E next to you."
		end
		updateDot()
	end)
	player:GetAttributeChangedSignal("Carrying"):Connect(function()
		if State.snapshot then
			render(State.snapshot)
		end
	end)
	Cursor.Changed:Connect(updateDot)
	local lastMode = inputMode()
	UserInputService.LastInputTypeChanged:Connect(function()
		local mode = inputMode()
		if mode ~= lastMode then
			lastMode = mode
			refreshHints()
		end
	end)
end

function Hud.start()
	-- loading card until the art is baked (or a short timeout)
	local t0 = os.clock()
	while workspace:GetAttribute("ClientArtReady") ~= true and os.clock() - t0 < 25 do
		task.wait(0.2)
	end
	fadeOut(loading, 1.5)
	task.wait(1.6)
	loading.Visible = false
	updateDot()
	-- periodic refresh keeps crew status in sync with attribute changes
	while true do
		task.wait(1)
		if State.snapshot then
			renderTeam(State.snapshot)
		end
		updateDot()
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="172">
            <Properties>
              <string name="Name">Pings</string>
              <string name="Source"><![CDATA[--!strict
-- Team pings (no voice needed): G / gamepad Y / on-screen button marks the
-- spot under the cursor/centre of screen for everyone for a few seconds.
-- The marker is a small amber diamond under a dark name plate, and the touch
-- button is a square HUD plate, both in the HUD style (docs/ART_DIRECTION.md).

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local State = require(script.Parent.State)
local Desktop = require(script.Parent.Desktop)
local Sfx = require(script.Parent.Parent.Ui.Sfx)
local UiKit = require(script.Parent.Parent.Ui.UiKit)

local player = Players.LocalPlayer
local C = UiKit.C

local Pings = {}

local FADE_OUT = 0.6

local lastPing = 0

local function aimPoint(): Vector3?
	local cam = workspace.CurrentCamera
	local screenPos: Vector2
	if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		screenPos = UserInputService:GetMouseLocation()
	else
		screenPos = cam.ViewportSize / 2
	end
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Instance }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * Config.PING.maxDistance, params)
	return if hit then hit.Position else nil
end

local function doPing(_name: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if state ~= Enum.UserInputState.Begin or Desktop.isOpen() then
		return Enum.ContextActionResult.Pass
	end
	if os.clock() - lastPing < 1.5 then
		return Enum.ContextActionResult.Sink
	end
	local p = aimPoint()
	if p then
		lastPing = os.clock()
		Net.remote("Ping"):FireServer(p)
	end
	return Enum.ContextActionResult.Sink
end

local function fadeOut(root: Instance, seconds: number)
	local info = TweenInfo.new(seconds)
	for _, d in root:GetDescendants() do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = 1 }):Play()
		elseif d:IsA("Frame") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
end

local function showPing(pos: Vector3, by: string, where: string)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = pos + Vector3.new(0, 1.2, 0)
	part.Parent = workspace
	local bb = UiKit.new("BillboardGui", { Name = "Ping", Size = UDim2.fromOffset(240, 76), AlwaysOnTop = true, MaxDistance = 200, Parent = part }) :: BillboardGui
	-- name plate: who pinged, then the area in pixel caps
	local plate = UiKit.frame({
		Name = "Plate",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = C.hud,
		BackgroundTransparency = 0.22,
		Parent = bb,
	})
	UiKit.stroke(plate, C.amber, 0.35)
	UiKit.padding(plate, UiKit.SPACE.s, UiKit.SPACE.xs)
	UiKit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = plate })
	UiKit.text("body", { Text = by, Font = UiKit.FONT_BOLD, Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, TextWrapped = false, TextColor3 = C.hudText, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Parent = plate })
	UiKit.text("title", { Text = string.upper(where), Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, TextWrapped = false, TextColor3 = C.amber, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Parent = plate })
	-- diamond over the pinged spot
	local mark = UiKit.frame({ Name = "Mark", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 1, -9), Size = UDim2.fromOffset(10, 10), Rotation = 45, BackgroundColor3 = C.amber, Parent = bb })
	UiKit.stroke(mark, C.hud, 0.2)
	Sfx.play("click", { pos = pos, volume = 0.5, speed = 1.4 })
	task.delay(math.max(0, Config.PING.lifetime - FADE_OUT), function()
		if bb.Parent then
			fadeOut(bb, FADE_OUT)
		end
	end)
	task.delay(Config.PING.lifetime, function()
		part:Destroy()
	end)
end

-- The touch button ContextActionService creates is a round image; restyle it
-- as a square dark HUD plate with a pixel label. Only exists on touch devices.
local function styleTouchButton()
	local b = ContextActionService:GetButton("NS_Ping")
	if not b then
		return
	end
	b.ImageTransparency = 1
	b.BackgroundColor3 = C.hud
	b.BackgroundTransparency = 0.22
	b.BorderSizePixel = 0
	UiKit.stroke(b, C.hudLine, 0.45)
	local title = b:FindFirstChild("ActionTitle")
	if title and title:IsA("TextLabel") then
		title.FontFace = UiKit.FONT_PIXEL_BOLD
		title.TextScaled = false
		title.TextSize = 16
		title.TextColor3 = C.hudText
	end
	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			b.BackgroundColor3 = C.hud:Lerp(C.amber, 0.35)
		end
	end)
	b.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			b.BackgroundColor3 = C.hud
		end
	end)
end

function Pings.init()
	ContextActionService:BindAction("NS_Ping", doPing, true, Enum.KeyCode.G, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("NS_Ping", "PING")
	ContextActionService:SetPosition("NS_Ping", UDim2.new(1, -170, 1, -150))
	styleTouchButton()
	State.Pinged:Connect(showPing)
end

return Pings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="173">
            <Properties>
              <string name="Name">PromptUi</string>
              <string name="Source"><![CDATA[--!strict
-- Custom interaction prompt. The server still owns the ProximityPrompts
-- (reach, hold time, validation), but every prompt is Style = Custom, so
-- Roblox draws nothing. This draws one card: a keycap, the action ("Collect
-- drive"), the object ("HD-1147"), an amber hold bar and - only when a prompt
-- on another key is in reach too - a smaller second row (F "Dock drive" under
-- E "Sit down"). There is only ever one card, so prompts never overlap.
--
-- Targeting happens here, not in Roblox: among enabled, on-screen prompts in
-- reach, the one nearest the centre of view wins, distance breaks ties, and
-- the current target is sticky so neighbours do not flicker. Every other
-- prompt gets MaxActivationDistance 0 locally, so a key press always fires
-- exactly what the card shows, and the card only draws a prompt once Roblox
-- has shown it (if Roblox declines one, it is skipped for a moment). The
-- real reach travels in the "Reach" attribute; the server re-validates every
-- trigger with its own values.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local Cursor = require(script.Parent.Parent.Ui.Cursor)
local Desktop = require(script.Parent.Desktop)

local player = Players.LocalPlayer
local C = UiKit.C

local PromptUi = {}

-- targeting
local MAX_ANGLE = 60 -- degrees off the view centre before a prompt is ignored,
local CLOSE = 3.5 -- unless it is this close (studs)
local DIST_WEIGHT = 3 -- cost of one stud of distance, in degrees
local STICKY = 12 -- head start of a prompt already on the card, in degrees
local REACH_IN = 0.5 -- a new target must be this far inside its reach (studs)
local SCREEN_IN = 0.02 -- and this far inside the viewport edges (fraction of the short side)
local GRACE = 0.3 -- seconds an armed prompt may wait for Roblox to show it
local HIDE_GRACE = 0.05 -- ...or to show it again after Roblox hid it while armed
local FLASH = 0.18

-- layout in px at scale 1; scale = viewport height / 1080 in [1, 1.5] like the HUD
local REF_HEIGHT = 1080
local SCALE_MAX = 1.5
local CAP = 28
local CAP_SMALL = 24
local GAP = 10 -- keycap to text
local PAD_X = 10
local PAD_Y = 8
local ROW_GAP = 6
local LINE_ACTION = 20
local LINE_SMALL = 18
local LINE_OBJECT = 17
local ACTION_SIZE = 17
local SMALL_SIZE = 15
local OBJECT_SIZE = UiKit.TYPE.caption.size
local HOLD_H = 3
local MAX_TEXT = 240
-- placement: just under the target, but always below the centre dot and
-- above Hud's bottom column (it keeps clear of PROMPT_Y * height + 92 px)
local BELOW = 22
local DOT_GAP = 26
local SPREAD = 0.16 -- card centre stays within this fraction of the width from the middle
local PROMPT_Y = 0.6
local PROMPT_CLEAR = 88
local EDGE = 16
local FOLLOW = 16 -- smoothing rate (1/s): settles in ~0.2 s

type Info = {
	reach: number,
	shown: boolean, -- Roblox has fired PromptShown and not PromptHidden
	waitSince: number?, -- armed but not (or no longer) shown by Roblox
	waitLimit: number,
	refusals: number, -- consecutive times Roblox would not show it
	refusedUntil: number,
	holdStart: number?,
	flashUntil: number,
	conns: { RBXScriptConnection },
}

type Row = {
	button: TextButton, -- the whole row is the touch target for its prompt
	cap: Frame,
	letter: TextLabel,
	action: TextLabel,
	object: TextLabel,
	holdBack: Frame,
	holdFill: Frame,
	small: boolean,
	prompt: ProximityPrompt?,
}

type Held = { prompt: ProximityPrompt, input: InputObject }

local infos: { [ProximityPrompt]: Info } = {}
-- survives unregistering, so a prompt that leaves and re-enters the
-- workspace never reads back the 0 we wrote
local knownReach: { [ProximityPrompt]: number } = setmetatable({}, { __mode = "k" }) :: any
local costs: { [ProximityPrompt]: number } = {}

local primary: ProximityPrompt? = nil
local second: ProximityPrompt? = nil
local inputMode: Enum.ProximityPromptInputType = Enum.ProximityPromptInputType.Keyboard
local held: Held? = nil

local gui: ScreenGui
local card: Frame
local rows: { Row } = {}
local cardPos: Vector2? = nil

local function worldPosition(p: ProximityPrompt): Vector3?
	local parent = p.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	elseif parent and parent:IsA("Model") then
		return parent:GetPivot().Position
	end
	return nil
end

-- E / F on keyboard, X / R1 on a gamepad, TAP on touch
local function keyText(p: ProximityPrompt): string
	if inputMode == Enum.ProximityPromptInputType.Touch then
		return "TAP"
	elseif inputMode == Enum.ProximityPromptInputType.Gamepad then
		local n = string.gsub(string.gsub(p.GamepadKeyCode.Name, "^Button", ""), "^DPad", "")
		return string.upper(n)
	end
	local n = p.KeyboardKeyCode.Name
	if n == "Space" then
		return "SPC"
	elseif n == "Return" then
		return "RET"
	end
	return string.upper(string.sub(n, 1, 5))
end

local function modeFor(t: Enum.UserInputType): Enum.ProximityPromptInputType?
	if t == Enum.UserInputType.Touch then
		return Enum.ProximityPromptInputType.Touch
	elseif string.sub(t.Name, 1, 7) == "Gamepad" then
		return Enum.ProximityPromptInputType.Gamepad
	elseif t == Enum.UserInputType.Keyboard or string.sub(t.Name, 1, 5) == "Mouse" then
		return Enum.ProximityPromptInputType.Keyboard
	end
	return nil
end

---------------------------------------------------------------------------
-- Registry: every prompt in the workspace, inert until it is targeted

local function endTouch()
	local h = held
	held = nil
	if h then
		h.prompt:InputHoldEnd()
	end
end

local function unregister(p: ProximityPrompt)
	local info = infos[p]
	if not info then
		return
	end
	for _, c in info.conns do
		c:Disconnect()
	end
	infos[p] = nil
	if held and held.prompt == p then
		held = nil
	end
	if primary == p then
		primary = nil
	end
	if second == p then
		second = nil
	end
end

local function register(p: ProximityPrompt)
	if infos[p] or not p:IsDescendantOf(workspace) then
		return
	end
	local attr = p:GetAttribute("Reach")
	local reach = if typeof(attr) == "number" then attr else knownReach[p] or p.MaxActivationDistance
	knownReach[p] = reach
	-- fallback for any prompt not made by Prompts.make: never let Roblox draw it
	if p.Style ~= Enum.ProximityPromptStyle.Custom then
		p.Style = Enum.ProximityPromptStyle.Custom
	end
	local info: Info = {
		reach = reach,
		shown = false,
		waitSince = nil,
		waitLimit = GRACE,
		refusals = 0,
		refusedUntil = 0,
		holdStart = nil,
		flashUntil = 0,
		conns = {},
	}
	infos[p] = info
	p.MaxActivationDistance = 0
	table.insert(
		info.conns,
		p.PromptButtonHoldBegan:Connect(function()
			info.holdStart = os.clock()
		end)
	)
	table.insert(
		info.conns,
		p.PromptButtonHoldEnded:Connect(function()
			info.holdStart = nil
		end)
	)
	table.insert(
		info.conns,
		p:GetAttributeChangedSignal("Reach"):Connect(function()
			local r = p:GetAttribute("Reach")
			if typeof(r) == "number" then
				info.reach = r
				knownReach[p] = r
			end
		end)
	)
	table.insert(
		info.conns,
		p.AncestryChanged:Connect(function()
			if not p:IsDescendantOf(workspace) then
				unregister(p)
			end
		end)
	)
end

---------------------------------------------------------------------------
-- Targeting

local function suppressed(): boolean
	if Desktop.isOpen() or Cursor.isFree() then
		return true
	end
	if player:GetAttribute("Downed") == true or player:GetAttribute("Escaped") == true then
		return true
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid == nil or humanoid.Health <= 0
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

local function armed(p: ProximityPrompt): boolean
	return p == primary or p == second
end

-- Roblox would not show an armed prompt (its own range / view test differs
-- from ours): skip it for a while, backing off if it keeps happening.
local function refuse(info: Info, now: number)
	info.waitSince = nil
	info.refusals += 1
	info.refusedUntil = now + math.min(3, 0.4 * 2 ^ (info.refusals - 1))
end

-- Lower is better: degrees off the view centre plus a distance term.
-- nil when the prompt cannot be the target at all.
local function cost(p: ProximityPrompt, info: Info, cam: Camera, rootPos: Vector3, now: number): number?
	if not p.Enabled or p:GetAttribute("OwnerUserId") == player.UserId then
		return nil -- disabled, or our own "Help up"
	end
	local isHeld = info.holdStart ~= nil or (held ~= nil and held.prompt == p)
	if now < info.refusedUntil and not isHeld then
		return nil
	end
	local pos = worldPosition(p)
	if not pos then
		return nil
	end
	local d = (pos - rootPos).Magnitude
	if d > (if armed(p) then info.reach else info.reach - REACH_IN) then
		return nil
	end
	-- Roblox only shows prompts in view, so only on-screen ones are candidates
	local vp = cam.ViewportSize
	local screen, onScreen = cam:WorldToViewportPoint(pos)
	local m = math.min(vp.X, vp.Y) * SCREEN_IN
	if not onScreen or screen.Z <= 0 or screen.X < m or screen.X > vp.X - m or screen.Y < m or screen.Y > vp.Y - m then
		return nil
	end
	local v = pos - cam.CFrame.Position
	local len = v.Magnitude
	local angle = if len > 0.05 then math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(v / len), -1, 1))) else 0
	if angle > MAX_ANGLE and d > CLOSE then
		return nil
	end
	if isHeld then
		return -math.huge -- never switch away mid-hold
	end
	return angle + d * DIST_WEIGHT
end

local function checkWait(p: ProximityPrompt?, now: number)
	local info = if p then infos[p] else nil
	local since = info and info.waitSince
	if info and since and now - since > info.waitLimit then
		refuse(info, now)
	end
end

-- Picks the primary target and, on a different key, the second row; then
-- arms exactly those two and disarms every other prompt.
local function choose(cam: Camera, now: number)
	checkWait(primary, now)
	checkWait(second, now)
	table.clear(costs)
	local rootPos = rootPosition()
	local newPrimary: ProximityPrompt? = nil
	local newSecond: ProximityPrompt? = nil
	if rootPos and not suppressed() then
		local best = math.huge
		for p, info in infos do
			local c = cost(p, info, cam, rootPos, now)
			if c then
				-- anything already on the card keeps a head start, even when
				-- it trades rows with the other key
				if armed(p) then
					c -= STICKY
				end
				costs[p] = c
				if c < best then
					newPrimary, best = p, c
				end
			end
		end
		if newPrimary then
			local key = newPrimary.KeyboardKeyCode
			local bestSecond = math.huge
			for p, c in costs do
				if p ~= newPrimary and p.KeyboardKeyCode ~= key then
					if c < bestSecond then
						newSecond, bestSecond = p, c
					end
				end
			end
		end
	end
	primary, second = newPrimary, newSecond
	for p, info in infos do
		local on = armed(p)
		local want = if on then info.reach else 0
		if math.abs(p.MaxActivationDistance - want) > 1e-3 then -- stored as float32
			p.MaxActivationDistance = want
			if on and not info.shown then
				info.waitSince, info.waitLimit = now, GRACE
			end
		end
		if not on then
			info.waitSince = nil
		end
	end
end

-- An armed prompt Roblox has not shown yet: the card keeps its last frame
-- for that moment instead of blinking between two targets.
local function waiting(p: ProximityPrompt?): boolean
	local info = if p then infos[p] else nil
	return info ~= nil and info.waitSince ~= nil
end

local function confirmed(p: ProximityPrompt?): boolean
	local info = if p then infos[p] else nil
	return info ~= nil and info.shown
end

---------------------------------------------------------------------------
-- Card

local function makeRow(small: boolean): Row
	local button = UiKit.new("TextButton", {
		Name = if small then "Second" else "Primary",
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(200, CAP),
		ZIndex = 2,
		Parent = card,
	}) :: TextButton
	local cap = UiKit.keycap(button, "E", if small then CAP_SMALL else CAP, 3)
	local letter = cap:FindFirstChild("Letter") :: TextLabel
	letter.TextScaled = false -- sized per scale below, so the pixel font stays crisp
	letter.TextSize = UiKit.TYPE.key.size
	local action = UiKit.text("heading", {
		Name = "Action",
		Text = "",
		TextSize = if small then SMALL_SIZE else ACTION_SIZE,
		TextColor3 = C.hudText,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.fromOffset(MAX_TEXT, LINE_ACTION),
		ZIndex = 3,
		Parent = button,
	})
	local object = UiKit.text("caption", {
		Name = "Object",
		Text = "",
		TextColor3 = C.hudDim,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.fromOffset(MAX_TEXT, LINE_OBJECT),
		ZIndex = 3,
		Parent = button,
	})
	local holdBack = UiKit.frame({ Name = "Hold", Size = UDim2.fromOffset(200, HOLD_H), BackgroundColor3 = C.charcoal, ZIndex = 3, Visible = false, Parent = button })
	local holdFill = UiKit.frame({ Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.amber, ZIndex = 4, Parent = holdBack })
	local row: Row = {
		button = button,
		cap = cap,
		letter = letter,
		action = action,
		object = object,
		holdBack = holdBack,
		holdFill = holdFill,
		small = small,
		prompt = nil,
	}
	-- touch (or a free mouse) holds the row's own prompt for as long as the
	-- finger stays down; release is caught globally in case it slides off
	button.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local p = row.prompt
		if p and not held and card.Visible then
			held = { prompt = p, input = input }
			p:InputHoldBegin()
		end
	end)
	button.InputEnded:Connect(function(input)
		local h = held
		if h and h.prompt == row.prompt and input.UserInputType == h.input.UserInputType then
			endTouch()
		end
	end)
	return row
end

local function build()
	gui = UiKit.new("ScreenGui", {
		Name = "Prompts",
		ResetOnSpawn = false,
		DisplayOrder = 7,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	card = UiKit.frame({
		Name = "Card",
		BackgroundColor3 = C.hud,
		BackgroundTransparency = 0.2,
		Size = UDim2.fromOffset(220, 50),
		Visible = false,
		ZIndex = 1,
		Parent = gui,
	})
	UiKit.stroke(card, C.hudLine, 0.45)
	rows[1] = makeRow(false)
	rows[2] = makeRow(true)
end

local function px(v: number, s: number): number
	return math.floor(v * s + 0.5)
end

-- math.clamp, but never throws when the range collapses (tiny viewports)
local function clamp(v: number, lo: number, hi: number): number
	if lo > hi then
		return (lo + hi) / 2
	end
	return math.clamp(v, lo, hi)
end

-- Lays out one row for prompt p; returns its content width and height.
local function fillRow(row: Row, p: ProximityPrompt, s: number, now: number): (number, number)
	row.prompt = p
	local info = infos[p]
	local key = keyText(p)
	if row.letter.Text ~= key then
		row.letter.Text = key
	end
	row.letter.TextSize = if s >= 1.3 then 24 else UiKit.TYPE.key.size -- Silkscreen stays on its 8 px grid
	local capH = px(if row.small then CAP_SMALL else CAP, s)
	local capW = math.max(capH, math.ceil(row.letter.TextBounds.X) + px(12, s))
	local flash = info ~= nil and now < info.flashUntil
	row.cap.BackgroundColor3 = if flash then C.amber else Color3.fromRGB(228, 222, 204)

	local hasObject = p.ObjectText ~= ""
	if row.action.Text ~= p.ActionText then
		row.action.Text = p.ActionText
	end
	if row.object.Text ~= p.ObjectText then
		row.object.Text = p.ObjectText
	end
	row.object.Visible = hasObject
	row.action.TextSize = px(if row.small then SMALL_SIZE else ACTION_SIZE, s)
	row.object.TextSize = px(OBJECT_SIZE, s)
	local lineA = px(if row.small then LINE_SMALL else LINE_ACTION, s)
	local lineO = px(LINE_OBJECT, s)
	local textH = if hasObject then lineA + lineO else lineA
	local rowH = math.max(capH, textH)
	local maxText = px(MAX_TEXT, s)
	-- labels stay maxText wide (truncating past it); the card hugs the text
	local textW = math.min(maxText, math.ceil(math.max(row.action.TextBounds.X, if hasObject then row.object.TextBounds.X else 0)))
	local textX = capW + px(GAP, s)
	local textY = math.floor((rowH - textH) / 2)
	row.cap.Size = UDim2.fromOffset(capW, capH)
	row.cap.Position = UDim2.fromOffset(0, math.floor((rowH - capH) / 2))
	row.action.Size = UDim2.fromOffset(maxText, lineA)
	row.action.Position = UDim2.fromOffset(textX, textY)
	row.object.Size = UDim2.fromOffset(maxText, lineO)
	row.object.Position = UDim2.fromOffset(textX, textY + lineA)

	local height = rowH
	local start = info and info.holdStart
	if start and p.HoldDuration > 0 then
		local gap = px(5, s)
		row.holdBack.Visible = true
		row.holdBack.Position = UDim2.fromOffset(0, rowH + gap)
		row.holdFill.Size = UDim2.fromScale(math.clamp((now - start) / p.HoldDuration, 0, 1), 1)
		height += gap + px(HOLD_H, s)
	else
		row.holdBack.Visible = false
	end
	return textX + textW, height
end

local function hide()
	card.Visible = false
	cardPos = nil
	rows[1].prompt = nil
	rows[2].prompt = nil
	if held then
		endTouch()
	end
end

local function step(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local now = os.clock()
	choose(cam, now)
	if card.Visible and (waiting(primary) or waiting(second)) then
		return
	end
	local a: ProximityPrompt? = if confirmed(primary) then primary else nil
	local b: ProximityPrompt? = if confirmed(second) then second else nil
	if not a then
		a, b = b, nil
	end
	local anchor = if a then worldPosition(a) else nil
	if not a or not anchor then
		hide()
		return
	end
	if held and held.prompt ~= a and held.prompt ~= b then
		endTouch()
	end

	local vp = cam.ViewportSize
	local s = math.clamp(vp.Y / REF_HEIGHT, 1, SCALE_MAX)
	local padX, padY = px(PAD_X, s), px(PAD_Y, s)
	local r1, r2 = rows[1], rows[2]
	local w1, h1 = fillRow(r1, a, s, now)
	local inner, y = w1, padY + h1
	if b then
		local w2, h2 = fillRow(r2, b, s, now)
		inner = math.max(w1, w2)
		r2.button.Visible = true
		r2.button.Position = UDim2.fromOffset(padX, y + px(ROW_GAP, s))
		r2.button.Size = UDim2.fromOffset(inner, h2)
		y += px(ROW_GAP, s) + h2
	else
		r2.button.Visible = false
		r2.prompt = nil
	end
	r1.button.Position = UDim2.fromOffset(padX, padY)
	r1.button.Size = UDim2.fromOffset(inner, h1)
	local holdH = math.max(2, px(HOLD_H, s))
	r1.holdBack.Size = UDim2.fromOffset(inner, holdH)
	r2.holdBack.Size = UDim2.fromOffset(inner, holdH)
	local w, h = inner + padX * 2, y + padY
	card.Size = UDim2.fromOffset(w, h)

	-- just under the target, pulled toward the middle, below the centre dot
	-- and above the HUD's bottom column; on screen even when the target is not
	local cx, cy = vp.X / 2, vp.Y / 2
	local tx, ty = cx, cy
	local screen, onScreen = cam:WorldToViewportPoint(anchor)
	if onScreen and screen.Z > 0 then
		tx = screen.X + a.UIOffset.X * s
		ty = screen.Y + a.UIOffset.Y * s + BELOW * s
	end
	local spread = vp.X * SPREAD
	tx = clamp(tx, math.max(cx - spread, EDGE + w / 2), math.min(cx + spread, vp.X - EDGE - w / 2))
	local top = cy + DOT_GAP * s
	ty = clamp(ty, top, math.max(top, vp.Y * PROMPT_Y + PROMPT_CLEAR - h))
	local goal = Vector2.new(tx - w / 2, ty)
	local last = cardPos
	local pos = if last and card.Visible then last:Lerp(goal, 1 - math.exp(-FOLLOW * dt)) else goal
	cardPos = pos
	card.Position = UDim2.fromOffset(math.floor(pos.X + 0.5), math.floor(pos.Y + 0.5))
	card.Visible = true
end

function PromptUi.init()
	build()
	inputMode = modeFor(UserInputService:GetLastInputType())
		or if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
			then Enum.ProximityPromptInputType.Touch
			else Enum.ProximityPromptInputType.Keyboard

	for _, d in workspace:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			register(d)
		end
	end
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			register(d)
		end
	end)

	ProximityPromptService.PromptShown:Connect(function(prompt, input)
		register(prompt)
		local info = infos[prompt]
		if info then
			info.shown = true
			info.waitSince = nil
			info.refusals = 0
			info.refusedUntil = 0
		end
		inputMode = input
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		local info = infos[prompt]
		if info then
			info.shown = false
			info.holdStart = nil
			-- hidden by Roblox while we still want it: give it a moment to
			-- come back (property changes can re-show it), then skip it
			if armed(prompt) and prompt.Enabled and prompt.MaxActivationDistance > 0 then
				info.waitSince, info.waitLimit = os.clock(), HIDE_GRACE
			end
		end
		if held and held.prompt == prompt then
			endTouch()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local info = infos[prompt]
		if info then
			info.flashUntil = os.clock() + FLASH
		end
	end)

	UserInputService.LastInputTypeChanged:Connect(function(t)
		local mode = modeFor(t)
		if mode then
			inputMode = mode
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local h = held
		if h and (input == h.input or (input.UserInputType == Enum.UserInputType.MouseButton1 and h.input.UserInputType == Enum.UserInputType.MouseButton1)) then
			endTouch()
		end
	end)

	RunService.RenderStepped:Connect(step)
end

return PromptUi
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="174">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
-- Client mirror of server state. Pure presentation input: the client never
-- decides anything from this, it only renders it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

local State = {}

State.snapshot = nil :: Types.Snapshot?
State.session = nil :: Types.SessionPayload?
State.Changed = Signal.new() :: Signal.Signal<Types.Snapshot>
State.SessionChanged = Signal.new() :: Signal.Signal<Types.SessionPayload>
State.Notified = Signal.new() :: Signal.Signal<string, string>
State.Fx = Signal.new() :: Signal.Signal<string, any>
State.Pinged = Signal.new() :: Signal.Signal<Vector3, string, string>

function State.init()
	Net.remote("State").OnClientEvent:Connect(function(snap: Types.Snapshot)
		State.snapshot = snap
		State.Changed:Fire(snap)
	end)
	Net.remote("Session").OnClientEvent:Connect(function(payload: Types.SessionPayload)
		State.session = payload
		State.SessionChanged:Fire(payload)
	end)
	Net.remote("Notify").OnClientEvent:Connect(function(text: string, kind: string)
		State.Notified:Fire(text, kind)
	end)
	Net.remote("Fx").OnClientEvent:Connect(function(name: string, data: any)
		State.Fx:Fire(name, data)
	end)
	Net.remote("Ping").OnClientEvent:Connect(function(pos: Vector3, by: string, where: string)
		State.Pinged:Fire(pos, by, where)
	end)
end

function State.nightClock(minutes: number?): string
	local m = math.floor(minutes or (if State.snapshot then State.snapshot.nightMinutes else 0))
	local h = (m // 60) % 24
	local suffix = if h >= 12 then "PM" else "AM"
	local h12 = h % 12
	if h12 == 0 then
		h12 = 12
	end
	return string.format("%d:%02d %s", h12, m % 60, suffix)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="175">
            <Properties>
              <string name="Name">WorkstationCamera</string>
              <string name="Source"><![CDATA[--!strict
-- First-person play, the seated workstation camera, and the one place that
-- turns Ui/Cursor state into real mouse behaviour.
--
-- Walking: StarterPlayer locks the camera to first person (LockFirstPerson,
-- zoom 0.5). The PlayerModule camera re-locks the mouse to the centre every
-- frame and its TransparencyController hides the local body, so the head
-- never shows. The cursor icon is hidden; the HUD draws a dot.
-- Seated: a Scriptable camera eases from the head to a framing of the
-- physical monitor (the room is behind you - that is the point). Scriptable
-- switches the PlayerModule camera controller off, so nothing re-locks the
-- free pointer the desktop needs.
-- Leaving (Leave button, Space / gamepad B), losing the seat, death,
-- respawn, being caught or a server-ended session restores first person at
-- once, without easing.
--
-- Pointer: free and visible whenever Cursor.isFree(), we are seated or the
-- desktop is open. Seated, MouseBehavior is simply Default. If UI frees the
-- pointer while walking, a hidden Modal button makes the engine release the
-- lock; overwriting MouseBehavior after the PlayerModule every frame would
-- warp the cursor to the centre each frame. player.CameraMode is never
-- toggled: changing it re-activates a camera controller even while the
-- camera is Scriptable, and with zoom clamped to 0.5 Classic is first person
-- (mouse locked) anyway.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Layout = require(ReplicatedStorage.Shared.Layout)
local State = require(script.Parent.State)
local Desktop = require(script.Parent.Desktop)
local Cursor = require(script.Parent.Parent.Ui.Cursor)

local player = Players.LocalPlayer

local WorkstationCamera = {}

local WALK_FOV = 70
-- Seated framing from Layout.WORKSTATION: aim at the screen centre, eye back
-- along the facing and a little above it. That puts the eye in open air
-- (>= 1.45 studs from chair, keyboard, monitor and desk, ~4 from both walls)
-- and, at FOV 50, keeps the physical monitor inside the desktop's bezel on
-- 4:3 to 21:9 screens so no second monitor edge peeks out beside it.
local SEAT_FOV = 50
local AIM_UP = 1.2 -- above the monitor base: screen centre height
local EYE_BACK = 3.3
local EYE_UP = 0.42
local EASE_IN = 0.35 -- seconds from the seated head to the monitor framing
local STEP_NAME = "NS_FirstPersonCamera"
local STEP_PRIORITY = Enum.RenderPriority.Camera.Value + 1 -- after the PlayerModule camera

local active = false
local easeFrom: CFrame? = nil
local easeFov = WALK_FOV
local engagedAt = 0
local touchHidden = false
local modal: TextButton? = nil

local function seatedCFrame(t: number): CFrame
	local W = Layout.WORKSTATION
	local target = W.monitor + Vector3.new(0, AIM_UP, 0)
	local eye = target - W.facing * EYE_BACK + Vector3.new(0, EYE_UP, 0)
	-- slow breathing sway, tiny so the edges around the desktop barely move
	local right = W.facing:Cross(Vector3.yAxis)
	local sway = right * (math.sin(t * 0.6) * 0.02) + Vector3.yAxis * (math.sin(t * 0.9) * 0.015)
	return CFrame.lookAt(eye + sway, target)
end

local function humanoid(): Humanoid?
	local character = player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

local function pointerFree(): boolean
	return active or Cursor.isFree() or Desktop.isOpen()
end

local function applyPointer()
	local free = pointerFree()
	if modal then
		modal.Visible = free
	end
	-- touch: the thumbstick and jump button sit under the desktop and would
	-- take taps meant for it (a stray jump stands you up); Leave is on screen
	local hideTouch = Desktop.isOpen()
	if hideTouch ~= touchHidden then
		touchHidden = hideTouch
		GuiService.TouchControlsEnabled = not hideTouch
	end
	if GuiService.MenuIsOpen then
		-- the Roblox menu owns the pointer while it is up
		if not UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = true
		end
		return
	end
	local scripted = workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable
	if free then
		if not UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = true
		end
		if scripted and UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	else
		if UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = false
		end
		if not scripted and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	end
end

local function step()
	if active then
		local cam = workspace.CurrentCamera
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Scriptable -- e.g. a replaced camera: keep the framing
		end
		local now = os.clock()
		local goal = seatedCFrame(now)
		local a = (now - engagedAt) / EASE_IN
		local from = easeFrom
		if from and a < 1 then
			local k = 1 - (1 - a) * (1 - a)
			cam.CFrame = from:Lerp(goal, k)
			cam.FieldOfView = easeFov + (SEAT_FOV - easeFov) * k
		else
			easeFrom = nil
			cam.CFrame = goal
			if cam.FieldOfView ~= SEAT_FOV then
				cam.FieldOfView = SEAT_FOV
			end
		end
	elseif Cursor.has("desktop") and not Desktop.isOpen() then
		-- a leaked desktop request must never leave a walker with a free cursor
		Cursor.request("desktop", false)
	end
	applyPointer()
end

local function engage()
	if active then
		return
	end
	local h = humanoid()
	if not h or h.Health <= 0 or player:GetAttribute("Downed") == true then
		return -- stale session for a dead or caught character: the server ends it
	end
	active = true
	local cam = workspace.CurrentCamera
	easeFrom = cam.CFrame
	easeFov = cam.FieldOfView
	engagedAt = os.clock()
	cam.CameraType = Enum.CameraType.Scriptable
	Cursor.request("seated", true)
	applyPointer()
end

-- Back to first person at once. `force` also resets a camera we did not
-- know was seated (respawn).
local function restore(force: boolean?)
	local cam = workspace.CurrentCamera
	if active or force then
		active = false
		easeFrom = nil
		cam.CameraType = Enum.CameraType.Custom
		local h = humanoid()
		if h then
			cam.CameraSubject = h
		end
	end
	cam.FieldOfView = WALK_FOV
	-- StarterPlayer sets this; only touched with the camera back on Custom
	if cam.CameraType ~= Enum.CameraType.Scriptable and player.CameraMode ~= Enum.CameraMode.LockFirstPerson then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
	Cursor.request("seated", false)
	applyPointer()
end

local function leaveSeat()
	Desktop.forceClose()
	restore()
end

local function hookCharacter(character: Model)
	local h = character:WaitForChild("Humanoid", 10)
	if h and h:IsA("Humanoid") then
		h.Seated:Connect(function(isSeated)
			if not isSeated then
				leaveSeat()
			end
		end)
		h.Died:Connect(leaveSeat)
	end
end

-- Invisible Modal button: while visible the engine keeps the mouse unlocked
-- even though the first-person camera asks for LockCenter every frame.
local function makeModal(): TextButton
	local gui = Instance.new("ScreenGui")
	gui.Name = "PointerRelease"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	local b = Instance.new("TextButton")
	b.Name = "Modal"
	b.Modal = true
	b.Visible = false
	b.Selectable = false
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.Text = ""
	b.AnchorPoint = Vector2.new(1, 1)
	b.Position = UDim2.fromScale(1, 1)
	b.Size = UDim2.fromOffset(1, 1)
	b.Parent = gui
	gui.Parent = player:WaitForChild("PlayerGui")
	return b
end

function WorkstationCamera.isActive(): boolean
	return active
end

function WorkstationCamera.init()
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
	workspace.CurrentCamera.FieldOfView = WALK_FOV
	modal = makeModal()
	State.SessionChanged:Connect(function(payload)
		if payload.active then
			engage()
		else
			restore()
		end
	end)
	Cursor.Changed:Connect(applyPointer)
	GuiService.MenuOpened:Connect(applyPointer)
	GuiService.MenuClosed:Connect(applyPointer)
	player:GetAttributeChangedSignal("Downed"):Connect(function()
		if player:GetAttribute("Downed") == true and active then
			leaveSeat()
		end
	end)
	player.CharacterAdded:Connect(function(c)
		restore(true)
		hookCharacter(c)
	end)
	if player.Character then
		task.spawn(hookCharacter, player.Character)
	end
	RunService:BindToRenderStep(STEP_NAME, STEP_PRIORITY, step)
	applyPointer()
end

return WorkstationCamera
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="176">
          <Properties>
            <string name="Name">Ui</string>
          </Properties>
          <Item class="ModuleScript" referent="177">
            <Properties>
              <string name="Name">Cursor</string>
              <string name="Source"><![CDATA[--!strict
-- Who owns the mouse pointer. Walking is first person: the cursor stays
-- locked to the centre and hidden. Any UI that needs the pointer (the seated
-- desktop, an ending card with buttons) asks for it with a reason and
-- releases the same reason when done. WorkstationCamera applies the result.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local Cursor = {}

local reasons: { [string]: boolean } = {}

-- fires with the new free/locked state whenever it flips
Cursor.Changed = Signal.new() :: Signal.Signal<boolean>

function Cursor.isFree(): boolean
	return next(reasons) ~= nil
end

-- whether `reason` is currently holding the pointer free
function Cursor.has(reason: string): boolean
	return reasons[reason] == true
end

function Cursor.request(reason: string, free: boolean)
	local before = Cursor.isFree()
	if free then
		reasons[reason] = true
	else
		reasons[reason] = nil
	end
	local after = Cursor.isFree()
	if after ~= before then
		Cursor.Changed:Fire(after)
	end
end

function Cursor.clear()
	local before = Cursor.isFree()
	table.clear(reasons)
	if before then
		Cursor.Changed:Fire(false)
	end
end

return Cursor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="178">
            <Properties>
              <string name="Name">Sfx</string>
              <string name="Source"><![CDATA[--!strict
-- Sound helper. Sound IDs live in Config.SOUNDS (empty = silent). Positional
-- sounds are parented to a temporary attachment so 3D falloff applies.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local Sfx = {}

local anchor: Part? = nil
local function getAnchor(): Part
	if anchor and anchor.Parent then
		return anchor
	end
	local p = Instance.new("Part")
	p.Name = "SfxAnchor"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(0, -100, 0)
	p.Parent = workspace
	anchor = p
	return p
end

export type PlayOpts = { volume: number?, speed: number?, pos: Vector3?, looped: boolean?, duration: number? }

function Sfx.id(name: string): string
	local v = (Config.SOUNDS :: any)[name]
	return if typeof(v) == "string" then v else ""
end

function Sfx.play(name: string, opts: PlayOpts?): Sound?
	local id = Sfx.id(name)
	if id == "" then
		return nil
	end
	local o: PlayOpts = opts or {}
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = o.volume or 0.5
	s.PlaybackSpeed = (o.speed or 1) * (0.95 + math.random() * 0.1)
	s.Looped = o.looped == true
	s.RollOffMaxDistance = 80
	s.RollOffMinDistance = 6
	if o.pos then
		local att = Instance.new("Attachment")
		att.WorldPosition = o.pos
		att.Parent = getAnchor()
		att.WorldPosition = o.pos
		s.Parent = att
		s.Ended:Connect(function()
			att:Destroy()
		end)
		if o.duration then
			task.delay(o.duration, function()
				att:Destroy()
			end)
		end
	else
		s.Parent = SoundService
		s.Ended:Connect(function()
			s:Destroy()
		end)
		if o.duration then
			task.delay(o.duration, function()
				s:Destroy()
			end)
		end
	end
	s:Play()
	return s
end

return Sfx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="179">
            <Properties>
              <string name="Name">UiKit</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny UI toolkit for the workstation desktop and the HUD: cream/grey
-- bevelled windows, charcoal-blue title bars, chunky buttons and one
-- typographic hierarchy for the whole game (see docs/ART_DIRECTION.md):
--   PIXEL   Silkscreen    short retro labels, window titles, status, keycaps
--   BODY    Ubuntu        dialogue, instructions, buttons, longer text
--   MONO    Inconsolata   file listings, tables, checksums
--   LETTER  Merriweather  recovered memos and story fragments only
-- Props named "Font" that hold a Font object are applied to FontFace.

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Fonts = require(ReplicatedStorage.Shared.Fonts)

local UiKit = {}

UiKit.FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
UiKit.POP = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
UiKit.FADE = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

UiKit.FONT = Fonts.BODY
UiKit.FONT_BOLD = Fonts.BODY_BOLD
UiKit.FONT_MONO = Fonts.MONO
UiKit.FONT_PIXEL = Fonts.PIXEL
UiKit.FONT_PIXEL_BOLD = Fonts.PIXEL_BOLD
UiKit.FONT_LETTER = Fonts.LETTER

-- Typographic roles. Silkscreen sizes stay on multiples of 8 so the pixels
-- stay crisp; readable text never goes below MIN_TEXT.
export type TypeRole = { font: Font, size: number }
UiKit.MIN_TEXT = 13
UiKit.TYPE = {
	display = { font = UiKit.FONT_PIXEL, size = 32 }, -- loading / ending card, one or two words
	title = { font = UiKit.FONT_PIXEL, size = 16 }, -- window titles, section labels, status lines
	key = { font = UiKit.FONT_PIXEL, size = 16 }, -- keycaps
	heading = { font = UiKit.FONT_BOLD, size = 18 }, -- headings inside windows and panels
	body = { font = UiKit.FONT, size = 16 }, -- instructions, descriptions
	dialogue = { font = UiKit.FONT, size = 18 }, -- boss lines, subtitles, toasts
	button = { font = UiKit.FONT_BOLD, size = 16 },
	caption = { font = UiKit.FONT, size = 14 }, -- secondary detail
	mono = { font = UiKit.FONT_MONO, size = 16 }, -- listings, checksums, tables
	letter = { font = UiKit.FONT_LETTER, size = 17 }, -- story fragments only
} :: { [string]: TypeRole }

-- Spacing grid (px): padding, gaps and margins use these steps only.
UiKit.SPACE = { xs = 4, s = 8, m = 12, l = 16, xl = 24 }

UiKit.C = {
	face = Color3.fromRGB(208, 204, 194),
	faceDark = Color3.fromRGB(122, 120, 114),
	faceLight = Color3.fromRGB(242, 240, 234),
	text = Color3.fromRGB(26, 28, 30),
	textDim = Color3.fromRGB(78, 80, 84), -- 5:1 on face, 7.3:1 on field
	title1 = Color3.fromRGB(60, 72, 82),
	title2 = Color3.fromRGB(88, 104, 116),
	desktop = Color3.fromRGB(64, 84, 92),
	taskbar = Color3.fromRGB(208, 204, 194),
	start = Color3.fromRGB(208, 204, 194),
	good = Color3.fromRGB(56, 118, 74),
	bad = Color3.fromRGB(156, 56, 50),
	warn = Color3.fromRGB(176, 136, 56),
	info = Color3.fromRGB(62, 88, 118),
	select = Color3.fromRGB(60, 76, 92),
	white = Color3.fromRGB(244, 242, 236),
	field = Color3.fromRGB(246, 244, 236),
	amber = Color3.fromRGB(200, 166, 107),
	cream = Color3.fromRGB(183, 176, 156),
	charcoal = Color3.fromRGB(53, 63, 70),
	hud = Color3.fromRGB(20, 24, 28),
	hudLine = Color3.fromRGB(150, 160, 166),
	hudText = Color3.fromRGB(236, 232, 222),
	hudDim = Color3.fromRGB(168, 176, 182),
	-- art-direction palette (docs/ART_DIRECTION.md)
	fog = Color3.fromRGB(168, 186, 195), -- #A8BAC3
	slate = Color3.fromRGB(119, 139, 150), -- #778B96
	burgundy = Color3.fromRGB(96, 73, 77), -- #60494D
	-- desktop chrome: outer window edge and unfocused title bars
	edge = Color3.fromRGB(44, 48, 52),
	titleOff1 = Color3.fromRGB(104, 110, 114),
	titleOff2 = Color3.fromRGB(136, 140, 142),
}

export type Props = { [string]: any }

function UiKit.new(className: string, props: Props, children: { Instance }?): any
	local inst = Instance.new(className)
	for k, v in props do
		if k == "Parent" then
			continue
		end
		if k == "Font" and typeof(v) == "Font" then
			(inst :: any).FontFace = v
		else
			(inst :: any)[k] = v
		end
	end
	local kids: { Instance } = children or {}
	for _, c in kids do
		c.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UiKit.frame(props: Props): Frame
	local p = table.clone(props)
	p.BorderSizePixel = p.BorderSizePixel or 0
	p.BackgroundColor3 = p.BackgroundColor3 or UiKit.C.face
	return UiKit.new("Frame", p)
end

function UiKit.label(props: Props): TextLabel
	local p = table.clone(props)
	p.BackgroundTransparency = p.BackgroundTransparency or 1
	p.Font = p.Font or UiKit.FONT
	p.TextColor3 = p.TextColor3 or UiKit.C.text
	p.TextSize = p.TextSize or 16
	p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
	p.TextWrapped = if p.TextWrapped == nil then true else p.TextWrapped
	p.BorderSizePixel = 0
	return UiKit.new("TextLabel", p)
end

-- Label in one of the TYPE roles; props override the role defaults.
-- Scaled text gets a size constraint so it never drops below MIN_TEXT.
function UiKit.text(role: string, props: Props): TextLabel
	local r = UiKit.TYPE[role] or UiKit.TYPE.body
	local p = table.clone(props)
	p.Font = p.Font or r.font
	p.TextSize = p.TextSize or r.size
	local l = UiKit.label(p)
	if l.TextScaled and not l:FindFirstChildOfClass("UITextSizeConstraint") then
		UiKit.new("UITextSizeConstraint", { MaxTextSize = r.size, MinTextSize = math.min(UiKit.MIN_TEXT, r.size), Parent = l })
	end
	return l
end

-- Scales a ScreenGui designed in pixels at `refHeight` to the viewport,
-- clamped so phones stay legible and large monitors do not look tiny.
function UiKit.autoScale(gui: LayerCollector, refHeight: number?, minScale: number?, maxScale: number?): UIScale
	local ref = refHeight or 900
	local lo = minScale or 0.6
	local hi = maxScale or 1.5
	local scale = gui:FindFirstChildOfClass("UIScale") or UiKit.new("UIScale", { Parent = gui })
	local function update()
		local cam = workspace.CurrentCamera
		if cam then
			scale.Scale = math.clamp(cam.ViewportSize.Y / ref, lo, hi)
		end
	end
	local function hook()
		local cam = workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	hook()
	return scale
end

-- 1px outline used by HUD panels, keycaps and prompt cards
function UiKit.stroke(parent: GuiObject, color: Color3?, transparency: number?, thickness: number?): UIStroke
	return UiKit.new("UIStroke", {
		Color = color or UiKit.C.hudLine,
		Transparency = transparency or 0.45,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UiKit.padding(parent: GuiObject, x: number, y: number?)
	local py = y or x
	UiKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, py),
		PaddingBottom = UDim.new(0, py),
		Parent = parent,
	})
end

-- Square HUD plate: dark translucent, thin outline, consistent padding.
function UiKit.panel(props: Props): Frame
	local p = table.clone(props)
	p.BackgroundColor3 = p.BackgroundColor3 or UiKit.C.hud
	p.BackgroundTransparency = if p.BackgroundTransparency == nil then 0.22 else p.BackgroundTransparency
	local f = UiKit.frame(p)
	UiKit.stroke(f)
	UiKit.padding(f, 10, 8)
	return f
end

-- Small keycap: cream key, charcoal pixel letter, darker base edge.
function UiKit.keycap(parent: Instance, key: string, size: number, zindex: number?): Frame
	local z = zindex or 1
	local cap = UiKit.frame({
		Name = "Key",
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.fromRGB(228, 222, 204),
		ZIndex = z,
		Parent = parent,
	})
	UiKit.stroke(cap, Color3.fromRGB(70, 78, 84), 0.1)
	UiKit.frame({ Name = "Base", Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = Color3.fromRGB(150, 144, 126), ZIndex = z + 1, Parent = cap })
	local l = UiKit.label({
		Name = "Letter",
		Text = key,
		Size = UDim2.new(1, 0, 1, -3),
		Font = UiKit.FONT_PIXEL,
		TextColor3 = Color3.fromRGB(40, 46, 52),
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = z + 2,
		Parent = cap,
	})
	UiKit.new("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 8, Parent = l })
	UiKit.padding(l, 3, 2)
	return cap
end

-- Recolours an existing bevel: raised (light top-left) or sunken/pressed.
local function paintBevel(f: Instance, sunken: boolean)
	local hi = if sunken then UiKit.C.faceDark else UiKit.C.faceLight
	local lo = if sunken then UiKit.C.faceLight else UiKit.C.faceDark
	for _, c in f:GetChildren() do
		if c:IsA("Frame") then
			if c.Name == "BevelL" or c.Name == "BevelL2" then
				c.BackgroundColor3 = hi
			elseif c.Name == "BevelD" or c.Name == "BevelD2" then
				c.BackgroundColor3 = lo
			end
		end
	end
end

-- 3D bevel like classic Windows controls: 2 px, square corners
function UiKit.bevel(f: GuiObject, sunken: boolean?)
	local z = f.ZIndex + 1
	UiKit.frame({ Name = "BevelL", Size = UDim2.new(1, 0, 0, 2), ZIndex = z, Parent = f })
	UiKit.frame({ Name = "BevelL2", Size = UDim2.new(0, 2, 1, 0), ZIndex = z, Parent = f })
	UiKit.frame({ Name = "BevelD", Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), ZIndex = z, Parent = f })
	UiKit.frame({ Name = "BevelD2", Size = UDim2.new(0, 2, 1, 0), Position = UDim2.new(1, -2, 0, 0), ZIndex = z, Parent = f })
	paintBevel(f, sunken == true)
end

-- Square amber outline for the gamepad-selected control (assigned to
-- GuiObject.SelectionImageObject). One shared template, never parented.
local ring: Frame? = nil
function UiKit.selectionRing(): Frame
	local existing = ring
	if existing then
		return existing
	end
	local r = UiKit.frame({ Name = "SelectionRing", Size = UDim2.new(1, 6, 1, 6), Position = UDim2.fromOffset(-3, -3), BackgroundTransparency = 1 })
	UiKit.stroke(r, UiKit.C.amber, 0, 2)
	ring = r
	return r
end

local clickSound: Sound? = nil
function UiKit.click()
	if not clickSound then
		local s = Instance.new("Sound")
		s.SoundId = Config.SOUNDS.click
		s.Volume = 0.25
		s.PlaybackSpeed = 1.6
		s.Parent = SoundService
		clickSound = s
	end
	local s = clickSound :: Sound
	s.PlaybackSpeed = 1.5 + math.random() * 0.2
	s:Play()
end

export type ButtonOpts = {
	text: string,
	size: UDim2,
	position: UDim2?,
	parent: Instance,
	color: Color3?,
	textColor: Color3?,
	textSize: number?,
	font: Font?,
	zindex: number?,
	onClick: (() -> ())?,
	name: string?,
	bevel: boolean?,
}

function UiKit.button(o: ButtonOpts): TextButton
	local b = UiKit.new("TextButton", {
		Name = o.name or "Button",
		Size = o.size,
		Position = o.position or UDim2.new(),
		BackgroundColor3 = o.color or UiKit.C.face,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = o.text,
		TextColor3 = o.textColor or UiKit.C.text,
		TextSize = o.textSize or 16,
		Font = o.font or UiKit.FONT_BOLD,
		TextWrapped = true,
		ZIndex = o.zindex or 1,
		Selectable = true,
		SelectionImageObject = UiKit.selectionRing(),
		Parent = o.parent,
	}) :: TextButton
	local bevelled = o.bevel ~= false
	if bevelled then
		UiKit.bevel(b)
		-- pressed state: the bevel sinks while the pointer is held down
		b.MouseButton1Down:Connect(function()
			if b.Active then
				paintBevel(b, true)
			end
		end)
		b.MouseButton1Up:Connect(function()
			paintBevel(b, false)
		end)
	end
	local base = b.BackgroundColor3
	b.MouseEnter:Connect(function()
		if b.Active then
			b.BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12)
		end
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = base
		if bevelled then
			paintBevel(b, false)
		end
	end)
	b.SelectionGained:Connect(function()
		b.BackgroundColor3 = base:Lerp(UiKit.C.amber, 0.35)
	end)
	b.SelectionLost:Connect(function()
		b.BackgroundColor3 = base
	end)
	if o.onClick then
		local cb = o.onClick
		b.Activated:Connect(function()
			if not b.Active then
				return
			end
			UiKit.click()
			-- brief pressed flash so gamepad / keyboard activation reads too
			if bevelled then
				paintBevel(b, true)
				task.delay(0.08, function()
					paintBevel(b, false)
				end)
			end
			cb()
		end)
	end
	return b
end

function UiKit.setEnabled(b: GuiButton, enabled: boolean)
	b.Active = enabled
	b.AutoButtonColor = false
	if b:IsA("TextButton") then
		b.TextTransparency = if enabled then 0 else 0.55
	end
end

-- Classic window: cream bevelled body with a 1 px dark edge, charcoal-blue
-- title bar with a Silkscreen title and a small square close button.
export type Window = {
	frame: Frame,
	body: Frame,
	title: TextLabel,
	close: TextButton?,
}

function UiKit.window(parent: Instance, title: string, size: UDim2, position: UDim2, zindex: number, onClose: (() -> ())?): Window
	local f = UiKit.frame({ Name = "Window", Size = size, Position = position, ZIndex = zindex, BorderSizePixel = 1, BorderColor3 = UiKit.C.edge, Parent = parent })
	UiKit.bevel(f)
	local bar = UiKit.frame({ Name = "TitleBar", Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = UiKit.C.title1, ZIndex = zindex + 1, Parent = f })
	UiKit.new("UIGradient", {
		Color = ColorSequence.new(UiKit.C.title1, UiKit.C.title2),
		Parent = bar,
	})
	local t = UiKit.text("title", {
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, if onClose then -36 else -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		TextColor3 = UiKit.C.white,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = zindex + 2,
		Parent = bar,
	})
	local close: TextButton? = nil
	if onClose then
		close = UiKit.button({
			name = "Close",
			text = "X",
			size = UDim2.fromOffset(18, 18),
			position = UDim2.new(1, -21, 0, 3),
			parent = bar,
			zindex = zindex + 3,
			textSize = 16,
			font = UiKit.FONT_PIXEL,
			onClick = onClose,
		})
	end
	local body = UiKit.frame({ Name = "Body", Size = UDim2.new(1, -12, 1, -36), Position = UDim2.fromOffset(6, 30), BackgroundTransparency = 1, ZIndex = zindex + 1, Parent = f })
	return { frame = f, body = body, title = t, close = close }
end

-- Focused windows keep the charcoal-blue title bar; the others turn grey.
function UiKit.setWindowActive(w: Window, active: boolean)
	local bar = w.frame:FindFirstChild("TitleBar")
	local grad = bar and bar:FindFirstChildOfClass("UIGradient")
	if grad then
		grad.Color = if active then ColorSequence.new(UiKit.C.title1, UiKit.C.title2) else ColorSequence.new(UiKit.C.titleOff1, UiKit.C.titleOff2)
	end
	w.title.TextColor3 = if active then UiKit.C.white else UiKit.C.faceLight:Lerp(UiKit.C.face, 0.4)
end

function UiKit.progress(parent: Instance, size: UDim2, position: UDim2, zindex: number): (Frame, Frame)
	local back = UiKit.frame({ Name = "Progress", Size = size, Position = position, BackgroundColor3 = UiKit.C.field, ZIndex = zindex, Parent = parent })
	UiKit.bevel(back, true)
	-- the fill runs inside the sunken bevel; callers size it 0..1 on X
	local track = UiKit.frame({ Name = "Track", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = zindex + 2, Parent = back })
	local fill = UiKit.frame({ Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = UiKit.C.good, ZIndex = zindex + 2, Parent = track })
	return back, fill
end

function UiKit.clear(f: Instance)
	for _, c in f:GetChildren() do
		if not c:IsA("UIBase") then
			c:Destroy()
		end
	end
end

return UiKit
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="180">
          <Properties>
            <string name="Name">Views</string>
          </Properties>
          <Item class="ModuleScript" referent="181">
            <Properties>
              <string name="Name">Checksum</string>
              <string name="Source"><![CDATA[--!strict
-- CHECKSUM MATCHING view: the TARGET readout, verified count and symbol
-- legend on the left, the record list on the right. Symbols are text glyphs
-- with names, never colour alone. Clicking a record submits it.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local C = UiKit.C
local S = UiKit.SPACE
local DIM = UiKit.C.textDim -- secondary text, 5:1 on the face

local SCREEN = Color3.fromRGB(30, 36, 40) -- dark readout well
local PHOSPHOR = Color3.fromRGB(170, 214, 176) -- soft green, not neon
local LEFT_W = 196
local PATTERN_X = 196 -- record row: pattern well starts here
local LEGEND = { "#  hash", "@  at", "%  percent", "&  and", "+  plus", "=  equals", "*  star", "?  query" }

local View = {}

-- Gamepad: every update rebuilds the view, so focus moves to the control
-- that replaces the one that had it.
local function focusName(root: Instance): string?
	local sel = GuiService.SelectedObject
	return if sel and sel:IsDescendantOf(root) then sel.Name else nil
end

local function refocus(root: Instance, name: string?, first: string?)
	local b = if name then root:FindFirstChild(name, true) else nil
	-- a stage change clears the area and drops focus: a pad user gets `first`
	if not b and first and GuiService.SelectedObject == nil and string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
		b = root:FindFirstChild(first, true)
	end
	if b and b:IsA("GuiObject") then
		GuiService.SelectedObject = b
	end
end

-- Hint: an amber edge inside the control plus a HINT tag, never colour alone.
local function hintMark(b: GuiObject, tagPos: UDim2, z: number)
	local edge = UiKit.frame({ Name = "HintEdge", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z, Parent = b })
	UiKit.stroke(edge, C.warn, 0, 2)
	UiKit.text("title", {
		Name = "HintTag",
		Text = "HINT",
		Size = UDim2.fromOffset(48, 18),
		Position = tagPos,
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.amber,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		ZIndex = z,
		Parent = b,
	})
end

function View.render(root: Frame, v: { [string]: any }, api: { act: (string, any, any) -> () }, z: number)
	local focus = focusName(root)
	UiKit.clear(root)
	local w = if root.Size.X.Offset > 0 then root.Size.X.Offset else 620
	local h = if root.Size.Y.Offset > 0 then root.Size.Y.Offset else 250

	-- target readout
	UiKit.text("title", { Text = "TARGET", Size = UDim2.fromOffset(LEFT_W, 18), TextWrapped = false, ZIndex = z, Parent = root })
	local screen = UiKit.frame({ Name = "Target", Size = UDim2.fromOffset(LEFT_W, 64), Position = UDim2.fromOffset(0, 20), BackgroundColor3 = SCREEN, ZIndex = z, Parent = root })
	UiKit.bevel(screen, true)
	UiKit.text("mono", {
		Text = v.target,
		TextSize = 28,
		Size = UDim2.fromScale(1, 1),
		TextColor3 = PHOSPHOR,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		ZIndex = z + 2,
		Parent = screen,
	})

	-- verified counter: the number plus filled / hollow pips
	UiKit.text("title", { Text = "VERIFIED", Size = UDim2.fromOffset(120, 18), Position = UDim2.fromOffset(0, 92), TextWrapped = false, ZIndex = z, Parent = root })
	UiKit.text("mono", {
		Text = string.format("%d / %d", v.matched, v.need),
		Size = UDim2.fromOffset(72, 18),
		Position = UDim2.fromOffset(LEFT_W - 72, 92),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = z,
		Parent = root,
	})
	local need = math.max(1, v.need)
	local pw = math.floor((LEFT_W - (need - 1) * S.xs) / need)
	for i = 1, need do
		local done = i <= v.matched
		local pip = UiKit.frame({ Size = UDim2.fromOffset(pw, 12), Position = UDim2.fromOffset((i - 1) * (pw + S.xs), 114), BackgroundColor3 = if done then C.good else C.field, ZIndex = z, Parent = root })
		UiKit.bevel(pip, not done)
	end

	-- symbol legend, so every glyph has a spoken name
	local legend = UiKit.frame({ Name = "Legend", Size = UDim2.fromOffset(LEFT_W, h - 136), Position = UDim2.fromOffset(0, 136), BackgroundColor3 = C.field, ZIndex = z, Parent = root })
	UiKit.bevel(legend, true)
	UiKit.text("title", { Text = "SYMBOLS", Size = UDim2.new(1, -2 * S.s, 0, 18), Position = UDim2.fromOffset(S.s, S.s), TextColor3 = DIM, TextWrapped = false, ZIndex = z + 2, Parent = legend })
	for i, entry in LEGEND do
		UiKit.text("mono", {
			Text = entry,
			TextSize = 14,
			Size = UDim2.fromOffset(88, 18),
			Position = UDim2.fromOffset(S.s + ((i - 1) // 4) * 92, 30 + ((i - 1) % 4) * 19),
			TextWrapped = false,
			ZIndex = z + 2,
			Parent = legend,
		})
	end

	-- record list: name in mono, pattern in a sunken well
	local lx = LEFT_W + S.m
	local lw = w - lx
	UiKit.text("title", { Text = "RECORDS", Size = UDim2.fromOffset(lw, 18), Position = UDim2.fromOffset(lx, 0), TextWrapped = false, ZIndex = z, Parent = root })
	local n = math.max(1, #v.records)
	local rowH = math.min(44, math.floor((h - 20 - (n - 1) * S.xs) / n))
	for i, r in v.records do
		local hinted = v.highlight == r.id
		local b = UiKit.button({
			name = "Record" .. tostring(r.id),
			text = "",
			size = UDim2.fromOffset(lw, rowH),
			position = UDim2.fromOffset(lx, 20 + (i - 1) * (rowH + S.xs)),
			parent = root,
			zindex = z,
			onClick = function()
				api.act("match", r.id, nil)
			end,
		})
		UiKit.text("mono", {
			Text = r.name,
			TextSize = 15,
			Size = UDim2.new(0, PATTERN_X - S.m - S.s, 1, 0),
			Position = UDim2.fromOffset(S.m, 0),
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = z + 2,
			Parent = b,
		})
		local tagW = if hinted then 48 + S.s else 0
		local well = UiKit.frame({ Name = "Pattern", Size = UDim2.new(1, -(PATTERN_X + S.s + tagW), 1, -10), Position = UDim2.fromOffset(PATTERN_X, 5), BackgroundColor3 = C.field, ZIndex = z + 2, Parent = b })
		UiKit.bevel(well, true)
		UiKit.text("mono", {
			Text = r.pattern,
			TextSize = 20,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			ZIndex = z + 4,
			Parent = well,
		})
		if hinted then
			hintMark(b, UDim2.new(1, -(48 + S.s), 0.5, 0), z + 4)
		end
	end
	refocus(root, focus, "Record1")
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="182">
            <Properties>
              <string name="Name">FileSort</string>
              <string name="Source"><![CDATA[--!strict
-- FILE SORTING view: numbered rules on the left, a details-view file list
-- and the PURGE / KEEP bins under it. Click a file, then a bin (no dragging).

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local C = UiKit.C
local S = UiKit.SPACE
local DIM = UiKit.C.textDim -- secondary text, 5:1 on the face

local RULES_W = 188
local BIN_H = 44
local HEAD_H = 20

type Col = { title: string, x: number, w: number }
-- details-view columns, x relative to the row
local MARK: Col = { title = "", x = 4, w = 12 }
local COLS: { Col } = {
	{ title = "NAME", x = 18, w = 150 },
	{ title = "YEAR", x = 172, w = 40 },
	{ title = "DEPT", x = 216, w = 92 },
	{ title = "TAG", x = 312, w = 104 },
}

local View = {}
local selected: number? = nil
local lastKey = ""

-- Gamepad: every update rebuilds the view, so focus moves to the control
-- that replaces the one that had it.
local function focusName(root: Instance): string?
	local sel = GuiService.SelectedObject
	return if sel and sel:IsDescendantOf(root) then sel.Name else nil
end

local function refocus(root: Instance, name: string?, first: string?)
	local b = if name then root:FindFirstChild(name, true) else nil
	-- a stage change clears the area and drops focus: a pad user gets `first`
	if not b and first and GuiService.SelectedObject == nil and string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
		b = root:FindFirstChild(first, true)
	end
	if b and b:IsA("GuiObject") then
		GuiService.SelectedObject = b
	end
end

-- Rule text with its leading verb (PURGE / KEEP / EXCEPTION:) in bold.
local function richRule(i: number, text: string): string
	local safe = string.gsub(text, "&", "&amp;")
	safe = string.gsub(safe, "<", "&lt;")
	safe = string.gsub(safe, ">", "&gt;")
	safe = string.gsub(safe, "^(%u+:?)", "<b>%1</b>")
	return string.format("<b>%d.</b> %s", i, safe)
end

local function rulesPanel(root: Frame, rules: { string }, h: number, z: number)
	local panel = UiKit.frame({ Name = "Rules", Size = UDim2.fromOffset(RULES_W, h), BackgroundColor3 = C.field, ZIndex = z, Parent = root })
	UiKit.bevel(panel, true)
	UiKit.text("title", { Text = "RULES", Size = UDim2.new(1, -2 * S.s, 0, 18), Position = UDim2.fromOffset(S.s, S.s), TextWrapped = false, ZIndex = z + 2, Parent = panel })
	UiKit.text("caption", {
		Text = "First matching rule wins.",
		Size = UDim2.new(1, -2 * S.s, 0, 18),
		Position = UDim2.fromOffset(S.s, S.s + 18),
		TextColor3 = DIM,
		ZIndex = z + 2,
		Parent = panel,
	})
	local list = UiKit.frame({ Name = "List", Size = UDim2.new(1, -2 * S.s, 1, -(S.s + 44)), Position = UDim2.fromOffset(S.s, S.s + 42), BackgroundTransparency = 1, ZIndex = z + 2, Parent = panel })
	UiKit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, S.s), Parent = list })
	for i, r in rules do
		UiKit.text("body", {
			Name = "Rule" .. i,
			Text = richRule(i, r),
			RichText = true,
			TextSize = 14,
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = i,
			ZIndex = z + 2,
			Parent = list,
		})
	end
end

-- Flat list row. UiKit's hover tint is invisible on the white field, so the
-- row gets its own grey wash.
local function row(parent: Instance, name: string, y: number, h: number, isSel: boolean, z: number, onClick: () -> ()): TextButton
	local b = UiKit.button({
		name = name,
		text = "",
		size = UDim2.new(1, 0, 0, h),
		position = UDim2.fromOffset(0, y),
		parent = parent,
		color = if isSel then C.select else C.field,
		bevel = false,
		zindex = z,
		onClick = onClick,
	})
	local wash = UiKit.frame({ Name = "Hover", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.face, BackgroundTransparency = 0.35, Visible = false, ZIndex = z + 1, Parent = b })
	b.MouseEnter:Connect(function()
		wash.Visible = b.Active and not isSel
	end)
	b.MouseLeave:Connect(function()
		wash.Visible = false
	end)
	return b
end

local function cell(parent: Instance, c: Col, text: string, ink: Color3, z: number): TextLabel
	return UiKit.text("mono", {
		Text = text,
		TextSize = 14,
		Size = UDim2.new(0, c.w, 1, 0),
		Position = UDim2.fromOffset(c.x, 0),
		TextColor3 = ink,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = z,
		Parent = parent,
	})
end

function View.render(root: Frame, v: { [string]: any }, api: { act: (string, any, any) -> () }, z: number)
	local focus = focusName(root)
	UiKit.clear(root)
	local w = if root.Size.X.Offset > 0 then root.Size.X.Offset else 620
	local h = if root.Size.Y.Offset > 0 then root.Size.Y.Offset else 250
	local files = v.files :: { any }
	-- a new stage drops the old selection
	local names = {}
	for _, f in files do
		table.insert(names, f.name)
	end
	local key = table.concat((v.rules :: { string }), "|") .. "#" .. table.concat(names, "|")
	if key ~= lastKey then
		selected = nil
		lastKey = key
	end
	-- and a file the server has since sorted cannot stay selected
	local selName: string? = nil
	local firstOpen: string? = nil
	local done = 0
	for _, f in files do
		if f.bin ~= nil then
			done += 1
		else
			firstOpen = firstOpen or "File" .. tostring(f.id)
			if f.id == selected then
				selName = f.name
			end
		end
	end
	if not selName then
		selected = nil
	end

	rulesPanel(root, v.rules, h, z)

	-- file list (details view)
	local fx = RULES_W + S.s
	local fw = w - fx
	UiKit.text("title", { Text = "FILES", Size = UDim2.fromOffset(80, 18), Position = UDim2.fromOffset(fx, 0), TextWrapped = false, ZIndex = z, Parent = root })
	UiKit.text("caption", {
		Text = if selName then "Selected: " .. selName else string.format("%d of %d sorted", done, #files),
		Size = UDim2.fromOffset(fw - 80, 18),
		Position = UDim2.fromOffset(fx + 80, 0),
		TextColor3 = if selName then C.text else DIM,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = z,
		Parent = root,
	})
	local listH = h - 20 - BIN_H - S.s
	local well = UiKit.frame({ Name = "FileList", Size = UDim2.fromOffset(fw, listH), Position = UDim2.fromOffset(fx, 20), BackgroundColor3 = C.field, ZIndex = z, Parent = root })
	UiKit.bevel(well, true)
	local inner = UiKit.frame({ Name = "Rows", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 2, Parent = well })
	local strip = UiKit.frame({ Name = "Columns", Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundColor3 = C.face, ZIndex = z + 2, Parent = inner })
	UiKit.bevel(strip)
	for _, c in COLS do
		UiKit.text("caption", { Text = c.title, Font = UiKit.FONT_BOLD, TextSize = 13, Size = UDim2.new(0, c.w, 1, 0), Position = UDim2.fromOffset(c.x, 0), TextWrapped = false, ZIndex = z + 4, Parent = strip })
	end
	local rowH = math.min(28, math.floor((listH - 4 - HEAD_H) / math.max(1, #files)))
	for i, f in files do
		local sorted = f.bin ~= nil
		local isSel = selected == f.id
		local hinted = v.highlight == f.id
		local b = row(inner, "File" .. tostring(f.id), HEAD_H + (i - 1) * rowH, rowH, isSel, z + 2, function()
			if not sorted then
				selected = f.id
				View.render(root, v, api, z) -- local re-render for selection
			end
		end)
		-- state is spelled out: > selected, ! hinted, bin name once sorted
		local ink = if isSel then C.white elseif sorted then DIM else C.text
		cell(b, MARK, if isSel then ">" elseif hinted then "!" else "", ink, z + 4)
		cell(b, COLS[1], f.name, ink, z + 4)
		cell(b, COLS[2], tostring(f.year), ink, z + 4)
		cell(b, COLS[3], f.dept, ink, z + 4)
		local status = if sorted then (if f.bin == "purge" then "PURGED" else "KEPT") elseif f.tag ~= "" then f.tag else "-"
		cell(b, COLS[4], status, ink, z + 4)
		if hinted then
			local edge = UiKit.frame({ Name = "HintEdge", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 5, Parent = b })
			UiKit.stroke(edge, C.warn, 0, 2)
		end
		UiKit.setEnabled(b, not sorted)
	end

	-- bins: greyed out until a file is selected
	local bw = math.floor((fw - S.s) / 2)
	local function bin(name: string, label: string, target: string, color: Color3, x: number)
		local on = selected ~= nil
		local b = UiKit.button({
			name = name,
			text = label,
			size = UDim2.fromOffset(bw, BIN_H),
			position = UDim2.fromOffset(x, h - BIN_H),
			parent = root,
			color = if on then color else C.face,
			textColor = if on then C.white else C.text,
			zindex = z,
			onClick = function()
				if selected then
					local id = selected
					selected = nil
					api.act("sort", id, target)
				end
			end,
		})
		UiKit.setEnabled(b, on)
	end
	bin("BinPurge", "PURGE  (delete)", "purge", C.bad, fx)
	bin("BinKeep", "KEEP  (archive)", "keep", C.good, fx + bw + S.s)
	refocus(root, focus, firstOpen)
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="183">
            <Properties>
              <string name="Name">MemorySequence</string>
              <string name="Source"><![CDATA[--!strict
-- MEMORY SEQUENCE view: plays the server's sequence whenever playId changes,
-- then accepts clicks. REPLAY restarts input (the small cost). A lit block
-- turns dark with an amber label and edge: a strong change in brightness and
-- shape, not just hue.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local C = UiKit.C
local S = UiKit.SPACE
local DIM = UiKit.C.textDim -- secondary text, 5:1 on the face

local SCREEN = Color3.fromRGB(30, 36, 40) -- dark status readout
local PHOSPHOR = Color3.fromRGB(170, 214, 176)
local CELL = 70
local PANEL_W = 220

local LABELS = { "TL", "T", "TR", "L", "C", "R", "BL", "B", "BR" }

local View = {}
local lastPlay = -1
local lastSeqKey = ""
local playing = false
local playToken = 0
local litNow: number? = nil -- block lit by playback right now
local cells: { TextButton } = {}
-- the latest render's status widgets, so playback can update them even
-- after a re-render replaced the ones it started with
local statusLabel: TextLabel? = nil
local replayButton: TextButton? = nil

-- Gamepad: every update rebuilds the view, so focus moves to the control
-- that replaces the one that had it.
local function focusName(root: Instance): string?
	local sel = GuiService.SelectedObject
	return if sel and sel:IsDescendantOf(root) then sel.Name else nil
end

local function refocus(root: Instance, name: string?, first: string?)
	local b = if name then root:FindFirstChild(name, true) else nil
	-- a stage change clears the area and drops focus: a pad user gets `first`
	if not b and first and GuiService.SelectedObject == nil and string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
		b = root:FindFirstChild(first, true)
	end
	if b and b:IsA("GuiObject") then
		GuiService.SelectedObject = b
	end
end

local function flash(b: TextButton?, on: boolean)
	local lit = if b then b:FindFirstChild("Lit") else nil
	if lit and lit:IsA("GuiObject") then
		lit.Visible = on
	end
end

local function showState()
	local st = statusLabel
	if st then
		st.Text = if playing then "WATCH" else "YOUR TURN"
		st.TextColor3 = if playing then C.amber else PHOSPHOR
	end
	local rb = replayButton
	if rb then
		UiKit.setEnabled(rb, not playing)
	end
end

function View.render(root: Frame, v: { [string]: any }, api: { act: (string, any, any) -> () }, z: number)
	local focus = focusName(root)
	UiKit.clear(root)
	cells = {}
	local w = if root.Size.X.Offset > 0 then root.Size.X.Offset else 620
	local h = if root.Size.Y.Offset > 0 then root.Size.Y.Offset else 250
	local gridW = 3 * CELL + 2 * S.s
	local trayW = gridW + 2 * S.s
	local x0 = (w - (trayW + S.xl + PANEL_W)) // 2
	local y0 = (h - trayW) // 2

	-- the nine blocks sit in a sunken tray
	local tray = UiKit.frame({ Name = "Blocks", Size = UDim2.fromOffset(trayW, trayW), Position = UDim2.fromOffset(x0, y0), BackgroundColor3 = C.faceDark, ZIndex = z, Parent = root })
	UiKit.bevel(tray, true)
	for i = 1, 9 do
		local col = (i - 1) % 3
		local rowN = (i - 1) // 3
		local b = UiKit.button({
			name = "Block" .. i,
			text = LABELS[i],
			size = UDim2.fromOffset(CELL, CELL),
			position = UDim2.fromOffset(S.s + col * (CELL + S.s), S.s + rowN * (CELL + S.s)),
			parent = tray,
			font = UiKit.FONT_PIXEL,
			textSize = 16,
			zindex = z + 2,
			onClick = function()
				if not playing then
					flash(cells[i], true)
					task.delay(0.15, function()
						flash(cells[i], false)
					end)
					api.act("press", i, nil)
				end
			end,
		})
		local lit = UiKit.frame({ Name = "Lit", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = C.select, Visible = playing and litNow == i, ZIndex = z + 6, Parent = b })
		UiKit.stroke(lit, C.amber, 0, 2)
		UiKit.text("title", { Text = LABELS[i], Size = UDim2.fromScale(1, 1), TextColor3 = C.amber, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = z + 7, Parent = lit })
		if v.highlight == i then
			-- hint: amber edge plus a HINT tag under the label
			local edge = UiKit.frame({ Name = "HintEdge", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 4, Parent = b })
			UiKit.stroke(edge, C.warn, 0, 2)
			UiKit.text("title", {
				Name = "HintTag",
				Text = "HINT",
				Size = UDim2.fromOffset(48, 18),
				Position = UDim2.new(0.5, -24, 1, -24),
				BackgroundTransparency = 0,
				BackgroundColor3 = C.amber,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false,
				ZIndex = z + 4,
				Parent = b,
			})
		end
		cells[i] = b
	end

	-- status panel: readout, input count, replay
	local px = x0 + trayW + S.xl
	local py = y0
	UiKit.text("title", { Text = "STATUS", Size = UDim2.fromOffset(PANEL_W, 18), Position = UDim2.fromOffset(px, py), TextWrapped = false, ZIndex = z, Parent = root })
	local screen = UiKit.frame({ Name = "Status", Size = UDim2.fromOffset(PANEL_W, 40), Position = UDim2.fromOffset(px, py + 20), BackgroundColor3 = SCREEN, ZIndex = z, Parent = root })
	UiKit.bevel(screen, true)
	statusLabel = UiKit.text("title", { Name = "State", Text = "", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = z + 2, Parent = screen })
	UiKit.text("title", { Text = "INPUT", Size = UDim2.fromOffset(120, 18), Position = UDim2.fromOffset(px, py + 72), TextWrapped = false, ZIndex = z, Parent = root })
	UiKit.text("mono", {
		Text = string.format("%d / %d", v.input, v.length),
		Size = UDim2.fromOffset(80, 18),
		Position = UDim2.fromOffset(px + PANEL_W - 80, py + 72),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = z,
		Parent = root,
	})
	local len = math.max(1, v.length)
	local pw = math.floor((PANEL_W - (len - 1) * S.xs) / len)
	for i = 1, len do
		local done = i <= v.input
		local pip = UiKit.frame({ Size = UDim2.fromOffset(pw, 12), Position = UDim2.fromOffset(px + (i - 1) * (pw + S.xs), py + 94), BackgroundColor3 = if done then C.good else C.field, ZIndex = z, Parent = root })
		UiKit.bevel(pip, not done)
	end
	replayButton = UiKit.button({
		name = "Replay",
		text = "Replay sequence",
		size = UDim2.fromOffset(PANEL_W, 40),
		position = UDim2.fromOffset(px, py + 122),
		parent = root,
		zindex = z,
		onClick = function()
			if not playing then
				api.act("replay", nil, nil)
			end
		end,
	})
	UiKit.text("caption", {
		Text = "Replaying restarts your input.",
		Size = UDim2.fromOffset(PANEL_W, 18),
		Position = UDim2.fromOffset(px, py + 168),
		TextColor3 = DIM,
		ZIndex = z,
		Parent = root,
	})
	UiKit.text("caption", {
		Text = "Replays used: " .. tostring(v.replays),
		Size = UDim2.fromOffset(PANEL_W, 18),
		Position = UDim2.fromOffset(px, py + 188),
		TextColor3 = DIM,
		ZIndex = z,
		Parent = root,
	})

	-- playback when the server bumps playId or a new sequence arrives
	local seqKey = table.concat(v.seq, ",")
	if v.playId ~= lastPlay or seqKey ~= lastSeqKey then
		lastPlay = v.playId
		lastSeqKey = seqKey
		playToken += 1
		local my = playToken
		local seq = v.seq :: { number }
		local slow = v.highlight ~= nil
		playing = true
		task.spawn(function()
			task.wait(0.6)
			for _, idx in seq do
				if my ~= playToken then
					return
				end
				litNow = idx
				flash(cells[idx], true)
				UiKit.click()
				task.wait(if slow then 0.75 else 0.5)
				litNow = nil
				flash(cells[idx], false)
				task.wait(0.18)
			end
			if my == playToken then
				playing = false
				showState()
			end
		end)
	end
	showState()
	refocus(root, focus, "Block1")
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="184">
            <Properties>
              <string name="Name">ProcessCleanup</string>
              <string name="Source"><![CDATA[--!strict
-- PROCESS CLEANUP view: rules, a task-manager style process list, file
-- groups that unlock when the right processes are ended. Every state is
-- spelled out (> selected, x ended, LOCKED / DELETE / DELETED), not only
-- coloured.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local C = UiKit.C
local S = UiKit.SPACE
local DIM = UiKit.C.textDim -- secondary text, 5:1 on the face

local RULES_W = 172
local TABLE_W = 300
local END_H = 40
local HEAD_H = 20

type Col = { title: string, x: number, w: number, right: boolean? }
-- task-manager columns, x relative to the row
local MARK: Col = { title = "", x = 4, w = 12 }
local PID: Col = { title = "PID", x = 18, w = 36 }
local NAME: Col = { title = "NAME", x = 58, w = 128 }
local OWNER: Col = { title = "OWNER", x = 190, w = 64 }
local CPU: Col = { title = "CPU", x = 256, w = 34, right = true }

local View = {}
local selected: number? = nil

-- Gamepad: every update rebuilds the view, so focus moves to the control
-- that replaces the one that had it.
local function focusName(root: Instance): string?
	local sel = GuiService.SelectedObject
	return if sel and sel:IsDescendantOf(root) then sel.Name else nil
end

local function refocus(root: Instance, name: string?, first: string?)
	local b = if name then root:FindFirstChild(name, true) else nil
	-- a stage change clears the area and drops focus: a pad user gets `first`
	if not b and first and GuiService.SelectedObject == nil and string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
		b = root:FindFirstChild(first, true)
	end
	if b and b:IsA("GuiObject") then
		GuiService.SelectedObject = b
	end
end

local function escape(text: string): string
	local s = string.gsub(text, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	return s
end

local function rulesPanel(root: Frame, rules: { string }, h: number, z: number)
	local panel = UiKit.frame({ Name = "Rules", Size = UDim2.fromOffset(RULES_W, h), BackgroundColor3 = C.field, ZIndex = z, Parent = root })
	UiKit.bevel(panel, true)
	UiKit.text("title", { Text = "RULES", Size = UDim2.new(1, -2 * S.s, 0, 18), Position = UDim2.fromOffset(S.s, S.s), TextWrapped = false, ZIndex = z + 2, Parent = panel })
	local list = UiKit.frame({ Name = "List", Size = UDim2.new(1, -2 * S.s, 1, -(S.s + 30)), Position = UDim2.fromOffset(S.s, S.s + 24), BackgroundTransparency = 1, ZIndex = z + 2, Parent = panel })
	UiKit.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, S.s), Parent = list })
	for i, r in rules do
		-- leading verb (END / NEVER) in bold
		local text = string.gsub(escape(r), "^(%u+)", "<b>%1</b>")
		UiKit.text("body", {
			Name = "Rule" .. i,
			Text = text,
			RichText = true,
			TextSize = 14,
			Size = UDim2.fromScale(1, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = i,
			ZIndex = z + 2,
			Parent = list,
		})
	end
end

local function cell(parent: Instance, c: Col, text: string, ink: Color3, z: number, rich: boolean?): TextLabel
	return UiKit.text("mono", {
		Text = text,
		TextSize = 14,
		RichText = rich == true,
		Size = UDim2.new(0, c.w, 1, 0),
		Position = UDim2.fromOffset(c.x, 0),
		TextColor3 = ink,
		TextXAlignment = if c.right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = z,
		Parent = parent,
	})
end

function View.render(root: Frame, v: { [string]: any }, api: { act: (string, any, any) -> () }, z: number)
	local focus = focusName(root)
	UiKit.clear(root)
	local w = if root.Size.X.Offset > 0 then root.Size.X.Offset else 620
	local h = if root.Size.Y.Offset > 0 then root.Size.Y.Offset else 250
	local procs = v.procs :: { any }
	-- a selection that ended or left the list (new stage) is dropped
	local selName: string? = nil
	for _, p in procs do
		if p.pid == selected and not p.ended then
			selName = string.format("%d  %s", p.pid, p.name) -- names repeat, PIDs do not
		end
	end
	if not selName then
		selected = nil
	end

	rulesPanel(root, v.rules, h, z)

	-- process table
	local tx = RULES_W + S.s
	local running = 0
	local firstOpen: string? = nil
	for _, p in procs do
		if not p.ended then
			running += 1
			firstOpen = firstOpen or "Proc" .. tostring(p.pid)
		end
	end
	UiKit.text("title", { Text = "PROCESSES", Size = UDim2.fromOffset(140, 18), Position = UDim2.fromOffset(tx, 0), TextWrapped = false, ZIndex = z, Parent = root })
	UiKit.text("caption", {
		Text = string.format("%d running", running),
		Size = UDim2.fromOffset(TABLE_W - 140, 18),
		Position = UDim2.fromOffset(tx + 140, 0),
		TextColor3 = DIM,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = z,
		Parent = root,
	})
	local listH = h - 20 - END_H - S.s
	local well = UiKit.frame({ Name = "ProcessList", Size = UDim2.fromOffset(TABLE_W, listH), Position = UDim2.fromOffset(tx, 20), BackgroundColor3 = C.field, ZIndex = z, Parent = root })
	UiKit.bevel(well, true)
	local inner = UiKit.frame({ Name = "Rows", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 2, Parent = well })
	local strip = UiKit.frame({ Name = "Columns", Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundColor3 = C.face, ZIndex = z + 2, Parent = inner })
	UiKit.bevel(strip)
	for _, c in { PID, NAME, OWNER, CPU } do
		UiKit.text("caption", {
			Text = c.title,
			Font = UiKit.FONT_BOLD,
			TextSize = 13,
			Size = UDim2.new(0, c.w, 1, 0),
			Position = UDim2.fromOffset(c.x, 0),
			TextXAlignment = if c.right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left,
			TextWrapped = false,
			ZIndex = z + 4,
			Parent = strip,
		})
	end
	local rowH = math.min(26, math.floor((listH - 4 - HEAD_H) / math.max(1, #procs)))
	for i, p in procs do
		local isSel = selected == p.pid
		local b = UiKit.button({
			name = "Proc" .. tostring(p.pid),
			text = "",
			size = UDim2.new(1, 0, 0, rowH),
			position = UDim2.fromOffset(0, HEAD_H + (i - 1) * rowH),
			parent = inner,
			color = if isSel then C.select else C.field,
			bevel = false,
			zindex = z + 2,
			onClick = function()
				if not p.ended then
					selected = p.pid
					View.render(root, v, api, z)
				end
			end,
		})
		-- UiKit's hover tint is invisible on the white field: grey wash instead
		local wash = UiKit.frame({ Name = "Hover", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.face, BackgroundTransparency = 0.35, Visible = false, ZIndex = z + 3, Parent = b })
		b.MouseEnter:Connect(function()
			wash.Visible = b.Active and not isSel
		end)
		b.MouseLeave:Connect(function()
			wash.Visible = false
		end)
		local ink = if isSel then C.white elseif p.ended then DIM else C.text
		local hinted = v.highlight == p.pid
		cell(b, MARK, if isSel then ">" elseif p.ended then "x" elseif hinted then "!" else "", ink, z + 4)
		cell(b, PID, tostring(p.pid), ink, z + 4)
		cell(b, NAME, if p.ended then "<s>" .. escape(p.name) .. "</s>" else escape(p.name), ink, z + 4, true)
		cell(b, OWNER, p.owner, ink, z + 4)
		cell(b, CPU, if p.ended then "--" else string.format("%d%%", p.cpu), ink, z + 4)
		if hinted then
			local edge = UiKit.frame({ Name = "HintEdge", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 5, Parent = b })
			UiKit.stroke(edge, C.warn, 0, 2)
		end
		if p.ended then
			UiKit.setEnabled(b, false)
		end
	end
	local endBtn = UiKit.button({
		name = "EndProcess",
		text = if selName then "END " .. selName else "END PROCESS",
		size = UDim2.fromOffset(TABLE_W, END_H),
		position = UDim2.fromOffset(tx, h - END_H),
		parent = root,
		color = if selName then C.bad else C.face,
		textColor = if selName then C.white else C.text,
		zindex = z,
		onClick = function()
			if selected then
				local pid = selected
				selected = nil
				api.act("kill", pid, nil)
			end
		end,
	})
	UiKit.setEnabled(endBtn, selected ~= nil)

	-- file groups: LOCKED until a matching process ends, then DELETE
	local gx = tx + TABLE_W + S.s
	local gw = w - gx
	UiKit.text("title", { Text = "GROUPS", Size = UDim2.fromOffset(gw, 18), Position = UDim2.fromOffset(gx, 0), TextWrapped = false, ZIndex = z, Parent = root })
	local groups = v.groups :: { any }
	local gh = math.min(64, math.floor((h - 20 - (#groups - 1) * S.s) / math.max(1, #groups)))
	for i, g in groups do
		local open = g.unlocked and not g.deleted
		local b = UiKit.button({
			name = "Group" .. i,
			text = "",
			size = UDim2.fromOffset(gw, gh),
			position = UDim2.fromOffset(gx, 20 + (i - 1) * (gh + S.s)),
			parent = root,
			color = if open then C.amber else C.face,
			zindex = z,
			onClick = function()
				api.act("purge", i, nil)
			end,
		})
		local ink = if open then C.text else DIM
		UiKit.text("mono", {
			Text = if g.deleted then "<s>" .. escape(g.name) .. "</s>" else escape(g.name),
			RichText = true,
			TextSize = 14,
			Size = UDim2.new(1, -2 * S.s, 0, 18),
			Position = UDim2.fromOffset(S.s, S.s),
			TextColor3 = ink,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = z + 2,
			Parent = b,
		})
		UiKit.text("title", {
			Text = if g.deleted then "DELETED" elseif g.unlocked then "DELETE" else "LOCKED",
			Size = UDim2.new(1, -2 * S.s, 0, 18),
			Position = UDim2.new(0, S.s, 1, -(S.s + 18)),
			TextColor3 = ink,
			TextWrapped = false,
			ZIndex = z + 2,
			Parent = b,
		})
		UiKit.setEnabled(b, open)
	end
	refocus(root, focus, firstOpen)
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="185">
            <Properties>
              <string name="Name">SectorRepair</string>
              <string name="Source"><![CDATA[--!strict
-- SECTOR REPAIR view: TARGET ORDER on top, current slots below. Click two
-- slots to swap them. Sectors show number+letter AND colour; slot state is
-- spelled out (OK / SWAP / HINT) rather than coloured.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local C = UiKit.C
local S = UiKit.SPACE
local DIM = UiKit.C.textDim -- secondary text, 5:1 on the face

local SWATCH: { [string]: Color3 } = {
	amber = Color3.fromRGB(222, 160, 58),
	teal = Color3.fromRGB(52, 160, 160),
	rose = Color3.fromRGB(206, 96, 120),
	lime = Color3.fromRGB(136, 188, 70),
	violet = Color3.fromRGB(136, 96, 188),
	sky = Color3.fromRGB(86, 146, 214),
	sand = Color3.fromRGB(204, 186, 140),
	slate = Color3.fromRGB(110, 120, 136),
}

local TARGET_H = 52
local SLOT_H = 100

local View = {}
local first: number? = nil
local lastKey = ""

-- Gamepad: every update rebuilds the view, so focus moves to the control
-- that replaces the one that had it.
local function focusName(root: Instance): string?
	local sel = GuiService.SelectedObject
	return if sel and sel:IsDescendantOf(root) then sel.Name else nil
end

local function refocus(root: Instance, name: string?, first: string?)
	local b = if name then root:FindFirstChild(name, true) else nil
	-- a stage change clears the area and drops focus: a pad user gets `first`
	if not b and first and GuiService.SelectedObject == nil and string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
		b = root:FindFirstChild(first, true)
	end
	if b and b:IsA("GuiObject") then
		GuiService.SelectedObject = b
	end
end

-- colour bar + mono label, shared by the target cells and the slots
local function sector(parent: Instance, s: { label: string, color: string }, labelY: number, labelSize: number, ink: Color3, z: number)
	UiKit.frame({ Name = "Swatch", Size = UDim2.new(1, -12, 0, 10), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = SWATCH[s.color] or C.faceDark, ZIndex = z, Parent = parent })
	UiKit.text("mono", {
		Text = s.label,
		TextSize = labelSize,
		Size = UDim2.new(1, 0, 0, labelSize + 6),
		Position = UDim2.fromOffset(0, labelY),
		TextColor3 = ink,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		ZIndex = z,
		Parent = parent,
	})
end

function View.render(root: Frame, v: { [string]: any }, api: { act: (string, any, any) -> () }, z: number)
	local focus = focusName(root)
	UiKit.clear(root)
	local w = if root.Size.X.Offset > 0 then root.Size.X.Offset else 620
	local h = if root.Size.Y.Offset > 0 then root.Size.Y.Offset else 250
	local n = #v.target
	-- a new stage (new target order) drops a half-made swap
	local labels = {}
	for i, s in v.target do
		labels[i] = s.label
	end
	local key = table.concat(labels, ",")
	if key ~= lastKey or (first and first > #v.current) then
		first = nil
		lastKey = key
	end
	local cw = math.min(92, math.floor((w - 20) / math.max(1, n)) - S.s)
	local x0 = (w - (n * (cw + S.s) - S.s)) // 2
	local y0 = math.max(0, (h - (20 + TARGET_H + 26 + 24 + SLOT_H)) // 2)

	-- target order: sunken read-only cells with slot numbers under them
	UiKit.text("title", { Text = "TARGET ORDER", Size = UDim2.fromOffset(200, 18), Position = UDim2.fromOffset(x0, y0), TextWrapped = false, ZIndex = z, Parent = root })
	for i, s in v.target do
		local x = x0 + (i - 1) * (cw + S.s)
		local f = UiKit.frame({ Name = "Target" .. i, Size = UDim2.fromOffset(cw, TARGET_H), Position = UDim2.fromOffset(x, y0 + 20), BackgroundColor3 = C.field, ZIndex = z, Parent = root })
		UiKit.bevel(f, true)
		sector(f, s, 20, 20, C.text, z + 2)
		UiKit.text("mono", {
			Text = "SLOT " .. i,
			TextSize = 14,
			Size = UDim2.fromOffset(cw, 18),
			Position = UDim2.fromOffset(x, y0 + 20 + TARGET_H + S.xs),
			TextColor3 = DIM,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			ZIndex = z,
			Parent = root,
		})
	end

	-- drive sectors: raised slot buttons
	local sy = y0 + 20 + TARGET_H + 26
	UiKit.text("title", { Text = "DRIVE SECTORS", Size = UDim2.fromOffset(160, 18), Position = UDim2.fromOffset(x0, sy), TextWrapped = false, ZIndex = z, Parent = root })
	UiKit.text("caption", {
		Text = if first then string.format("Slot %d selected. Pick the slot to swap it with.", first) else "Select two slots to swap them.",
		Size = UDim2.fromOffset(math.max(0, w - (x0 + 168)), 18),
		Position = UDim2.fromOffset(x0 + 168, sy),
		TextColor3 = if first then C.text else DIM,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = z,
		Parent = root,
	})
	local hl = v.highlight
	for i, s in v.current do
		local isFirst = first == i
		local hinted = typeof(hl) == "table" and (hl[1] == i or hl[2] == i)
		local b = UiKit.button({
			name = "Slot" .. i,
			text = "",
			size = UDim2.fromOffset(cw, SLOT_H),
			position = UDim2.fromOffset(x0 + (i - 1) * (cw + S.s), sy + 24),
			parent = root,
			color = if isFirst then C.select else C.face,
			zindex = z,
			onClick = function()
				if first == nil then
					first = i
					View.render(root, v, api, z)
				elseif first == i then
					first = nil
					View.render(root, v, api, z)
				else
					local a = first
					first = nil
					api.act("swap", a, i)
				end
			end,
		})
		sector(b, s, 24, 22, if isFirst then C.white else C.text, z + 2)
		-- status line: SWAP (picked), HINT, OK (aligned)
		local status = if isFirst then "SWAP" elseif hinted then "HINT" elseif s.ok then "OK" else ""
		UiKit.text("title", {
			Name = "State",
			Text = status,
			Size = UDim2.fromOffset(52, 18),
			Position = UDim2.new(0.5, -26, 1, -(S.s + 20)),
			BackgroundTransparency = if hinted and not isFirst then 0 else 1,
			BackgroundColor3 = C.amber,
			TextColor3 = if isFirst then C.amber elseif s.ok and not hinted then C.good else C.text,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			ZIndex = z + 3,
			Parent = b,
		})
		if hinted then
			local edge = UiKit.frame({ Name = "HintEdge", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 3, Parent = b })
			UiKit.stroke(edge, C.warn, 0, 2)
		end
	end
	refocus(root, focus, "Slot1")
end

function View.reset()
	first = nil
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="186">
            <Properties>
              <string name="Name">SignalRouting</string>
              <string name="Source"><![CDATA[--!strict
-- SIGNAL ROUTING view: click tiles to rotate. Tiles sit on a dark board and
-- draw their connectors as bars; lit tiles carry the purge signal from IN to
-- OUT. Lit wires are amber AND thicker with a large node, so the path also
-- reads by shape and brightness.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent.Parent.Ui.UiKit)
local C = UiKit.C
local S = UiKit.SPACE

local BOARD = Color3.fromRGB(30, 36, 40)
local TILE = Color3.fromRGB(52, 60, 66)
local TILE_LIT = Color3.fromRGB(70, 64, 50)
local WIRE = Color3.fromRGB(112, 124, 132)
local GLOW = Color3.fromRGB(226, 186, 116)
local PAD = 6 -- board margin around the tiles
local LABEL_W = 60 -- IN / OUT label
local PORT = 80 -- room beside the board for the label and its stub wire

local BASE: { [string]: { number } } = { I = { 1, 3 }, L = { 1, 2 }, T = { 1, 2, 3 } }

local View = {}

-- Gamepad: every update rebuilds the view, so focus moves to the control
-- that replaces the one that had it (rotating a tile keeps it focused).
local function focusName(root: Instance): string?
	local sel = GuiService.SelectedObject
	return if sel and sel:IsDescendantOf(root) then sel.Name else nil
end

local function refocus(root: Instance, name: string?, first: string?)
	local b = if name then root:FindFirstChild(name, true) else nil
	-- a stage change clears the area and drops focus: a pad user gets `first`
	if not b and first and GuiService.SelectedObject == nil and string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
		b = root:FindFirstChild(first, true)
	end
	if b and b:IsA("GuiObject") then
		GuiService.SelectedObject = b
	end
end

local function dirs(kind: string, rot: number): { [number]: boolean }
	local out = {}
	local base: { number } = BASE[kind] or {}
	for _, d in base do
		out[(d - 1 + rot) % 4 + 1] = true
	end
	return out
end

function View.render(root: Frame, v: { [string]: any }, api: { act: (string, any, any) -> () }, z: number)
	local focus = focusName(root)
	UiKit.clear(root)
	local w = if root.Size.X.Offset > 0 then root.Size.X.Offset else 620
	local h = if root.Size.Y.Offset > 0 then root.Size.Y.Offset else 250
	local gw, gh = v.w, v.h
	local size = math.min(math.floor((h - 2 * PAD + 2) / gh), math.floor((w - 2 * (PAD + PORT)) / gw), 60)
	local inner = size - 2 -- tiles keep a 2 px gap
	local gx = (w - (gw * size - 2)) // 2
	local gy = (h - (gh * size - 2)) // 2
	local thin = math.max(4, size // 8)
	local thick = math.max(6, size // 5)
	local half = inner // 2

	local board = UiKit.frame({
		Name = "Board",
		Size = UDim2.fromOffset(gw * size - 2 + 2 * PAD, gh * size - 2 + 2 * PAD),
		Position = UDim2.fromOffset(gx - PAD, gy - PAD),
		BackgroundColor3 = BOARD,
		ZIndex = z,
		Parent = root,
	})
	UiKit.bevel(board, true)

	-- IN / OUT ports: a label and a stub wire that lights with its tile
	local function port(text: string, row: number, left: boolean, lit: boolean)
		local y = gy + (row - 1) * size + half
		local wireW = PAD + S.l
		local band = if lit then thick else thin
		UiKit.frame({
			Name = text .. "Wire",
			Size = UDim2.fromOffset(wireW, band),
			Position = UDim2.fromOffset(if left then gx - wireW else gx + gw * size - 2, y - band // 2),
			BackgroundColor3 = if lit then GLOW else WIRE,
			ZIndex = z + 3,
			Parent = root,
		})
		UiKit.text("title", {
			Name = text .. "Label",
			Text = if left then text .. " >" else "> " .. text,
			Size = UDim2.fromOffset(LABEL_W, 18),
			Position = UDim2.fromOffset(if left then gx - wireW - S.xs - LABEL_W else gx + gw * size - 2 + wireW + S.xs, y - 9),
			TextXAlignment = if left then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left,
			TextWrapped = false,
			ZIndex = z,
			Parent = root,
		})
	end
	local inTile = v.tiles[(v.inRow - 1) * gw + 1]
	local outTile = v.tiles[v.outRow * gw]
	port("IN", v.inRow, true, inTile ~= nil and inTile.lit == true)
	port("OUT", v.outRow, false, outTile ~= nil and outTile.lit == true and dirs(outTile.kind, outTile.rot)[2] == true)

	for y = 1, gh do
		for x = 1, gw do
			local i = (y - 1) * gw + x
			local t = v.tiles[i]
			local lit = t.lit == true
			local b = UiKit.button({
				name = "Tile" .. i,
				text = "",
				size = UDim2.fromOffset(inner, inner),
				position = UDim2.fromOffset(gx + (x - 1) * size, gy + (y - 1) * size),
				parent = root,
				color = if lit then TILE_LIT else TILE,
				zindex = z + 2,
				bevel = false,
				onClick = function()
					api.act("rotate", i, nil)
				end,
			})
			local bar = if lit then thick else thin
			local ink = if lit then GLOW else WIRE
			local node = if lit then thick + 6 else thin + 2
			UiKit.frame({ Name = "Node", Size = UDim2.fromOffset(node, node), Position = UDim2.fromOffset(half - node // 2, half - node // 2), BackgroundColor3 = ink, ZIndex = z + 3, Parent = b })
			for d in dirs(t.kind, t.rot) do
				local pos, sz
				if d == 1 then
					pos, sz = UDim2.fromOffset(half - bar // 2, 0), UDim2.fromOffset(bar, half)
				elseif d == 3 then
					pos, sz = UDim2.fromOffset(half - bar // 2, half), UDim2.fromOffset(bar, inner - half)
				elseif d == 2 then
					pos, sz = UDim2.fromOffset(half, half - bar // 2), UDim2.fromOffset(inner - half, bar)
				else
					pos, sz = UDim2.fromOffset(0, half - bar // 2), UDim2.fromOffset(half, bar)
				end
				UiKit.frame({ Name = "Wire", Size = sz, Position = pos, BackgroundColor3 = ink, ZIndex = z + 3, Parent = b })
			end
			if v.highlight == i then
				-- hint: amber edge plus a "!" tag in the corner, clear of the wires
				local edge = UiKit.frame({ Name = "HintEdge", Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, ZIndex = z + 4, Parent = b })
				UiKit.stroke(edge, C.warn, 0, 2)
				UiKit.text("title", {
					Name = "HintTag",
					Text = "!",
					Size = UDim2.fromOffset(14, 18),
					Position = UDim2.fromOffset(S.xs, S.xs),
					BackgroundTransparency = 0,
					BackgroundColor3 = C.amber,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextWrapped = false,
					ZIndex = z + 4,
					Parent = b,
				})
			end
		end
	end
	refocus(root, focus, "Tile1")
end

return View
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="187">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>
{
  "name": "NightShift",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "ArtData": {
        "$path": "src/art"
      },
      "QAClient": {
        "$path": "src/studio/ReplicatedStorage/QAClient.luau"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CameraMaxZoomDistance": 0.5,
        "CameraMinZoomDistance": 0.5,
        "CameraMode": "LockFirstPerson"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 1.5,
        "Brightness": 0.25,
        "GlobalShadows": true,
        "Technology": "Future",
        "Ambient": [
          0.1804,
          0.2118,
          0.2353
        ],
        "OutdoorAmbient": [
          0.4235,
          0.4863,
          0.5255
        ],
        "EnvironmentDiffuseScale": 0.2,
        "EnvironmentSpecularScale": 0.2,
        "ExposureCompensation": 0
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "MaxPlayers": 4
      }
    },
    "SoundService": {
      "$properties": {
        "AmbientReverb": "Hallway"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "DevSync": {
        "$path": "src/studio/ServerStorage/DevSync.luau"
      }
    }
  }
}
